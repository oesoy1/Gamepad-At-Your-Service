+u32 MenuRepeatStepMs(u32 heldMs, bool trackbar)
+{
+	if (heldMs >= 1000)
+		return trackbar ? 40 : 63;
+	if (trackbar && heldMs >= 600)
+		return 80;
+	return CGamepadContextDispatcher::MENU_FOCUS_REPEAT_STEP_MS;
