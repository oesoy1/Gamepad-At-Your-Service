+	if (idx >= static_cast<size_t>(EGamepadHapticChannel::Count))
+		return;
+
+	SGamepadHapticChannelConfig clean = cfg;
+	clean.slider = SanitizeSlider(cfg.slider, 1.0f);
+	clean.base_low = SanitizeSlider(cfg.base_low, 0.5f);
