+ENGINE_API bool RecordSimpleGamepadError(const char* stageTag,
+                                         const char* errorDetail,
+                                         const char* contextName,
+                                         const char* recoveryAction,
+                                         bool isLuaError)
+{
+    if (g_recoveryCallback)
+    {
