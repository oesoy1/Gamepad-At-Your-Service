+				return fnPaw(objId, worldPos.x, worldPos.y, worldPos.z, lvid, gvid, levelName.c_str() ? levelName.c_str() : "");
+			}
+			catch (...)
+			{
+			}
+		}
+	}
+	return false;
+}
