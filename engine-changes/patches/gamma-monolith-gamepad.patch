+    std::snprintf(telBuf, sizeof(telBuf),
+                  TrWid("ui_gp_eng_wid_topbar_telemetry_fmt", " [RB]  | Вес: %.1f/%.1f кг | %u RU | %s"),
+                  current_weight_kg_, max_weight_kg_, money_ru_, pauseLbl);
