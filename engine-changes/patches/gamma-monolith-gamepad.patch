+        GlyphSetToString(m_styleOverride),
+        GlyphSetToString(m_effectiveSet),
+        FaceStyleToString(m_effectiveFaceStyle),
+        m_promptRevision,
+        m_lastDirtyReason);
+    Msg("* [Gamepad] gp_glyphs sample prompts: USE='%s' (tex='%s'), SPRINT_TOGGLE='%s' (tex='%s'), JUMP='%s' (tex='%s'), ltx='%s'",
