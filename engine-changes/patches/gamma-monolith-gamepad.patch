+		           Device.dwTimeContinual, m_lastWeaponAction, actionId, dik, ok ? 1 : 0, m_bLtAdsActive ? 1 : 0,
+		           m_adsLeanSide, pWpn ? pWpn->cNameSect().c_str() : "none");
+		pInput->WriteGamepadTelemetryLine(line);
+	}
