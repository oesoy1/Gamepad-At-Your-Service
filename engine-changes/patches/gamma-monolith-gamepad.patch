+static uint32_t FindOrAddGroup(gpfocus::FocusGraph& graph,
+                               const char* name,
+                               gpfocus::FocusLayoutMode mode,
+                               uint8_t bag_id,
+                               bool wrap)
+{
+    for (const gpfocus::FocusGroup& g : graph.GetGroups())
+    {
+        if (g.name == name)
+            return g.group_id;
+    }
+    return graph.AddGroup(name, mode, bag_id, wrap);
+}
