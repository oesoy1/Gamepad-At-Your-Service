+				moment += glyph.moment;
+			}
+			pen += glyph.advance;
+		}
+		supported &= mass > 0.0;
+		const float inkWidth = supported ? (inkRight - inkLeft) / FooterGlyphScale : 0.0f;
+		const float iconRef = showIcon ? RefIcon + RefIconGap : 0.0f;
+		const float group = iconRef + inkWidth;
