+		if (mode == EScreenMode::WizardClassC)
+		{
+			StartClassCWizard(0);
+		}
+		else
+		{
+			SetStatusMessage(TrRemap("ui_gp_eng_remap_mode_active", "Remap active: [LB/RB] Context, [A] Bind, [X] Unbind, [Y/F2] Class C Wizard, [B/Start] Save & Exit."), false);
