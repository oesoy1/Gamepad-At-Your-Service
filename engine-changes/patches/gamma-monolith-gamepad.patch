+// Gesture trigger type (D4.1 item 1)
+enum class TriggerType : std::uint8_t
+{
+    Button = 0, // Single button press (Tap / Press)
+    Hold = 1,   // Button held for >= hold_threshold_ms
+    Chord = 2   // Modifier button held + primary button pressed
+};
