+void ComparisonCardWidget::InitializeInGraph(gpfocus::FocusGraph& graph)
+{
+    group_id_ = FindOrAddGroup(graph, "WidgetComparisonCard", gpfocus::FocusLayoutMode::List1D, 11, false);
