+	{
+		float rx = 0.f;
+		float ry = 0.f;
+		float sec = 0.f;
+		if (!args || !args[0] || sscanf(args, "%f %f %f", &rx, &ry, &sec) != 3 || sec <= 0.f || (_abs(rx) < EPS_S && _abs(ry) < EPS_S))
