+
+        // 4.8 Сжатие списка при удалении элементов автоматически поджимает окно видимости без выхода за границы
+        scroller.Configure(5, 6, 32.0f); // осталось 5 предметов при 6 видимых строках -> maxTop = 0
+        CheckCase(
