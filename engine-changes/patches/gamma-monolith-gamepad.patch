+	static bool s_freeZoomUpOwned = false;
+	{
+		const u32 upBtn = CInput::GP_BTN_DPAD_UP;
+		const bool ltHeld = aimBtnBit < VBTN_TOTAL_COUNT && IsButtonHeld(aimBtnBit);
+		if (!IsButtonHeld(upBtn) && !IsButtonPressed(upBtn))
