+        GetEngineActionTextureId("USE"),
+        sprintPromptEn,
+        GetEngineActionTextureId("SPRINT_TOGGLE"),
+        jumpPromptEn,
+        GetEngineActionTextureId("JUMP"),
+        ltxPath);
+}
