+CDialogHolder* GetSafeActiveDialogHolderForRemap()
+{
+	if (MainMenu() && MainMenu()->IsActive())
+		return MainMenu();
+	if (g_pGameLevel && CurrentGameUI())
+		return CurrentGameUI();
+	return nullptr;
+}
