+        bool QueryHintsVisibleLua() const
+        {
+            if (g_ai_space)
+            {
+                try
+                {
+                    ::luabind::functor<bool> visFn;
+                    if (ai().script_engine().functor("gp_icons.hints_visible", visFn))
+                        return visFn("menu");
+                }
+                catch (...)
+                {
+                }
+            }
+            return true;
+        }
