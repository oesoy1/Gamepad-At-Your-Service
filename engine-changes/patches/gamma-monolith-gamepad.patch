+	if (w && Device.m_SecondViewport.IsSVPActive() && w->IsZoomed())
+		fov = w->GetSecondVPFov();
+	if (fov < 0.5f || fov > 179.f)
+		return 1.f;
+	const float t0 = tanf(deg2rad(g_fov) * 0.5f);
+	const float t1 = tanf(deg2rad(fov) * 0.5f);
+	return (t1 > 0.f) ? t0 / t1 : 1.f;
+}
