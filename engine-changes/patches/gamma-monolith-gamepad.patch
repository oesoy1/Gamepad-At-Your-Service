+	Msg("* [Gamepad] gp_ctx buttons: raw=0x%05X barrier_consumed=0x%05X effective=0x%05X pressed=0x%05X held=0x%05X released=0x%05X exit_released=0x%05X",
+	    m_rawDownMask,
+	    m_consumedUntilReleaseMask,
+	    m_effectiveDownMask,
+	    m_pressedMask,
+	    m_heldMask,
