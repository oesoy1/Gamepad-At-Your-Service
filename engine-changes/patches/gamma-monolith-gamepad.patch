+	string512 name;
+	xr_sprintf(name, "%s - %02d.%02d.%04d %02d-%02d", level, local.tm_mday, local.tm_mon + 1, local.tm_year + 1900,
+		local.tm_hour, local.tm_min);
+	edit->SetText(name);
+}
