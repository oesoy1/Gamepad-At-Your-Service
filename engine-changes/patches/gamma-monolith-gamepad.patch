+void TrimMenuRadioBounds(Frect& rect)
+{
+	const float width = rect.width();
+	const float height = rect.height();
+	rect.x1 += width * (28.0f / 94.0f);
+	rect.x2 -= width * (29.0f / 94.0f);
+	rect.y1 += height * (10.0f / 56.0f);
+	rect.y2 -= height * (11.0f / 56.0f);
+}
