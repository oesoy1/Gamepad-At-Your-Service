+static void FinishHoldIconRing(u32 now, bool fired)
+{
+	const bool had = g_gpInvHoldIconStart != 0;
+	g_gpInvHoldIconStart = 0;
+	g_gpInvHoldIconDoneAt = (had && fired) ? (now ? now : 1) : 0;
+}
