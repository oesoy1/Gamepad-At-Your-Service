+inline void EnsureParentDirectories(const char* fullPath)
+{
+    if (!fullPath || !fullPath[0])
+        return;
+    char dirBuf[520] = {};
+    std::strncpy(dirBuf, fullPath, sizeof(dirBuf) - 1);
+    for (char* p = dirBuf; *p; ++p)
+    {
+        if (*p == '/' || *p == '\\')
+        {
+            const char saved = *p;
+            *p = '\0';
+            if (dirBuf[0] && std::strlen(dirBuf) > 2)
+                _mkdir(dirBuf);
+            *p = saved;
+        }
+    }
