+bool CUIMessageBox::HasGamepadConfirmation()
+{
+	if (m_eMessageBoxStyle != MESSAGEBOX_YES_NO && m_eMessageBoxStyle != MESSAGEBOX_QUIT_GAME &&
+		m_eMessageBoxStyle != MESSAGEBOX_QUIT_WINDOWS)
