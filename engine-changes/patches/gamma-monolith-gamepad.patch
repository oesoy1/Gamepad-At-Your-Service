+void FillAutoSaveName(CUIWindow* root)
+{
+	auto* edit = FindMenuEdit(root);
+	if (!edit || (edit->GetText() && *edit->GetText()))
+		return;
+	string256 level = "save";
+	if (g_pGameLevel)
+		xr_strcpy(level, CStringTable().translate(Level().name()).c_str());
+	for (char* c = level; *c; ++c)
+		if (strchr("/\\:*?\"<>|^()[]%", *c))
