+namespace
+{
+struct STestFaultCtx
+{
+    int mode = 0;
+    int healthyTicks = 0;
+};
+
+void TestStepFunction(void* rawCtx)
+{
+    STestFaultCtx* ctx = static_cast<STestFaultCtx*>(rawCtx);
+    if (!ctx)
+        return;
+    if (ctx->mode == 1)
+    {
+#ifdef _WIN32
+        RaiseException(EXCEPTION_ACCESS_VIOLATION, 0, 0, nullptr);
+#endif
+    }
+    ctx->healthyTicks++;
+}
+} // namespace
