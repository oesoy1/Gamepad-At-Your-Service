diff --git a/tools/dlss/package_compatibility.py b/tools/dlss/package_compatibility.py
new file mode 100644
index 000000000..ef9b08b74
--- /dev/null
+++ b/tools/dlss/package_compatibility.py
@@ -0,0 +1,124 @@
+"""Build the three-page shader FOMOD. Does not build or deploy the engine."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import shutil
+from zipfile import ZIP_DEFLATED, ZipFile, ZipInfo
+
+
+REPO = Path(__file__).resolve().parents[2]
+SOURCE = REPO / "extras/dlss_fomod"
+LEGACY = REPO / "extras/dlss_gamma/gamedata"
+VERSION = "0.721"
+# The only shader Atmospherics RC7.x and this patch both replace. SSS and Atmospherics
+# keep their own ssfx_* shaders; the upscaler needs no changes in them.
+ATMOS_FILES = ("deffer_impl_flat.ps",)
+# Glossy Puddles Overhaul v2.5 deffer_impl_flat.ps, one per weather family.
+GLOSSY_PUDDLES = ("glossy_puddles_pbr", "glossy_puddles_sss")
+
+
+def copy_file(source: Path, destination: Path) -> None:
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copyfile(source, destination)
+
+
+def write_text(destination: Path, content: str) -> None:
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    destination.write_text(content, encoding="utf-8", newline="\n")
+
+
+def build(output: Path, version: str = VERSION) -> None:
+    archive_name = f"dlss-binaries-GAMMA-compatibility-patch-{version}.zip"
+    # A fresh staging directory prevents stale optional files entering an archive.
+    output.mkdir(parents=True, exist_ok=False)
+    stage = output / "package"
+    stage.mkdir()
+
+    for source in sorted(LEGACY.rglob("*")):
+        if not source.is_file():
+            continue
+        relative = source.relative_to(LEGACY)
+        if relative == Path("shaders/r3/wd_body.vs"):
+            component = "wearable"
+        elif relative.parent == Path("shaders/r3") and relative.name in ATMOS_FILES:
+            component = "atmos_rc7"
+        else:
+            component = "base"
+        copy_file(source, stage / "components" / component / "gamedata" / relative)
+
+    # SSS 23.5's version (puddles kept), with motion vectors.
+    for name in ATMOS_FILES:
+        copy_file(
+            SOURCE / "sss235/gamedata/shaders/r3" / name,
+            stage / "components/base/gamedata/shaders/r3" / name,
+        )
+
+    for component in ("better_beefs", "better_beefs_atmos_rc7", "better_beefs_atmos_rc8", *GLOSSY_PUDDLES):
+        component_source = SOURCE / component / "gamedata"
+        for source in sorted(component_source.rglob("*")):
+            if source.is_file():
+                copy_file(source, stage / "components" / component / "gamedata" / source.relative_to(component_source))
+
+    for name in ("ModuleConfig.xml", "info.xml"):
+        copy_file(SOURCE / "fomod" / name, stage / "fomod" / name)
+    for name in ("README.txt", "CREDITS.txt"):
+        copy_file(SOURCE / name, stage / "docs" / name)
+    for name in ("SOURCE_NOTES.txt", "SOURCE_MANIFEST.json"):
+        copy_file(SOURCE / name, output / name)
+    copy_file(SOURCE / "README.txt", stage / "README.txt")
+
+    selections = {
+        "atmos_none.txt": "Selected: no Atmospherics.",
+        "atmos_26893.txt": "Selected: Atmospherics 2.68.93 Hotfix 3 (stock GAMMA 0.9.5).",
+        "atmos_rc7.txt": "Selected: Atmospherics 2.69 RC7.x (RC7.5 to RC7.71).",
+        "atmos_rc8.txt": "Selected: Atmospherics 2.69 RC8 (any hotfix).",
+        "wearable.txt": "Selected: WearableDevices compatibility.",
+        "better_beefs.txt": "Selected: Better Beef's NVGs (.19) compatibility.",
+        "glossy_puddles.txt": "Selected: Glossy Puddles Overhaul v2.5 compatibility.",
+    }
+    for name, description in selections.items():
+        write_text(stage / "selections" / name, f"{description}\nPatch: {version}\n")
+
+    manifest = {
+        "package": archive_name,
+        "binary_release": version,
+        "status": "release package; no MO2, shader compilation or in-game validation performed for the new variants",
+        "files": [
+            {
+                "path": path.relative_to(stage).as_posix(),
+                "bytes": path.stat().st_size,
+                "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
+            }
+            for path in sorted(stage.rglob("*")) if path.is_file()
+        ],
+    }
+    write_text(output / "MANIFEST.json", json.dumps(manifest, indent=2) + "\n")
+
+    archive = output / archive_name
+    with ZipFile(archive, "w", compression=ZIP_DEFLATED, compresslevel=9) as package:
+        for path in sorted(stage.rglob("*")):
+            if path.is_file():
+                entry = ZipInfo(path.relative_to(stage).as_posix(), (2026, 10, 13, 0, 0, 0))
+                entry.compress_type = ZIP_DEFLATED
+                entry.external_attr = 0o644 << 16
+                package.writestr(entry, path.read_bytes(), compresslevel=9)
+    digest = hashlib.sha256(archive.read_bytes()).hexdigest()
+    write_text(output / f"SHA256SUMS-{version}.txt", f"{digest}  {archive_name}\n")
+    print(f"Created {archive} ({archive.stat().st_size:,} bytes)")
+    print(f"SHA256 {digest}")
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--output", type=Path,
+        default=REPO / "_build/releases" / VERSION,
+        help="New output directory; existing directories are never overwritten.",
+    )
+    parser.add_argument("--version", default=VERSION, help="Name the archive after a test build.")
+    args = parser.parse_args()
+    build(args.output.resolve(), args.version)
diff --git a/tools/dlss/package_release.ps1 b/tools/dlss/package_release.ps1
new file mode 100644
index 000000000..658ea38da
--- /dev/null
+++ b/tools/dlss/package_release.ps1
@@ -0,0 +1,145 @@
+param(
+    [string]$ReleaseName = '',
+    [string]$RuntimeDirectory = '',
+    [string]$TestReport = '',
+    [switch]$AllowUncommitted,
+    [switch]$FullBundle
+)
+$ErrorActionPreference = 'Stop'
+$repo = [IO.Path]::GetFullPath((Join-Path $PSScriptRoot '..\..'))
+if (-not $RuntimeDirectory) { $RuntimeDirectory = Join-Path $repo '_build\dlss_310.9.16' }
+$revision = (& git -C $repo -c "safe.directory=$repo" rev-parse HEAD).Trim()
+if ($LASTEXITCODE -ne 0) { throw 'Cannot determine source revision' }
+$changedPaths = @(& git -C $repo -c "safe.directory=$repo" diff --name-only HEAD -- src sdk extras gamedata)
+if ($LASTEXITCODE -ne 0) { throw 'Cannot inspect source changes' }
+$untrackedPaths = @(& git -C $repo -c "safe.directory=$repo" ls-files --others --exclude-standard -- src sdk extras gamedata)
+if ($LASTEXITCODE -ne 0) { throw 'Cannot inspect untracked sources' }
+$sourceChanges = @(@($changedPaths + $untrackedPaths) | Sort-Object -Unique | ForEach-Object {
+    $sourceFile = Join-Path $repo $_
+    [ordered]@{ path=$_; sha256=$(if (Test-Path -LiteralPath $sourceFile -PathType Leaf) { (Get-FileHash -LiteralPath $sourceFile).Hash } else { 'deleted' }) }
+})
+if ($sourceChanges.Count -and -not $AllowUncommitted) { throw 'Commit source changes or explicitly use -AllowUncommitted for a working-tree test package' }
+if (-not $ReleaseName) { $ReleaseName = 'experimental-' + (Get-Date -Format yyyyMMdd) + '-' + $revision.Substring(0,8) }
+if ($ReleaseName -notmatch '^[a-zA-Z0-9_.-]+$') { throw 'Unsafe release name' }
+$out = Join-Path $repo "_build\releases\$ReleaseName"
+if (Test-Path -LiteralPath $out) { throw "Refusing to overwrite existing release: $out" }
+$standard = Join-Path $repo '_build\_game\bin_dbg\AnomalyDX11.exe'
+$avx = Join-Path $repo '_build\_game\bin_dbg\AnomalyDX11AVX.exe'
+$runtime = Join-Path $RuntimeDirectory 'nvngx_dlss.dll'
+$runtimeLicense = Join-Path $RuntimeDirectory 'LICENSE.txt'
+foreach ($required in $standard,$avx,$runtime,$runtimeLicense,$TestReport) {
+    if (-not $required -or -not (Test-Path -LiteralPath $required -PathType Leaf)) {
+        throw "Required release input is missing: $required"
+    }
+}
+if ((Get-FileHash -LiteralPath $runtime).Hash -ne '3975567B8943C53ACCE397F2B72380092F84F162D00B0D2C7D08A1025C563983') {
+    throw 'Unexpected NVIDIA runtime; update the pinned version and documentation deliberately'
+}
+if ((Get-AuthenticodeSignature -LiteralPath $runtime).Status -ne 'Valid') { throw 'NVIDIA runtime signature is not valid' }
+$reportText = Get-Content -LiteralPath $TestReport -Raw
+if ($sourceChanges.Count -and -not $reportText.Contains('UNCOMMITTED WORKING-TREE BUILD')) { throw 'Test report must identify uncommitted source changes' }
+foreach ($stamp in $revision,(Get-FileHash -LiteralPath $standard).Hash,(Get-FileHash -LiteralPath $avx).Hash) {
+    if (-not $reportText.Contains($stamp)) { throw 'Test report does not match the current engine revision/binaries' }
+}
+$docs = Join-Path $PSScriptRoot 'release'
+$utf8 = [Text.UTF8Encoding]::new($false)
+New-Item -ItemType Directory -Path $out | Out-Null
+Copy-Item -LiteralPath (Join-Path $docs 'PUBLISHING_TEXT.txt'),(Join-Path $docs 'PUBLISHER_CHECKLIST.txt') -Destination $out
+Copy-Item -LiteralPath $TestReport -Destination (Join-Path $out 'TEST_REPORT.txt')
+$packages = @(
+    @{ Name="Monolith-DLSS-FSR3-MT-Engine-DX11-$ReleaseName"; Exe=$standard; Variant='DX11' },
+    @{ Name="Monolith-DLSS-FSR3-MT-Engine-DX11-AVX-$ReleaseName"; Exe=$avx; Variant='DX11-AVX' },
+    @{ Name="Monolith-DLSS-FSR3-GAMMA-Compatibility-$ReleaseName"; Exe=$null; Variant='GAMMA shader/UI override' }
+)
+Add-Type -AssemblyName System.IO.Compression.FileSystem
+$archiveHashes = @()
+foreach ($package in $packages) {
+    $stage = Join-Path $out $package.Name
+    $licenses = Join-Path $stage 'licenses'
+    New-Item -ItemType Directory -Path $stage,$licenses | Out-Null
+    Copy-Item -LiteralPath (Join-Path $docs 'INSTALL.txt'),(Join-Path $docs 'CREDITS.txt') -Destination $stage
+    Copy-Item -LiteralPath $TestReport -Destination (Join-Path $stage 'TEST_REPORT.txt')
+    Copy-Item -LiteralPath (Join-Path $repo 'License.txt') -Destination (Join-Path $licenses 'GSC-Engine.txt')
+    Copy-Item -LiteralPath (Join-Path $repo 'sdk\FSR3\LICENSE.txt') -Destination (Join-Path $licenses 'AMD-FidelityFX.txt')
+    if ($package.Exe) {
+        New-Item -ItemType Directory -Path (Join-Path $stage 'bin') | Out-Null
+        Copy-Item -LiteralPath $package.Exe,$runtime -Destination (Join-Path $stage 'bin')
+        Copy-Item -LiteralPath $runtimeLicense -Destination (Join-Path $licenses 'NVIDIA-DLSS-Runtime.txt')
+        Copy-Item -LiteralPath (Join-Path $repo 'sdk\DLSS\LICENSE.txt') -Destination (Join-Path $licenses 'NVIDIA-NGX-SDK.txt')
+        Copy-Item -LiteralPath (Join-Path $repo 'sdk\FSR3\Third_party_notices.txt') -Destination (Join-Path $licenses 'FidelityFX-Third-Party.txt')
+        Copy-Item -LiteralPath (Join-Path $repo 'src\3rd party\cximage\license.txt') -Destination (Join-Path $licenses 'CxImage.txt')
+    } else {
+        Copy-Item -LiteralPath (Join-Path $repo 'extras\dlss_gamma\gamedata') -Destination (Join-Path $stage 'gamedata') -Recurse
+    }
+    $files = @(Get-ChildItem -LiteralPath $stage -File -Recurse | Sort-Object FullName | ForEach-Object {
+        $relative = $_.FullName.Substring($stage.Length + 1).Replace('\','/')
+        if ($relative -match '(?i)(savedgames|appdata|shader_cache|fsgame\.ltx|meta\.ini|\.pdb$|\.scoc$|\.scop$|\.log$)') {
+            throw "Private/development artifact in package: $relative"
+        }
+        [ordered]@{ path=$relative; bytes=$_.Length; sha256=(Get-FileHash -LiteralPath $_.FullName).Hash }
+    })
+    $manifest = [ordered]@{
+        release=$ReleaseName
+        source_revision=$revision
+        source_state=$(if ($sourceChanges.Count) { 'uncommitted working-tree test build; revision is the base commit only' } else { 'committed' })
+        source_changes=$sourceChanges
+        source_branch='feat/dlss-sr-mt'
+        upstream_base='7b79d2be'
+        variant=$package.Variant
+        configuration='Release x64; engine solution DX11 or DX11-AVX as named'
+        dlss_runtime='310.9.16.0'
+        fsr_upscaler='3.1.2 community D3D11'
+        frame_generation=$false
+        note='Manifest covers payload files, excluding this manifest itself. No gameplay/FPS guarantee.'
+        files=$files
+    }
+    [IO.File]::WriteAllText((Join-Path $stage 'MANIFEST.json'),($manifest | ConvertTo-Json -Depth 7),$utf8)
+    $zipPath = Join-Path $out ($package.Name + '.zip')
+    [IO.Compression.ZipFile]::CreateFromDirectory($stage,$zipPath,[IO.Compression.CompressionLevel]::Optimal,$false)
+    # Verify actual archive payload, not only the loose staging files.
+    $zip = [IO.Compression.ZipFile]::OpenRead($zipPath)
+    try {
+        foreach ($file in $files) {
+            $entry = $zip.GetEntry($file.path)
+            if (-not $entry -or $entry.Length -ne $file.bytes) { throw "Archive mismatch: $($file.path)" }
+            $stream = $entry.Open()
+            $sha = [Security.Cryptography.SHA256]::Create()
+            try { $hash = [BitConverter]::ToString($sha.ComputeHash($stream)).Replace('-','') }
+            finally { $sha.Dispose(); $stream.Dispose() }
+            if ($hash -ne $file.sha256) { throw "Archive hash mismatch: $($file.path)" }
+        }
+        if ($zip.Entries.Count -ne $files.Count + 1) { throw 'Unexpected extra ZIP entries' }
+    } finally { $zip.Dispose() }
+    $archiveHashes += (Get-FileHash -LiteralPath $zipPath).Hash + '  ' + [IO.Path]::GetFileName($zipPath)
+    Write-Output "Verified $($package.Name).zip ($($files.Count) payload files)"
+}
+[IO.File]::WriteAllLines((Join-Path $out 'SHA256SUMS.txt'),$archiveHashes,$utf8)
+if ($FullBundle) {
+    $bundleStage = Join-Path $out 'full-bundle'
+    New-Item -ItemType Directory -Path $bundleStage | Out-Null
+    foreach ($package in $packages) {
+        Copy-Item -LiteralPath (Join-Path $out ($package.Name + '.zip')) -Destination $bundleStage
+    }
+    Copy-Item -LiteralPath (Join-Path $docs 'INSTALL.txt') -Destination $bundleStage
+    Copy-Item -LiteralPath (Join-Path $out 'TEST_REPORT.txt'),(Join-Path $out 'SHA256SUMS.txt') -Destination $bundleStage
+    $bundleFiles = @(Get-ChildItem -LiteralPath $bundleStage -File)
+    $bundlePath = Join-Path $out "Monolith-DLSS-FSR3-MT-Full-$ReleaseName.zip"
+    [IO.Compression.ZipFile]::CreateFromDirectory($bundleStage,$bundlePath,[IO.Compression.CompressionLevel]::NoCompression,$false)
+    $bundleZip = [IO.Compression.ZipFile]::OpenRead($bundlePath)
+    try {
+        if ($bundleZip.Entries.Count -ne $bundleFiles.Count) { throw 'Unexpected full bundle entries' }
+        foreach ($file in $bundleFiles) {
+            $entry = $bundleZip.GetEntry($file.Name)
+            if (-not $entry -or $entry.Length -ne $file.Length) { throw "Bundle mismatch: $($file.Name)" }
+            $stream = $entry.Open()
+            $sha = [Security.Cryptography.SHA256]::Create()
+            try { $hash = [BitConverter]::ToString($sha.ComputeHash($stream)).Replace('-','') }
+            finally { $sha.Dispose(); $stream.Dispose() }
+            if ($hash -ne (Get-FileHash -LiteralPath $file.FullName).Hash) { throw "Bundle hash mismatch: $($file.Name)" }
+        }
+    } finally { $bundleZip.Dispose() }
+    $bundleHash = (Get-FileHash -LiteralPath $bundlePath).Hash + '  ' + [IO.Path]::GetFileName($bundlePath)
+    [IO.File]::WriteAllLines((Join-Path $out 'FULL-BUNDLE-SHA256.txt'),@($bundleHash),$utf8)
+    Write-Output "Verified full bundle: $bundlePath"
+}
+Write-Output "Release output: $out"
diff --git a/tools/dlss/pda_depth_test.cpp b/tools/dlss/pda_depth_test.cpp
new file mode 100644
index 000000000..6ced6998a
--- /dev/null
+++ b/tools/dlss/pda_depth_test.cpp
@@ -0,0 +1,174 @@
+// Runs the actual native-PDA depth shader on D3D11 WARP, then draws a one-pixel
+// checkerboard through its depth buffer to verify native UI and hand occlusion.
+#include <d3d11.h>
+#include <d3dcompiler.h>
+#include <wrl/client.h>
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <stdexcept>
+#include <vector>
+using Microsoft::WRL::ComPtr;
+static void Check(HRESULT hr, const char* stage)
+{
+    if (FAILED(hr)) { std::printf("%s: 0x%08X\n", stage, unsigned(hr)); throw std::runtime_error(stage); }
+}
+static void Require(bool good, const char* stage) { if (!good) throw std::runtime_error(stage); }
+static ComPtr<ID3DBlob> Compile(const char* source, const char* entry, const char* target)
+{
+    ComPtr<ID3DBlob> code, error;
+    HRESULT hr = source ? D3DCompile(source, std::strlen(source), nullptr, nullptr, nullptr,
+        entry, target, D3DCOMPILE_ENABLE_STRICTNESS, 0, &code, &error) :
+        D3DCompileFromFile(L"extras/dlss_gamma/gamedata/shaders/r3/dlss_ui_depth.ps", nullptr,
+            D3D_COMPILE_STANDARD_FILE_INCLUDE, entry, target, D3DCOMPILE_ENABLE_STRICTNESS, 0, &code, &error);
+    if (error) std::printf("%s", static_cast<const char*>(error->GetBufferPointer()));
+    Check(hr, "Compile");
+    return code;
+}
+int main()
+try
+{
+    ComPtr<ID3D11Device> device;
+    ComPtr<ID3D11DeviceContext> ctx;
+    Check(D3D11CreateDevice(nullptr, D3D_DRIVER_TYPE_WARP, nullptr, D3D11_CREATE_DEVICE_DEBUG,
+        nullptr, 0, D3D11_SDK_VERSION, &device, nullptr, &ctx), "Device");
+    ComPtr<ID3D11InfoQueue> debug;
+    Check(device.As(&debug), "Debug layer");
+    const char* shader = R"(
+float4 VS(uint id : SV_VertexID) : SV_Position
+{
+    float2 uv = float2((id << 1) & 2, id & 2);
+    return float4(uv * float2(2, -2) + float2(-1, 1), 0.5, 1);
+}
+float4 PS(float4 position : SV_Position) : SV_Target
+{
+    uint2 pixel = uint2(position.xy);
+    float value = (pixel.x + pixel.y) & 1;
+    return float4(value, value, value, 1);
+})";
+    auto vsCode = Compile(shader, "VS", "vs_5_0");
+    auto uiCode = Compile(shader, "PS", "ps_5_0");
+    auto depthCode = Compile(nullptr, "main", "ps_5_0");
+    ComPtr<ID3D11VertexShader> vs;
+    ComPtr<ID3D11PixelShader> depthPs, uiPs;
+    Check(device->CreateVertexShader(vsCode->GetBufferPointer(), vsCode->GetBufferSize(), nullptr, &vs), "VS");
+    Check(device->CreatePixelShader(depthCode->GetBufferPointer(), depthCode->GetBufferSize(), nullptr, &depthPs), "Depth PS");
+    Check(device->CreatePixelShader(uiCode->GetBufferPointer(), uiCode->GetBufferSize(), nullptr, &uiPs), "UI PS");
+    constexpr unsigned width = 37, height = 23, depthMax = 0xffffff;
+    D3D11_TEXTURE2D_DESC desc = {};
+    desc.Width = width; desc.Height = height; desc.MipLevels = desc.ArraySize = desc.SampleDesc.Count = 1;
+    desc.Format = DXGI_FORMAT_R24G8_TYPELESS; desc.BindFlags = D3D11_BIND_DEPTH_STENCIL;
+    ComPtr<ID3D11Texture2D> depth, depthRead, color, colorRead;
+    Check(device->CreateTexture2D(&desc, nullptr, &depth), "Native depth");
+    D3D11_DEPTH_STENCIL_VIEW_DESC dsvDesc = {};
+    dsvDesc.Format = DXGI_FORMAT_D24_UNORM_S8_UINT; dsvDesc.ViewDimension = D3D11_DSV_DIMENSION_TEXTURE2D;
+    ComPtr<ID3D11DepthStencilView> dsv;
+    Check(device->CreateDepthStencilView(depth.Get(), &dsvDesc, &dsv), "Native DSV");
+    desc.BindFlags = 0; desc.Usage = D3D11_USAGE_STAGING; desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    Check(device->CreateTexture2D(&desc, nullptr, &depthRead), "Depth staging");
+    desc.Format = DXGI_FORMAT_R32G32B32A32_FLOAT;
+    Check(device->CreateTexture2D(&desc, nullptr, &colorRead), "Color staging");
+    desc.BindFlags = D3D11_BIND_RENDER_TARGET; desc.Usage = D3D11_USAGE_DEFAULT; desc.CPUAccessFlags = 0;
+    Check(device->CreateTexture2D(&desc, nullptr, &color), "Native color");
+    ComPtr<ID3D11RenderTargetView> rtv;
+    Check(device->CreateRenderTargetView(color.Get(), nullptr, &rtv), "Native RTV");
+    D3D11_DEPTH_STENCIL_DESC dsDesc = {};
+    dsDesc.DepthEnable = TRUE; dsDesc.DepthWriteMask = D3D11_DEPTH_WRITE_MASK_ALL;
+    dsDesc.DepthFunc = D3D11_COMPARISON_ALWAYS;
+    ComPtr<ID3D11DepthStencilState> copyState, uiState;
+    Check(device->CreateDepthStencilState(&dsDesc, &copyState), "Copy depth state");
+    dsDesc.DepthWriteMask = D3D11_DEPTH_WRITE_MASK_ZERO; dsDesc.DepthFunc = D3D11_COMPARISON_LESS_EQUAL;
+    Check(device->CreateDepthStencilState(&dsDesc, &uiState), "UI depth state");
+    D3D11_BLEND_DESC blendDesc = {};
+    ComPtr<ID3D11BlendState> noColor;
+    Check(device->CreateBlendState(&blendDesc, &noColor), "Depth-only color mask");
+    D3D11_BUFFER_DESC cbDesc = {};
+    cbDesc.ByteWidth = 16; cbDesc.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+    ComPtr<ID3D11Buffer> cb;
+    Check(device->CreateBuffer(&cbDesc, nullptr, &cb), "Constants");
+    ctx->VSSetShader(vs.Get(), nullptr, 0);
+    ctx->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    ctx->PSSetConstantBuffers(0, 1, cb.GetAddressOf());
+    unsigned cases = 0;
+    for (const auto size : {std::array<unsigned, 2>{37, 23}, {25, 15}, {19, 12}, {12, 8}, {1, 1}})
+    {
+        const unsigned rw = size[0], rh = size[1];
+        std::vector<uint32_t> input(rw * rh);
+        for (unsigned y = 0; y < rh; ++y) for (unsigned x = 0; x < rw; ++x)
+        {
+            const float z = (x == 0 && y == 0) ? 0.f : (x == rw - 1 && y == rh - 1) ? 1.f :
+                x < rw / 2 ? 0.005f + float(y) * 0.00001f : 0.018f + float(y) * 0.00001f;
+            input[y * rw + x] = uint32_t(std::round(z * depthMax)) | 0xac000000u;
+        }
+        desc.Width = rw; desc.Height = rh; desc.Format = DXGI_FORMAT_R24G8_TYPELESS;
+        desc.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+        D3D11_SUBRESOURCE_DATA data{input.data(), rw * sizeof(uint32_t), 0};
+        ComPtr<ID3D11Texture2D> source;
+        Check(device->CreateTexture2D(&desc, &data, &source), "Source depth");
+        D3D11_SHADER_RESOURCE_VIEW_DESC srvDesc = {};
+        srvDesc.Format = DXGI_FORMAT_R24_UNORM_X8_TYPELESS; srvDesc.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE2D;
+        srvDesc.Texture2D.MipLevels = 1;
+        ComPtr<ID3D11ShaderResourceView> srv;
+        Check(device->CreateShaderResourceView(source.Get(), &srvDesc, &srv), "Source SRV");
+        for (const auto jitter : {std::array<float, 2>{0, 0}, {0.49f, 0.33f}, {-0.49f, -0.33f}, {0.49f, -0.49f}, {-0.49f, 0.49f}})
+        {
+            const std::array<float, 4> params{float(rw) / width, float(rh) / height, jitter[0], jitter[1]};
+            ctx->UpdateSubresource(cb.Get(), 0, nullptr, params.data(), 0, 0);
+            const float clear[4] = {0.25f, 0.25f, 0.25f, 1};
+            ctx->ClearRenderTargetView(rtv.Get(), clear);
+            ctx->ClearDepthStencilView(dsv.Get(), D3D11_CLEAR_DEPTH | D3D11_CLEAR_STENCIL, 0, 0x5a);
+            ctx->OMSetRenderTargets(1, rtv.GetAddressOf(), dsv.Get());
+            ctx->OMSetDepthStencilState(copyState.Get(), 0);
+            ctx->OMSetBlendState(noColor.Get(), nullptr, ~0u);
+            D3D11_VIEWPORT viewport{0, 0, float(width), float(height), 0, 1};
+            ctx->RSSetViewports(1, &viewport);
+            ctx->PSSetShader(depthPs.Get(), nullptr, 0);
+            ctx->PSSetShaderResources(0, 1, srv.GetAddressOf());
+            ctx->Draw(3, 0);
+            ctx->OMSetDepthStencilState(uiState.Get(), 0);
+            ctx->OMSetBlendState(nullptr, nullptr, ~0u);
+            viewport.MaxDepth = 0.02f; // Same compressed HUD range as rmNear.
+            ctx->RSSetViewports(1, &viewport);
+            ctx->PSSetShader(uiPs.Get(), nullptr, 0);
+            ctx->Draw(3, 0);
+            ctx->CopyResource(depthRead.Get(), depth.Get());
+            ctx->CopyResource(colorRead.Get(), color.Get());
+            D3D11_MAPPED_SUBRESOURCE zd, cd;
+            Check(ctx->Map(depthRead.Get(), 0, D3D11_MAP_READ, 0, &zd), "Depth readback");
+            Check(ctx->Map(colorRead.Get(), 0, D3D11_MAP_READ, 0, &cd), "Color readback");
+            bool valid = true;
+            for (unsigned y = 0; y < height; ++y) for (unsigned x = 0; x < width; ++x)
+            {
+                const int sx = std::clamp(int(std::floor((x + 0.5f) * params[0] + jitter[0])), 0, int(rw) - 1);
+                const int sy = std::clamp(int(std::floor((y + 0.5f) * params[1] + jitter[1])), 0, int(rh) - 1);
+                const uint32_t expected = input[sy * rw + sx] & depthMax;
+                const auto actual = reinterpret_cast<const uint32_t*>(static_cast<const char*>(zd.pData) + y * zd.RowPitch)[x];
+                valid &= std::abs(int(actual & depthMax) - int(expected)) <= 1 && (actual >> 24) == 0x5a;
+                const auto pixel = reinterpret_cast<const float*>(static_cast<const char*>(cd.pData) + y * cd.RowPitch) + x * 4;
+                const float expectedColor = double(expected) / depthMax < 0.01 ? 0.25f : float((x + y) & 1);
+                valid &= pixel[0] == expectedColor && pixel[1] == expectedColor && pixel[2] == expectedColor && pixel[3] == 1;
+            }
+            ctx->Unmap(depthRead.Get(), 0); ctx->Unmap(colorRead.Get(), 0);
+            Require(valid, "Native depth/occlusion/checkerboard mismatch");
+            ++cases;
+        }
+    }
+    for (UINT64 i = 0; i < debug->GetNumStoredMessages(); ++i)
+    {
+        SIZE_T size = 0; debug->GetMessage(i, nullptr, &size);
+        std::vector<char> bytes(size);
+        auto* message = reinterpret_cast<D3D11_MESSAGE*>(bytes.data());
+        Check(debug->GetMessage(i, message, &size), "Debug message");
+        if (message->Severity <= D3D11_MESSAGE_SEVERITY_WARNING)
+        {
+            std::printf("%s\n", message->pDescription);
+            throw std::runtime_error("D3D11 debug warning/error");
+        }
+    }
+    ctx->ClearState(); ctx->Flush();
+    std::printf("Native PDA depth tests passed: %u scale/jitter cases, depth/stencil, occlusion and native pixel detail.\n", cases);
+}
+catch (const std::exception& e) { std::fprintf(stderr, "FAIL: %s\n", e.what()); return 1; }
