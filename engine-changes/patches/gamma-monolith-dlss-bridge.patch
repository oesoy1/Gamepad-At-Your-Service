diff --git a/extras/dlss_gamma/gamedata/shaders/r3/dlss_sunshaft_mask.ps b/extras/dlss_gamma/gamedata/shaders/r3/dlss_sunshaft_mask.ps
new file mode 100644
index 000000000..324b46200
--- /dev/null
+++ b/extras/dlss_gamma/gamedata/shaders/r3/dlss_sunshaft_mask.ps
@@ -0,0 +1,67 @@
+#include "common.h"
+#include "anomaly_shaders.h"
+
+// Screen-space sunshaft mask over time, for the post chain after reconstruction.
+// The mask comes from jittered, render-sized depth, so silhouettes change a little
+// every frame and nothing smooths them any more: the radial blur spreads each change
+// along a whole shaft. Blending the frames turns the jitter into coverage instead.
+Texture2D s_current; // this frame's mask
+Texture2D s_history;
+Texture2D s_motion_vectors;
+
+float4x4 m_current;
+float4x4 m_previous;
+float4 dlss_sunshaft_params; // x = weight of this frame
+
+#define DLSS_SUNSHAFT_SKY_DEPTH 10000.0f
+#define DLSS_SUNSHAFT_CLAMP_RADIUS 2.0f // display pixels; wider than a render pixel
+
+struct dlss_sunshaft_out
+{
+    float4 mask : SV_Target0;
+    float4 history : SV_Target1;
+};
+
+// Previous position in UV. The sky writes no motion vectors, so it follows the camera.
+float2 dlss_sunshaft_previous(float2 tc)
+{
+    float depth = s_position.Sample(smp_nofilter, tc).z;
+    if (is_not_sky(depth) > 0.5f)
+        return tc - s_motion_vectors.Sample(smp_nofilter, tc).xy;
+
+    float2 pixel = tc * screen_res.xy;
+    float4 P = float4(DLSS_SUNSHAFT_SKY_DEPTH * float3(pixel * pos_decompression_params.zw - pos_decompression_params.xy, 1.0f), 1.0f);
+    float4 current = mul(m_current, P);
+    float4 previous = mul(m_previous, P);
+    float2 motion = current.xy / current.w - previous.xy / previous.w;
+    return tc - float2(motion.x, -motion.y) * 0.5f;
+}
+
+dlss_sunshaft_out main(v2p_ssss I)
+{
+    float2 tc = I.tc0.xy;
+    float4 center = s_current.Sample(smp_nofilter, tc);
+
+    // Limits for the history, so that what moved away does not stay in the shafts.
+    float low = center.x, high = center.x;
+    float2 reach = DLSS_SUNSHAFT_CLAMP_RADIUS * screen_res.zw;
+    for (int y = -1; y <= 1; ++y)
+    {
+        for (int x = -1; x <= 1; ++x)
+        {
+            float value = s_current.Sample(smp_nofilter, tc + float2(x, y) * reach).x;
+            low = min(low, value);
+            high = max(high, value);
+        }
+    }
+
+    float2 previous = dlss_sunshaft_previous(tc);
+    bool inside = all(previous >= 0.0f) && all(previous <= 1.0f);
+    float history = clamp(s_history.Sample(smp_rtlinear, previous).x, low, high);
+    float mask = inside ? lerp(history, center.x, dlss_sunshaft_params.x) : center.x;
+
+    dlss_sunshaft_out O;
+    O.mask = float4(mask, mask, mask, center.w);
+    O.history = float4(mask, 0.0f, 0.0f, 1.0f);
+    return O;
+}
diff --git a/extras/dlss_gamma/gamedata/shaders/r3/dlss_ui_depth.ps b/extras/dlss_gamma/gamedata/shaders/r3/dlss_ui_depth.ps
new file mode 100644
index 000000000..2b8bd86b8
--- /dev/null
+++ b/extras/dlss_gamma/gamedata/shaders/r3/dlss_ui_depth.ps
@@ -0,0 +1,25 @@
+// Native-resolution depth for HUD screens drawn AFTER temporal reconstruction.
+// Jitter is in render pixels (+X right, +Y down). Sample the corresponding
+// jittered scene pixel; filtering depth would invent surfaces at silhouettes.
+Texture2D<float> s_scene_depth;
+float4 dlss_ui_depth_params; // render/display xy, current raster jitter zw
+float4 dlss_ui_depth_lens;   // x > 0: depth for 3D scope lenses
+
+float main(float4 position : SV_Position) : SV_Depth
+{
+    uint width, height;
+    s_scene_depth.GetDimensions(width, height);
+    const int2 last = int2(width, height) - 1;
+    int2 pixel = int2(floor(position.xy * dlss_ui_depth_params.xy + dlss_ui_depth_params.zw));
+    float depth = s_scene_depth.Load(int3(clamp(pixel, int2(0, 0), last), 0));
+    // The upscaler blends the scope body's rim with the unmagnified scene behind
+    // it, since the lens is not in the scene. Take the farthest depth around the
+    // pixel so the lens covers that strip, about one render pixel wide.
+    if (dlss_ui_depth_lens.x > 0)
+    {
+        [unroll] for (int y = -1; y <= 1; ++y)
+        [unroll] for (int x = -1; x <= 1; ++x)
+            depth = max(depth, s_scene_depth.Load(int3(clamp(pixel + int2(x, y), int2(0, 0), last), 0)));
+    }
+    return depth;
+}
diff --git a/extras/dlss_gamma/gamedata/shaders/r3/dlss_volumetric_history.ps b/extras/dlss_gamma/gamedata/shaders/r3/dlss_volumetric_history.ps
new file mode 100644
index 000000000..f35d0da17
--- /dev/null
+++ b/extras/dlss_gamma/gamedata/shaders/r3/dlss_volumetric_history.ps
@@ -0,0 +1,64 @@
+#include "common.h"
+#include "anomaly_shaders.h"
+#include "dlss_contract.h"
+
+// Volumetric lights over time, for the post chain after reconstruction. They are
+// drawn render-sized and jittered, with noise that changes every frame, and are
+// added after the upscaler, so nothing averaged them any more: grain and flicker
+// around foliage. Same history as dlss_sunshaft_mask.ps, in colour.
+Texture2D s_current; // this frame's volumetric lights, render-sized and jittered
+Texture2D s_history; // display-sized, unjittered
+Texture2D s_motion_vectors;
+
+float4x4 m_current;
+float4x4 m_previous;
+float4 dlss_volumetric_history_params; // x = weight of this frame, yz = raster jitter in UV
+
+#define DLSS_VOLUMETRIC_SKY_DEPTH 10000.0f
+
+// Previous position in UV. The sky writes no motion vectors, so it follows the camera.
+float2 dlss_volumetric_previous(float2 tc)
+{
+    float depth = s_position.SampleLevel(smp_nofilter, tc, 0).z;
+    float2 motion;
+    [branch] if (is_not_sky(depth) > 0.5f)
+    {
+        motion = s_motion_vectors.SampleLevel(smp_nofilter, tc, 0).xy;
+    }
+    else
+    {
+        float2 pixel = tc * screen_res.xy;
+        float4 P = float4(DLSS_VOLUMETRIC_SKY_DEPTH * float3(pixel * pos_decompression_params.zw - pos_decompression_params.xy, 1.0f), 1.0f);
+        float4 current = mul(m_current, P);
+        float4 previous = mul(m_previous, P);
+        float2 camera = current.xy / current.w - previous.xy / previous.w;
+        motion = float2(camera.x, -camera.y) * 0.5f;
+    }
+    return tc - motion;
+}
+
+float4 main(float4 position : SV_Position) : SV_Target
+{
+    float2 tc = position.xy * screen_res.zw;
+    float2 current_tc = tc + dlss_volumetric_history_params.yz;
+    float4 center = s_current.SampleLevel(smp_rtlinear, current_tc, 0);
+
+    // Limits for the history from this frame's render pixels around it, so that
+    // what moved away does not stay. They span the noise, which then averages out.
+    float2 texel = rcp(dlss_params.yz);
+    float4 low = center, high = center;
+    [unroll] for (int y = -1; y <= 1; ++y)
+    {
+        [unroll] for (int x = -1; x <= 1; ++x)
+        {
+            float4 value = s_current.SampleLevel(smp_nofilter, current_tc + float2(x, y) * texel, 0);
+            low = min(low, value);
+            high = max(high, value);
+        }
+    }
+
+    float2 previous = dlss_volumetric_previous(tc);
+    bool inside = all(previous >= 0.0f) && all(previous <= 1.0f);
+    float4 history = clamp(s_history.SampleLevel(smp_rtlinear, previous, 0), low, high);
+    return inside ? lerp(history, center, dlss_volumetric_history_params.x) : center;
+}
diff --git a/extras/dlss_gamma/gamedata/shaders/r3/lmape.vs b/extras/dlss_gamma/gamedata/shaders/r3/lmape.vs
new file mode 100644
index 000000000..4eb6c99dd
--- /dev/null
+++ b/extras/dlss_gamma/gamedata/shaders/r3/lmape.vs
@@ -0,0 +1,43 @@
+//	TODO: DX10: Check r2 path. If we always get hemi here
+#define	USE_LM_HEMI
+#include "common.h"
+#include "screenspace_mvectors.h"
+
+struct 	v_lmap
+{
+	float4 	pos		: POSITION;		// (float,float,float,1)
+	float4	norm	: NORMAL;		// (nx,ny,nz,hemi occlusion)
+	float2 	tc0		: TEXCOORD0;	// (base)
+	float2	tc1		: TEXCOORD1;	// (lmap/compressed)
+};
+struct vf
+{
+	float2 tc0	: TEXCOORD0;
+	float2 tc1	: TEXCOORD1;
+	float2 tch	: TEXCOORD2;
+	float3 tc2	: TEXCOORD3;
+	float3 c0	: COLOR0;		// c0=hemi+v-lights, 	c0.a = dt*
+	float3 c1	: COLOR1;		// c1=sun, 		c1.a = dt+
+	float  fog	: FOG;
+	float4 hpos	: SV_Position;
+};
+
+vf main(v_static v)
+{
+	vf 		o;
+
+	float3 	pos_w	= v.P;
+	float3 	norm_w	= normalize(unpack_normal(v.Nh));
+	
+	o.hpos 		= mul				(m_VP, v.P);			// xform, input in world coords
+	o.hpos.xy	= ssfx_taa_jitter	(o.hpos);				// without it the upscaler gets the same samples while the view is still
+	o.tc0		= unpack_tc_base	(v.tc,v.T.w,v.B.w);		// copy tc
+	o.tc1		= unpack_tc_lmap	(v.lmh);			// copy tc 
+	o.tch 		= o.tc1;
+	o.tc2		= calc_reflection	(pos_w, norm_w);
+	o.c0		= v_hemi(norm_w);	// just hemisphere
+	o.c1 		= v_sun	(norm_w);  	// sun
+	o.fog.x 	= saturate(calc_fogging (v.P));			// fog, input in world coords
+
+	return o;
+}
diff --git a/extras/dlss_gamma/gamedata/shaders/r3/night_vision.h b/extras/dlss_gamma/gamedata/shaders/r3/night_vision.h
