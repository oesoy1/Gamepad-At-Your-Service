+	D.rgb = 2 * D.rgb * dt;
+
+	// Damp ring: wet-look darkening ( darks get richer, brights stay bright )
+	D.rgb = pow(max(D.rgb, 0.0001f), lerp(1.0f, G_PUDDLES_DAMP_GAMMA, damp_ring));
+
+	// Apply tint
+	D.rgb = lerp( D.rgb, D.rgb * G_PUDDLES_TINT, puddles);
+
+	// Deeper water is darker
+	D.rgb *= lerp(float3(1.0f, 1.0f, 1.0f), G_PUDDLES_DEPTH_DARKEN, puddles * depth_n);
+	D.rgb *= 1.0f + erandis_wk.z;
+
+	// Puddle gloss ( bus_erandis.w is driven by monkey_gloss.script through the shader bus: time of day + weather ).
+	// Same gloss as terrain puddles, so a puddle looks the same on dirt and on asphalt.
+	float water_src    = saturate(bus_erandis.w);
+	water_src    = (water_src > 0.001f) ? water_src : G_PUDDLES_FALLBACK_GLOSS; // no bus / script not running: fixed gloss
+	float water_gloss  = min(water_src, G_PUDDLES_REFLECTIVITY);
+	float puddle_gloss = water_gloss * lerp(G_PUDDLES_SHALLOW_GLOSS, 1.0f, depth_n);
+	float ground_gloss = g_R + g_G + g_B + g_A;
+
+	// Add at the end the extra wetness. Full intensity at 50% of wetness ( rain_params.y )
+#ifndef SSFX_NEWGLOSS
+	ground_gloss += saturate(rain_params.y * 2.0f) * G_PUDDLES_TERRAIN_EXTRA_WETNESS * (1.0f - puddles);
+#endif
+
+	// Damp ring and puddles to the final gloss result
+	// Damp ring gloss: never below G_PUDDLES_DAMP_GLOSS_MIN, never above the puddle gloss itself
+	float damp_gloss = min(max(water_gloss * G_PUDDLES_DAMP_GLOSS, G_PUDDLES_DAMP_GLOSS_MIN), water_gloss);
+	G = lerp(ground_gloss, max(ground_gloss, damp_gloss), damp_ring);
+	G = lerp(G, puddle_gloss, puddles);
+
+  #else
+	float3	N 	= I.N.xyz	;
+  #endif
+
+ #else
+	D.rgb	= 2*D.rgb*s_detail.Sample( smp_base, I.tcdbump).rgb;
+ #endif
+#else
+	float3	N 	= I.N.xyz	;
+#endif
+
+	// hemi, sun, material
+	float 	ms	= xmaterial	;
+#ifdef USE_R2_STATIC_SUN
+		 	ms 	= L.w		;
+#endif
+
+  // 2. Standart output
+  float4     Ne = float4	(normalize(N), 									D.w			);
+  O				= pack_gbuffer( 
+								Ne,	// hemi
+								float4 	(I.position.xyz + Ne.xyz*def_virtualh/2.h, 	0.95f			),	//
+								float4	(D.x,	D.y,	D.z,						G			) );	// OUT: rgb.gloss
+
+  // Preserve Glossy Puddles shading while supplying temporal motion.
+  O.velocity = ssfx_mv_calc(I.vel_curr, I.vel_prev, 0, 0);
+  return O;
+}
diff --git a/extras/dlss_fomod/sss235/gamedata/shaders/r3/deffer_impl_flat.ps b/extras/dlss_fomod/sss235/gamedata/shaders/r3/deffer_impl_flat.ps
new file mode 100644
index 000000000..9b10adebf
--- /dev/null
+++ b/extras/dlss_fomod/sss235/gamedata/shaders/r3/deffer_impl_flat.ps
@@ -0,0 +1,195 @@
+#include "check_screenspace.h"
+#include "settings_screenspace_PUDDLES.h"
+#include "settings_screenspace_SSR.h"
+
+#include "common.h"
+#include "screenspace_mvectors.h"
+#include "sload.h"
+
+#include "screenspace_common_ripples.h"
+
+Texture2D s_puddles_normal;
+Texture2D s_puddles_perlin;
+Texture2D s_puddles_mask;
+Texture2D s_rainsplash;
+
+#define	USE_4_DETAIL
+
+#if defined(USE_TDETAIL) && defined(USE_4_DETAIL)
+#	define	USE_4_BUMP
+#endif
+
+#ifdef USE_4_BUMP
+f_deffer 	main	( p_bumped I 	)
+#else
+f_deffer 	main	( p_flat I 		)
+#endif
+{
+	f_deffer	O;
+
+ 	// diffuse
+	float4 D		= tbase		(I.tcdh);			// IN:  rgb.a
+	float4 L 	= s_lmap.Sample( smp_base, I.tcdh);
+	float G 	= 0.001;
+
+#ifdef	USE_TDETAIL
+ #ifdef USE_4_DETAIL
+	float4	mask= s_mask.Sample ( smp_base, I.tcdh);
+	float 	mag	= dot 		(mask,1);
+			mask= mask/mag	;
+
+  #ifdef USE_4_BUMP
+ 	 float4	n_Rt = s_dn_r.Sample ( smp_base, I.tcdbump).wzyx;
+	 float4	n_Gt = s_dn_g.Sample ( smp_base, I.tcdbump).wzyx;
+	 float4	n_Bt = s_dn_b.Sample ( smp_base, I.tcdbump).wzyx;
+	 float4	n_At = s_dn_a.Sample ( smp_base, I.tcdbump).wzyx;
+	 
+ 	 float3	n_R = (n_Rt-0.5)*mask.r; 
+	 float g_R=n_Rt.w*mask.r;
+	 
+	 float3	n_G = (n_Gt-0.5)*mask.g; 
+	 float g_G=n_Gt.w*mask.g;
+	 
+	 float3	n_B = (n_Bt-0.5)*mask.b; 
+	 float g_B=n_Bt.w*mask.b;
+	 
+	 float3	n_A = (n_At-0.5)*mask.a; 
+	 float g_A=n_At.w*mask.a;
+
+	 float3	mix		= 	n_R+n_G+n_B+n_A;
+			mix	*=	float3(0.6f, 0.6f, 1); // Adjust bump strength
+
+	 float3	N		= 	mul     	(float3x3(I.M1, I.M2, I.M3), mix.xyz);
+
+	// Puddles Implementation - SSS Update 14.6
+	// https://www.moddb.com/mods/stalker-anomaly/addons/screen-space-shaders/
+
+	// Wetness factor
+	float wetness_f = rain_params.y;
+
+	// Always render puddles if G_PUDDLES_ALLWAYS is defined
+	#ifdef G_PUDDLES_ALLWAYS
+		wetness_f = 1.0f;
+	#endif
+
+	// Intensity factor.
+	float puddles_f = wetness_f;
+
+	// Size factor. Convert 0 ~ 1 to 1 ~ -0.1f
+	float size_f = (1.0f - G_PUDDLES_SIZE * 1.1f);
+
+	// Texture mask
+	float puddles_mask = 1.0f - s_puddles_mask.Sample(smp_base, I.tcdh).r;
+
+	// Puddles perlin
+	float puddles = saturate((s_puddles_perlin.Sample(smp_base, I.tcdh * 15.0f / G_PUDDLES_GLOBAL_SIZE).r - size_f) * puddles_f);
+
+	// Get normals and transform space to create a slope mask
+	float3 N1 = mul(float3x3(I.M1, I.M2, I.M3), float3(0,0,1));
+	float3 N2 = mul(m_inv_V, normalize(N1));
+
+	// Slope mask
+	float slope = max(N2.x, N2.y);
+
+	// Slope adjustements... Some magic numbers
+	slope = saturate((slope - 0.997f) * (102.0f + 0.997f));
+
+	// Slope & texture mask defines final puddles intensity
+	puddles *= slope * puddles_mask;
+
+	// Puddles border hardness
+	puddles = smoothstep(0, saturate(0.3f - G_PUDDLES_BORDER_HARDNESS * 0.3f), puddles);
+
+#ifdef G_PUDDLES_RIPPLES
+
+	float rain_int = saturate(rain_params.x * 1.5f);
+
+	// Base ripples anim speed
+	float ripples_anim =  timers.x * ((0.01f + (rain_int * 0.008f)) * G_PUDDLES_RIPPLES_SPEED );
+	
+	// Base ripples scale
+	float ripples_scale = 140 / G_PUDDLES_RIPPLES_SCALE;
+
+	// Base ripples Normal
+	float3 WN0 = s_puddles_normal.Sample(smp_base, I.tcdh * ripples_scale + float2(0, ripples_anim));
+	float3 WN1 = s_puddles_normal.Sample(smp_base, I.tcdh * ripples_scale - float2(0.33f, ripples_anim));
+	float3 ripplesNormal = ((WN0 + WN1) * 0.5f) * 2.0f - 1.0f;
+
+	// Rain Ripples
+	float2 ripplesUV = I.tcdh * ripples_scale * 1.3f / G_PUDDLES_RAIN_RIPPLES_SCALE;
+	float2 rainRipples = ssfx_rain_ripples( s_rainsplash, ripplesUV, float3(0.85f, 1.0f, 10.0f), I.position.z);
+
+	// Rain ripples intensity... ( Rain intensity * Depth fadeout * Intensity )
+	rainRipples *= rain_params.x * 3.0f * G_PUDDLES_RAIN_RIPPLES_INTENSITY;
+
+	// Base ripples Intensity
+	ripplesNormal *= saturate(0.05f + rain_int * G_PUDDLES_RIPPLES_RAINING_INT * G_PUDDLES_RIPPLES_INTENSITY);
+	
+	// Mix ripples
+	ripplesNormal = ripplesNormal * 0.666f + float3(rainRipples * 0.333f, 0);
+
+#else
+	float3 ripplesNormal = 0;
+#endif
+
+	// Normal Up and ripples for puddles
+	float3 MirrorUp	= mul(m_V,  float3(ripplesNormal.x, 1.0, ripplesNormal.y));
+	N = lerp(N, MirrorUp, puddles);
+
+	// Refraction Normal
+	float3 N_refra = ripplesNormal;
+
+	// Adjust refraction intensity based on wetness and puddle perlin
+	N_refra.xy *= 0.15f * smoothstep( 0.6f, 0.8f, wetness_f * puddles ) * G_PUDDLES_REFRACTION_INTENSITY;
+
+	// Detail textures + refraction when needed
+	float2 detail_tc = I.tcdbump + N_refra;
+	float3 d_R = s_dt_r.Sample ( smp_base, detail_tc) * mask.r;
+	float3 d_G = s_dt_g.Sample ( smp_base, detail_tc) * mask.g;
+	float3 d_B = s_dt_b.Sample ( smp_base, detail_tc) * mask.b;
+	float3 d_A = s_dt_a.Sample ( smp_base, detail_tc) * mask.a;
+	float3 dt = d_R + d_G + d_B + d_A;
+	D.rgb = 2 * D.rgb * dt;
+
+	// Apply tint
+	D.rgb = lerp( D.rgb, D.rgb * G_PUDDLES_TINT, puddles);
+
+	// Limit pudddle reflection.
+	puddles = clamp(puddles, 0, G_PUDDLES_REFLECTIVITY);
+
+	// Add at the end the extra wetness. Full intensity at 50% of wetness ( rain_params.y )
+#ifndef SSFX_NEWGLOSS
+	puddles = puddles + saturate(rain_params.y * 2.0f) * G_PUDDLES_TERRAIN_EXTRA_WETNESS;
+#endif
+
+	// Add gloss and puddles to the final gloss result
+	G = max(g_R + g_G + g_B + g_A, puddles);
+
+  #else
+	float3	N 	= I.N.xyz	;
+  #endif
+
+ #else
+	D.rgb	= 2*D.rgb*s_detail.Sample( smp_base, I.tcdbump).rgb;
+ #endif
+#else
+	float3	N 	= I.N.xyz	;
+#endif
+
+	// hemi, sun, material
+	float 	ms	= xmaterial	;
+#ifdef USE_R2_STATIC_SUN
+		 	ms 	= L.w		;
+#endif
+
+  // 2. Standart output
+  float4     Ne = float4	(normalize(N), 									D.w			);
+  O				= pack_gbuffer( 
+								Ne,	// hemi
+								float4 	(I.position.xyz + Ne.xyz*def_virtualh/2.h, 	0.95f			),	//
+								float4	(D.x,	D.y,	D.z,						G			) );	// OUT: rgb.gloss
+
+  // Preserve SSS 23.5 material/puddle shading while supplying temporal motion.
+  O.velocity = ssfx_mv_calc(I.vel_curr, I.vel_prev, 0, 0);
+  return O;
+}
diff --git a/extras/dlss_gamma/README.txt b/extras/dlss_gamma/README.txt
new file mode 100644
index 000000000..1afe4bc03
--- /dev/null
+++ b/extras/dlss_gamma/README.txt
@@ -0,0 +1,90 @@
+Experimental DLSS / FSR3 shader override for the audited GAMMA profile
+=================================================================
+
+Place this folder as its own MO2 mod, with priority after the original shader
+mods, only when explicitly installing/testing the matching DLSS engine.
+Do not replace the original mods. Disable this override when reverting engines.
+These overrides have new engine constants and must not be used with stock bins.
+
+Audited enabled loose-file providers in G.A.M.M.A. Co-op, 2026-10-07:
+  190- Screen Space Shaders 23 - Ascii1457:
+    screenspace_mvectors.h, deffer_grass.vs, combine_volumetric.ps (beam noise
+    moves every frame while upscaling before reconstruction; after it, the buffer
+    is sampled unjittered and the noise stays fixed; else unchanged),
+    vert.vs (upscaler jitter for blended alpha surfaces)
+  Base game:
+    particle.vs, particle-clip.vs, lmape.vs (upscaler jitter)
+  Atmospherics 2.69 RC7.5:
+    deffer_impl_flat.ps
+  (Since 0.63 no ssfx_* shader is overridden; SSS / Atmospherics use their own.)
+  189- Beef's NVG - theRealBeef:
+    night_vision.h
+  Optional WearableDevices:
+    wd_body.vs (body and alpha-tested chassis/bracer materials)
+  New integration files:
+    dlss_contract.h, dlss_copy.ps, dlss_cas.h, dlss_sharpen.ps, dlss_ui_depth.ps
+    dlss_display_copy.ps, dlss_sunshaft_mask.ps, dlss_hdr.h, dlss_hdr_encode.ps,
+    dlss_hdr_decode.ps, dlss_debug_mv.ps, dlss_volumetric_history.ps,
+    dlss_fg_hudless_test.ps, dlss_fg_laser_fill.ps
+    scripts/modxml_dlss_options.script
+    configs/text/eng/st_monolith_dlss.xml
+
+Settings > Video > Basic includes an Off / NVIDIA DLSS / AMD FSR 3 selector.
+The other controls change immediately with the pending method selection:
+Off hides them; DLSS shows quality, model preset and sharpening; FSR3 shows
+quality and sharpening. Switching preserves each method's pending quality.
+Only Apply changes console settings/restarts the renderer; Cancel discards them.
+The dual-method UI has no second Off entry in the DLSS quality dropdown.
+FSR3 quality: Native AA/Quality/Balanced/Performance/Ultra Performance.
+Only the selected method runs. FSR3 uses OGSR's native DX11 FSR 3.1.2 backend;
+it requires D3D feature level 11.1, but no NVIDIA runtime or DX12 bridge.
+No Frame Generation. The engine logs its negotiated feature level at startup.
+The same shader override supplies both methods; no second SSS patch is needed.
+Method/quality changes apply on vid_restart, never halfway through a frame.
+Selecting NVIDIA DLSS shows quality and render preset dropdowns.
+Quality: DLAA/Quality/Balanced/Performance/Ultra Performance.
+Preset: Default/J/K/L/M (SR preset F is deprecated in DLSS 310.9.1).
+Apply saves the settings and restarts the renderer. Turn MSAA off before enabling.
+The shared Upscaling sharpening (CAS) slider ranges from 0 (off, default) to 1 (maximum).
+Unlike mode/preset changes, sharpness alone applies without restarting the
+renderer. It filters reconstructed DLSS/DLAA/FSR3 color before display overlays/UI,
+inside the existing resolve draw. Atmospherics clarity/NV effects are unchanged.
+The UI hook is additive; it does not replace GAMMA's ui_options.script.
+English strings also provide the engine's localization fallback.
+Use NVIDIA's release nvngx_dlss.dll 310.9.16 beside AnomalyDX11.exe; source and
+checksum are recorded in tools/dlss/README.txt. No Frame Generation is included.
+
+Changes: non-jittered MV convention retained; bounded homogeneous division;
+uniform DLSS grass jitter and previous wind motion; flat-material MV output;
+jitter-aware SSS history reprojection; NV depth loads use physical depth size.
+Existing material/weather/NV customization and attribution remain in place.
+
+The matching engine draws the handheld PDA screen after reconstruction, at
+display resolution. dlss_ui_depth.ps supplies unjittered occlusion depth so
+hands/casing still hide the screen. Update BOTH binaries and this patch; older
+patches without that shader are rejected with an explicit upscaler log message.
+The flat 2D PDA/menu already renders after the scene at display resolution.
+
+For WearableDevices, place this compatibility override below WearableDevices
+in MO2's left pane. Its chassis/bracer meshes already pass through DLSS/FSR;
+wd_body.vs restores their raster jitter while either upscaler is active, keeping
+motion-vector positions unjittered. The mod intentionally disabled this jitter
+for SSS TAA. Upscaling Off retains that behavior. Screen widgets and covering
+glass keep the engine's existing native-resolution pass. This shader update
+works with the 0.3 executables; no additional engine rebuild is required.
+The override is unused when WearableDevices materials are not loaded.
+The user confirmed this override resolved the chassis/bracer pixelation in-game.
+
+Activation/runtime failures produce red console/log messages and a persistent
+red on-screen warning in release builds, including in menus. The warning names
+the failed method, gives the reason and recovery action, and identifies native
+rendering or spatial-upscale fallback. It clears after the first successful
+scene evaluation or after applying Upscaling Off. Debug statistics and -xclsx
+do not hide this renderer warning. Initialization alone is not confirmation:
+the green console message "[DLSS] ACTIVE" / "[FSR3] ACTIVE" confirms that the
+first scene evaluation actually succeeded. Errors are logged on failure, not
+repeated each frame; the warning stays visible while the failure persists.
+
+This is a profile-specific experimental override, not a generic SSS distribution.
+Other versions or higher-priority overrides require re-merging and testing.
+See tools/dlss/README.txt in the engine repository for controls and limitations.
diff --git a/extras/dlss_gamma/gamedata/configs/text/eng/st_monolith_dlss.xml b/extras/dlss_gamma/gamedata/configs/text/eng/st_monolith_dlss.xml
new file mode 100644
index 000000000..59e61460f
--- /dev/null
+++ b/extras/dlss_gamma/gamedata/configs/text/eng/st_monolith_dlss.xml
@@ -0,0 +1,53 @@
+<?xml version="1.0" encoding="utf-8"?>
+<string_table>
+    <string id="ui_mm_lst_renderer_r4_dx12_bridge"><text>DirectX 12 (Bridge)</text></string>
+    <string id="ui_mm_video_basic_upscaler"><text>Temporal upscaler</text></string>
+    <string id="ui_mm_video_basic_upscaler_desc"><text>Select NVIDIA DLSS or AMD FSR upscaling. Off retains the native renderer and its existing anti-aliasing settings. All methods require MSAA off and the matching temporal shader override. Only methods supported by this GPU are listed, and only the selected method runs; its quality setting is below. The experimental DX12 executable adds AMD's DX12 runtime: FSR 4 on Radeon RX 7000/9000, listed as FSR 3.1 (DX12) on other GPUs. Apply restarts the renderer.</text></string>
+    <string id="ui_mm_video_basic_fsr3_mode"><text>AMD FSR quality</text></string>
+    <string id="ui_mm_video_basic_fsr3_mode_desc"><text>Used when the temporal upscaler is FSR 3 or FSR 4. Native AA uses native resolution; Ultra Quality, Quality, Balanced, Performance and Ultra Performance use 1.3x, 1.5x, 1.7x, 2x and 3x scaling respectively. FSR 3 is native DX11 FSR 3.1.2 on any GPU. FSR 4 runs through the DX12 executable's AMD runtime. No NVIDIA runtime required. Replaces SSS TAA and SMAA while active. Apply restarts the renderer.</text></string>
+    <string id="ui_mm_lst_upscaler_fsr4"><text>AMD FSR 4 (DX12)</text></string>
+    <string id="ui_mm_lst_upscaler_fsr_dx12"><text>AMD FSR 3.1 (DX12)</text></string>
+    <string id="ui_mm_video_basic_dlss_linear_input"><text>DLSS Linear Input</text></string>
+    <string id="ui_mm_video_basic_dlss_linear_input_desc"><text>Reduces ghosting/smearing and other visual artifacts caused by DLSS on movement with bright effects, especially helpful for preset K/J.\nAlmost no performance cost, may cause shimmering behind DoF on Performance mode or below.</text></string>
+    <string id="ui_mm_video_basic_dlss_sharpness"><text>Upscaling sharpening (CAS)</text></string>
+    <string id="ui_mm_video_basic_dlss_sharpness_desc"><text>Shared Contrast Adaptive Sharpening after DLSS or FSR reconstruction, before display overlays and UI. 0 disables this filter; 1 is maximum. Applies without a renderer restart. Does not change Atmospherics clarity or night-vision effects. High values can emphasize noise and edges. Has no effect with upscaling off or during spatial fallback.</text></string>
+    <string id="ui_mm_lst_upscaler_dlss"><text>NVIDIA DLSS</text></string>
+    <string id="ui_mm_lst_upscaler_fsr3"><text>AMD FSR 3</text></string>
+    <string id="ui_mm_lst_fsr3_native_aa"><text>Native AA</text></string>
+    <string id="ui_mm_video_basic_dlss_mode"><text>NVIDIA DLSS quality</text></string>
+    <string id="ui_mm_video_basic_dlss_mode_desc"><text>DLAA renders at native resolution; Ultra Quality (1.3x), Quality, Balanced, Performance and Ultra Performance upscale a smaller scene. Requires an RTX GPU, the NVIDIA DLSS runtime and the matching shader override. Turn MSAA off before enabling DLSS. DLSS replaces SSS TAA and SMAA while active. Apply restarts the renderer; Cancel leaves the current settings unchanged.</text></string>
+    <string id="ui_mm_video_basic_dlss_preset"><text>NVIDIA DLSS render preset</text></string>
+    <string id="ui_mm_video_basic_dlss_preset_desc"><text>Selects the reconstruction model independently of scaling mode. Default lets NVIDIA select the recommended preset for each mode. J/K/L/M explicitly request that preset; NVIDIA driver overrides can affect the result. Requires the supplied DLSS 310.9.1 runtime. Apply restarts the renderer. Deprecated preset F is not offered.</text></string>
+    <string id="ui_mm_lst_dlss_off"><text>Off</text></string>
+    <string id="ui_mm_lst_dlss_dlaa"><text>DLAA (native)</text></string>
+    <string id="ui_mm_lst_dlss_ultra_quality"><text>Ultra Quality</text></string>
+    <string id="ui_mm_lst_dlss_quality"><text>Quality</text></string>
+    <string id="ui_mm_lst_dlss_balanced"><text>Balanced</text></string>
+    <string id="ui_mm_lst_dlss_performance"><text>Performance</text></string>
+    <string id="ui_mm_lst_dlss_ultra_performance"><text>Ultra Performance</text></string>
+    <string id="ui_mm_lst_dlss_default"><text>Default (NVIDIA recommended)</text></string>
+    <string id="ui_mm_lst_dlss_j"><text>J</text></string>
+    <string id="ui_mm_lst_dlss_k"><text>K</text></string>
+    <string id="ui_mm_lst_dlss_l"><text>L</text></string>
+    <string id="ui_mm_lst_dlss_m"><text>M</text></string>
+    <string id="ui_mm_video_basic_frame_generation"><text>Frame generation (experimental)</text></string>
+    <string id="ui_mm_video_basic_frame_generation_desc"><text>Adds generated frames between rendered frames: one for 2x, two for 3x, three for 4x. Only methods supported by this GPU are listed. DLSS 3x and 4x need an RTX 50 GPU, or a frame generation unlock on older RTX GPUs; otherwise they run as 2x. DLSS 2x requires an NVIDIA RTX 40/50 GPU, hardware-accelerated GPU scheduling and the supplied Streamline runtime. AMD FSR 2x works on any DX12 GPU (FSR 4 frame generation on Radeon RX 9000 with Windows 11, otherwise FSR 3.1); it has no Reflex, and after using it, DLSS 2x and Reflex need a game restart. Requires an upscaler and MSAA off. Pauses in menus and loading screens. With frame generation active the FPS limit applies to displayed frames. Apply restarts the renderer.</text></string>
+    <string id="ui_mm_lst_fg_dlss_2x"><text>DLSS 2x</text></string>
+    <string id="ui_mm_lst_fg_dlss_2x_restart"><text>DLSS 2x (restart the game)</text></string>
+    <string id="ui_mm_lst_fg_dlss_3x"><text>DLSS 3x</text></string>
+    <string id="ui_mm_lst_fg_dlss_3x_restart"><text>DLSS 3x (restart the game)</text></string>
+    <string id="ui_mm_lst_fg_dlss_4x"><text>DLSS 4x</text></string>
+    <string id="ui_mm_lst_fg_dlss_4x_restart"><text>DLSS 4x (restart the game)</text></string>
+    <string id="ui_mm_lst_fg_fsr_2x"><text>AMD FSR 3.1 2x</text></string>
+    <string id="ui_mm_lst_fg_fsr4_2x"><text>AMD FSR 4 2x</text></string>
+    <string id="ui_mm_header_upscaling"><text>Upscaling</text></string>
+    <string id="ui_mm_video_basic_upscaler_post_after"><text>Post-processing after upscaling</text></string>
+    <string id="ui_mm_video_basic_upscaler_post_after_desc"><text>Keeps post-processing effects at full resolution without upscaling, which reduces ghosting and smearing on them.\nCan cost FPS and VRAM, especially on weaker GPUs.</text></string>
+    <string id="ui_mm_video_basic_upscaler_sunshafts"><text>Sunshafts</text></string>
+    <string id="ui_mm_video_basic_upscaler_sunshafts_desc"><text>Choose how sunshafts are handled on the upscaler.\nUpscaled: Upscaled normally. Most stable, but can show smearing.\nRaw: Drawn after the upscaler. Sharpest, but can shimmer or look grainy.\nSmoothed: Same as Raw, with an extra smoothing pass to reduce shimmer.</text></string>
+    <string id="ui_mm_lst_upscaler_sunshafts_upscaled"><text>Upscaled</text></string>
+    <string id="ui_mm_lst_upscaler_sunshafts_smoothed"><text>Smoothed</text></string>
+    <string id="ui_mm_lst_upscaler_sunshafts_raw"><text>Raw</text></string>
+    <string id="ui_mm_video_basic_upscaler_particles_after"><text>Full resolution particles</text></string>
+    <string id="ui_mm_video_basic_upscaler_particles_after_desc"><text>Draws smoke, fire and dust at full resolution without upscaling, which reduces visual artifacts on them.\nCan cost FPS, especially on weaker GPUs.\nThe visual difference is small with DLSS.</text></string>
+</string_table>
diff --git a/extras/dlss_gamma/gamedata/configs/text/rus/st_monolith_dlss.xml b/extras/dlss_gamma/gamedata/configs/text/rus/st_monolith_dlss.xml
new file mode 100644
index 000000000..2a4b22605
--- /dev/null
+++ b/extras/dlss_gamma/gamedata/configs/text/rus/st_monolith_dlss.xml
@@ -0,0 +1,53 @@
+<?xml version="1.0" encoding="windows-1251"?>
+<string_table>
+    <string id="ui_mm_lst_renderer_r4_dx12_bridge"><text>DirectX 12 (мост)</text></string>
+    <string id="ui_mm_video_basic_upscaler"><text>Временной апскейлер</text></string>
+    <string id="ui_mm_video_basic_upscaler_desc"><text>Выбор апскейлинга NVIDIA DLSS или AMD FSR. «Выкл.» оставляет обычный рендер и прежнее сглаживание. Для всех методов нужно выключить MSAA и поставить подходящий шейдерный патч. В списке только методы, которые поддерживает видеокарта; работает только выбранный, его качество настраивается ниже. Исполняемый файл DX12 добавляет DX12-библиотеку AMD: FSR 4 на Radeon RX 7000/9000, на других картах — FSR 3.1 (DX12). «Применить» перезапускает рендер.</text></string>
+    <string id="ui_mm_video_basic_fsr3_mode"><text>Качество AMD FSR</text></string>
+    <string id="ui_mm_video_basic_fsr3_mode_desc"><text>Используется, когда апскейлер — FSR 3 или FSR 4. «Родное сглаживание» работает в родном разрешении; «Ультра качество», «Качество», «Баланс», «Производительность» и «Ультра производительность» — масштаб 1.3x, 1.5x, 1.7x, 2x и 3x. FSR 3 — встроенный DX11 FSR 3.1.2 на любой видеокарте. FSR 4 работает через библиотеку AMD в версии DX12. Библиотеки NVIDIA не нужны. Пока включён, заменяет TAA и SMAA от SSS. «Применить» перезапускает рендер.</text></string>
+    <string id="ui_mm_lst_upscaler_fsr4"><text>AMD FSR 4 (DX12)</text></string>
+    <string id="ui_mm_lst_upscaler_fsr_dx12"><text>AMD FSR 3.1 (DX12)</text></string>
+    <string id="ui_mm_video_basic_dlss_linear_input"><text>Линейный вход DLSS</text></string>
+    <string id="ui_mm_video_basic_dlss_linear_input_desc"><text>Уменьшает шлейфы, смазывание и другие артефакты DLSS при движении рядом с яркими эффектами, особенно с пресетами K/J.\nПочти не стоит FPS, на «Производительности» и ниже может мерцать за размытием глубины резкости.</text></string>
+    <string id="ui_mm_video_basic_dlss_sharpness"><text>Резкость апскейлинга (CAS)</text></string>
+    <string id="ui_mm_video_basic_dlss_sharpness_desc"><text>Адаптивная резкость после восстановления кадра DLSS или FSR, до наложений и интерфейса. 0 — выключено, 1 — максимум. Применяется без перезапуска рендера. Не меняет чёткость Atmospherics и эффекты ночного видения. Большие значения подчёркивают шум и края. Не действует при выключенном апскейлинге.</text></string>
+    <string id="ui_mm_lst_upscaler_dlss"><text>NVIDIA DLSS</text></string>
+    <string id="ui_mm_lst_upscaler_fsr3"><text>AMD FSR 3</text></string>
+    <string id="ui_mm_lst_fsr3_native_aa"><text>Родное сглаживание</text></string>
+    <string id="ui_mm_video_basic_dlss_mode"><text>Качество NVIDIA DLSS</text></string>
+    <string id="ui_mm_video_basic_dlss_mode_desc"><text>DLAA работает в родном разрешении; «Ультра качество» (1.3x), «Качество», «Баланс», «Производительность» и «Ультра производительность» рисуют сцену меньше и увеличивают её. Нужны видеокарта RTX, библиотека NVIDIA DLSS и подходящий шейдерный патч. Перед включением DLSS выключите MSAA. Пока DLSS включён, он заменяет TAA и SMAA от SSS. «Применить» перезапускает рендер; «Отмена» оставляет прежние настройки.</text></string>
+    <string id="ui_mm_video_basic_dlss_preset"><text>Пресет NVIDIA DLSS</text></string>
+    <string id="ui_mm_video_basic_dlss_preset_desc"><text>Выбирает модель восстановления независимо от масштаба. «По умолчанию» — NVIDIA сама выбирает рекомендуемый пресет для режима. J/K/L/M явно задают пресет; настройки драйвера NVIDIA могут его переопределить. Нужна прилагаемая библиотека DLSS 310.9.1. «Применить» перезапускает рендер. Устаревший пресет F не предлагается.</text></string>
+    <string id="ui_mm_lst_dlss_off"><text>Выкл.</text></string>
+    <string id="ui_mm_lst_dlss_dlaa"><text>DLAA (родное)</text></string>
+    <string id="ui_mm_lst_dlss_ultra_quality"><text>Ультра качество</text></string>
+    <string id="ui_mm_lst_dlss_quality"><text>Качество</text></string>
+    <string id="ui_mm_lst_dlss_balanced"><text>Баланс</text></string>
+    <string id="ui_mm_lst_dlss_performance"><text>Производительность</text></string>
+    <string id="ui_mm_lst_dlss_ultra_performance"><text>Ультра производительность</text></string>
+    <string id="ui_mm_lst_dlss_default"><text>По умолчанию (выбор NVIDIA)</text></string>
+    <string id="ui_mm_lst_dlss_j"><text>J</text></string>
+    <string id="ui_mm_lst_dlss_k"><text>K</text></string>
+    <string id="ui_mm_lst_dlss_l"><text>L</text></string>
+    <string id="ui_mm_lst_dlss_m"><text>M</text></string>
+    <string id="ui_mm_video_basic_frame_generation"><text>Генерация кадров (экспериментально)</text></string>
+    <string id="ui_mm_video_basic_frame_generation_desc"><text>Добавляет сгенерированные кадры между настоящими: один для 2x, два для 3x, три для 4x. В списке только методы, которые поддерживает видеокарта. DLSS 3x и 4x требуют RTX 50 (или разблокировки на старых RTX), иначе работают как 2x. DLSS 2x требует NVIDIA RTX 40/50, включённого аппаратного планирования GPU и прилагаемой библиотеки Streamline. AMD FSR 2x работает на любой видеокарте с DX12 (FSR 4 — на Radeon RX 9000 с Windows 11, иначе FSR 3.1); у него нет Reflex, и после него для DLSS 2x и Reflex нужен перезапуск игры. Нужны апскейлер и выключенный MSAA. В меню и на загрузках не работает. С генерацией кадров ограничение FPS относится к показанным кадрам. «Применить» перезапускает рендер.</text></string>
+    <string id="ui_mm_lst_fg_dlss_2x"><text>DLSS 2x</text></string>
+    <string id="ui_mm_lst_fg_dlss_2x_restart"><text>DLSS 2x (перезапустите игру)</text></string>
+    <string id="ui_mm_lst_fg_dlss_3x"><text>DLSS 3x</text></string>
+    <string id="ui_mm_lst_fg_dlss_3x_restart"><text>DLSS 3x (перезапустите игру)</text></string>
+    <string id="ui_mm_lst_fg_dlss_4x"><text>DLSS 4x</text></string>
+    <string id="ui_mm_lst_fg_dlss_4x_restart"><text>DLSS 4x (перезапустите игру)</text></string>
+    <string id="ui_mm_lst_fg_fsr_2x"><text>AMD FSR 3.1 2x</text></string>
+    <string id="ui_mm_lst_fg_fsr4_2x"><text>AMD FSR 4 2x</text></string>
+    <string id="ui_mm_header_upscaling"><text>Апскейлинг</text></string>
+    <string id="ui_mm_video_basic_upscaler_post_after"><text>Постобработка после апскейлинга</text></string>
+    <string id="ui_mm_video_basic_upscaler_post_after_desc"><text>Оставляет эффекты постобработки в полном разрешении без апскейлинга, это уменьшает на них шлейфы и смазывание.\nМожет стоить FPS и видеопамяти, особенно на слабых видеокартах.</text></string>
+    <string id="ui_mm_video_basic_upscaler_sunshafts"><text>Солнечные лучи</text></string>
+    <string id="ui_mm_video_basic_upscaler_sunshafts_desc"><text>Как апскейлер обрабатывает солнечные лучи.\nАпскейл: обычный апскейл. Стабильнее всего, но возможно смазывание.\nСырые: рисуются после апскейлера. Резче всего, но могут мерцать или зернить.\nСглаженные: как «Сырые», плюс проход сглаживания против мерцания.</text></string>
+    <string id="ui_mm_lst_upscaler_sunshafts_upscaled"><text>Апскейл</text></string>
+    <string id="ui_mm_lst_upscaler_sunshafts_smoothed"><text>Сглаженные</text></string>
+    <string id="ui_mm_lst_upscaler_sunshafts_raw"><text>Сырые</text></string>
+    <string id="ui_mm_video_basic_upscaler_particles_after"><text>Частицы в полном разрешении</text></string>
+    <string id="ui_mm_video_basic_upscaler_particles_after_desc"><text>Рисует дым, огонь и пыль в полном разрешении без апскейлинга, это уменьшает артефакты на них.\nМожет стоить FPS, особенно на слабых видеокартах.\nС DLSS разница небольшая.</text></string>
+</string_table>
diff --git a/extras/dlss_gamma/gamedata/configs/text/ukr/st_monolith_dlss.xml b/extras/dlss_gamma/gamedata/configs/text/ukr/st_monolith_dlss.xml
new file mode 100644
index 000000000..84ddb8579
--- /dev/null
+++ b/extras/dlss_gamma/gamedata/configs/text/ukr/st_monolith_dlss.xml
@@ -0,0 +1,53 @@
+<?xml version="1.0" encoding="windows-1251"?>
+<string_table>
+    <string id="ui_mm_lst_renderer_r4_dx12_bridge"><text>DirectX 12 (міст)</text></string>
+    <string id="ui_mm_video_basic_upscaler"><text>Часовий апскейлер</text></string>
+    <string id="ui_mm_video_basic_upscaler_desc"><text>Вибір апскейлінгу NVIDIA DLSS або AMD FSR. «Вимк.» залишає звичайний рендер і попереднє згладжування. Для всіх методів треба вимкнути MSAA і встановити відповідний шейдерний патч. У списку лише методи, які підтримує відеокарта; працює лише обраний, його якість налаштовується нижче. Виконуваний файл DX12 додає DX12-бібліотеку AMD: FSR 4 на Radeon RX 7000/9000, на інших картах — FSR 3.1 (DX12). «Застосувати» перезапускає рендер.</text></string>
+    <string id="ui_mm_video_basic_fsr3_mode"><text>Якість AMD FSR</text></string>
+    <string id="ui_mm_video_basic_fsr3_mode_desc"><text>Використовується, коли апскейлер — FSR 3 або FSR 4. «Рідне згладжування» працює в рідній роздільності; «Ультра якість», «Якість», «Баланс», «Продуктивність» і «Ультра продуктивність» — масштаб 1.3x, 1.5x, 1.7x, 2x і 3x. FSR 3 — вбудований DX11 FSR 3.1.2 на будь-якій відеокарті. FSR 4 працює через бібліотеку AMD у версії DX12. Бібліотеки NVIDIA не потрібні. Поки увімкнений, замінює TAA і SMAA від SSS. «Застосувати» перезапускає рендер.</text></string>
+    <string id="ui_mm_lst_upscaler_fsr4"><text>AMD FSR 4 (DX12)</text></string>
+    <string id="ui_mm_lst_upscaler_fsr_dx12"><text>AMD FSR 3.1 (DX12)</text></string>
+    <string id="ui_mm_video_basic_dlss_linear_input"><text>Лінійний вхід DLSS</text></string>
+    <string id="ui_mm_video_basic_dlss_linear_input_desc"><text>Зменшує шлейфи, змазування та інші артефакти DLSS під час руху біля яскравих ефектів, особливо з пресетами K/J.\nМайже не коштує FPS, на «Продуктивності» і нижче може мерехтіти за розмиттям глибини різкості.</text></string>
+    <string id="ui_mm_video_basic_dlss_sharpness"><text>Різкість апскейлінгу (CAS)</text></string>
+    <string id="ui_mm_video_basic_dlss_sharpness_desc"><text>Адаптивна різкість після відновлення кадру DLSS або FSR, до накладень та інтерфейсу. 0 — вимкнено, 1 — максимум. Застосовується без перезапуску рендера. Не змінює чіткість Atmospherics та ефекти нічного бачення. Великі значення підкреслюють шум і краї. Не діє з вимкненим апскейлінгом.</text></string>
+    <string id="ui_mm_lst_upscaler_dlss"><text>NVIDIA DLSS</text></string>
+    <string id="ui_mm_lst_upscaler_fsr3"><text>AMD FSR 3</text></string>
+    <string id="ui_mm_lst_fsr3_native_aa"><text>Рідне згладжування</text></string>
+    <string id="ui_mm_video_basic_dlss_mode"><text>Якість NVIDIA DLSS</text></string>
+    <string id="ui_mm_video_basic_dlss_mode_desc"><text>DLAA працює в рідній роздільності; «Ультра якість» (1.3x), «Якість», «Баланс», «Продуктивність» і «Ультра продуктивність» малюють сцену меншою і збільшують її. Потрібні відеокарта RTX, бібліотека NVIDIA DLSS і відповідний шейдерний патч. Перед увімкненням DLSS вимкніть MSAA. Поки DLSS увімкнений, він замінює TAA і SMAA від SSS. «Застосувати» перезапускає рендер; «Скасувати» залишає попередні налаштування.</text></string>
+    <string id="ui_mm_video_basic_dlss_preset"><text>Пресет NVIDIA DLSS</text></string>
+    <string id="ui_mm_video_basic_dlss_preset_desc"><text>Обирає модель відновлення незалежно від масштабу. «За замовчуванням» — NVIDIA сама обирає рекомендований пресет для режиму. J/K/L/M явно задають пресет; налаштування драйвера NVIDIA можуть його перевизначити. Потрібна бібліотека DLSS 310.9.1, що додається. «Застосувати» перезапускає рендер. Застарілий пресет F не пропонується.</text></string>
+    <string id="ui_mm_lst_dlss_off"><text>Вимк.</text></string>
+    <string id="ui_mm_lst_dlss_dlaa"><text>DLAA (рідне)</text></string>
+    <string id="ui_mm_lst_dlss_ultra_quality"><text>Ультра якість</text></string>
+    <string id="ui_mm_lst_dlss_quality"><text>Якість</text></string>
+    <string id="ui_mm_lst_dlss_balanced"><text>Баланс</text></string>
+    <string id="ui_mm_lst_dlss_performance"><text>Продуктивність</text></string>
+    <string id="ui_mm_lst_dlss_ultra_performance"><text>Ультра продуктивність</text></string>
+    <string id="ui_mm_lst_dlss_default"><text>За замовчуванням (вибір NVIDIA)</text></string>
+    <string id="ui_mm_lst_dlss_j"><text>J</text></string>
+    <string id="ui_mm_lst_dlss_k"><text>K</text></string>
+    <string id="ui_mm_lst_dlss_l"><text>L</text></string>
+    <string id="ui_mm_lst_dlss_m"><text>M</text></string>
+    <string id="ui_mm_video_basic_frame_generation"><text>Генерація кадрів (експериментально)</text></string>
+    <string id="ui_mm_video_basic_frame_generation_desc"><text>Додає згенеровані кадри між справжніми: один для 2x, два для 3x, три для 4x. У списку лише методи, які підтримує відеокарта. DLSS 3x і 4x потребують RTX 50 (або розблокування на старших RTX), інакше працюють як 2x. DLSS 2x потребує NVIDIA RTX 40/50, увімкненого апаратного планування GPU та бібліотеки Streamline, що додається. AMD FSR 2x працює на будь-якій відеокарті з DX12 (FSR 4 — на Radeon RX 9000 з Windows 11, інакше FSR 3.1); у нього немає Reflex, і після нього для DLSS 2x та Reflex потрібен перезапуск гри. Потрібні апскейлер і вимкнений MSAA. У меню та на завантаженнях не працює. З генерацією кадрів обмеження FPS стосується показаних кадрів. «Застосувати» перезапускає рендер.</text></string>
+    <string id="ui_mm_lst_fg_dlss_2x"><text>DLSS 2x</text></string>
+    <string id="ui_mm_lst_fg_dlss_2x_restart"><text>DLSS 2x (перезапустіть гру)</text></string>
+    <string id="ui_mm_lst_fg_dlss_3x"><text>DLSS 3x</text></string>
+    <string id="ui_mm_lst_fg_dlss_3x_restart"><text>DLSS 3x (перезапустіть гру)</text></string>
+    <string id="ui_mm_lst_fg_dlss_4x"><text>DLSS 4x</text></string>
+    <string id="ui_mm_lst_fg_dlss_4x_restart"><text>DLSS 4x (перезапустіть гру)</text></string>
+    <string id="ui_mm_lst_fg_fsr_2x"><text>AMD FSR 3.1 2x</text></string>
+    <string id="ui_mm_lst_fg_fsr4_2x"><text>AMD FSR 4 2x</text></string>
+    <string id="ui_mm_header_upscaling"><text>Апскейлінг</text></string>
+    <string id="ui_mm_video_basic_upscaler_post_after"><text>Постобробка після апскейлінгу</text></string>
+    <string id="ui_mm_video_basic_upscaler_post_after_desc"><text>Залишає ефекти постобробки в повній роздільності без апскейлінгу, це зменшує на них шлейфи і змазування.\nМоже коштувати FPS і відеопам'яті, особливо на слабких відеокартах.</text></string>
+    <string id="ui_mm_video_basic_upscaler_sunshafts"><text>Сонячні промені</text></string>
+    <string id="ui_mm_video_basic_upscaler_sunshafts_desc"><text>Як апскейлер обробляє сонячні промені.\nАпскейл: звичайний апскейл. Найстабільніше, але можливе змазування.\nСирі: малюються після апскейлера. Найрізкіше, але можуть мерехтіти або зернити.\nЗгладжені: як «Сирі», плюс прохід згладжування проти мерехтіння.</text></string>
+    <string id="ui_mm_lst_upscaler_sunshafts_upscaled"><text>Апскейл</text></string>
+    <string id="ui_mm_lst_upscaler_sunshafts_smoothed"><text>Згладжені</text></string>
+    <string id="ui_mm_lst_upscaler_sunshafts_raw"><text>Сирі</text></string>
+    <string id="ui_mm_video_basic_upscaler_particles_after"><text>Частинки в повній роздільності</text></string>
+    <string id="ui_mm_video_basic_upscaler_particles_after_desc"><text>Малює дим, вогонь і пил у повній роздільності без апскейлінгу, це зменшує артефакти на них.\nМоже коштувати FPS, особливо на слабких відеокартах.\nЗ DLSS різниця невелика.</text></string>
