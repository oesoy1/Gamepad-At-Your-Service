diff --git a/src/Layers/xrRenderPC_R4/Dlss/DlssNativeUi.h b/src/Layers/xrRenderPC_R4/Dlss/DlssNativeUi.h
new file mode 100644
index 000000000..cb3d3a0d3
--- /dev/null
+++ b/src/Layers/xrRenderPC_R4/Dlss/DlssNativeUi.h
@@ -0,0 +1,46 @@
+#pragma once
+#include <algorithm>
+#include <string_view>
+
+namespace dlss
+{
+inline bool IsWearableScreenGlass(std::string_view name)
+{
+    // WearableDevices draws its screen widgets directly, but its glass is a
+    // separate sorted mesh. Move that glass too so it blends over the native UI.
+    return name == "wd\\promin\\promin_screen_glass" ||
+        name == "wd\\promin\\promin_screen_glass_broken" ||
+        name == "wd\\vektor\\vektor_screen_glass";
+}
+
+inline bool IsNativeHudUiTexture(std::string_view name)
+{
+    return name == "$user$ui" || IsWearableScreenGlass(name);
+}
+
+// The queues retain the original draw packets (including skinning and object
+// transforms) until the display-resolution pass in the SAME rendered view.
+template<class Queue, class Predicate>
+void ExtractNativeUi(Queue& scene, Queue& display, Predicate isUi)
+{
+    display.clear();
+    scene.erase(std::remove_if(scene.begin(), scene.end(), [&](const auto& item)
+    {
+        if (!isUi(item)) return false;
+        display.push_back(item);
+        return true;
+    }), scene.end());
+}
+
+template<class Queue, class DisplayQueue>
+void RemoveNativeUiDuplicates(Queue& scene, const DisplayQueue& display)
+{
+    scene.erase(std::remove_if(scene.begin(), scene.end(), [&](const auto& item)
+    {
+        return std::any_of(display.begin(), display.end(), [&](const auto& ui)
+        {
+            return item.pVisual == ui.pVisual && item.pMatrix == ui.pMatrix;
+        });
+    }), scene.end());
+}
+}
diff --git a/src/Layers/xrRenderPC_R4/Dlss/DlssTemporal.h b/src/Layers/xrRenderPC_R4/Dlss/DlssTemporal.h
new file mode 100644
index 000000000..4074a5369
--- /dev/null
+++ b/src/Layers/xrRenderPC_R4/Dlss/DlssTemporal.h
@@ -0,0 +1,88 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace dlss
+{
+// Values are the r_dlss_quality token ids; UltraQuality was added last to keep saved ids.
+enum class Quality : unsigned { Off, DLAA, Quality, Balanced, Performance, UltraPerformance, UltraQuality };
+// NGX Super Resolution preset values. F is deprecated in runtime 310.9.1;
+// reserved presets are deliberately not exposed as working choices.
+enum class Preset : unsigned { Default = 0, J = 10, K = 11, L = 12, M = 13 };
+inline bool ValidPreset(Preset preset)
+{
+    return preset == Preset::Default || preset == Preset::J || preset == Preset::K ||
+        preset == Preset::L || preset == Preset::M;
+}
+
+struct Size
+{
+    unsigned width = 0, height = 0;
+    bool operator==(const Size& other) const { return width == other.width && height == other.height; }
+    bool operator!=(const Size& other) const { return !(*this == other); }
+    bool Valid() const { return width != 0 && height != 0; }
+};
+
+struct Offset { float x = 0, y = 0; };
+
+// Ultra Quality: 1/1.3 (~77%) of the display per axis, between DLAA and Quality.
+// Neither NGX nor FSR 3.1 defines this mode, so the render size is computed here.
+constexpr float UltraQualityRatio = 1.3f;
+inline Size ScaledRender(Size display, float ratio)
+{
+    return {std::max(1u, unsigned(std::lround(display.width / ratio))),
+        std::max(1u, unsigned(std::lround(display.height / ratio)))};
+}
+
+inline float Halton(unsigned index, unsigned base)
+{
+    float value = 0, fraction = 1;
+    while (index)
+    {
+        fraction /= float(base);
+        value += fraction * float(index % base);
+        index /= base;
+    }
+    return value;
+}
+
+// Pixel-space raster offset: +X right, +Y down. Use the SAME sample for the
+// geometry shader constant and NGX evaluation, advancing only on main-view frames.
+inline Offset Jitter(unsigned sample, Size render, Size display)
+{
+    if (!render.Valid() || !display.Valid()) return {};
+    const double ratio = double(display.width) / render.width;
+    const unsigned phases = unsigned(std::clamp(std::ceil(8.0 * ratio * ratio), 8.0, 128.0));
+    const unsigned index = sample % phases + 1;
+    return {Halton(index, 2) - 0.5f, Halton(index, 3) - 0.5f};
+}
+
+inline Offset ClipJitter(Offset pixels, Size render)
+{
+    if (!render.Valid()) return {};
+    return {2.0f * pixels.x / render.width, -2.0f * pixels.y / render.height};
+}
+
+// SSS 23 writes currentUV - previousUV, excluding jitter. NGX wants the
+// current-to-previous displacement in pixels; negate BOTH axes, without a copy.
+inline Offset MotionScale(Size render) { return {-float(render.width), -float(render.height)}; }
+
+// Own one history per camera. Never feed a scope camera into the main history.
+class History
+{
+public:
+    bool Begin(std::uint64_t frame, bool cameraCut)
+    {
+        m_reset = !m_valid || cameraCut || frame <= m_lastFrame;
+        return m_reset;
+    }
+    void Commit(std::uint64_t frame) { m_lastFrame = frame; m_valid = true; m_reset = false; }
+    void Invalidate() { m_valid = false; m_reset = true; }
+    bool Reset() const { return m_reset; }
+private:
+    std::uint64_t m_lastFrame = 0;
+    bool m_valid = false, m_reset = true;
+};
+}
diff --git a/src/Layers/xrRenderPC_R4/Dlss/FrameGeneration.cpp b/src/Layers/xrRenderPC_R4/Dlss/FrameGeneration.cpp
new file mode 100644
index 000000000..e770aabf0
--- /dev/null
+++ b/src/Layers/xrRenderPC_R4/Dlss/FrameGeneration.cpp
@@ -0,0 +1,301 @@
+#include "stdafx.h"
+#include "FrameGeneration.h"
+#include "../../xrRenderDX10/D3D12PresentBridge.h"
+#include "../../../xrEngine/IGame_Persistent.h"
+#include "../../../xrEngine/IGame_Level.h"
+#include "../../../xrEngine/RendererError.h"
+#pragma comment(lib, "version.lib") // RuntimeVersions
+
+extern u32 ps_r_frame_generation;
+extern int ps_r_fg_diagnostics;
+extern int ps_framelimiter;
+extern bool IsMainMenuActive();
+extern bool use_reshade;
+
+namespace fg
+{
+namespace
+{
+bool simulationFrame{}, renderStarted{}, scopeFrame{}, havePrevious{};
+// dlss::Active() is only true between BeginScene and EndScene. Decide eligibility
+// once at scene capture; the later HUD-less capture and Present reuse it.
+bool sceneCaptured{};
+Fmatrix previousTransform;
+Fvector previousPosition, previousDirection;
+float previousFov{};
+u32 previousFrame{};
+const char* lastReason{};
+
+// Saved values: 3 and 4 were added after FSR, so Dlss3x/Dlss4x come after it.
+enum Method : u32 { Off = 0, Dlss = 1, Fsr = 2, Dlss3x = 3, Dlss4x = 4 };
+
+// DLSS-G frames generated per rendered frame; the runtime clamps it to what it allows.
+UINT FramesToGenerate()
+{
+    return ps_r_frame_generation == Dlss4x ? 3 : ps_r_frame_generation == Dlss3x ? 2 : 1;
+}
+
+void Status(const char* reason)
+{
+    if (reason == lastReason) return;
+    lastReason = reason;
+    if (ps_r_frame_generation) Msg("[%s FG] %s", ps_r_frame_generation == Fsr ? "FSR" : "DLSS", reason);
+}
+
+// The bridge runtime is fixed until vid_restart rebuilds it for the selected method.
+bool RuntimeMatchesSetting(const D3D12PresentBridge& bridge)
+{
+    const PresentRuntime runtime = bridge.Runtime();
+    return ps_r_frame_generation == Fsr ? runtime == PresentRuntime::Fsr : runtime == PresentRuntime::Streamline;
+}
+
+bool Eligible()
+{
+    if (!ps_r_frame_generation) { Status("Off"); return false; }
+    auto* bridge = HW.PresentationBridge();
+    if (!bridge) return false;
+    if (!RuntimeMatchesSetting(*bridge))
+    {
+        Status(ps_r_frame_generation != Fsr && !StreamlineIntegration::CanInitialize() ?
+            "DLSS frame generation needs a game restart after FSR frame generation was used." :
+            "Selected method is not active: Apply/vid_restart to switch, or it failed to start (see [DX12 bridge] lines).");
+        return false;
+    }
+    if (bridge->GenerationFailed()) { Status("Disabled after a runtime error."); return false; }
+    if (!bridge->FrameGenerationReady()) { Status("Unavailable: the runtime did not start. See the log."); return false; }
+    if (!Device.b_is_Active || Device.Paused() || !g_pGameLevel || Device.dwPrecacheFrame || IsMainMenuActive())
+    { Status("Suspended: menu, loading, pause or inactive window."); return false; }
+    if (bridge->VSyncBlocksGeneration())
+    { Status("Suspended: this DLSS-G runtime cannot generate frames with VSync on. Turn VSync off."); return false; }
+    if (RImplementation.o.dx10_msaa || !RImplementation.o.ssfx_motionvectors || !dlss::Active())
+    { Status("Requires an active temporal upscaler and SSS motion vectors, with MSAA off."); return false; }
+    // Scopes and thermal vision are post effects over the same main-view inputs. A 3D
+    // scope's lens updates at its own rate and may ghost slightly inside the lens.
+    Status("Eligible: generating frames.");
+    return true;
+}
+
+void ToFloats(float (&target)[16], const Fmatrix& source)
+{
+    static_assert(sizeof(Fmatrix) == sizeof(target), "Fmatrix layout");
+    memcpy(target, &source, sizeof(target));
+}
+}
+
+void BeginSimulation()
+{
+    auto* bridge = HW.PresentationBridge();
+    if (!bridge) return;
+    simulationFrame = true;
+    renderStarted = false;
+    // dwFrame advances in FrameMove, after this call. A 3D-scope (SVP) frame renders
+    // the scope view without presenting; it belongs to the next presented frame and
+    // must neither sleep in Reflex nor consume a frame token.
+    auto& svp = Device.m_SecondViewport;
+    scopeFrame = svp.IsSVPActive() && (Device.dwFrame + 1) % svp.GetSVPFrameDelay() == 0;
+    if (scopeFrame) return;
+    UINT limitUs = 0;
+    if (ReflexLimitsFrames())
+        limitUs = UINT(1e6f * FrameLimitScale() / float(ps_framelimiter));
+    R_CHK(bridge->BeginFrame(limitUs, ps_r_frame_generation != 0, FramesToGenerate()));
+}
+
+void EndSimulation()
+{
+    auto* bridge = HW.PresentationBridge();
+    if (!bridge || !simulationFrame || renderStarted) return;
+    renderStarted = true;
+    if (scopeFrame) return;
+    if (auto* runtime = bridge->GetStreamline())
+    {
+        runtime->Marker(sl::PCLMarker::eSimulationEnd);
+        runtime->Marker(sl::PCLMarker::eRenderSubmitStart);
+    }
+}
+
+void BeginRender()
+{
+    // Loading-screen draws can bypass on_idle's simulation path. They get their
+    // own token and paired markers, but never reuse an old scene capture.
+    if (!simulationFrame) BeginSimulation();
+    EndSimulation();
+}
+
+void EndPresent()
+{
+    simulationFrame = renderStarted = scopeFrame = false;
+    auto* bridge = HW.PresentationBridge();
+    // A runtime error turned FG off (the game keeps running). Reflect that in the
+    // setting so the menu shows Off, and let the player turn it on again to retry.
+    static u32 disabledNoticeUntil = 0;
+    static bool disabledOutOfVram = false;
+    if (ps_r_frame_generation && bridge && bridge->GenerationFailed())
+    {
+        Msg("! [FG] Frame generation was turned off after an error (see above). It can be turned on again in Video settings.");
+        ps_r_frame_generation = Off;
+        // Read before ClearGenerationFailure, which forgets the VRAM warning.
+        disabledOutOfVram = bridge->GenerationOutOfVram();
+        bridge->ClearGenerationFailure();
+        disabledNoticeUntil = Device.dwTimeGlobal + 8000;
+    }
+    if (!ps_r_frame_generation)
+        SetFrameGenerationError(Device.dwTimeGlobal >= disabledNoticeUntil ? nullptr : disabledOutOfVram ?
+            "OUT OF VRAM FG STOPPED WORKING" :
+            "Frame generation was turned off after an error. You can turn it on again in Video settings.");
+    else if (!bridge || bridge->GenerationFailed() || !bridge->FrameGenerationReady())
+        SetFrameGenerationError("Frame generation is unavailable. See the game log.");
+    else if (!RuntimeMatchesSetting(*bridge))
+        SetFrameGenerationError(ps_r_frame_generation != Fsr && !StreamlineIntegration::CanInitialize() ?
+            "DLSS frame generation needs a game restart after using FSR frame generation." :
+            "Selected frame generation method is not active. Apply again or see the game log.");
+    // Upscaling Off is the player's choice, not an error: the menu hides the frame
+    // generation row then, and generation resumes when an upscaler is selected again.
+    // Eligible() logs why it is not generating.
+    else SetFrameGenerationError(nullptr);
+}
+
+// ReShade on DX12 runs on the presenting D3D12 device and never sees the game's depth
+// buffer: the bridge copies the scene depth over. Only with ReShade loaded, so nobody
+// else pays for it. Frame generation's own capture covers the frames it runs on.
+static bool depthExportFailed{};
+
+static void CaptureDepth(D3D12PresentBridge& bridge)
+{
+    if (!use_reshade || depthExportFailed) return;
+    ID3D11Resource* depth = dlss::Active() ? dlss::SceneDepthTexture() : nullptr;
+    ID3D11Resource* native{};
+    if (!depth && HW.pBaseZB)
+    {
+        HW.pBaseZB->GetResource(&native);
+        depth = native;
+    }
+    if (depth && FAILED(bridge.CaptureDepth(depth)))
+    {
+        depthExportFailed = true;
+        bridge.SetDepthExport(false);
+        Msg("! [ReShade] Depth for DX12 disabled: %s", bridge.LastFailure());
+    }
+    _RELEASE(native);
+}
+
+void CaptureScene()
+{
+    auto* bridge = HW.PresentationBridge();
+    sceneCaptured = false;
+    // The scope view has its own camera; leave the main view's history untouched.
+    if (Device.m_SecondViewport.IsSVPFrame()) return;
+    if (bridge) bridge->SetDepthExport(use_reshade && !depthExportFailed);
+    if (!bridge || !Eligible() || !bridge->NeedsFGInputs()) { havePrevious = false; if (bridge) CaptureDepth(*bridge); return; }
+    // Main frames are not consecutive while a 3D scope renders on alternate frames.
+    const u32 maxGap = Device.m_SecondViewport.IsSVPActive() ? Device.m_SecondViewport.GetSVPFrameDelay() : 1;
+    const bool cut = !havePrevious || Device.dwFrame <= previousFrame || Device.dwFrame - previousFrame > maxGap ||
+        previousPosition.distance_to_sqr(Device.vCameraPosition) > 64.f ||
+        previousDirection.dotproduct(Device.vCameraDirection) < .25f || _abs(previousFov - Device.fFOV) > 10.f;
+    Fmatrix inverseProjection, inverseCurrent, clipToPrevious, previousToClip;
+    // Projective matrices: Fmatrix::invert is a 4x3 affine inverse, so use the full 4x4 one.
+    D3DXMatrixInverse((D3DXMATRIX*)&inverseProjection, nullptr, (D3DXMATRIX*)&Device.mProject);
+    D3DXMatrixInverse((D3DXMATRIX*)&inverseCurrent, nullptr, (D3DXMATRIX*)&Device.mFullTransform);
+    clipToPrevious.mul(cut ? Device.mFullTransform : previousTransform, inverseCurrent);
+    D3DXMatrixInverse((D3DXMATRIX*)&previousToClip, nullptr, (D3DXMATRIX*)&clipToPrevious);
+    FrameGenerationInputs inputs;
+    ToFloats(inputs.viewToClip, Device.mProject);
+    ToFloats(inputs.clipToView, inverseProjection);
+    ToFloats(inputs.clipToPrevClip, clipToPrevious);
+    ToFloats(inputs.prevClipToClip, previousToClip);
+    const auto jitter = dlss::RasterJitter();
+    inputs.jitterX = jitter.x;
+    inputs.jitterY = jitter.y;
+    // SSS stores current UV minus previous UV (unlike OGSR's NDC vectors).
+    inputs.motionToUvX = inputs.motionToUvY = -1.f;
+    const Fvector* vectors[]{&Device.vCameraPosition, &Device.vCameraTop, &Device.vCameraRight, &Device.vCameraDirection};
+    float* targets[]{inputs.cameraPosition, inputs.cameraUp, inputs.cameraRight, inputs.cameraForward};
+    for (int i = 0; i < 4; ++i) { targets[i][0] = vectors[i]->x; targets[i][1] = vectors[i]->y; targets[i][2] = vectors[i]->z; }
+    inputs.cameraNear = -Device.mProject._43 / Device.mProject._33;
+    inputs.cameraFar = -Device.mProject._43 / (Device.mProject._33 - 1.f);
+    inputs.verticalFov = 2.f * atanf(1.f / Device.mProject._22);
+    inputs.aspectRatio = Device.mProject._22 / Device.mProject._11;
+    inputs.frameTimeDelta = Device.fTimeDelta * 1000.f;
+    inputs.reset = cut;
+    const HRESULT result = bridge->CaptureScene(dlss::SceneDepthTexture(), RImplementation.Target->rt_ssfx_motion_vectors->pSurface, inputs);
+    if (FAILED(result)) { R_CHK(bridge->FailGeneration(bridge->LastFailure())); havePrevious = false; return; }
+    if (ps_r_fg_diagnostics && (cut || Device.dwFrame % 240 == 0))
+        Msg("[FG DIAG] Capture engineFrame=%u previous=%u cut=%u scope=%u render=%ux%u display=%ux%u",Device.dwFrame,previousFrame,unsigned(cut),
+            unsigned(Device.m_SecondViewport.IsSVPActive()),dlss::RenderWidth(),dlss::RenderHeight(),Device.dwWidth,Device.dwHeight);
+    previousFrame = Device.dwFrame;
+    previousTransform = Device.mFullTransform;
+    previousPosition = Device.vCameraPosition;
+    previousDirection = Device.vCameraDirection;
+    previousFov = Device.fFOV;
+    havePrevious = true;
+    sceneCaptured = true;
+}
+
+void CaptureHudless(ID3D11Texture2D* source)
+{
+    auto* bridge = HW.PresentationBridge();
+    if (!bridge) return;
+    const HRESULT result = bridge->CaptureHudless(sceneCaptured, source);
+    sceneCaptured = false;
+    if (FAILED(result)) R_CHK(bridge->FailGeneration(bridge->LastFailure()));
+}
+
+namespace
+{
+// File version of a loaded module, "none" when it is not loaded.
+void ModuleVersion(const wchar_t* module, char* out, size_t size)
+{
+    xr_strcpy(out, size, "none");
+    HMODULE handle = GetModuleHandleW(module);
+    wchar_t path[MAX_PATH]{};
+    if (!handle || !GetModuleFileNameW(handle, path, MAX_PATH)) return;
+    DWORD ignored = 0;
+    const DWORD bytes = GetFileVersionInfoSizeW(path, &ignored);
+    xr_vector<u8> data(bytes);
+    VS_FIXEDFILEINFO* info = nullptr;
+    UINT length = 0;
+    if (!bytes || !GetFileVersionInfoW(path, 0, bytes, data.data()) ||
+        !VerQueryValueW(data.data(), L"\\", (void**)&info, &length) || !info)
+    {
+        xr_strcpy(out, size, "loaded, no version");
+        return;
+    }
+    xr_sprintf(out, size, "%u.%u.%u.%u", HIWORD(info->dwFileVersionMS), LOWORD(info->dwFileVersionMS),
+        HIWORD(info->dwFileVersionLS), LOWORD(info->dwFileVersionLS));
+}
+}
+
+const char* RuntimeVersions()
+{
+    static string512 text;
+    auto* bridge = HW.PresentationBridge();
+    if (!bridge) return "no DX12 presentation bridge";
+    string64 dlssg, sl;
+    ModuleVersion(L"nvngx_dlssg.dll", dlssg, sizeof(dlssg));
+    ModuleVersion(L"sl.dlss_g.dll", sl, sizeof(sl));
+    const char* fsr = bridge->FsrFrameGenerationVersion();
+    xr_sprintf(text, "runtime %s, FSR frame generation %s, nvngx_dlssg %s, sl.dlss_g %s",
+        bridge->RuntimeName(), fsr && *fsr ? fsr : "none", dlssg, sl);
+    return text;
+}
+
+void Reset()
+{
+    havePrevious = simulationFrame = renderStarted = scopeFrame = sceneCaptured = false;
+    lastReason = nullptr;
+    if (auto* bridge = HW.PresentationBridge()) bridge->ResetHistory();
+}
+
+bool ReflexLimitsFrames()
+{
+    auto* bridge = HW.PresentationBridge();
+    // Menus and pause keep the engine's own eco limiter.
+    return ps_framelimiter > 0 && bridge && bridge->GetStreamline() && !bridge->GenerationFailed() &&
+        !Device.Paused() && !IsMainMenuActive();
+}
+
+float FrameLimitScale()
+{
+    auto* bridge = HW.PresentationBridge();
+    return bridge && bridge->GenerationActive() ? float(bridge->GenerationMultiplier()) : 1.f;
+}
+}
