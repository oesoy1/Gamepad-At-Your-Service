+bool Configured();
+// DLSS takes linear HDR input (r_dlss_hdr_input)
+bool HdrInput();
+unsigned RenderWidth();
+unsigned RenderHeight();
+Offset RasterJitter();
+Offset PreviousRasterJitter();
