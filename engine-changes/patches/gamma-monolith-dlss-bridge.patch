diff --git a/extras/dlss_gamma/gamedata/scripts/modxml_dlss_options.script b/extras/dlss_gamma/gamedata/scripts/modxml_dlss_options.script
new file mode 100644
index 000000000..2c2c8ba89
--- /dev/null
+++ b/extras/dlss_gamma/gamedata/scripts/modxml_dlss_options.script
@@ -0,0 +1,333 @@
+-- Additive options extension: do not replace GAMMA/Anomaly's ui_options.script.
+local installed = false
+
+local function current_method()
+    local method = get_console_cmd(0, "r_upscaler")
+    -- Older configs selected DLSS implicitly and used quality=off to disable it.
+    -- Display those as Off without changing the console just by opening the UI.
+    if method == "dlss" and get_console_cmd(0, "r_dlss_quality") == "off" then
+        return "off"
+    end
+    return method
+end
+
+-- "fsr" rows serve both FSR 3 (DX11) and FSR 4 (DX12 executable).
+local function method_matches(needed, method)
+    if not needed or needed == method then return true end
+    if needed == "either" then return method ~= "off" end
+    return needed == "fsr" and (method == "fsr3" or method == "fsr4")
+end
+
+local function find_row(tree, id)
+    for _, row in ipairs(tree.gr or {}) do
+        if row.id == id then return row end
+    end
+end
+
+-- The engine lists only choices this GPU/runtime supports (plus the current value),
+-- so filtering by its token list is the hardware guard.
+local function content_for(command, choices)
+    local tokens = get_console():get_token_list(command)
+    local supported, content = {}, {}
+    if tokens then
+        for _, token in ipairs(tokens) do supported[token] = true end
+    end
+    for _, choice in ipairs(choices) do
+        if supported[choice[1]] then content[#content + 1] = choice end
+    end
+    return content
+end
+
+-- "dlss=1 fsr3=1 fsr_dx12=3.1.5 fg_dlss=restart fg_fsr=3.1.6" from r_upscaler_support.
+local function support()
+    local caps = {}
+    local text = get_console_cmd(0, "r_upscaler_support")
+    if type(text) == "string" then
+        for key, value in string.gmatch(text, "([%w_]+)=([%w%.]+)") do caps[key] = value end
+    end
+    return caps
+end
+
+-- Plain 0/1 console commands: stock or older binaries do not have them.
+local function has_switch(command)
+    local value = get_console_cmd(0, command)
+    return value == "0" or value == "1"
+end
+
+local function switch_row(id, command, fields)
+    -- A checkbox writes on/off unless told otherwise, which these commands reject.
+    local row = {id = id, type = "check", val = 1, cmd = command, bool_to_num = true}
+    for key, value in pairs(fields) do row[key] = value end
+    return row
+end
+
+-- Pending, so that a change on the Advanced page shows here before Apply.
+local function sunshaft_type(menu)
+    local row = menu:GetOption("video/advanced/sunshafts_mode")
+    if type(row) == "table" and row.cmd then
+        return menu:GetCurrentValue("video/advanced", row.id, row)
+    end
+    return get_console_cmd(0, "r2_sunshafts_mode")
+end
+
+-- Smoothed covers both screen-space and volumetric sunshafts.
+local function sunshaft_handling_choices()
+    return content_for("r_upscaler_sunshafts", {
+        {"upscaled", "upscaler_sunshafts_upscaled"}, {"smoothed", "upscaler_sunshafts_smoothed"},
+        {"raw", "upscaler_sunshafts_raw"},
+    })
+end
+
+local function major(version)
+    return tonumber(string.match(version or "", "^(%d+)%.")) or 0
+end
+
+-- Labels say what actually runs: FSR 4 only on supported Radeon GPUs.
+local function upscaler_choices()
+    local caps = support()
+    return content_for("r_upscaler", {
+        {"off", "dlss_off"}, {"dlss", "upscaler_dlss"}, {"fsr3", "upscaler_fsr3"},
+        {"fsr4", major(caps.fsr_dx12) >= 4 and "upscaler_fsr4" or "upscaler_fsr_dx12"},
+    })
+end
+
+local function generation_choices()
+    local caps = support()
+    local restart = caps.fg_dlss == "restart" and "_restart" or ""
+    return content_for("r_frame_generation", {
+        {"off", "dlss_off"},
+        {"dlss", "fg_dlss_2x" .. restart},
+        {"dlss3x", "fg_dlss_3x" .. restart},
+        {"dlss4x", "fg_dlss_4x" .. restart},
+        {"fsr", major(caps.fg_fsr) >= 4 and "fg_fsr4_2x" or "fg_fsr_2x"},
+    })
+end
+
+local function install_dynamic_options()
+    local class = ui_options.UIOptions
+    local reset, cache, update = class.Reset_opt, class.CacheValue, class.Update
+    local accept = class.On_Accept
+    class.Reset_opt = function(self, tree, path, flags)
+        self._upscaler_refresh = nil
+        local selector = path == "video/basic" and find_row(tree, "upscaler")
+        local post_after = path == "video/basic" and find_row(tree, "upscaler_post_after")
+        if not selector and not post_after then return reset(self, tree, path, flags) end
+        local method
+        if selector then
+            -- Support can change in a session (e.g. Streamline needs a restart after
+            -- FSR frame generation was used): rebuild these choices on every show.
+            selector.content = upscaler_choices()
+            local generation = find_row(tree, "frame_generation")
+            if generation then generation.content = generation_choices() end
+            -- Ask the options framework for its PENDING value, not the live console.
+            method = self:GetCurrentValue(path, selector.id, selector)
+        end
+        local post_on = post_after and self:GetCurrentValue(path, post_after.id, post_after)
+        local sunshafts = path == "video/basic" and find_row(tree, "upscaler_sunshafts") and sunshaft_type(self)
+        local visible = {}
+        for key, value in pairs(tree) do visible[key] = value end
+        visible.gr = {}
+        for _, row in ipairs(tree.gr) do
+            if method_matches(row.upscaler_method, method) and (post_on or not row.needs_post_after) and
+                (sunshafts ~= "off" or not row.needs_sunshafts) then
+                visible.gr[#visible.gr + 1] = row
+            end
+        end
+        -- Filter only the displayed rows. Keep the canonical options tree intact
+        -- so hidden settings retain pending values and Apply/Cancel still work.
+        return reset(self, visible, path, flags)
+    end
+    class.CacheValue = function(self, path, opt, value, row)
+        cache(self, path, opt, value, row)
+        if path == "video/basic" and opt == "upscaler" then
+            if value == "dlss" then
+                local quality = self:GetOption("video/basic/dlss_mode")
+                if self:GetCurrentValue(path, quality.id, quality) == "off" then
+                    -- Selecting DLSS must actually enable it. Stage Quality only
+                    -- for legacy Off; preserve all existing non-Off choices.
+                    cache(self, path, quality.id, "quality", quality)
+                end
+            end
+            -- Never destroy a combo box while its selection callback is running.
+            self._upscaler_refresh = true
+        elseif path == "video/basic" and opt == "upscaler_post_after" then
+            self._upscaler_refresh = true
+        end
+    end
+    class.Update = function(self, ...)
+        update(self, ...)
+        if self._upscaler_refresh then
+            self._upscaler_refresh = nil
+            if self.last_path == "video/basic" and self.last_curr_tree then
+                self:Reset_opt(self.last_curr_tree, self.last_path)
+            end
+        end
+    end
+    class.On_Accept = function(self, ...)
+        local selector = self:GetOption("video/basic/upscaler")
+        if selector and selector.cmd == "r_upscaler" then
+            local method = self:GetCurrentValue("video/basic", selector.id, selector)
+            local quality = self:GetOption("video/basic/dlss_mode")
+            -- Legacy dlss+quality=off is displayed as Off. If DLSS was selected
+            -- and then Off again, its pending quality can still be non-Off.
+            -- Preserve that quality preference but make Off authoritative.
+            if method == "off" and get_console_cmd(0, "r_upscaler") == "dlss" and
+                get_console_cmd(0, "r_dlss_quality") == "off" and
+                self:GetCurrentValue("video/basic", quality.id, quality) ~= "off" then
+                exec_console_cmd("r_upscaler off")
+                -- The pending quality already requests cfg_save/vid_restart.
+            end
+        end
+        return accept(self, ...)
+    end
+end
+
+local function add_options()
+    local generation = generation_choices()
+    local methods = upscaler_choices()
+    local fsr_modes = content_for("r_fsr3_quality", {
+        {"native_aa", "fsr3_native_aa"}, {"ultra_quality", "dlss_ultra_quality"}, {"quality", "dlss_quality"},
+        {"balanced", "dlss_balanced"}, {"performance", "dlss_performance"},
+        {"ultra_performance", "dlss_ultra_performance"},
+    })
+    -- Commands only exist in the matching DX11 renderer. Hide these controls
+    -- with stock/other-renderer binaries instead of issuing unknown commands.
+    local modes = content_for("r_dlss_quality", {
+        {"off", "dlss_off"}, {"dlaa", "dlss_dlaa"}, {"ultra_quality", "dlss_ultra_quality"},
+        {"quality", "dlss_quality"}, {"balanced", "dlss_balanced"},
+        {"performance", "dlss_performance"}, {"ultra_performance", "dlss_ultra_performance"},
+    })
+    local presets = content_for("r_dlss_preset", {
+        {"default", "dlss_default"}, {"j", "dlss_j"}, {"k", "dlss_k"},
+        {"l", "dlss_l"}, {"m", "dlss_m"},
+    })
+    if #modes == 0 or #presets == 0 then return end
+    -- A method selector whenever the engine has one: on AMD GPUs DLSS is not
+    -- offered, leaving Off plus the FSR methods.
+    local dual = #methods >= 2 and #fsr_modes > 0
+    if dual then
+        -- Off belongs only to the method selector, not the quality selector.
+        for i = #modes, 1, -1 do
+            if modes[i][1] == "off" then table.remove(modes, i) end
+        end
+    end
+
+    for _, top in ipairs(ui_options.options) do
+        if top.id == "video" and top.gr then
+            for _, group in ipairs(top.gr) do
+                if group.id == "basic" and group.gr then
+                    for _, row in ipairs(group.gr) do
+                        if row.id == "dlss_mode" then return end
+                    end
+                    local function add(row) group.gr[#group.gr + 1] = row end
+                    -- A section at the end of the page, like those on the Advanced page,
+                    -- so that it does not take in the rows after it.
+                    add({id = "line", type = "line"})
+                    add({
+                        id = "title", type = "title", text = "ui_mm_header_upscaling",
+                        align = "l", clr = {255, 200, 200, 200},
+                    })
+                    -- Standard pending-value/Apply/Cancel handling. vid requests
+                    -- ONE vid_restart after both console values have been applied.
+                    if dual then
+                        add({
+                            id = "upscaler", type = "list", val = 0,
+                            cmd = "r_upscaler", content = methods, vid = true,
+                            curr = {current_method},
+                        })
+                    end
+                    add({
+                        id = "dlss_mode", type = "list", val = 0,
+                        cmd = "r_dlss_quality", content = modes, vid = true,
+                        upscaler_method = dual and "dlss" or nil,
+                    })
+                    if dual then
+                        add({
+                            id = "fsr3_mode", type = "list", val = 0,
+                            cmd = "r_fsr3_quality", content = fsr_modes, vid = true,
+                            upscaler_method = "fsr",
+                        })
+                    end
+                    add({
+                        id = "dlss_preset", type = "list", val = 0,
+                        cmd = "r_dlss_preset", content = presets, vid = true,
+                        upscaler_method = dual and "dlss" or nil,
+                    })
+                    if has_switch("r_dlss_hdr_input") then
+                        add(switch_row("dlss_linear_input", "r_dlss_hdr_input", {
+                            vid = true, upscaler_method = dual and "dlss" or nil,
+                        }))
+                    end
+                    add({
+                        id = "dlss_sharpness", type = "track", val = 2,
+                        cmd = "r_dlss_sharpness", min = 0, max = 1, step = 0.05,
+                        upscaler_method = dual and "either" or nil,
+                    })
+                    if #generation > 0 then
+                        -- Switching between DLSS and FSR rebuilds the DX12 swapchain.
+                        -- Frame generation needs an upscaler, so it is shown only with one.
+                        add({
+                            id = "frame_generation", type = "list", val = 0,
+                            cmd = "r_frame_generation", content = generation, vid = true,
+                            upscaler_method = dual and "either" or nil,
+                        })
+                    end
+                    if has_switch("r_upscaler_post_after") then
+                        add(switch_row("upscaler_post_after", "r_upscaler_post_after", {
+                            vid = true, upscaler_method = dual and "either" or nil,
+                        }))
+                        local handling = sunshaft_handling_choices()
+                        if #handling > 0 then
+                            add({
+                                id = "upscaler_sunshafts", type = "list", val = 0,
+                                cmd = "r_upscaler_sunshafts", content = handling,
+                                needs_post_after = true, needs_sunshafts = true,
+                                upscaler_method = dual and "either" or nil,
+                            })
+                        end
+                        if has_switch("r_upscaler_particles_after") then
+                            add(switch_row("upscaler_particles_after", "r_upscaler_particles_after", {
+                                needs_post_after = true, upscaler_method = dual and "either" or nil,
+                            }))
+                        end
+                    end
+                    return
+                end
+            end
+        end
+    end
+end
+
+-- AnomalyDX12.exe (the only build with frame generation) renders with the DX11
+-- renderer and presents through DX12. Only the label changes; the console
+-- value stays renderer_r4 so saved configs and scripts keep working.
+local function label_dx12_renderer()
+    -- get_token_list returns an empty table, not nil, for an unknown command.
+    if #get_console():get_token_list("r_frame_generation") == 0 then return end
+    for _, top in ipairs(ui_options.options) do
+        if top.id == "video" and top.gr then
+            for _, group in ipairs(top.gr) do
+                if group.id == "basic" then
+                    local row = find_row(group, "renderer")
+                    if row then row.content = {{"renderer_r4", "renderer_r4_dx12_bridge"}} end
+                    return
+                end
+            end
+        end
+    end
+end
+
+function on_xml_read()
+    if installed then return end
+    installed = true
+    install_dynamic_options()
+    -- Insert before indexing, rather than invoking the indexer a second time:
+    -- GAMMA's indexer also appends radio playlist controls.
+    local original = ui_options.init_opt_coder
+    ui_options.init_opt_coder = function(...)
+        label_dx12_renderer()
+        add_options()
+        return original(...)
+    end
+    ui_options.init_opt_base()
+end
diff --git a/extras/dlss_gamma/gamedata/shaders/r3/combine_volumetric.ps b/extras/dlss_gamma/gamedata/shaders/r3/combine_volumetric.ps
new file mode 100644
index 000000000..65316ebe9
--- /dev/null
+++ b/extras/dlss_gamma/gamedata/shaders/r3/combine_volumetric.ps
@@ -0,0 +1,80 @@
+#include "common.h"
+#include "dlss_contract.h"
+
+Texture2D noise_tex;
+uniform float4 ssfx_timedelta; // y = frame
+uniform float4 dlss_volumetric_params; // xy = raster jitter in UV, z = drawn after reconstruction
+
+//	Igor: used for volumetric light
+#ifndef USE_MSAA
+	Texture2D s_vollight;
+#else
+	#ifndef SM_5
+		Texture2DMS<float4,MSAA_SAMPLES> s_vollight;
+	#else
+		Texture2DMS<float4>	s_vollight;
+	#endif
+#endif
+
+struct	_input
+{
+	float4	tc0	: TEXCOORD0;	// tc.xy, tc.w = tonemap scale
+};
+
+struct	_out
+{
+	float4	low		: SV_Target0;
+	float4	high	: SV_Target1;
+};
+
+//	TODO: DX10: Use load instead of sample
+_out main( _input I )
+{
+	_out	o;
+	float4	color;
+
+#ifndef USE_MSAA // Get Volumetric Buffer [ No MSAA ]
+
+	// After reconstruction the rest of the frame is unjittered, but this buffer is not.
+	color = s_vollight.SampleLevel( smp_linear, I.tc0.xy + dlss_volumetric_params.xy, 0);
+
+	// Read Depth
+	float _depth = s_position.Sample(smp_nofilter, I.tc0.xy).z;
+
+#else // Get Volumetric Buffer [ MSAA ]
+
+	float2 tc = I.tc0.xy * screen_res.xy;
+
+	color = s_vollight.Load(int3(tc, 0), 0);
+	[unroll] for(int iSample = 1; iSample < MSAA_SAMPLES; ++iSample)
+	{
+		color	+= s_vollight.Load(int3(tc, 0), iSample);
+	}
+	color /= MSAA_SAMPLES;
+
+	// Read Depth [ MSAA ]
+	float _depth = s_position.Load(int3(tc, 0), iSample).z;
+#endif
+
+	// Noise TC
+	float2 uv_noise = I.tc0.xy;
+	uv_noise /= 256.0f / screen_res.xy; // Resolution independent. The default noise texture is 512x512
+
+	// Upscaling: a screen-fixed pattern does not move with the jittered scene, so the
+	// upscaler keeps it as static grain when the camera is still. Move it every frame
+	// (R2 sequence) so it averages out instead. Drawn after reconstruction, nothing
+	// averages it, so it stays fixed.
+	if (dlss_params.x > 0.5f && dlss_volumetric_params.z < 0.5f)
+		uv_noise += frac(fmod(ssfx_timedelta.y, 1024.0f) * float2(0.7548777f, 0.5698403f)); // wraps
+
+	// Add noise to dither the result
+	color = saturate(color - noise_tex.Sample( smp_linear, uv_noise).xxxx * 0.01f);
+
+	// Discard Sky.
+	color *= _depth < 0.001 ? 1.0f : saturate(_depth * 1.5f);
+
+
+	tonemap(o.low, o.high, color, I.tc0.w );
+
+	return o;
+}
\ No newline at end of file
diff --git a/extras/dlss_gamma/gamedata/shaders/r3/deffer_grass.vs b/extras/dlss_gamma/gamedata/shaders/r3/deffer_grass.vs
new file mode 100644
index 000000000..a1494ed41
--- /dev/null
+++ b/extras/dlss_gamma/gamedata/shaders/r3/deffer_grass.vs
@@ -0,0 +1,179 @@
+#define SSFX_WIND_ISGRASS
+
+#include "common.h"
+#include "check_screenspace.h"
+
+#include "screenspace_mvectors.h"
+
+uniform float4 ssfx_floravariation; // Grass Int, Grass Freq, Foliage Int, Foliage Freq
+
+float4 grass_anim_prev;
+
+float4 benders_prevpos[32]; // Prev Frame
+float4 benders_pos[32]; // Current Frame
+float4 benders_setup;
+float4 exdata[61]; // Terrain Normal [xyz] & Grass alpha [w]
+int grass_align;
+
+float4 consts; // {1/quant,1/quant,diffusescale,ambient}
+float4 wave; // cx,cy,cz,tm
+float4 wave_prev;
+float4 dir2D_prev;
+float4 dir2D; 
+float4 array[61*4];
+
+float4 wind;
+
+#ifdef SSFX_WIND
+	#include "screenspace_wind.h"
+#endif
+
+v2p_bumped 	main (v_detail v)
+{
+	v2p_bumped 		O;
+	// index
+	int 	i 	= v.misc.w;
+	float4  m0 	= array[i+0];
+	float4  m1 	= array[i+1];
+	float4  m2 	= array[i+2];
+	float4  c0 	= array[i+3];
+
+	float4 data = exdata[i / 4]; // Adjust size ( 61 instead of 61*4 )
+
+	// Transform pos to world coords
+	float4 P;
+ 	P.x = dot(m0, v.pos);
+ 	P.y = dot(m1, v.pos);
+ 	P.z = dot(m2, v.pos);
+	P.w = 1;
+
+	float H = P.y - m1.w; // height of vertex (scaled)
+
+	// Force grass to go up
+	P.xz = P.xz - 0.5f * data.xz * H * grass_align;
+
+	float4 P_prev = 0;
+
+#ifndef SSFX_WIND
+	float dp = calc_cyclic(dot(P, wave));
+	float frac = v.misc.z * consts.x;	// fractional
+	float inten = H * dp;
+	float2 result = calc_xz_wave(dir2D.xz * inten, frac);
+	
+	float4 pos = float4(P.x + result.x, P.y, P.z + result.y, 1);
+	float prev_dp = calc_cyclic(dot(P, wave_prev));
+	float2 prev_result = calc_xz_wave(dir2D_prev.xz * (H * prev_dp), frac);
+	P_prev = float4(P.x + prev_result.x, P.y, P.z + prev_result.y, 1);
+#else
+	float3	wind_result = ssfx_wind_grass(P.xyz, H, ssfx_wind_setup(), false);
+	float4 pos = float4(P.xyz + wind_result.xyz, 1);
+
+	// Prev Position
+	P_prev = float4(P.xyz + ssfx_wind_grass(P.xyz, H, ssfx_wind_setup(), true), 1);
+#endif
+
+	// INTERACTIVE GRASS - SSS Update 15.4
+	// https://www.moddb.com/mods/stalker-anomaly/addons/screen-space-shaders/
+#ifdef SSFX_INTER_GRASS
+#if SSFX_INT_GRASS > 0
+	for (int b = 0; b < SSFX_INT_GRASS + 1; b++)
+	{
+		// Direction, Radius & Bending Strength, Distance and Height Limit
+		float3 dir = benders_pos[b + 16].xyz;
+		float3 rstr = float3(benders_pos[b].w, benders_pos[b + 16].ww);
+		bool non_dynamic = rstr.x <= 0 ? true : false;
+		float dist = distance(pos.xz, benders_pos[b].xz);
+		float height_limit = 1.0f - saturate(abs(pos.y - benders_pos[b].y) / ( non_dynamic ? 2.0f : rstr.x ));
+		height_limit *= H;
+
+		// Adjustments ( Fix Radius or Dynamic Radius )
+		rstr.x = non_dynamic ? benders_setup.x : rstr.x;
+ 		rstr.yz *= non_dynamic ? benders_setup.yz : 1.0f;
+
+		// Strength through distance and bending direction.
+		float bend = 1.0f - saturate(dist / (rstr.x + 0.001f));
+		float3 bend_dir = normalize(pos.xyz - benders_pos[b].xyz) * bend;
+		float3 dir_limit = dir.y >= -1 ? saturate(dot(bend_dir.xyz, dir.xyz) * 5.0f) : 1.0f; // Limit if nedeed
+
+		// Apply direction limit
+		bend_dir.xz *= dir_limit.xz;
+
+		// Apply vertex displacement
+		pos.xz += bend_dir.xz * 2.0f * rstr.yy * height_limit; 			// Horizontal
+		pos.y -= bend * 0.6f * rstr.z * height_limit * dir_limit.y;		// Vertical
+	}
+
+	// Prev Frame
+	for (int p = 0; p < SSFX_INT_GRASS + 1; p++)
+	{
+		// Direction, Radius & Bending Strength, Distance and Height Limit
+		float3 dir = benders_prevpos[p + 16].xyz;
+		float3 rstr = float3(benders_prevpos[p].w, benders_prevpos[p + 16].ww);
+		bool non_dynamic = rstr.x <= 0 ? true : false;
+		float dist = distance(P_prev.xz, benders_prevpos[p].xz);
+		float height_limit = 1.0f - saturate(abs(P_prev.y - benders_prevpos[p].y) / ( non_dynamic ? 2.0f : rstr.x ));
+		height_limit *= H;
+
+		// Adjustments ( Fix Radius or Dynamic Radius )
+		rstr.x = non_dynamic ? benders_setup.x : rstr.x;
+ 		rstr.yz *= non_dynamic ? benders_setup.yz : 1.0f;
+
+		// Strength through distance and bending direction.
+		float bend = 1.0f - saturate(dist / (rstr.x + 0.001f));
+		float3 bend_dir = normalize(P_prev.xyz - benders_prevpos[p].xyz) * bend;
+		float3 dir_limit = dir.y >= -1 ? saturate(dot(bend_dir.xyz, dir.xyz) * 5.0f) : 1.0f; // Limit if nedeed
+
+		// Apply direction limit
+		bend_dir.xz *= dir_limit.xz;
+
+		P_prev.xz += bend_dir.xz * 2.0f * rstr.yy * height_limit; 			// Horizontal
+		P_prev.y -= bend * 0.6f * rstr.z * height_limit * dir_limit.y;		// Vertical
+	}
+#endif
+#endif
+
+	// FLORA FIXES & IMPROVEMENTS - SSS Update 22
+	// https://www.moddb.com/mods/stalker-anomaly/addons/screen-space-shaders/	
+
+	// Use terrain normal [ c0.xyz ]
+	float3 N = mul((float3x3)m_WV, data.xyz);
+
+	float3x3 xform = 0;
+
+	// Normal
+	xform[0].z = N.x;
+	xform[1].z = N.y;
+	xform[2].z = N.z;
+	
+	// Alpha here
+	xform[0].x = data.w;
+
+	// Feed this transform to pixel shader
+	O.M1 			= xform[0];
+	O.M2 			= xform[1];
+	O.M3 			= xform[2];
+
+	// Eye-space pos/normal
+	float 	hemi 	= clamp(c0.w, 0.05f, 1.0f); // Some spots are bugged ( Full black ), better if we limit the value till a better solution. // Option -> v_hemi(N);
+	float3	Pe		= mul		(m_V,  	pos		);
+	O.tcdh 			= float4	((v.misc * consts).xyyy);
+	O.hpos 			= mul		(m_VP,	pos		);
+	O.position		= float4	(Pe, 	hemi	);
+
+	// Values to calc motion vectors
+	O.vel_curr = O.hpos;
+	O.vel_prev = mul(m_vp_prev, P_prev);
+
+	O.sss_extra = float4(0, 0, hash12(floor((P.xz + m0.xx * 2.0f) * ssfx_floravariation.y)), H);
+
+	// TAA Jitter
+	if (H < 0.1f || dlss_params.x > 0.5f)
+		O.hpos.xy = ssfx_taa_jitter(O.hpos);
+
+#if defined(USE_R2_STATIC_SUN) && !defined(USE_LM_HEMI)
+	O.tcdh.w		= hemi * c_sun.x + c_sun.y;					// (,,,dir-occlusion)
+#endif
+
+	return O;
+}
+FXVS;
diff --git a/extras/dlss_gamma/gamedata/shaders/r3/deffer_impl_flat.ps b/extras/dlss_gamma/gamedata/shaders/r3/deffer_impl_flat.ps
new file mode 100644
index 000000000..313de8b10
--- /dev/null
+++ b/extras/dlss_gamma/gamedata/shaders/r3/deffer_impl_flat.ps
@@ -0,0 +1,195 @@
+#include "check_screenspace.h"
+#include "settings_screenspace_PUDDLES.h"
+#include "settings_screenspace_SSR.h"
+
+#include "common.h"
+#include "screenspace_mvectors.h"
+#include "sload.h"
+
+#include "screenspace_common_ripples.h"
+
+Texture2D s_puddles_normal;
+Texture2D s_puddles_perlin;
+Texture2D s_puddles_mask;
+Texture2D s_rainsplash;
+
+#define	USE_4_DETAIL
+
+#if defined(USE_TDETAIL) && defined(USE_4_DETAIL)
+#	define	USE_4_BUMP
+#endif
+
+#ifdef USE_4_BUMP
+f_deffer 	main	( p_bumped I 	)
+#else
+f_deffer 	main	( p_flat I 		)
+#endif
+{
+	f_deffer	O;
+
+ 	// diffuse
+	float4 D		= tbase		(I.tcdh);			// IN:  rgb.a
+	float4 L 	= s_lmap.Sample( smp_base, I.tcdh);
+	float G 	= 0.001;
+
+#ifdef	USE_TDETAIL
+ #ifdef USE_4_DETAIL
+	float4	mask= s_mask.Sample ( smp_base, I.tcdh);
+	float 	mag	= dot 		(mask,1);
+			mask= mask/mag	;
+
+  #ifdef USE_4_BUMP
+ 	 float4	n_Rt = s_dn_r.Sample ( smp_base, I.tcdbump).wzyx;
+	 float4	n_Gt = s_dn_g.Sample ( smp_base, I.tcdbump).wzyx;
+	 float4	n_Bt = s_dn_b.Sample ( smp_base, I.tcdbump).wzyx;
+	 float4	n_At = s_dn_a.Sample ( smp_base, I.tcdbump).wzyx;
+	 
+ 	 float3	n_R = (n_Rt-0.5)*mask.r; 
+	 float g_R=n_Rt.w*mask.r;
+	 
+	 float3	n_G = (n_Gt-0.5)*mask.g; 
+	 float g_G=n_Gt.w*mask.g;
+	 
+	 float3	n_B = (n_Bt-0.5)*mask.b; 
+	 float g_B=n_Bt.w*mask.b;
+	 
+	 float3	n_A = (n_At-0.5)*mask.a; 
+	 float g_A=n_At.w*mask.a;
+
+	 float3	mix		= 	n_R+n_G+n_B+n_A;
+			mix	*=	float3(0.35f, 0.35f, 1.0); // Adjust bump strength
+
+	 float3	N		= 	mul     	(float3x3(I.M1, I.M2, I.M3), mix.xyz);
+
+	// Puddles Implementation - SSS Update 14.6
+	// https://www.moddb.com/mods/stalker-anomaly/addons/screen-space-shaders/
+
+	// Wetness factor
+	float wetness_f = rain_params.y;
+
+	// Always render puddles if G_PUDDLES_ALLWAYS is defined
+	#ifdef G_PUDDLES_ALLWAYS
+		wetness_f = 1.0f;
+	#endif
+
+	// Intensity factor.
+	float puddles_f = wetness_f;
+
+	// Size factor. Convert 0 ~ 1 to 1 ~ -0.1f
+	float size_f = (1.0f - G_PUDDLES_SIZE * 1.1f);
+
+	// Texture mask
+	float puddles_mask = 1.0f - s_puddles_mask.Sample(smp_base, I.tcdh).r;
+
+	// Puddles perlin
+	float puddles = saturate((s_puddles_perlin.Sample(smp_base, I.tcdh * 15.0f / G_PUDDLES_GLOBAL_SIZE).r - size_f) * puddles_f);
+
+	// Get normals and transform space to create a slope mask
+	float3 N1 = mul(float3x3(I.M1, I.M2, I.M3), float3(0,0,1));
+	float3 N2 = mul(m_inv_V, normalize(N1));
+
+	// Slope mask
+	float slope = max(N2.x, N2.y);
+
+	// Slope adjustements... Some magic numbers
+	slope = saturate((slope - 0.997f) * (102.0f + 0.997f));
+
+	// Slope & texture mask defines final puddles intensity
+	puddles *= slope * puddles_mask;
+
+	// Puddles border hardness
+	puddles = smoothstep(0, saturate(0.3f - G_PUDDLES_BORDER_HARDNESS * 0.3f), puddles);
+
+#ifdef G_PUDDLES_RIPPLES
+
+	float rain_int = saturate(rain_params.x * 1.5f);
+
+	// Base ripples anim speed
+	float ripples_anim =  timers.x * ((0.01f + (rain_int * 0.008f)) * G_PUDDLES_RIPPLES_SPEED );
+	
+	// Base ripples scale
+	float ripples_scale = 140 / G_PUDDLES_RIPPLES_SCALE;
+
+	// Base ripples Normal
+	float3 WN0 = s_puddles_normal.Sample(smp_base, I.tcdh * ripples_scale + float2(0, ripples_anim));
+	float3 WN1 = s_puddles_normal.Sample(smp_base, I.tcdh * ripples_scale - float2(0.33f, ripples_anim));
+	float3 ripplesNormal = ((WN0 + WN1) * 0.5f) * 2.0f - 1.0f;
+
+	// Rain Ripples
+	float2 ripplesUV = I.tcdh * ripples_scale * 1.3f / G_PUDDLES_RAIN_RIPPLES_SCALE;
+	float2 rainRipples = ssfx_rain_ripples( s_rainsplash, ripplesUV, float3(0.85f, 1.0f, 10.0f), I.position.z);
+
+	// Rain ripples intensity... ( Rain intensity * Depth fadeout * Intensity )
+	rainRipples *= rain_params.x * 3.0f * G_PUDDLES_RAIN_RIPPLES_INTENSITY;
+
+	// Base ripples Intensity
+	ripplesNormal *= saturate(0.05f + rain_int * G_PUDDLES_RIPPLES_RAINING_INT * G_PUDDLES_RIPPLES_INTENSITY);
+	
+	// Mix ripples
+	ripplesNormal = ripplesNormal * 0.666f + float3(rainRipples * 0.333f, 0);
+
+#else
+	float3 ripplesNormal = 0;
+#endif
+
+	// Normal Up and ripples for puddles
+	float3 MirrorUp	= mul(m_V,  float3(ripplesNormal.x, 1.0, ripplesNormal.y));
+	N = lerp(N, MirrorUp, puddles);
+
+	// Refraction Normal
+	float3 N_refra = ripplesNormal;
+
+	// Adjust refraction intensity based on wetness and puddle perlin
+	N_refra.xy *= 0.15f * smoothstep( 0.6f, 0.8f, wetness_f * puddles ) * G_PUDDLES_REFRACTION_INTENSITY;
+
+	// Detail textures + refraction when needed
+	float2 detail_tc = I.tcdbump + N_refra;
+	float3 d_R = s_dt_r.Sample ( smp_base, detail_tc) * mask.r;
+	float3 d_G = s_dt_g.Sample ( smp_base, detail_tc) * mask.g;
+	float3 d_B = s_dt_b.Sample ( smp_base, detail_tc) * mask.b;
+	float3 d_A = s_dt_a.Sample ( smp_base, detail_tc) * mask.a;
+	float3 dt = d_R + d_G + d_B + d_A;
+	D.rgb = 2 * D.rgb * dt;
+
+	// Apply tint
+	D.rgb = lerp( D.rgb, D.rgb * G_PUDDLES_TINT, puddles);
+
+	// Limit pudddle reflection.
+	puddles = clamp(puddles, 0, G_PUDDLES_REFLECTIVITY);
+
+	// Add at the end the extra wetness. Full intensity at 50% of wetness ( rain_params.y )
+#ifndef SSFX_NEWGLOSS
+	puddles = puddles + saturate(rain_params.y * 2.0f) * G_PUDDLES_TERRAIN_EXTRA_WETNESS;
+#endif
+
+	// Add gloss and puddles to the final gloss result
+	G = max(g_R + g_G + g_B + g_A, puddles);
+
+  #else
+	float3	N 	= I.N.xyz	;
+  #endif
+
+ #else
+	D.rgb	= 2*D.rgb*s_detail.Sample( smp_base, I.tcdbump).rgb;
+ #endif
+#else
+	float3	N 	= I.N.xyz	;
+#endif
+
+	// hemi, sun, material
+	float 	ms	= xmaterial	;
+#ifdef USE_R2_STATIC_SUN
+		 	ms 	= L.w		;
+#endif
+
+  // 2. Standart output
+  float4     Ne = float4	(normalize(N), 									D.w			);
+  O				= pack_gbuffer( 
+								Ne,	// hemi
+								float4 	(I.position.xyz + Ne.xyz*def_virtualh/2.h, 	1.333334f			),	//
+								float4	(D.x,	D.y,	D.z,						G			) );	// OUT: rgb.gloss
+
+  // Preserve Atmospherics material/puddle shading while supplying temporal motion.
+  O.velocity = ssfx_mv_calc(I.vel_curr, I.vel_prev, 0, 0);
+  return O;
+}
diff --git a/extras/dlss_gamma/gamedata/shaders/r3/dlss_cas.h b/extras/dlss_gamma/gamedata/shaders/r3/dlss_cas.h
new file mode 100644
index 000000000..d29dcbd69
--- /dev/null
+++ b/extras/dlss_gamma/gamedata/shaders/r3/dlss_cas.h
@@ -0,0 +1,49 @@
+// CAS adapted from OGSR's postprocess_cas.ps, based on AMD's CAS presentation:
+// https://gpuopen.com/wp-content/uploads/2019/07/FidelityFX-CAS.pptx
+// Kept separate from NGX: operates on the reconstructed display-resolution image.
+float4 dlss_sharpening; // x: blend strength [0,1]
+
+float3 DlssCasSample(float2 uv, int2 offset)
+{
+    float3 c = max(s_image.SampleLevel(smp_rtlinear, uv, 0, offset).rgb, 0.0);
+    return c / (1.0 + c);
+}
+
+float4 DlssCas(float2 uv)
+{
+    float4 original = s_image.SampleLevel(smp_rtlinear, uv, 0);
+    float strength = saturate(dlss_sharpening.x);
+    if (strength <= 0.0) return original;
+
+    float3 a = DlssCasSample(uv, int2(-1, -1));
+    float3 b = DlssCasSample(uv, int2( 0, -1));
+    float3 c = DlssCasSample(uv, int2( 1, -1));
+    float3 d = DlssCasSample(uv, int2(-1,  0));
+    float3 e = max(original.rgb, 0.0);
+    e = e / (1.0 + e);
+    float3 f = DlssCasSample(uv, int2( 1,  0));
+    float3 g = DlssCasSample(uv, int2(-1,  1));
+    float3 h = DlssCasSample(uv, int2( 0,  1));
+    float3 i = DlssCasSample(uv, int2( 1,  1));
+
+    float3 mn = min(min(min(d, e), min(f, b)), h);
+    mn += min(mn, min(min(a, c), min(g, i)));
+    float3 mx = max(max(max(d, e), max(f, b)), h);
+    mx += max(mx, max(max(a, c), max(g, i)));
+    // Guard black neighborhoods against 0/0; sqrt avoids reciprocal infinity.
+    float3 amplitude = sqrt(saturate(min(mn, 2.0 - mx) / max(mx, 1e-6)));
+#ifdef DLSS_CAS_HDR
+    // The HDR curve exaggerates contrast compared with display values, which weakens
+    // CAS on fine detail. Estimated from the center pixel alone, so it fades out on
+    // edges, where a wrong estimate would add halos.
+    float3 contrast = saturate(mn / max(mx, 1e-6));
+    float level = max(max(original.r, max(original.g, original.b)), 0.0);
+    level /= 1.0 + DLSS_HDR_SLOPE * level;
+    float slope = 2.2 * (1.0 + sqrt(level)) / (1.0 + level / 16.0);
+    amplitude = lerp(amplitude, pow(contrast, 1.0 / (1.0 + slope)), contrast);
+#endif
+    float3 weight = -amplitude / 5.0;
+    float3 sharpened = saturate(((b + d + f + h) * weight + e) / (1.0 + 4.0 * weight));
+    float3 result = lerp(e, sharpened, strength);
+    return float4(min(result / max(1.0 - result, 1e-5), 65504.0), original.a);
+}
diff --git a/extras/dlss_gamma/gamedata/shaders/r3/dlss_contract.h b/extras/dlss_gamma/gamedata/shaders/r3/dlss_contract.h
new file mode 100644
index 000000000..2e59b41a4
--- /dev/null
+++ b/extras/dlss_gamma/gamedata/shaders/r3/dlss_contract.h
@@ -0,0 +1,12 @@
+#ifndef MONOLITH_DLSS_CONTRACT
+#define MONOLITH_DLSS_CONTRACT 1
+// Paired with the feat/dlss-sr renderer. Keep SSS vectors in their original
+// current-minus-previous UV convention; the engine supplies NGX's negative scale.
+uniform float4 dlss_params; // active, render width, render height, reserved
+uniform float4 dlss_temporal_jitter; // current raster UV offset, previous raster UV offset
+float2 dlss_history_offset()
+{
+    return dlss_params.x > 0.5f ? dlss_temporal_jitter.zw - dlss_temporal_jitter.xy : float2(0, 0);
+}
+float2 dlss_reproject(float2 uv) { return uv + dlss_history_offset(); }
+#endif
