diff --git a/src/xrEngine/RendererError.h b/src/xrEngine/RendererError.h
new file mode 100644
index 000000000..d9cf4e4ad
--- /dev/null
+++ b/src/xrEngine/RendererError.h
@@ -0,0 +1,9 @@
+#pragma once
+
+// Persistent, release-visible renderer failure. Pass nullptr to clear it after
+// recovery or after the user applies a setting that disables the failed feature.
+// The caller also logs the diagnostic; this does not depend on log callbacks.
+ENGINE_API void SetRendererError(const char* summary, const char* detail = nullptr,
+    const char* recovery = nullptr);
+
+ENGINE_API void SetFrameGenerationError(const char* summary);
diff --git a/src/xrEngine/Stats.cpp b/src/xrEngine/Stats.cpp
index dbdeb44ad..822556a0a 100644
--- a/src/xrEngine/Stats.cpp
+++ b/src/xrEngine/Stats.cpp
@@ -2,6 +2,9 @@
 #include "GameFont.h"
 #pragma hdrstop
 
+#include "RendererError.h"
+#include <atomic>
+
 #include "../xrcdb/ISpatial.h"
 #include "IGame_Persistent.h"
 #include "render.h"
@@ -12,6 +15,57 @@
 int g_ErrorLineCount = 15;
 Flags32 g_stats_flags = {0};
 
+namespace
+{
+xrCriticalSection rendererErrorGuard;
+std::atomic_bool hasRendererError{false};
+string512 rendererErrorLines[3] = {};
+string512 frameGenerationError = {};
+std::atomic_bool hasFrameGenerationError{false};
+
+void DrawRendererError(CGameFont* font)
+{
+    if (!font || !(hasRendererError.load() || hasFrameGenerationError.load())) return;
+    string512 lines[4];
+    {
+        xrCriticalSectionGuard guard(&rendererErrorGuard);
+        if (!(hasRendererError.load() || hasFrameGenerationError.load())) return;
+        memcpy(lines, rendererErrorLines, sizeof(rendererErrorLines));
+        memcpy(lines[3], frameGenerationError, sizeof(frameGenerationError));
+    }
+    const float oldHeight = font->GetHeight();
+    font->SetAligment(CGameFont::alLeft);
+    font->SetColor(color_rgba(255, 48, 48, 255));
+    for (unsigned i = 0; i < 4; ++i)
+    {
+        if (!lines[i][0]) continue;
+        font->SetHeightI(0.018f);
+        const float width = font->SizeOf_(lines[i]);
+        const float available = Device.dwWidth * 0.95f;
+        if (width > available) font->SetHeight(font->GetHeight() * available / width);
+        font->OutI(-0.95f, -0.90f + i * 0.045f, "%s", lines[i]);
+    }
+    font->OnRender();
+    font->SetHeight(oldHeight);
+}
+}
+
+void SetRendererError(const char* summary, const char* detail, const char* recovery)
+{
+    xrCriticalSectionGuard guard(&rendererErrorGuard);
+    const char* lines[] = {summary, detail, recovery};
+    for (unsigned i = 0; i < 3; ++i)
+        strncpy_s(rendererErrorLines[i], sizeof(rendererErrorLines[i]), lines[i] ? lines[i] : "", _TRUNCATE);
+    hasRendererError.store(summary && *summary);
+}
+
+void SetFrameGenerationError(const char* summary)
+{
+    xrCriticalSectionGuard guard(&rendererErrorGuard);
+    strncpy_s(frameGenerationError,sizeof(frameGenerationError),summary ? summary : "",_TRUNCATE);
+    hasFrameGenerationError.store(summary && *summary);
+}
+
 // stats
 DECLARE_RP(Stats);
 
