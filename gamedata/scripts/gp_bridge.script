function get_apply_to_rules_catalog()
    local out = {}
    for i = 1, #APPLY_TO_RULES_CATALOG do
        local r = APPLY_TO_RULES_CATALOG[i]
        out[i] = { id = r.id, rule = r.rule, script = r.script, desc = r.desc }
    end
    return out
end

function get_monkey_patch_chains_catalog()
    local out = {}
    for i = 1, #MONKEY_PATCH_CHAINS_CATALOG do
        local c = MONKEY_PATCH_CHAINS_CATALOG[i]
        local methods_copy = {}
        for j = 1, #c.methods do methods_copy[j] = c.methods[j] end
        local wrappers_copy = {}
        for j = 1, #c.wrappers do wrappers_copy[j] = c.wrappers[j] end
        out[i] = {
            id = c.id,
            chain_name = c.chain_name,
            target_class = c.target_class,
            methods = methods_copy,
            wrappers = wrappers_copy,
        }
    end
    return out
end

function get_no_apply_targets_toast_text()
    if game and type(game.translate_string) == "function" then
        local ok, tr = pcall(game.translate_string, "st_gp_no_apply_targets")
        if ok and type(tr) == "string" and tr ~= "" and tr ~= "st_gp_no_apply_targets" then
            return tr
        end
    end
    return TOAST_NO_APPLY_TARGETS_CP1251
end

function emit_bridge_toast(msg)
    local text = tostring(msg or get_no_apply_targets_toast_text())
    bridge_stats.last_toast_msg = text
    if _G.gp_toast and type(_G.gp_toast.show_toast) == "function" then
        pcall(_G.gp_toast.show_toast, text)
    elseif _G.game and type(_G.game.show_gamepad_toast) == "function" then
        pcall(_G.game.show_gamepad_toast, text)
    elseif _G.actor_menu and type(_G.actor_menu.set_msg) == "function" then
        pcall(_G.actor_menu.set_msg, 1, text, 3)
    end
    return text
end

function get_bag_edd_type(gui, bag_name)
    local b = tostring(bag_name or "actor_bag")
    if gui and type(gui.bag_id) == "table" and gui.bag_id[b] ~= nil then
        return gui.bag_id[b]
    end
    local edd = _G.EDDListType
    if type(edd) == "table" then
        if b == "actor_bag" or b == "actor_trade_bag" then
            return edd.iActorBag
        elseif b == "actor_equ" then
            return edd.iActorSlot
        elseif b == "actor_belt" then
            return edd.iActorBelt
        elseif b == "actor_trade" then
            return edd.iActorTrade
        elseif b == "npc_bag" then
            return edd.iDeadBodyBag
        elseif b == "npc_trade_bag" then
            -- F3.3 red-team R4: ui_inventory.script:209 maps npc_trade_bag -> EDDListType.iPartnerTradeBag
            return edd.iPartnerTradeBag or edd.iDeadBodyBag
        elseif b == "npc_trade" then
            return edd.iPartnerTrade
        elseif b == "actor_quick" then
            return edd.iQuickSlot
        end
    end
    -- Standard X-Ray EDDListType numeric fallbacks
    local fallback_map = {
        actor_trade = 1,
        actor_bag = 2,
        actor_slot = 3,
        actor_equ = 3,
        actor_belt = 4,
        actor_trade_bag = 2,
        npc_trade = 5,
        npc_bag = 6,
        npc_trade_bag = 6,
        actor_quick = 8,
    }
    return fallback_map[b] or 2
end

local MELTER_SKIP_SECTIONS = {
    af_surge = true, af_frames = true, af_grid = true, af_freon = true,
    af_cooler = true, af_kevlar = true, af_plates = true, af_camelbak = true,
    af_surge_up = true, af_frames_up = true, af_grid_up = true, af_freon_up = true,
    af_cooler_up = true, af_kevlar_up = true, af_plates_up = true, af_camelbak_up = true,
    hide_chimera = true, hide_pseudogiant = true, hide_psy_dog = true, hide_pseudodog = true,
    hide_burer = true, hide_controller = true, hide_bloodsucker = true, hide_psysucker = true,
    hide_lurker = true, hide_boar = true, hide_flesh = true,
}

local function is_artefact_item_readonly(obj, sec_opt)
    if _G.IsArtefact and type(_G.IsArtefact) == "function" then
        local ok, r = pcall(_G.IsArtefact, obj)
        if ok and r == true then return true end
    end
    local sec = sec_opt or (obj and type(obj.section) == "function" and obj:section()) or ""
    if sec == "" then return false end
    local cls = SYS_GetParam and SYS_GetParam(0, sec, "class", "") or ""
    if cls == "ARTEFACT" or cls == "SCRPTART" or cls == "SCRP_ART" then
        return true
    end
    local kind = SYS_GetParam and SYS_GetParam(0, sec, "kind", "") or ""
    return kind == "i_arty" or kind == "i_arty_junk" or kind == "i_arty_cont"
end

local function check_weapon_has_part_readonly(obj_wpn, part_sec)
    if not obj_wpn or not part_sec or part_sec == "" then
        return false
    end
    -- 1. Check already-saved parts in m_data without triggering evaluate_parts (evaluate = false)
    if _G.item_parts and type(_G.item_parts.get_parts_con) == "function" then
        local ok_p, saved_parts = pcall(_G.item_parts.get_parts_con, obj_wpn, nil, false)
        if ok_p and type(saved_parts) == "table" then
            return saved_parts[part_sec] ~= nil
        end
    end
    -- 2. Read-only LTX lookup in itms_manager.ini_parts ("con_parts_list")
    local wpn_sec = (type(obj_wpn.section) == "function") and obj_wpn:section() or ""
    if wpn_sec == "" then
        return false
    end
    local parent_sec = (ini_sys and type(ini_sys.r_string_ex) == "function" and ini_sys:r_string_ex(wpn_sec, "parent_section")) or wpn_sec
    local ini_parts = _G.itms_manager and _G.itms_manager.ini_parts
    if ini_parts and type(ini_parts.r_string_ex) == "function" then
        local list_str = ini_parts:r_string_ex("con_parts_list", parent_sec)
        if type(list_str) == "string" and list_str ~= "" then
            for token in string.gmatch(list_str, "([^,%s]+)") do
                if token == part_sec then
                    return true
                end
            end
        end
    end
    return false
end

local function is_thermal_powered_item_readonly(target_obj)
    if not target_obj or type(target_obj.section) ~= "function" then
        return false
    end
    local sec = target_obj:section()
    if sec == "wpn_gauss" or sec == "wpn_gauss_quest" then
        return false
    end
    if _G.z_3dss_thermal_battery and type(_G.z_3dss_thermal_battery.is_powered_target) == "function" then
        local ok, res = pcall(_G.z_3dss_thermal_battery.is_powered_target, target_obj)
        if ok and res == true then
            return true
        end
    end
    if ini_sys and type(ini_sys.r_float_ex) == "function" then
        local img_type = math.floor(tonumber(ini_sys:r_float_ex(sec, "s3ds_image_type")) or 0)
        if img_type == 2 or img_type == 3 then
            return true
        end
    end
    if ini_sys and type(ini_sys.r_bool_ex) == "function" and ini_sys:r_bool_ex(sec, "s3ds_fusion_outline", false) == true then
        return true
    end
    if _G.IsWeapon and _G.IsWeapon(target_obj) and _G.z_3d_scopes and type(_G.z_3d_scopes.parse_parameters) == "function" then
        local ok_z, info = pcall(_G.z_3d_scopes.parse_parameters, target_obj, 0)
        if ok_z and type(info) == "table" then
            local it = math.floor(tonumber(info.s3ds_image_type) or 0)
            if it == 2 or it == 3 or info.s3ds_fusion_outline == true then
                return true
            end
        end
    end
    return false
end

-- Pure read-only compatibility predicate for Contour 3 ("Apply To..." Step 1).
-- Categorically NEVER calls SendScriptCallback("ActorMenu_on_item_drag_drop", ...) or parts_match_item.
function check_pair_compatibility_readonly(obj_from, bag_from, obj_to, bag_to, gui_opt)
    if not obj_from or not obj_to then
        return false, nil
    end
    local ok_id1, id1 = pcall(obj_from.id, obj_from)
    local ok_id2, id2 = pcall(obj_to.id, obj_to)
    if not ok_id1 or not ok_id2 or id1 == id2 then
        return false, nil
    end
    local ok_s1, sec_1 = pcall(obj_from.section, obj_from)
    local ok_s2, sec_2 = pcall(obj_to.section, obj_to)
    if not ok_s1 or not ok_s2 or not sec_1 or not sec_2 then
        return false, nil
    end

    local gui = gui_opt or (ui_inventory and ui_inventory.GUI) or nil
    local b_from = tostring(bag_from or "actor_bag")
    local b_to = tostring(bag_to or "actor_bag")
    local edd = _G.EDDListType
    local iActorBag = (edd and edd.iActorBag) or 2
    local iActorSlot = (edd and edd.iActorSlot) or 3
    local slot_from = get_bag_edd_type(gui, b_from)
    local slot_to = get_bag_edd_type(gui, b_to)
    local from_bag_to_bag = (slot_from == iActorBag and slot_to == iActorBag)
    local from_bag_to_bag_or_slot = (slot_from == iActorBag and (slot_to == iActorBag or slot_to == iActorSlot))
    local active_mode = (gui and gui.mode) or "inventory"

    -- Rule 1: UIInventory:Cond_Attach (ui_inventory.script:1059-1083, 3461-3463)
    if (b_to == "actor_bag" or b_to == "actor_equ") and gui and type(gui.Cond_Attach) == "function" then
        local ok_att, can_att = pcall(gui.Cond_Attach, gui, obj_from, "actor_bag", nil, nil, obj_to)
        if ok_att and can_att == true then
            return true, "cond_attach"
        end
    end

    -- Rule 2: itms_manager (itms_manager.script:374-392) - Artefact container or item_combine
    if from_bag_to_bag and _G.itms_manager then
        local im = _G.itms_manager
        if type(im.itms_arty_container) == "table" and im.itms_arty_container[sec_2] then
            local cls = SYS_GetParam and SYS_GetParam(0, sec_1, "class", "") or ""
            if (cls == "ARTEFACT" or cls == "SCRPTART" or (_G.IsArtefact and _G.IsArtefact(obj_from)))
                and ini_sys and type(ini_sys.section_exist) == "function"
                and ini_sys:section_exist(sec_1 .. "_" .. sec_2)
            then
                return true, "itms_manager_combine"
            end
        end
        if type(im.item_combine) == "table" and type(im.item_combine[sec_1]) == "table" and im.item_combine[sec_1][sec_2] then
            return true, "itms_manager_combine"
        end
    end

    -- Rule 3: arti_jamming weapon part replacement (arti_jamming.script:808-821, 897-933)
    if _G.arti_jamming and type(_G.arti_jamming.is_part) == "function" and type(_G.arti_jamming.has_parts) == "function" then
        local ok_ip, is_p = pcall(_G.arti_jamming.is_part, sec_1)
        local ok_hp, has_p = pcall(_G.arti_jamming.has_parts, obj_to)
        if ok_ip and is_p and ok_hp and has_p then
            local ok_brl, is_brl = true, false
            if type(_G.arti_jamming.is_barrel) == "function" then
                ok_brl, is_brl = pcall(_G.arti_jamming.is_barrel, sec_1)
            end
            local w_cond = (type(obj_to.condition) == "function" and obj_to:condition()) or 1.0
            if (not ok_brl or not is_brl) and w_cond >= 0.2 and check_weapon_has_part_readonly(obj_to, sec_1) then
                return true, "arti_jamming_replace_part"
            end
        end
    end

    -- Rule 4: item_parts disassembly tool onto item (item_parts.script:647-659)
    if from_bag_to_bag and _G.IsItem and _G.IsItem("disassemble", sec_1) and _G.item_parts and type(_G.item_parts.menu_disassembly) == "function" then
        local ok_dis, menu_str = pcall(_G.item_parts.menu_disassembly, obj_to)
        if ok_dis and menu_str ~= nil and menu_str ~= false and menu_str ~= "" then
            return true, "item_parts_disassemble"
        end
    end

    -- Rule 5: item_exo_device battery / PSU onto exoskeleton (item_exo_device.script:274-296)
    if from_bag_to_bag_or_slot and active_mode ~= "trade" and _G.item_exo_device and type(_G.item_exo_device.is_exo) == "function" then
        local ok_exo, is_e = pcall(_G.item_exo_device.is_exo, obj_to)
        if ok_exo and is_e then
            local batt_sec = _G.item_exo_device.battery_sec or "batteries_exo"
            local is_psu = (SYS_GetParam and SYS_GetParam(1, sec_1, "is_psu", false) == true) or false
            if sec_1 == batt_sec or is_psu then
                return true, "item_exo_device_battery_psu"
            end
        end
    end

    -- Rule 6: item_device battery onto device (item_device.script:185-212)
    if from_bag_to_bag_or_slot and _G.item_device then
        local dev_batt = _G.item_device.device_battery or "batteries_dead"
        local dev_cons = _G.item_device.dev_consumption
        if sec_1 == dev_batt and type(dev_cons) == "table" and dev_cons[sec_2] ~= nil then
            local c_from = (type(obj_from.condition) == "function" and obj_from:condition()) or 1.0
            local c_to = (type(obj_to.condition) == "function" and obj_to:condition()) or 0.0
            if c_to <= c_from then
                return true, "item_device_battery"
            end
        end
    end

    -- Rule 7: z_3dss_thermal_battery (z_3dss_thermal_battery.script:969-1019)
    if from_bag_to_bag_or_slot then
        local tb_sec = (_G.z_3dss_thermal_battery and _G.z_3dss_thermal_battery.battery_section) or "batteries_dead"
        if sec_1 == tb_sec and is_thermal_powered_item_readonly(obj_to) then
            return true, "z_3dss_thermal_battery"
        elseif sec_2 == tb_sec and is_thermal_powered_item_readonly(obj_from) then
            return true, "z_3dss_thermal_battery"
        end
    end

    -- Rule 8: scripted_canted_irons (scripted_canted_irons.script:1281-1301)
    -- REWORK-7: is_supported_weapon / is_canted_irons / is_canted_rds are LOCAL (L857/980/967) ->
    -- taken from upvalues of the global on_item_drag_dropped; canted RDS also needs a free slot
    -- (global precond_install_rds_pos1..3, L1143-1145), same as the drag-drop handler.
    if from_bag_to_bag_or_slot and _G.scripted_canted_irons then
        local sci = _G.scripted_canted_irons
        local sup = sci_local(sci, "is_supported_weapon")
        if sup then
            local irons, rds = sci_local(sci, "is_canted_irons"), sci_local(sci, "is_canted_rds")
            local function rds_fits(item, wpn)
                for slot = 1, 3 do
                    local pre = sci["precond_install_rds_pos" .. slot]
                    if type(pre) ~= "function" or pre(item, wpn) then return true end
                end
                return false
            end
            local function is_canted_addon(o, w)
                if irons and irons(o) then return true end
                return (rds and rds(o) and rds_fits(o, w)) and true or false
            end
            local ok_1, m1 = pcall(function() return is_canted_addon(obj_from, obj_to) and sup(obj_to) end)
            local ok_2, m2 = pcall(function() return is_canted_addon(obj_to, obj_from) and sup(obj_from) end)
            if (ok_1 and m1) or (ok_2 and m2) then
                return true, "scripted_canted_irons"
            end
        end
    end

    -- Rule 9: magazines (magazines.script:219-277, 1128)
    if _G.magazines or _G.magazine_binder then
        local mb = _G.magazine_binder or _G.magazines
        local is_mag_fn = (mb and type(mb.is_magazine) == "function" and mb.is_magazine) or (_G.magazines and _G.magazines.is_magazine)
        local is_compat_fn = (mb and type(mb.is_compatible) == "function" and mb.is_compatible) or (_G.magazines and _G.magazines.is_compatible)
        local get_cal_fn = (mb and type(mb.get_magazine_caliber) == "function" and mb.get_magazine_caliber) or (_G.magazines and _G.magazines.get_magazine_caliber)
        -- 9a: Ammo onto magazine
        if _G.IsAmmo and _G.IsAmmo(obj_from) and is_mag_fn then
            local ok_m, is_m = pcall(is_mag_fn, obj_to)
            if ok_m and is_m then
                if get_cal_fn then
                    local ok_c, cal_tbl = pcall(get_cal_fn, obj_to)
                    if ok_c and type(cal_tbl) == "table" then
                        for _, cal_sec in pairs(cal_tbl) do
                            if cal_sec == sec_1 or _ == sec_1 then
                                return true, "magazines_drag_drop"
                            end
                        end
                    end
                else
                    return true, "magazines_drag_drop"
                end
            end
        end
        -- 9b: Magazine onto weapon
        if is_mag_fn and _G.IsWeapon and _G.IsWeapon(obj_to) then
            local ok_m, is_m = pcall(is_mag_fn, obj_from)
            if ok_m and is_m then
                local compat = true
                if is_compat_fn then
                    local ok_c, c_res = pcall(is_compat_fn, obj_to, obj_from)
                    compat = (ok_c and c_res == true)
                end
                local in_gl = (type(obj_to.weapon_in_grenade_mode) == "function" and obj_to:weapon_in_grenade_mode() == true) or false
                if compat and not in_gl then
                    return true, "magazines_drag_drop"
                end
            end
        end
        -- 9c: Ammo onto weapon (chamber single round)
        if _G.IsAmmo and _G.IsAmmo(obj_from) and _G.IsWeapon and _G.IsWeapon(obj_to) then
            if _G.magazines and type(_G.magazines.can_chamber_single_round) == "function" then
                local ok_ch, can_ch = pcall(_G.magazines.can_chamber_single_round, obj_from, obj_to)
                if ok_ch and can_ch == true then
                    return true, "magazines_drag_drop"
                end
            else
                local ammo_list = SYS_GetParam and SYS_GetParam(0, sec_2, "ammo_class", "") or ""
                if type(ammo_list) == "string" and ammo_list ~= "" then
                    for a_sec in string.gmatch(ammo_list, "([^,%s]+)") do
                        if a_sec == sec_1 then
                            return true, "magazines_drag_drop"
                        end
                    end
                end
            end
        end
    end

    -- Rule 10: speed_loaders (speed_loaders.script:157-177)
    if from_bag_to_bag_or_slot and _G.speed_loaders and type(_G.speed_loaders.is_speed_loader) == "function" then
        local sl = _G.speed_loaders
        local function check_sl_pair(ldr, wpn)
            if not sl.is_speed_loader(ldr) or not (_G.IsWeapon and _G.IsWeapon(wpn)) then
                return false
            end
            if type(sl.is_compatible_weapon) == "function" then
                return sl.is_compatible_weapon(ldr, wpn) == true
            end
            local use1 = SYS_GetParam and SYS_GetParam(0, ldr:section(), "use1_functor", "") or ""
            local fn_name = string.match(tostring(use1), "%.([%w_]+)$")
            if fn_name and type(sl[fn_name]) == "function" then
                local ok_p, res_p = pcall(sl[fn_name], wpn)
                return ok_p and res_p ~= nil and res_p ~= false
            end
            return false
        end
        local ok_sl1, r_sl1 = pcall(check_sl_pair, obj_from, obj_to)
        local ok_sl2, r_sl2 = pcall(check_sl_pair, obj_to, obj_from)
        if (ok_sl1 and r_sl1) or (ok_sl2 and r_sl2) then
            return true, "speed_loaders"
        end
    end

    -- Rule 11: mag_pouches (mag_pouches.script:93-102)
    if from_bag_to_bag_or_slot and _G.mag_pouches and type(_G.mag_pouches.is_pouch) == "function" and type(_G.mag_pouches.precond_install) == "function" then
        if _G.IsOutfit and _G.IsOutfit(obj_to) then
            local ok_mp, can_mp = pcall(function()
                return _G.mag_pouches.is_pouch(obj_from) and _G.mag_pouches.precond_install(obj_from, obj_to)
            end)
            if ok_mp and can_mp == true then
                return true, "mag_pouches"
            end
        end
    end

    -- Rule 12: item_weapon custom scope (item_weapon.script:980-1003)
    -- REWORK-6: item_weapon.check_scope is a local function (item_weapon.script:30), never exported;
    -- same check here: addon section in the weapon's "scopes" list (model-swap scopes of G.A.M.M.A.)
    local check_scope_fn = _G.item_weapon and type(_G.item_weapon.check_scope) == "function" and _G.item_weapon.check_scope or nil
    if not check_scope_fn and _G.item_weapon and type(_G.parse_list) == "function" and _G.ini_sys then
        check_scope_fn = function(addon_sect, weapon_sect)
            for _, v in pairs(_G.parse_list(_G.ini_sys, weapon_sect, "scopes") or {}) do
                if v == addon_sect then return true end
            end
            return false
        end
    end
    if from_bag_to_bag_or_slot and check_scope_fn and _G.IsWeapon and _G.IsWeapon(obj_to) then
        local ok_ws, can_ws = pcall(check_scope_fn, sec_1, sec_2)
        if ok_ws and can_ws == true then
            return true, "item_weapon_scope"
        end
    end

    -- Rule 13: perk_based_artefacts (perk_based_artefacts.script:3808-3850, 4696-4707)
    if from_bag_to_bag_or_slot and (_G.perk_based_artefacts or _G.bat_transmutate_func) then
        local function check_pba_pair(art_obj, target_obj)
            local a_sec = art_obj:section()
            local t_sec = target_obj:section()
            if a_sec == "af_sandstone" then
                if not (_G.IsWeapon and _G.IsWeapon(target_obj)) then return false end
                if (_G.IsMelee and _G.IsMelee(target_obj))
                    or (_G.IsItem and _G.IsItem("fake_ammo_wpn", t_sec))
                    or (_G.IsBinoc and _G.IsBinoc(t_sec))
                    or (_G.IsBolt and _G.IsBolt(target_obj))
                    or (_G.IsGrenade and _G.IsGrenade(target_obj))
                then
                    return false
                end
                return true
            elseif a_sec == "af_bat" and _G.bat_transmutate_func and type(_G.bat_transmutate_func.check_transmutate) == "function" then
                local ok_bt, can_bt = pcall(_G.bat_transmutate_func.check_transmutate, target_obj, nil, "inventory")
                return ok_bt and can_bt == true
            end
            return false
        end
        local ok_pba1, r_pba1 = pcall(check_pba_pair, obj_from, obj_to)
        local ok_pba2, r_pba2 = pcall(check_pba_pair, obj_to, obj_from)
        if (ok_pba1 and r_pba1) or (ok_pba2 and r_pba2) then
            return true, "perk_based_artefacts_drop"
        end
    end

    -- Rule 14: grok_artefacts_melter_charge (grok_artefacts_melter_charge.script:85-111)
    if from_bag_to_bag and sec_1 == "itm_artefactskit" and is_artefact_item_readonly(obj_to, sec_2) and not MELTER_SKIP_SECTIONS[sec_2] then
        local uses = (type(obj_from.get_remaining_uses) == "function" and obj_from:get_remaining_uses()) or 0
        if uses < 10 then
            return true, "grok_artefacts_melter_charge"
        end
    end

    -- Rule 15: placeable_furniture fuel refueling (placeable_furniture.script:884-906)
    if from_bag_to_bag_or_slot then
        local fuel_sec = (ini_sys and type(ini_sys.r_string_ex) == "function" and ini_sys:r_string_ex(sec_2, "fuel_section"))
            or (SYS_GetParam and SYS_GetParam(0, sec_2, "fuel_section", nil))
        if fuel_sec and fuel_sec == sec_1 then
            return true, "placeable_furniture_fuel"
        end
    end

    return false, nil
end

-- F3.3 red-team R2/R3: vanilla UIInventory:On_CC_DragDrop (ui_inventory.script:3389-3392) only ever takes
-- obj_from/obj_to from displayed containers (self.CC[bag]:GetObj), and a drop onto the belt container goes to the
-- "Ruck to Belt" branch (ui_inventory.script:3438-3439), never to Action_Attach / ActorMenu_on_item_drag_drop.
-- So an item takes part in "Apply To..." only if it really sits in the bag it is labelled with:
--   actor_bag / actor_trade_bag -> parent is the actor, not on belt, not in a slot;
--   actor_equ  -> parent is the actor and it is in one of slots 1..13;
--   actor_belt -> parent is the actor and it is on the belt (allowed only as a SOURCE, see callers);
--   npc_bag / npc_trade / npc_trade_bag -> parent is the current partner/box (gui.npc_id).
local function collect_actor_slot_id_set()
    local slot_ids = {}
    if db and db.actor and type(db.actor.item_in_slot) == "function" then
        for s = 1, 13 do
            local eq = db.actor:item_in_slot(s)
            if eq and type(eq.id) == "function" then
                local ok_id, eq_id = pcall(eq.id, eq)
                if ok_id and eq_id ~= nil then
                    slot_ids[eq_id] = true
                end
            end
        end
    end
    return slot_ids
end

function is_item_in_bag_for_apply(gui, obj, bag_name, slot_ids_opt, actor_id_opt)
    if not obj or type(obj.parent) ~= "function" or not db or not db.actor then
        return false
    end
    local ok_p, p = pcall(obj.parent, obj)
    if not ok_p or not p or type(p.id) ~= "function" then
        return false
    end
    local pid = p:id()
    local b = tostring(bag_name or "actor_bag")
    if string.find(b, "^npc_") then
        return (gui ~= nil) and (gui.npc_id ~= nil) and (pid == gui.npc_id)
    end
    local aid = actor_id_opt or db.actor:id()
    if pid ~= aid then
        return false
    end
    local on_belt = false
    if type(db.actor.is_on_belt) == "function" then
        local ok_b, r = pcall(db.actor.is_on_belt, db.actor, obj)
        on_belt = (ok_b and r) and true or false
    end
    if b == "actor_belt" then
        return on_belt
    end
    if on_belt then
        return false
    end
    local in_slot = false
    local oid = obj:id()
    if type(slot_ids_opt) == "table" then
        in_slot = (slot_ids_opt[oid] == true)
    elseif type(db.actor.item_in_slot) == "function" then
        for s = 1, 13 do
            local eq = db.actor:item_in_slot(s)
            if eq and eq:id() == oid then
                in_slot = true
                break
            end
        end
    end
    if b == "actor_equ" then
        return in_slot
    end
    if b == "actor_bag" or b == "actor_trade_bag" then
        return not in_slot
    end
    return false
end

local function collect_candidate_items_for_apply(gui, candidate_items_opt)
    if type(candidate_items_opt) == "table" then
        local list = {}
        for i = 1, #candidate_items_opt do
            local entry = candidate_items_opt[i]
            if type(entry) == "table" and entry.obj then
                table.insert(list, { obj = entry.obj, bag = tostring(entry.bag or "actor_bag") })
            else
                local o = resolve_item_object(entry)
                if o then
                    table.insert(list, { obj = o, bag = "actor_bag" })
                end
            end
        end
        return list
    end

    local seen_ids = {}
    local list = {}
    local function add_cand(obj, bag_name)
        if not obj or type(obj.id) ~= "function" then
            return
        end
        local ok_id, id = pcall(obj.id, obj)
        if not ok_id or type(id) ~= "number" or seen_ids[id] then
            return
        end
        seen_ids[id] = true
        table.insert(list, { obj = obj, bag = bag_name })
    end

    -- 1. Equipped slots (1..13) as "actor_equ"
    if db and db.actor and type(db.actor.item_in_slot) == "function" then
        for s = 1, 13 do
            local eq = db.actor:item_in_slot(s)
            if eq then
                add_cand(eq, "actor_equ")
            end
        end
    end

    -- 2. Actor inventory items as "actor_bag"
    if db and db.actor and type(db.actor.iterate_inventory) == "function" then
        db.actor:iterate_inventory(function(_, itm)
            add_cand(itm, "actor_bag")
        end, db.actor)
    end

    -- 3. Any additional items present in gui.CC["actor_equ"] or gui.CC["actor_bag"]
    if gui and type(gui.CC) == "table" then
        for _, b_name in ipairs({ "actor_equ", "actor_bag" }) do
            local cc = gui.CC[b_name]
            if cc and type(cc.cell) == "table" then
                for idx, ci in pairs(cc.cell) do
                    if ci and ci.ID and not seen_ids[ci.ID] and type(cc.GetObj) == "function" then
                        local ok_o, cell_obj = pcall(cc.GetObj, cc, idx)
                        if ok_o and cell_obj then
                            add_cand(cell_obj, b_name)
                        end
                    end
                end
            end
        end
    end

    return list
end

-- Step 1 of Contour 3 (D52, D54): Read-Only Preview for "Apply To...".
-- Returns ONLY compatible targets. If 0 targets are compatible, does NOT open an empty list
-- and immediately emits toast "Ne k chemu primenit (CP1251)".
function preview_apply_to_targets(item_from_or_ref, bag_from, candidate_items_opt)
    local obj_from, id_from, err = resolve_item_object(item_from_or_ref)
    if not obj_from then
        return nil, err
    end

    local gui = ensure_gui()
    local b_from = tostring(bag_from or "actor_bag")
    -- F3.3 red-team R2: no drag-drop at all in trade mode (ui_inventory.script:3395)
    if gui and gui.mode == "trade" then
        return nil, "err:trade_mode"
    end
    local actor_id = db and db.actor and type(db.actor.id) == "function" and db.actor:id() or nil
    local slot_ids = collect_actor_slot_id_set()
    if not is_item_in_bag_for_apply(gui, obj_from, b_from, slot_ids, actor_id) then
        return nil, "err:source_not_in_bag:" .. tostring(b_from)
    end
    local candidates = collect_candidate_items_for_apply(gui, candidate_items_opt)
    local compatible = {}

    bridge_stats.apply_to_previews = (bridge_stats.apply_to_previews or 0) + 1

    for i = 1, #candidates do
        local cand = candidates[i]
        local obj_to = cand.obj
        local b_to = cand.bag or "actor_bag"
        -- F3.3 red-team R3: belt is never a drop target for item-on-item; target must really be in its bag
        if obj_to and obj_to:id() ~= id_from and b_to ~= "actor_belt" and is_item_in_bag_for_apply(gui, obj_to, b_to, slot_ids, actor_id) then
            local is_ok, rule_name = check_pair_compatibility_readonly(obj_from, b_from, obj_to, b_to, gui)
            if is_ok then
                local id_to = obj_to:id()
                local sec_to = obj_to:section()
                table.insert(compatible, {
                    item_id = id_to,
                    stable_id = make_stable_item_id(id_to),
                    section = sec_to,
                    bag = b_to,
                    slot_to = get_bag_edd_type(gui, b_to),
                    rule = rule_name,
                    source_item_id = id_from,
                    source_stable_id = make_stable_item_id(id_from),
                    source_bag = b_from,
                    slot_from = get_bag_edd_type(gui, b_from),
                })
            end
        end
    end

    if #compatible == 0 then
        bridge_stats.apply_to_empty_toasts = (bridge_stats.apply_to_empty_toasts or 0) + 1
        local toast_txt = emit_bridge_toast(get_no_apply_targets_toast_text())
        return compatible, "empty:toast=" .. tostring(toast_txt)
    end

    return compatible, "ok:targets=" .. tostring(#compatible)
end

-- Step 2 of Contour 3 (D52, D54): Single Confirmation of "Apply To..." on the chosen target.
-- Validates both StableItemIDs, resolves exact EDDListType via gui.bag_id, and executes
-- either gui:Action_Attach or SendScriptCallback("ActorMenu_on_item_drag_drop", obj_from, obj_to, slot_from, slot_to) + gui:On_Item_Update()
-- exactly matching UIInventory:On_CC_DragDrop (ui_inventory.script:3460-3498).
function confirm_apply_to(item_from_or_ref, bag_from, item_to_or_entry, bag_to)
    local target_ref = item_to_or_entry
    local b_from = tostring(bag_from or "actor_bag")
    local b_to = tostring(bag_to or "actor_bag")

    if type(item_to_or_entry) == "table" and item_to_or_entry.item_id ~= nil and item_to_or_entry.rule ~= nil then
        if type(item_to_or_entry.stable_id) == "table" and not validate_stable_item_id(item_to_or_entry.stable_id) then
            return false, "err:stale_stable_item_id"
        end
        if type(item_to_or_entry.source_stable_id) == "table" and not validate_stable_item_id(item_to_or_entry.source_stable_id) then
            return false, "err:stale_stable_item_id"
        end
        target_ref = item_to_or_entry.stable_id or item_to_or_entry.item_id
        if not bag_to and item_to_or_entry.bag then
            b_to = tostring(item_to_or_entry.bag)
        end
        if not bag_from and item_to_or_entry.source_bag then
            b_from = tostring(item_to_or_entry.source_bag)
        end
    end

    local obj_from, id_from, err_from = resolve_item_object(item_from_or_ref)
    if not obj_from then
        return false, err_from
    end

    local obj_to, id_to, err_to = resolve_item_object(target_ref)
    if not obj_to then
        return false, err_to
    end

    if type(item_to_or_entry) == "table" and item_to_or_entry.source_item_id ~= nil and tonumber(item_to_or_entry.source_item_id) ~= id_from then
        return false, "err:source_item_mismatch"
    end

    -- F4.1: block confirm_apply_to if either source or target item is locked in a Pending Category B transaction
    if txn_is_item_locked and (txn_is_item_locked(item_from_or_ref) or txn_is_item_locked(target_ref)) then
        return false, "err:txn_locked_pending"
    end

    local gui, gui_state = ensure_gui()
    if not gui then
        return false, tostring(gui_state)
    end

    -- F3.3 red-team R2/R3: same gates as vanilla On_CC_DragDrop (ui_inventory.script:3390-3395, 3438-3439)
    if gui.mode == "trade" then
        return false, "err:trade_mode"
    end
    if not is_item_in_bag_for_apply(gui, obj_from, b_from) then
        return false, "err:source_not_in_bag:" .. tostring(b_from)
    end
    if b_to == "actor_belt" or not is_item_in_bag_for_apply(gui, obj_to, b_to) then
        return false, "err:target_not_in_bag:" .. tostring(b_to)
    end

    local is_ok, rule_name = check_pair_compatibility_readonly(obj_from, b_from, obj_to, b_to, gui)
    if not is_ok then
        return false, "err:incompatible_pair:" .. tostring(obj_from:section()) .. "->" .. tostring(obj_to:section())
    end

    local slot_from = get_bag_edd_type(gui, b_from)
    local slot_to = get_bag_edd_type(gui, b_to)

    -- Exact UIInventory:On_CC_DragDrop execution path (ui_inventory.script:3461-3498)
    local used_attach = false
    if rule_name ~= "scripted_canted_irons" and (b_to == "actor_bag" or b_to == "actor_equ")
        and type(gui.Cond_Attach) == "function"
        and type(gui.Action_Attach) == "function"
        and gui:Cond_Attach(obj_from, "actor_bag", nil, nil, obj_to)
    then
        gui:Action_Attach(obj_from, "actor_bag", nil, nil, obj_to)
        used_attach = true
    else
        if SendScriptCallback then
            SendScriptCallback("ActorMenu_on_item_drag_drop", obj_from, obj_to, slot_from, slot_to)
        end
    end

    if type(gui.On_Item_Update) == "function" then
        gui:On_Item_Update()
    end

    bridge_stats.calls = bridge_stats.calls + 1
    bridge_stats.apply_to_confirms = (bridge_stats.apply_to_confirms or 0) + 1
    bridge_stats.last_op = "confirm_apply_to:" .. tostring(rule_name)
    bridge_stats.last_item_id = id_from
    bridge_stats.last_section = obj_from:section()

    return true, string.format(
        "ok:confirmed=%s;method=%s;from=%d;to=%d;slot_from=%d;slot_to=%d",
        tostring(rule_name),
        used_attach and "Action_Attach" or "ActorMenu_on_item_drag_drop",
        id_from,
        id_to,
        tonumber(slot_from) or 0,
        tonumber(slot_to) or 0
    )
end

-- Contour 4: Self-test & verification of Contours 3-4 + Fixes C5.1-N1 and C5.1-N3
function selftest_contours_3_4(mode_arg)
    -- 1. Verify C5.1-N3 (D48): ensure_gui() MUST NOT mutate gui.mode when nil
    local saved_ui_inv = _G.ui_inventory
    local raw_created_gui = nil
    _G.ui_inventory = {
        GUI = nil,
        UIInventory = function()
            raw_created_gui = {
                mode = nil,
                custom_functor = { [1] = true },
            }
            return raw_created_gui
        end,
    }
    local g_n3, st_n3 = ensure_gui()
    local n3_ok = rawequal(g_n3, raw_created_gui) and (st_n3 == "created") and (g_n3.mode == nil)
    _G.ui_inventory = saved_ui_inv

    local gui, gui_state = ensure_gui()
    if not gui then
        return string.format("err:selftest_3_4_no_gui:%s", tostring(gui_state)), nil
    end

    -- 2. Verify C5.1-N1 (D48): execute_focus_test_op with unopened inventory syncs slots via UpdateSlots/UpdateBelt
    -- and calls wrapped gui:Action_Equip(obj, "actor_bag"), NEVER raw db.actor:move_to_slot bypass.
    local orig_obj_by_id = level and level.object_by_id
    local orig_check_item = gui.CheckItem
    local orig_update_slots = gui.UpdateSlots
    local orig_update_belt = gui.UpdateBelt
    local orig_action_equip = gui.Action_Equip
    local orig_cc = gui.CC
    local orig_mode = gui.mode

    local n1_slots_synced = 0
    local n1_belt_synced = 0
    local n1_equip_called = 0
    local n1_equip_bag = nil
    local n1_Item = {
        _id = 65531,
        _section = "wpn_ak74_n1_test",
        id = selftest_mock_item_id,
        section = selftest_mock_item_section,
        name = selftest_mock_item_name,
    }

    if level then
        level.object_by_id = function(qid)
            if qid == 65531 then return n1_Item end
            return orig_obj_by_id and orig_obj_by_id(qid) or nil
        end
    end
    gui.CheckItem = function(self_g, itm, msg)
        if rawequal(itm, n1_Item) or rawequal(itm, 65531) then return n1_Item end
        return orig_check_item and orig_check_item(self_g, itm, msg) or itm
    end
    gui.CC = {
        actor_equ = {
            cell = {
                { IsShown = function() return n1_slots_synced > 0 end },
            },
        },
    }
    gui.UpdateSlots = function(self_g)
        n1_slots_synced = n1_slots_synced + 1
    end
    gui.UpdateBelt = function(self_g)
        n1_belt_synced = n1_belt_synced + 1
    end
    gui.Action_Equip = function(self_g, obj_arg, bag_arg)
        n1_equip_called = n1_equip_called + 1
        n1_equip_bag = bag_arg
    end
    gui.mode = nil

    local n1_res = execute_focus_test_op(65531, "wpn_ak74_n1_test", "to_slot", 3)
    local n1_ok = (n1_slots_synced == 1)
        and (n1_belt_synced == 1)
        and (n1_equip_called == 1)
        and (n1_equip_bag == "actor_bag")
        and (gui.mode == nil)
        and (string.find(tostring(n1_res), "^ok:method=Action_Equip;") ~= nil)

    gui.CheckItem = orig_check_item
    gui.UpdateSlots = orig_update_slots
    gui.UpdateBelt = orig_update_belt
    gui.Action_Equip = orig_action_equip
    gui.CC = orig_cc
    gui.mode = orig_mode
    if level then
        level.object_by_id = orig_obj_by_id
    end

    -- 3. Verify Contour 3 (D52, D54): Read-Only Preview + Empty Toast + Confirm EDDListType &Zero trial callbacks
    local orig_send_cb = _G.SendScriptCallback
    local orig_cond_attach = gui.Cond_Attach
    local orig_action_attach = gui.Action_Attach
    local orig_item_update = gui.On_Item_Update
    local orig_bag_id = gui.bag_id

    local drag_drop_cb_count = 0
    local last_dd_args = nil
    local parts_match_mutated = 0
    local attach_called = 0

    _G.SendScriptCallback = function(cb_name, a1, a2, a3, a4, ...)
        if cb_name == "ActorMenu_on_item_drag_drop" then
            drag_drop_cb_count = drag_drop_cb_count + 1
            last_dd_args = { from = a1, to = a2, slot_from = a3, slot_to = a4 }
            return
        end
        if orig_send_cb then
            return orig_send_cb(cb_name, a1, a2, a3, a4, ...)
        end
    end

    local src_scope = { _id = 65532, _section = "wpn_addon_scope", id = selftest_mock_item_id, section = selftest_mock_item_section, name = selftest_mock_item_name }
    local tgt_rifle = { _id = 65533, _section = "wpn_ak74", id = selftest_mock_item_id, section = selftest_mock_item_section, name = selftest_mock_item_name }
    local tgt_medkit = { _id = 65534, _section = "medkit", id = selftest_mock_item_id, section = selftest_mock_item_section, name = selftest_mock_item_name }

    if level then
        level.object_by_id = function(qid)
            if qid == 65532 then return src_scope end
            if qid == 65533 then return tgt_rifle end
            if qid == 65534 then return tgt_medkit end
            return orig_obj_by_id and orig_obj_by_id(qid) or nil
        end
    end

    gui.bag_id = { actor_bag = 2, actor_equ = 3, actor_belt = 4 }
    gui.Cond_Attach = function(self_g, o_from, b_from, _, __, o_to)
        return (rawequal(o_from, src_scope) and rawequal(o_to, tgt_rifle))
    end
    gui.Action_Attach = function(self_g, o_from, b_from, _, __, o_to)
        attach_called = attach_called + 1
    end
    gui.On_Item_Update = function() end
    -- Mock items are not in the real actor inventory: stub the F3.3 ownership gate for the duration of the selftest
    local orig_in_bag_gate = is_item_in_bag_for_apply
    is_item_in_bag_for_apply = function(_, _, b) return tostring(b) ~= "actor_belt" end
    local orig_gui_mode_c3 = gui.mode
    gui.mode = "inventory"

    -- 3a: Preview with 1 compatible (tgt_rifle in actor_equ) and 1 incompatible (tgt_medkit in actor_bag)
    local cands = {
        { obj = tgt_rifle, bag = "actor_equ" },
        { obj = tgt_medkit, bag = "actor_bag" },
    }
    local prev_targets, prev_status = preview_apply_to_targets(src_scope, "actor_bag", cands)
    local preview_ok = (type(prev_targets) == "table")
        and (#prev_targets == 1)
        and (prev_targets[1].item_id == 65533)
        and (prev_targets[1].rule == "cond_attach")
        and (prev_targets[1].slot_from == 2)
        and (prev_targets[1].slot_to == 3)
        and (drag_drop_cb_count == 0)
        and (parts_match_mutated == 0)
        and (prev_status == "ok:targets=1")

    -- 3b: Preview with 0 compatible targets -> must NOT open empty list and MUST emit toast "Ne k chemu primenit (CP1251)"
    local empty_targets, empty_status = preview_apply_to_targets(tgt_medkit, "actor_bag", { { obj = src_scope, bag = "actor_bag" } })
    local empty_toast_ok = (type(empty_targets) == "table")
        and (#empty_targets == 0)
        and (drag_drop_cb_count == 0)
        and (string.find(tostring(empty_status), "^empty:toast=") ~= nil)
        and (bridge_stats.last_toast_msg == get_no_apply_targets_toast_text())

    -- 3c: Confirm attach action -> calls gui:Action_Attach once
    local conf_att_ok, conf_att_msg = confirm_apply_to(src_scope, "actor_bag", prev_targets[1], "actor_equ")
    local confirm_attach_pass = (conf_att_ok == true)
        and (attach_called == 1)
        and (drag_drop_cb_count == 0)
        and (string.find(tostring(conf_att_msg), "method=Action_Attach") ~= nil)

    -- 3d: Confirm callback pair action (itms_manager_combine) -> calls SendScriptCallback("ActorMenu_on_item_drag_drop", ...) once with exact EDDListType
    local saved_im = _G.itms_manager
    _G.itms_manager = { item_combine = { ["medkit"] = { ["wpn_ak74"] = true } } }
    local prev_cb_targets = preview_apply_to_targets(tgt_medkit, "actor_bag", { { obj = tgt_rifle, bag = "actor_bag" } })
    local cb_preview_zero_calls = (drag_drop_cb_count == 0) and (#prev_cb_targets == 1) and (prev_cb_targets[1].rule == "itms_manager_combine")
    local conf_cb_ok, conf_cb_msg = confirm_apply_to(tgt_medkit, "actor_bag", prev_cb_targets[1], "actor_bag")
    local confirm_cb_pass = cb_preview_zero_calls
        and (conf_cb_ok == true)
        and (drag_drop_cb_count == 1)
        and (last_dd_args ~= nil and rawequal(last_dd_args.from, tgt_medkit) and rawequal(last_dd_args.to, tgt_rifle) and last_dd_args.slot_from == 2 and last_dd_args.slot_to == 2)
        and (string.find(tostring(conf_cb_msg), "method=ActorMenu_on_item_drag_drop") ~= nil)
    _G.itms_manager = saved_im

    -- 3e (F3.3): trade mode blocks "Apply To..." exactly like ui_inventory.script:3395; belt is never a target
    gui.mode = "trade"
    local tr_prev, tr_prev_st = preview_apply_to_targets(src_scope, "actor_bag", cands)
    local tr_conf_ok, tr_conf_st = confirm_apply_to(src_scope, "actor_bag", tgt_rifle, "actor_equ")
    gui.mode = "inventory"
    local belt_conf_ok, belt_conf_st = confirm_apply_to(src_scope, "actor_bag", tgt_rifle, "actor_belt")
    local gates_pass = (tr_prev == nil) and (tr_prev_st == "err:trade_mode")
        and (tr_conf_ok == false) and (tr_conf_st == "err:trade_mode")
        and (belt_conf_ok == false) and (string.find(tostring(belt_conf_st), "^err:target_not_in_bag:") ~= nil)
        and (attach_called == 1) and (drag_drop_cb_count == 1)
    confirm_cb_pass = confirm_cb_pass and gates_pass
    is_item_in_bag_for_apply = orig_in_bag_gate
    gui.mode = orig_gui_mode_c3

    _G.SendScriptCallback = orig_send_cb
    gui.Cond_Attach = orig_cond_attach
    gui.Action_Attach = orig_action_attach
    gui.On_Item_Update = orig_item_update
    gui.bag_id = orig_bag_id
    if level then
        level.object_by_id = orig_obj_by_id
    end

    local contour3_ok = preview_ok and empty_toast_ok and confirm_attach_pass and confirm_cb_pass

    -- 4. Verify Contour 4: All 7 monkey-patch chains on UIInventory & UIWorkshopCraft
    local chains = get_monkey_patch_chains_catalog()
    local chains_verified = 0
    for i = 1, #chains do
        local ch = chains[i]
        local ch_ok = false
        if ch.id == 1 then
            ch_ok = (type(gui.Name_Custom) == "function") and (type(gui.Action_Custom) == "function")
        elseif ch.id == 2 then
            ch_ok = (type(gui.Action_Equip) == "function") and (type(gui.Action_UnEquip) == "function")
        elseif ch.id == 3 then
            ch_ok = (type(gui.Action_Move) == "function") or (type(gui.Action_Move_All) == "function") or (type(gui.CheckItem) == "function")
        elseif ch.id == 4 then
            ch_ok = (type(gui.On_Item_Update) == "function") or (type(gui.UpdateWeight) == "function") or (type(gui.UpdateSlots) == "function")
        elseif ch.id == 5 then
            ch_ok = (type(gui.On_CC_Mouse1) == "function") or (type(gui.On_CC_Mouse2) == "function") or (type(gui.CheckItem) == "function")
        elseif ch.id == 6 then
            ch_ok = (type(gui.On_CC_DragDrop) == "function") or (type(gui.Cond_Attach) == "function") or (type(gui.CheckItem) == "function")
        elseif ch.id == 7 then
            local ws_ok = (_G.ui_workshop == nil)
                or (_G.ui_workshop.UIWorkshopCraft == nil)
                or (type(_G.ui_workshop.UIWorkshopCraft.ListRecipes) == "function" and type(_G.ui_workshop.UIWorkshopCraft.LoadRecipes) == "function")
            ch_ok = ws_ok and ((type(gui.RMode_UpgradeYes) == "function") or (type(gui.CheckItem) == "function"))
        end
        ch.verified = ch_ok
        if ch_ok then
            chains_verified = chains_verified + 1
        end
    end

    local rules_cat = get_apply_to_rules_catalog()
    local summary = string.format(
        "ok:selftest=%s;n1_headless_equip=%s;n3_no_mode_mutate=%s;c3_preview_readonly=%s;c3_empty_toast=%s;c3_confirm=%s;c3_rules=%d/15;c4_chains=%d/7",
        tostring(mode_arg or "3-4"),
        n1_ok and "pass" or "fail",
        n3_ok and "pass" or "fail",
        preview_ok and "pass" or "fail",
        empty_toast_ok and "pass" or "fail",
        (confirm_attach_pass and confirm_cb_pass) and "pass" or "fail",
        #rules_cat,
        chains_verified
    )

    local report = {
        summary = summary,
        n1_ok = n1_ok,
        n3_ok = n3_ok,
        contour3_ok = contour3_ok,
        preview_ok = preview_ok,
        empty_toast_ok = empty_toast_ok,
        confirm_attach_pass = confirm_attach_pass,
        confirm_cb_pass = confirm_cb_pass,
        rules_count = #rules_cat,
        chains_verified = chains_verified,
        chains = chains,
    }

    if printf then
        pcall(printf, "* [Gamepad] gp_bridge_selftest 3-4: %s", summary)
    end

    return summary, report
end

-- ============================================================================
-- F2.1: Read-Only Base Widgets Data & Accurate Defense Values Reader
-- Strictly read-only: never mutates inventory, slots, belt, or actor health.
-- ============================================================================

local WIDGET_CATEGORY_MAP = {
    w_rifle     = "weapons",
    w_pistol    = "weapons",
    w_shotgun   = "weapons",
    w_sniper    = "weapons",
    w_smg       = "weapons",
    w_melee     = "weapons",
    w_explosive = "weapons",
    w_misc      = "weapons",
    w_ammo      = "ammo",
    i_medical   = "meds",
    i_food      = "food",
    i_drink     = "food",
    o_light     = "armor_af",
    o_medium    = "armor_af",
    o_heavy     = "armor_af",
    o_sci       = "armor_af",
    o_helmet    = "armor_af",
    i_arty      = "armor_af",
    i_arty_junk = "armor_af",
    i_arty_cont = "armor_af",
    i_Attach    = "tools_parts",
    i_tool      = "tools_parts",
    i_repair    = "tools_parts",
    i_part      = "tools_parts",
    i_upgrade   = "tools_parts",
    i_kit       = "tools_parts",
}

function classify_item_widget_category(sec, obj)
    if not sec or sec == "" then
        return "misc"
    end
    local kind = SYS_GetParam and SYS_GetParam(0, sec, "kind", "") or ""
    if kind and WIDGET_CATEGORY_MAP[kind] then
        return WIDGET_CATEGORY_MAP[kind]
    end
    if obj then
        if IsWeapon and IsWeapon(obj) then return "weapons" end
        if IsAmmo and IsAmmo(obj) then return "ammo" end
        if (IsOutfit and IsOutfit(obj)) or (IsHeadgear and IsHeadgear(obj)) or (IsArtefact and IsArtefact(obj)) then
            return "armor_af"
        end
    end
    return "misc"
end

function detect_item_stats_group(sec, obj)
    if not sec or sec == "" then
        return "misc"
    end
    if obj then
        if IsOutfit and IsOutfit(obj) then return "outfit" end
        if IsHeadgear and IsHeadgear(obj) then return "helmet" end
        if IsArtefact and IsArtefact(obj) then return "artefact" end
        if IsWeapon and IsWeapon(obj) then return "weapon" end
    end
    local kind = SYS_GetParam and SYS_GetParam(0, sec, "kind", "") or ""
    if kind == "o_helmet" then return "helmet" end
    if kind == "o_light" or kind == "o_medium" or kind == "o_heavy" or kind == "o_sci" then return "outfit" end
    if kind == "i_arty" or kind == "i_arty_junk" or kind == "i_arty_cont" then return "artefact" end
    if string.sub(kind, 1, 2) == "w_" and kind ~= "w_ammo" then return "weapon" end
    if kind == "i_medical" or kind == "i_food" or kind == "i_drink" then return "booster" end
    if kind == "i_backpack" then return "backpack" end
    return "misc"
end

local ADB_SAVED_KEYS = {
    "total_prot", "headshot", "elemental", "psy", "adjuster",
    "premitigation", "limiter", "hit_type", "immunity", "protection",
    "booster_type_def", "arti_adjuster", "cap_stat", "defense", "no_pen",
}

local function snapshot_adb_globals(adb)
    if type(adb) ~= "table" then return nil end
    local snap = {}
    for i = 1, #ADB_SAVED_KEYS do
        local k = ADB_SAVED_KEYS[i]
        snap[k] = adb[k]
    end
    return snap
end

local function restore_adb_globals(adb, snap)
    if type(adb) ~= "table" or type(snap) ~= "table" then return end
    for i = 1, #ADB_SAVED_KEYS do
        local k = ADB_SAVED_KEYS[i]
        adb[k] = snap[k]
    end
end

local function make_readonly_probe_hit(hit_type_id, bone_name, bone_id)
    local h = nil
    if type(_G.hit) == "function" then
        local ok, inst = pcall(_G.hit)
        if ok and inst then
            h = inst
        end
    end
    if not h then
        h = {}
    end
    h.type = hit_type_id or 0
    h.power = 0.05
    h.impulse = 1
    h.draftsman = db and db.actor or nil
    h.bone = bone_name or "bip01_spine"
    h.bone_id = bone_id or 13
    return h
end

function read_accurate_defense_values(item_ref, full_stats_flag)
    local obj = nil
    local item_id = nil
    if item_ref ~= nil then
        local resolved_obj, resolved_id, err = resolve_item_object(item_ref)
        if not resolved_obj then
            return nil, err
        end
        obj = resolved_obj
        item_id = resolved_id
    end

    local adb = _G.grok_actor_damage_balancer
    local bsb = _G.zz_ui_inventory_better_stats_bars
    local saved_full_stats = bsb and bsb.show_full_stats or nil
    if bsb and full_stats_flag ~= nil then
        bsb.show_full_stats = (full_stats_flag == true)
    end
    local adb_snap = snapshot_adb_globals(adb)

    local result = {
        read_only = true,
        full_stats = (full_stats_flag == true),
        item_id = item_id,
        section = obj and obj:section() or nil,
        condition = (obj and type(obj.condition) == "function") and obj:condition() or 1.0,
        group = obj and detect_item_stats_group(obj:section(), obj) or "actor",
        item_adv = {},
        actor_adv = {
            body_br_class = 0,
            body_premitigation_pct = 0,
            body_fire_wound = 0,
            body_wound = 0,
            body_explosion = 0,
            body_strike = 0,
            body_burn = 0,
            body_shock = 0,
            body_acid = 0,
            body_psi = 0,
            body_radia = 0,
            head_br_class = 0,
            head_premitigation_pct = 0,
            head_fire_wound = 0,
            head_psi = 0,
        },
    }

    -- 1. Read per-item Accurate Defense Values via grok_actor_damage_balancer read-only functors
    if obj and type(adb) == "table" then
        local sec = result.section
        local gr = result.group
        if (gr == "outfit" or gr == "helmet") and type(adb.get_outfit_value) == "function" then
            local outfit_stats = {
                "fire_wound_protection",
                "burn_protection",
                "shock_protection",
                "chemical_burn_protection",
                "radiation_protection",
                "telepatic_protection",
                "wound_protection",
                "strike_protection",
                "explosion_protection",
            }
            for i = 1, #outfit_stats do
                local st_name = outfit_stats[i]
                local ok, val = pcall(adb.get_outfit_value, obj, sec, st_name, 0)
                result.item_adv[st_name] = (ok and type(val) == "number") and val or 0
            end
            if type(adb.get_outfit_ap_res) == "function" then
                local ok_ap, ap_val = pcall(adb.get_outfit_ap_res, obj)
                result.item_adv.ap_res = (ok_ap and type(ap_val) == "number") and ap_val or 0
            end
        elseif gr == "artefact" and type(adb.get_af_value) == "function" then
            local af_stats = {
                "burn_immunity",
                "shock_immunity",
                "chemical_burn_immunity",
                "radiation_immunity",
                "telepatic_immunity",
                "wound_immunity",
                "fire_wound_immunity",
                "strike_immunity",
                "explosion_immunity",
            }
            for i = 1, #af_stats do
                local st_name = af_stats[i]
                local ok, val = pcall(adb.get_af_value, obj, sec, st_name, 0)
                result.item_adv[st_name] = (ok and type(val) == "number") and val or 0
            end
        end
    end

    -- 2. Read actor-level Accurate Defense Values (torso bone 13 & head bone 19) via get_protection
    if type(adb) == "table" and type(adb.get_protection) == "function" and db and db.actor then
        local function query_prot(adb_mode, bone_name, bone_id, k_ap)
            if type(adb.get_adb_constants) == "function" then
                pcall(adb.get_adb_constants, adb_mode)
            end
            local h = make_readonly_probe_hit(adb.hit_type or 0, bone_name, bone_id)
            local ok, total_p, lim, arm_p, hlm_p, arm_bone, hlm_bone, premit =
                pcall(adb.get_protection, h, bone_id, k_ap)
            if not ok then
                return 0, 0, 0, 0
            end
            return (total_p or 0), (arm_bone or 0), (hlm_bone or 0), (premit or 0)
        end

        local _, arm_bone_100, _, body_premit = query_prot("fire_wound", "bip01_spine", 13, 100)
        local body_fw_0 = query_prot("fire_wound", "bip01_spine", 13, 0)
        result.actor_adv.body_br_class = math.floor((arm_bone_100 or 0) * 100 + 0.5)
        result.actor_adv.body_premitigation_pct = math.ceil((body_premit or 0) * 100)
        result.actor_adv.body_fire_wound = body_fw_0 or 0

        result.actor_adv.body_wound = (query_prot("wound", "bip01_spine", 13, 0))
        result.actor_adv.body_explosion = (query_prot("explosion", "bip01_spine", 13, 0))
        result.actor_adv.body_strike = (query_prot("strike", "bip01_spine", 13, 0))
        result.actor_adv.body_burn = (query_prot("fire", "bip01_spine", 13, 0))
        result.actor_adv.body_shock = (query_prot("shock", "bip01_spine", 13, 0))
        result.actor_adv.body_acid = (query_prot("acid", "bip01_spine", 13, 0))
        result.actor_adv.body_psi = (query_prot("psi", "bip01_spine", 13, 0))
        result.actor_adv.body_radia = (query_prot("radia", "bip01_spine", 13, 0))

        local _, _, hlm_bone_100, head_premit = query_prot("fire_wound", "bip01_head", 19, 100)
        local head_fw_0 = query_prot("fire_wound", "bip01_head", 19, 0)
        result.actor_adv.head_br_class = math.floor((hlm_bone_100 or 0) * 100 + 0.5)
        result.actor_adv.head_premitigation_pct = math.ceil((head_premit or 0) * 100)
        result.actor_adv.head_fire_wound = head_fw_0 or 0
        result.actor_adv.head_psi = (query_prot("psi", "bip01_head", 19, 0))
    end

    restore_adb_globals(adb, adb_snap)
    if bsb and full_stats_flag ~= nil then
        bsb.show_full_stats = saved_full_stats
    end

    return result, "ok"
end

function read_widget_comparison_card(item_ref, compare_slot_override, full_stats_flag)
    local obj, item_id, err = resolve_item_object(item_ref)
    if not obj then
        return nil, err
    end

    local sec = obj:section()
    local gr = detect_item_stats_group(sec, obj)
    local cond = (type(obj.condition) == "function") and obj:condition() or 1.0
    local weight = (type(obj.weight) == "function") and obj:weight() or (SYS_GetParam and SYS_GetParam(2, sec, "inv_weight", 0) or 0)
    local cost = (type(obj.cost) == "function") and obj:cost() or (SYS_GetParam and SYS_GetParam(2, sec, "cost", 0) or 0)

    -- Resolve target comparison slot (e.g. R3 toggles between slot 2 and slot 3 in 1-based engine slots, or outfit slot 7, helmet slot 12)
    local target_slot = compare_slot_override
    if not target_slot or target_slot <= 0 then
        if gr == "outfit" then
            target_slot = 7
        elseif gr == "helmet" then
            target_slot = 12
        elseif gr == "backpack" then
            target_slot = 13
        elseif gr == "weapon" then
            local ltx_slot = SYS_GetParam and SYS_GetParam(2, sec, "slot", 1) or 1
            target_slot = ltx_slot + 1
        end
    end

    local compared_obj = nil
    if target_slot and target_slot > 0 and db and db.actor and type(db.actor.item_in_slot) == "function" then
        local eq = db.actor:item_in_slot(target_slot)
        if eq and (type(eq.id) ~= "function" or eq:id() ~= item_id) then
            compared_obj = eq
        end
    end

    local adv_data = read_accurate_defense_values(obj, full_stats_flag)
    local cmp_adv_data = compared_obj and read_accurate_defense_values(compared_obj, full_stats_flag) or nil

    local bsb = _G.zz_ui_inventory_better_stats_bars
    local saved_full_stats = bsb and bsb.show_full_stats or nil
    if bsb and full_stats_flag ~= nil then
        bsb.show_full_stats = (full_stats_flag == true)
    end

    local stats_rows = {}
    local uui = _G.utils_ui
    if type(uui) == "table" and type(uui.prepare_stats_table) == "function" then
        pcall(uui.prepare_stats_table)
    end

    local gr_table = (type(uui) == "table" and type(uui.stats_table) == "table") and uui.stats_table[gr] or nil
    if type(gr_table) == "table" and type(uui.get_stats_value) == "function" then
        local sorted_keys = {}
        for k, v in pairs(gr_table) do
            if type(v) == "table" then
                table.insert(sorted_keys, k)
            end
        end
        table.sort(sorted_keys, function(a, b)
            local ia = gr_table[a].index or 999
            local ib = gr_table[b].index or 999
            if ia == ib then return tostring(a) < tostring(b) end
            return ia < ib
        end)

        for i = 1, #sorted_keys do
            local st_key = sorted_keys[i]
            local st_meta = gr_table[st_key]
            local ok_v, val = pcall(uui.get_stats_value, obj, sec, gr, st_key)
            local num_val = (ok_v and type(val) == "number") and val or 0
            local cmp_val = nil
            local delta = 0
            local delta_sign = "="
            if compared_obj and st_meta.compare ~= false then
                local ok_c, cv = pcall(uui.get_stats_value, compared_obj, compared_obj:section(), gr, st_key)
                if ok_c and type(cv) == "number" then
                    cmp_val = cv
                    delta = num_val - cmp_val
                    if math.abs(delta) > 1e-4 then
                        delta_sign = (delta > 0) and "+" or "-"
                    end
                end
            end
            table.insert(stats_rows, {
                stat = st_key,
                index = st_meta.index or i,
                name = st_meta.name or st_key,
                magnitude = st_meta.magnitude or 1,
                unit = st_meta.unit or "",
                value = num_val,
                compare_value = cmp_val,
                delta = delta,
                delta_sign = delta_sign,
            })
        end
    elseif adv_data and adv_data.item_adv then
        -- Fallback direct stat rows from item_adv when utils_ui.stats_table is not initialized
        local fallback_keys = {}
        for k in pairs(adv_data.item_adv) do
            table.insert(fallback_keys, k)
        end
        table.sort(fallback_keys)
        for i = 1, #fallback_keys do
            local k = fallback_keys[i]
            local v = adv_data.item_adv[k] or 0
            local cv = (cmp_adv_data and cmp_adv_data.item_adv) and cmp_adv_data.item_adv[k] or nil
            local delta = (cv ~= nil) and (v - cv) or 0
            local sign = "="
            if cv ~= nil and math.abs(delta) > 1e-4 then
                sign = (delta > 0) and "+" or "-"
            end
            table.insert(stats_rows, {
                stat = k,
                index = i,
                name = k,
                magnitude = 100,
                unit = "%",
                value = v,
                compare_value = cv,
                delta = delta,
                delta_sign = sign,
            })
        end
    end

    if bsb and full_stats_flag ~= nil then
        bsb.show_full_stats = saved_full_stats
    end

    local card = {
        read_only = true,
        stable_id = make_stable_item_id(item_id),
        item_id = item_id,
        section = sec,
        group = gr,
        category = classify_item_widget_category(sec, obj),
        condition = cond,
        weight = weight,
        cost = cost,
        compare_slot = target_slot or 0,
        compared_item_id = (compared_obj and type(compared_obj.id) == "function") and compared_obj:id() or nil,
        compared_section = compared_obj and compared_obj:section() or nil,
        full_stats = (full_stats_flag == true),
        stats_rows = stats_rows,
        adv = adv_data,
        compared_adv = cmp_adv_data,
        summary = string.format(
            "ok:sec=%s;gr=%s;cond=%.2f;slot=%d;cmp=%s;rows=%d;br_body=%d;br_head=%d",
            tostring(sec),
            tostring(gr),
            cond,
            target_slot or 0,
            compared_obj and tostring(compared_obj:section()) or "none",
            #stats_rows,
            adv_data and adv_data.actor_adv.body_br_class or 0,
            adv_data and adv_data.actor_adv.head_br_class or 0
        ),
    }

    return card, "ok"
end

function collect_widget_items_snapshot(category_filter)
    local filter = (type(category_filter) == "string" and category_filter ~= "") and category_filter or "all"
    local items = {}

    local function push_item(obj, bag_name, slot_num)
        if not obj or type(obj.id) ~= "function" or type(obj.section) ~= "function" then
            return
        end
        local id = obj:id()
        local sec = obj:section()
        local cat = classify_item_widget_category(sec, obj)
        if filter ~= "all" and cat ~= filter then
            return
        end
        local cond = (type(obj.condition) == "function") and obj:condition() or 1.0
        local weight = (type(obj.weight) == "function") and obj:weight() or (SYS_GetParam and SYS_GetParam(2, sec, "inv_weight", 0) or 0)
        local cost = (type(obj.cost) == "function") and obj:cost() or (SYS_GetParam and SYS_GetParam(2, sec, "cost", 0) or 0)
        local gw = SYS_GetParam and SYS_GetParam(2, sec, "inv_grid_width", 1) or 1
        local gh = SYS_GetParam and SYS_GetParam(2, sec, "inv_grid_height", 1) or 1
        local is_fav = false
        local is_junk = false
        if _G.zzz_rax_sortingplus_mcm then
            if type(_G.zzz_rax_sortingplus_mcm.is_favorite) == "function" then
                local ok_f, fv = pcall(_G.zzz_rax_sortingplus_mcm.is_favorite, sec)
                is_fav = (ok_f and fv == true) or false
            end
            if type(_G.zzz_rax_sortingplus_mcm.is_junk) == "function" then
                local ok_j, jv = pcall(_G.zzz_rax_sortingplus_mcm.is_junk, sec)
                is_junk = (ok_j and jv == true) or false
            end
        end

        table.insert(items, {
            stable_id = make_stable_item_id(id),
            item_id = id,
            section = sec,
            category = cat,
            group = detect_item_stats_group(sec, obj),
            bag = bag_name or "actor_bag",
            slot = slot_num or 0,
            condition = cond,
            weight = weight,
            cost = cost,
            grid_w = gw,
            grid_h = gh,
            is_favorite = is_fav,
            is_junk = is_junk,
        })
    end

    if db and db.actor and type(db.actor.iterate_inventory) == "function" then
        db.actor:iterate_inventory(function(_, obj)
            pcall(push_item, obj, "actor_bag", 0)
        end, db.actor)
    end

    table.sort(items, function(a, b)
        if a.is_favorite ~= b.is_favorite then
            return a.is_favorite
        end
        if a.is_junk ~= b.is_junk then
            return not a.is_junk
        end
        if a.section ~= b.section then
            return a.section < b.section
        end
        return a.item_id < b.item_id
    end)

    return items, "ok"
end

-- ============================================================================
-- FG.2 (D24, D59): Fast Gamepad Buttons in Standard UIInventory
--   1. Button A (GP_BTN_SOUTH): short press = single click (MOUSE_1), hold > 150 ms
--      + cursor move + release = native UICellContainer:On_Drag -> On_CC_DragDrop,
--      with self.db.tg = 0 reset so fast Drag-and-Drop (< 400 ms) or rapid A taps
--      never trigger a false On_Mouse1_DB.
--   2. Button Y (GP_BTN_NORTH): single press directly calls gui:On_CC_Mouse1_DB(bag, idx)
--      (use / equip / unequip / move to stash or trade).
--   3. Button X (GP_BTN_WEST): single press calls gui:On_CC_Mouse2(bag, idx) -> InitProperties
--      (opening self.item_props with all 34 G.A.M.M.A. functors); when item_props is shown,
--      D-Pad/stick navigates list_box rows, A activates the selected row, and B closes ONLY
--      item_props (or picker) without closing UIInventory.
--   4. Triggers LT / RT (VBTN_LT / VBTN_RT): switch sort_btn[i] strictly in 2 steps:
--      gui:On_Sort(i, true) followed by gui:On_Sort(i) (ui_inventory.script:4029-4030).
--   5. Button View (GP_BTN_BACK, D24) & LB modifier (GP_BTN_LEFT_SHOULDER):
--      View jumps cursor between main panels of current mode (actor_bag <-> actor_equ /
--      npc_bag / npc_trade_bag / repair upx); holding LB enables holding_ctrl = true and
--      show_full_stats = true (Action_Move_All on LB+Y, 100% stats comparison, LB+X in loot
--      calls LMode_TakeAll, LB+X in trade calls TMode_Sell + TMode_Buy).
--   6. Stack shrink focus retention (ResetToChild): if using/moving an item from a stack
--      triggers UICellContainer:RemoveIndex (utils_ui.script:1507-1509) while the stack
--      still has remaining items, preserve selection, hover, and highlight on the cell.
-- ============================================================================

fg2_state = {
    lb_modifier_active = false,
    item_props_row = 0,
    last_sort_idx = 1,
    rb_prev_sort_idx = nil,
    rb_press_count = 0,
    quick_assign_count = 0,
    last_quick_slot = 0,
    last_panel = "actor_bag",
    y_press_count = 0,
    x_press_count = 0,
    b_popup_close_count = 0,
    sort_switch_count = 0,
    panel_switch_count = 0,
    drag_drop_reset_count = 0,
    stack_focus_kept_count = 0,
}

function inv_set_props_selected_row(row_idx)
    fg2_state.item_props_row = math.max(0, tonumber(row_idx) or 0)
    return fg2_state.item_props_row
end

local function install_cc_table_hooks(cc_proto)
    if (type(cc_proto) ~= "table" and type(cc_proto) ~= "userdata") or cc_proto._gp_fg2_hooked then
        return false
    end
    cc_proto._gp_fg2_hooked = true

    -- 1. Hook On_Drag: 150 ms hold threshold on gamepad + db.tg = 0 reset on drag completion (FG.2 item 1)
    if type(cc_proto.On_Drag) == "function" then
        local orig_on_drag = cc_proto.On_Drag
        cc_proto.On_Drag = function(self, idx, tg, set)
            local now_tg = tonumber(tg) or (time_global and time_global() or 0)
            local gp_on = is_gamepad_active() or (self._gp_force_gamepad == true)

            if set == true and idx then
                -- INV-REWORK-1: перекладывания с геймпада нет — drag не начинается
                if gp_on and _G.gp_inv_rework and _G.gp_inv_rework.single_a_enabled and _G.gp_inv_rework.single_a_enabled() then
                    self._gp_drag_start_tg = nil
                    self._gp_drag_active = false
                    return
                end
                self._gp_drag_start_tg = now_tg
                self._gp_drag_active = false
                self._gp_suppress_post_drag_click = false
                -- Offset hold.tg by +50 ms when gamepad is active so utils_ui.script:2091 (tg - hold.tg > 100)
                -- triggers strictly at > 150 ms hold!
                return orig_on_drag(self, idx, gp_on and (now_tg + 50) or now_tg, true)
            elseif not set then
                local res = orig_on_drag(self, idx, now_tg, set)
                if self.hold and self.hold.idx and self._gp_drag_start_tg and (now_tg - self._gp_drag_start_tg > 150) then
                    self._gp_drag_active = true
                end
                return res
            else
                -- Release (set == true and not idx)
                local had_hold = (self.hold and self.hold.idx and self.hold.idx ~= false) and true or false
                local moved_cell = had_hold and (not self.hover or self.hold.idx ~= self.hover.idx) and true or false
                local release_tg = (now_tg > 0) and now_tg or (time_global and time_global() or 0)
                local held_ms = self._gp_drag_start_tg and (release_tg - self._gp_drag_start_tg) or 999

                if gp_on and had_hold and (held_ms <= 150) and (not self._gp_drag_active) then
                    -- Short press A (<= 150 ms): cancel hold before orig_on_drag so it never fires an accidental DragDrop
                    self.hold.idx = false
                    self.hold.tg = 0
                    if self.hold.ico and type(self.hold.ico.Show) == "function" then
                        self.hold.ico:Show(false)
                    end
                    if self.owner then
                        self.owner.item_in_hold = false
                    end
                    return orig_on_drag(self, false, 0, true)
                end

                local res = orig_on_drag(self, idx, tg, set)
                if had_hold and (moved_cell or self._gp_drag_active or (gp_on and held_ms > 150)) then
                    if self.db then
                        self.db.tg = 0
                        self.db.idx = false
                    end
                    if self.owner and type(self.owner.CC) == "table" then
                        for _, other_cc in pairs(self.owner.CC) do
                            if (type(other_cc) == "table" or type(other_cc) == "userdata") and other_cc.db then
                                other_cc.db.tg = 0
                                other_cc.db.idx = false
                            end
                        end
                    end
                    if moved_cell or self._gp_drag_active then
                        self._gp_suppress_post_drag_click = true
                    end
                    fg2_state.drag_drop_reset_count = fg2_state.drag_drop_reset_count + 1
                end
                self._gp_drag_active = false
                return res
            end
        end
    end

    -- 2. Hook On_Mouse1: suppress spurious post-drag click & prevent false double-click on A when gamepad is active (FG.2 item 1)
    if type(cc_proto.On_Mouse1) == "function" then
        local orig_on_mouse1 = cc_proto.On_Mouse1
        cc_proto.On_Mouse1 = function(self, idx)
            if self._gp_suppress_post_drag_click then
                self._gp_suppress_post_drag_click = false
                if self.db then
                    self.db.tg = 0
                    self.db.idx = false
                end
                return
            end
            -- INV-REWORK-1: одинарное A = действие двойного клика (надеть/снять/использовать/переложить)
            if (is_gamepad_active() or self._gp_force_gamepad == true) and _G.gp_inv_rework
                and _G.gp_inv_rework.single_a_enabled and _G.gp_inv_rework.single_a_enabled() then
                return _G.gp_inv_rework.on_confirm(self, idx, orig_on_mouse1)
            end
            if (is_gamepad_active() or self._gp_force_gamepad == true) and self.db then
                self.db.tg = 0
                self.db.idx = false
                local res = orig_on_mouse1(self, idx)
                self.db.tg = 0
                self.db.idx = false
                return res
            end
            return orig_on_mouse1(self, idx)
        end
    end

    -- 3. Hook RemoveIndex: preserve selection, hover, and highlight when a stack shrinks via ResetToChild / PopChild (FG.2 item 6)
    if type(cc_proto.RemoveIndex) == "function" then
        local orig_remove_index = cc_proto.RemoveIndex
        cc_proto.RemoveIndex = function(self, id, sec, indx)
            local cell_idx = indx or (type(self.indx_id) == "table" and id and self.indx_id[id]) or nil
            local ci = (cell_idx and type(self.cell) == "table") and self.cell[cell_idx] or nil
            local stack_survives = (ci ~= nil)
                and is_ui_shown_safe(ci)
                and (ci.ID ~= nil)
                and (ci.ID ~= false)
                and (ci.ID ~= id)

            local was_selected = stack_survives and (self.selected == cell_idx)
            local was_hovered = stack_survives and (type(self.hover) == "table" and self.hover.idx == cell_idx)
            local owner = self.owner or (ui_inventory and ui_inventory.GUI)
            local owner_hovered = stack_survives
                and (owner and type(owner.hover) == "table" and owner.hover.bag == self.ID and owner.hover.idx == cell_idx)

            local res = orig_remove_index(self, id, sec, indx)

            if stack_survives then
                if type(self.indx_id) == "table" then
                    self.indx_id[ci.ID] = cell_idx
                end
                if was_selected then
                    if type(self.On_Select) == "function" then
                        self:On_Select(cell_idx)
                    else
                        self.selected = cell_idx
                    end
                end
                if was_hovered then
                    self.hover.idx = cell_idx
                    if type(ci.Highlight) == "function" then
                        ci:Highlight(true)
                    end
                end
                if owner_hovered then
                    owner.hover.bag = self.ID
                    owner.hover.idx = cell_idx
                end
                fg2_state.stack_focus_kept_count = fg2_state.stack_focus_kept_count + 1
            end
            return res
        end
    end

    return true
end

function ensure_fg2_cc_hooks(gui)
    local any_installed = false
    if _G.utils_ui and (type(_G.utils_ui.UICellContainer) == "table" or type(_G.utils_ui.UICellContainer) == "userdata") then
        if install_cc_table_hooks(_G.utils_ui.UICellContainer) then
            any_installed = true
        end
    end
    local g = gui or (ui_inventory and ui_inventory.GUI)
    if g and type(g.CC) == "table" then
        for _, cc in pairs(g.CC) do
            if (type(cc) == "table" or type(cc) == "userdata") and install_cc_table_hooks(cc) then
                any_installed = true
            end
        end
    end
    return any_installed
end

function inv_find_hovered_cell(gui)
    local g = gui or (ui_inventory and ui_inventory.GUI)
    if not g or type(g.CC) ~= "table" then
        return nil, nil, nil, nil
    end

    -- 1. Check g.hover.bag and g.hover.idx
    if type(g.hover) == "table" and g.hover.bag and g.hover.idx then
        local cc = g.CC[g.hover.bag]
        if cc and is_ui_shown_safe(cc) then
            local ci = type(cc.cell) == "table" and cc.cell[g.hover.idx] or nil
            if ci and (ci.ID ~= nil or (type(cc.GetObj) == "function" and cc:GetObj(g.hover.idx) ~= nil)) then
                return g.hover.bag, g.hover.idx, cc, ci
            end
        end
    end

    -- 2. Check container-level cc.hover.idx
    for bag_name, cc in pairs(g.CC) do
        if cc and is_ui_shown_safe(cc) and type(cc.hover) == "table" and cc.hover.idx then
            local ci = type(cc.cell) == "table" and cc.cell[cc.hover.idx] or nil
            if ci and (ci.ID ~= nil or (type(cc.GetObj) == "function" and cc:GetObj(cc.hover.idx) ~= nil)) then
                return bag_name, cc.hover.idx, cc, ci
            end
        end
    end

    -- 3. Check cell under current UI cursor coordinates
    if GetCursorPosition then
        local ok_p, pos = pcall(GetCursorPosition)
        if ok_p and pos and pos.x and pos.y then
            local cx, cy = pos.x, pos.y
            for bag_name, cc in pairs(g.CC) do
                if cc and is_ui_shown_safe(cc) and type(cc.cell) == "table" then
                    for idx, ci in pairs(cc.cell) do
                        if ci and (ci.ID ~= nil or ci.section ~= nil) and is_ui_shown_safe(ci) and ci.cell then
                            local x1, y1, x2, y2 = get_widget_rect_safe(ci.cell)
                            if x1 and cx >= x1 and cx <= x2 and cy >= y1 and cy <= y2 then
                                return bag_name, idx, cc, ci
                            end
                        end
                    end
                end
            end
        end
    end

    -- 4. Fallback to selected cell in actor_bag or any shown container
    for bag_name, cc in pairs(g.CC) do
        if cc and is_ui_shown_safe(cc) and cc.selected then
            local ci = type(cc.cell) == "table" and cc.cell[cc.selected] or nil
            if ci and ci.ID ~= nil then
                return bag_name, cc.selected, cc, ci
            end
        end
    end

    return nil, nil, nil, nil
end

function inv_exec_quick_action()
    local gui = ui_inventory and ui_inventory.GUI
    if not gui or not is_ui_shown_safe(gui) then
        return "err:no_active_inventory"
    end
    ensure_fg2_cc_hooks(gui)

    local bag, idx, cc, ci = inv_find_hovered_cell(gui)
    if not bag or not idx or type(gui.On_CC_Mouse1_DB) ~= "function" then
        return "err:no_hovered_cell"
    end

    if fg2_state.lb_modifier_active then
        gui.holding_ctrl = true
    end
    if cc then
        if type(cc.On_Select) == "function" then
            cc:On_Select(idx)
        else
            cc.selected = idx
        end
        if cc.db then
            cc.db.tg = 0
            cc.db.idx = false
        end
    end

    gui:On_CC_Mouse1_DB(bag, idx)
    fg2_state.y_press_count = fg2_state.y_press_count + 1

    -- Preserve focus and highlight if stack shrunk (ResetToChild) and cell still holds remaining items (FG.2 item 6)
    local after_ci = (cc and type(cc.cell) == "table") and cc.cell[idx] or ci
    if cc and after_ci and is_ui_shown_safe(after_ci) and after_ci.ID ~= nil and after_ci.ID ~= false then
        if type(cc.On_Select) == "function" then
            cc:On_Select(idx)
        else
            cc.selected = idx
        end
        if type(cc.hover) == "table" then
            cc.hover.idx = idx
        end
        if type(gui.hover) == "table" then
            gui.hover.bag = bag
            gui.hover.idx = idx
        end
        if type(after_ci.Highlight) == "function" then
            after_ci:Highlight(true)
        end
    end

    return string.format("ok:y_db;bag=%s;idx=%d;ctrl=%d", tostring(bag), tonumber(idx) or 0, gui.holding_ctrl and 1 or 0)
end

function inv_on_button_y()
    local res = dispatch_menu_trigger("button", "Y")
    return res
end

function inv_exec_context_menu()
    local gui = ui_inventory and ui_inventory.GUI
    if not gui or not is_ui_shown_safe(gui) then
        return "err:no_active_inventory"
    end
    local rw = rw_mod()
    if rw then
        if type(rw.on_msg_box_button) == "function" then
            local mb_res = rw.on_msg_box_button("X")
            if mb_res then return mb_res end
        end
        if type(rw.modal_open) == "function" and rw.modal_open(gui) then
            return "handled_modal:noop"
        end
        if type(rw.ensure_item_props_hook) == "function" then
            pcall(rw.ensure_item_props_hook, gui)
        end
    end
    ensure_fg2_cc_hooks(gui)

    -- INV-REWORK-21 (Миша 2026-11-12): LB+X «взять всё / сделка» убрано — в обыске RB/LB,
    -- в торговле RB купить / LB продать (gp_inv_rework.rb_press / lb_press).

    local bag, idx, cc = inv_find_hovered_cell(gui)
    if not bag or not idx or type(gui.On_CC_Mouse2) ~= "function" then
        return "err:no_hovered_cell"
    end

    ensure_dynamic_functors_flushed(gui, false)
    if cc then
        if type(cc.On_Select) == "function" then
            cc:On_Select(idx)
        else
            cc.selected = idx
        end
    end

    gui:On_CC_Mouse2(bag, idx)
    fg2_state.x_press_count = fg2_state.x_press_count + 1
    fg2_state.item_props_row = 0

    local props = gui.item_props
    if props and is_ui_shown_safe(props) and props.list_box then
        local lb = props.list_box
        local ok_sz, sz = pcall(lb.GetSize, lb)
        if ok_sz and type(sz) == "number" and sz > 0 then
            local ok_it, itm0 = pcall(lb.GetItemByIndex, lb, 0)
            if ok_it and itm0 then
                local x1, y1, _, _, mx, my = get_widget_rect_safe(itm0)
                if x1 and mx and my then
                    if SetCursorPosition and vector2 then
                        pcall(function() SetCursorPosition(vector2():set(mx, my)) end)
                    end
                    return string.format("ok:x_props;bag=%s;idx=%d;cx=%.1f;cy=%.1f", tostring(bag), tonumber(idx) or 0, mx, my)
                end
            end
        end
    end

    return string.format("ok:x_props;bag=%s;idx=%d", tostring(bag), tonumber(idx) or 0)
end

function inv_on_button_x()
    local res = dispatch_menu_trigger("button", "X")
    return res
end

-- INV-REWORK-19 (Миша 2026-11-12): удержание X, когда у предмета несколько особых действий — родное меню предмета
-- (UIInventory.item_props), отфильтрованное до дополнительных строк. entries — записи collect_item_actions
-- (raw_name/action_func/action_params), порядок и параметры как в UIInventory:InitProperties.
-- Курсор ставится на первую строку, как в inv_exec_context_menu; дальше меню ведёт обычная навигация (D-pad, A, B).
function open_extras_menu(obj, cc, idx, entries)
    local gui = ui_inventory and ui_inventory.GUI
    if not gui or not is_ui_shown_safe(gui) or not gui.item_props or type(gui.item_props.Reset) ~= "function" then
        return "err:no_menu"
    end
    if type(entries) ~= "table" or #entries == 0 then
        return "err:no_entries"
    end
    local acts, names, params = {}, {}, {}
    for i, e in ipairs(entries) do
        acts[i] = e.action_func
        names[i] = e.raw_name
        params[i] = e.action_params
    end
    if cc then
        if type(cc.On_Select) == "function" then
            cc:On_Select(idx)
        else
            cc.selected = idx
        end
    end
    local pos = (GetCursorPosition and GetCursorPosition()) or nil
    gui.item_props:Reset(pos, acts, names, params)
    fg2_state.item_props_row = 0
    local props = gui.item_props
    if props and is_ui_shown_safe(props) and props.list_box then
        local lb = props.list_box
        local ok_sz, sz = pcall(lb.GetSize, lb)
        if ok_sz and type(sz) == "number" and sz > 0 then
            local ok_it, itm0 = pcall(lb.GetItemByIndex, lb, 0)
            if ok_it and itm0 then
                local x1, y1, _, _, mx, my = get_widget_rect_safe(itm0)
                if x1 and mx and my then
                    if SetCursorPosition and vector2 then
                        pcall(function() SetCursorPosition(vector2():set(mx, my)) end)
                    end
                    return string.format("ok:x_menu;rows=%d;cx=%.1f;cy=%.1f", #entries, mx, my)
                end
            end
        end
    end
    return string.format("ok:x_menu;rows=%d", #entries)
end

function inv_exec_confirm_in_props()
    local gui = ui_inventory and ui_inventory.GUI
    if not gui or not is_ui_shown_safe(gui) then
        return "pass"
    end
    local rw = rw_mod()
    if rw and type(rw.on_button_a_fast) == "function" then
        local fast_res = rw.on_button_a_fast()
        if fast_res then return fast_res end
    end
    local props = (rw and type(rw.active_custom_props) == "function" and rw.active_custom_props()) or gui.item_props
    if not props or not is_ui_shown_safe(props) or not props.list_box then
        return "pass"
    end

    local lb = props.list_box
    local ok_sz, sz = pcall(lb.GetSize, lb)
    if not ok_sz or type(sz) ~= "number" or sz <= 0 then
        return "pass"
    end

    local chosen_itm = nil
    local chosen_idx = nil

    -- 1. Check item under cursor
    if GetCursorPosition then
        local ok_p, pos = pcall(GetCursorPosition)
        if ok_p and pos and pos.x and pos.y then
            for i = 0, sz - 1 do
                local ok_it, itm = pcall(lb.GetItemByIndex, lb, i)
                if ok_it and itm then
                    local x1, y1, x2, y2 = get_widget_rect_safe(itm)
                    if x1 and pos.x >= x1 and pos.x <= x2 and pos.y >= y1 and pos.y <= y2 then
                        chosen_itm = itm
                        chosen_idx = i
                        break
                    end
                end
            end
        end
    end

    -- 2. Check IsCursorOverWindow on items
    if not chosen_itm then
        for i = 0, sz - 1 do
            local ok_it, itm = pcall(lb.GetItemByIndex, lb, i)
            if ok_it and itm and type(itm.IsCursorOverWindow) == "function" then
                local ok_ov, over = pcall(itm.IsCursorOverWindow, itm)
                if ok_ov and over then
                    chosen_itm = itm
                    chosen_idx = i
                    break
                end
            end
        end
    end

    -- 3. Check tracked D-Pad row or GetSelectedItem
    if not chosen_itm then
        local row_idx = math.max(0, math.min(sz - 1, tonumber(fg2_state.item_props_row) or 0))
        local ok_it, itm = pcall(lb.GetItemByIndex, lb, row_idx)
        if ok_it and itm then
            chosen_itm = itm
            chosen_idx = row_idx
        elseif type(lb.GetSelectedItem) == "function" then
            local ok_sel, sel_itm = pcall(lb.GetSelectedItem, lb)
            if ok_sel and sel_itm then
                chosen_itm = sel_itm
                chosen_idx = 0
            end
        end
    end

    if not chosen_itm then
        return "pass"
    end

    local orig_get_sel = lb.GetSelectedItem
    lb.GetSelectedItem = function()
        return chosen_itm
    end
    if type(props.OnListItemDbClicked) == "function" then
        pcall(props.OnListItemDbClicked, props)
    else
        local owner = props.owner or gui
        if owner and chosen_itm.func and type(owner[chosen_itm.func]) == "function" then
            if type(chosen_itm.params) == "table" then
                pcall(owner[chosen_itm.func], owner, unpack(chosen_itm.params))
            else
                pcall(owner[chosen_itm.func], owner)
            end
        end
        if type(props.OnHide) == "function" then
            pcall(props.OnHide, props)
        end
    end
    lb.GetSelectedItem = orig_get_sel

    return string.format("handled_item_props:row=%d", tonumber(chosen_idx) or 0)
end

function inv_on_button_a_in_props()
    -- FIX-LIVE3 p.18: "Replace?" for an occupied D-pad pin -> A = yes
    local ok_q, qp = pcall(function() return gp_qaw_patch end)
    if ok_q and type(qp) == "table" and type(qp.pin_pending_active) == "function" and qp.pin_pending_active() then
        return "handled_item_props:" .. tostring(qp.pin_confirm())
    end
    local res = dispatch_menu_trigger("button", "A")
    return res
end

function inv_exec_back()
    local gui = ui_inventory and ui_inventory.GUI
    if not gui or not is_ui_shown_safe(gui) then
        return "pass_close_inventory"
    end

    local rw = rw_mod()
    if rw and type(rw.on_button_b_fast) == "function" then
        local b_res = rw.on_button_b_fast()
        if b_res then return b_res end
    end

    -- 1. If item_props (UICellProperties / UICellPropertiesCustom) is open, close ONLY popup via DIK_ESCAPE (utils_ui.script:3481)
    local props = (rw and type(rw.active_custom_props) == "function" and rw.active_custom_props()) or gui.item_props
    if props and is_ui_shown_safe(props) then
        local dik_esc = (_G.DIK_keys and _G.DIK_keys.DIK_ESCAPE) or 1
        local ev_press = (_G.ui_events and _G.ui_events.WINDOW_KEY_PRESSED) or 6
        if type(props.OnKeyboard) == "function" then
            props:OnKeyboard(dik_esc, ev_press)
        end
        if is_ui_shown_safe(props) and type(props.OnHide) == "function" then
            props:OnHide()
        end
        fg2_state.b_popup_close_count = fg2_state.b_popup_close_count + 1
        return "closed_item_props"
    end

    -- 2. If stack picker popup is open, close ONLY picker without closing UIInventory
    local picker = gui.CC and gui.CC["picker"]
    if picker and is_ui_shown_safe(picker) then
        if type(gui.Picker_Toggle) == "function" then
            gui:Picker_Toggle(nil, nil, false, true)
        elseif type(picker.Show) == "function" then
            picker:Show(false)
        end
        fg2_state.b_popup_close_count = fg2_state.b_popup_close_count + 1
        return "closed_picker"
    end

    return "pass_close_inventory"
end

function inv_on_button_b()
    -- FIX-LIVE3 p.18: "Replace?" for an occupied D-pad pin -> B = no (keeps the inventory open)
    local ok_q, qp = pcall(function() return gp_qaw_patch end)
    if ok_q and type(qp) == "table" and type(qp.pin_pending_active) == "function" and qp.pin_pending_active() then
        qp.pin_cancel()
        return "closed_item_props"
    end
    -- INV-REWORK-21 + W4-TECH-SYS: модальные окна (message_box / message_box_up / qty_dlg / wpn_dlg) закрываются B
    local rw = gp_inv_rework
    if rw and type(rw.on_button_b_fast) == "function" then
        local b_res = rw.on_button_b_fast()
        if b_res then return b_res end
    elseif rw and rw.close_msg_box and rw.close_msg_box(ui_inventory and ui_inventory.GUI) then
        return "closed_item_props"
    end
    local res = dispatch_menu_trigger("button", "B")
    return res
end

function inv_exec_cycle_sort_tab(delta)
    local gui = ui_inventory and ui_inventory.GUI
    if not gui or not is_ui_shown_safe(gui) or type(gui.sort_btn) ~= "table" or type(gui.On_Sort) ~= "function" then
        return "err:no_sort_tabs"
    end

    local total = #gui.sort_btn
    if total <= 0 then
        return "err:no_sort_tabs"
    end

    local cur_i = nil
    for i = 1, total do
        local btn = gui.sort_btn[i]
        if btn and type(btn.GetCheck) == "function" and btn:GetCheck() then
            cur_i = i
            break
        end
    end
    if not cur_i then
        cur_i = math.max(1, math.min(total, tonumber(fg2_state.last_sort_idx) or 1))
    end

    local step = ((tonumber(delta) or 1) < 0) and -1 or 1
    local next_i = cur_i
    for _ = 1, total do
        next_i = ((next_i - 1 + step) % total) + 1
        local btn = gui.sort_btn[next_i]
        if btn and (btn.IsShown == nil or is_ui_shown_safe(btn)) then
            break
        end
    end

    -- Strictly 2-step sort switch matching UIInventory:OnKeyboard (ui_inventory.script:4029-4030)
    gui:On_Sort(next_i, true)
    gui:On_Sort(next_i)

    fg2_state.last_sort_idx = next_i
    fg2_state.rb_prev_sort_idx = nil
    fg2_state.sort_switch_count = fg2_state.sort_switch_count + 1
    return string.format("ok:sort=%d;steps=2", next_i)
end

function inv_cycle_sort_tab(delta)
    local btn = ((tonumber(delta) or 1) < 0) and "LT" or "RT"
    local res = dispatch_menu_trigger("button", btn, delta)
    return res
end

-- FG.6k3: RB in UIInventory switches filter tab immediately to medicine (button_sort_tab_8, i_medical);
-- pressing RB again restores the previous tab (usually tab 1 "all"), and snaps cursor focus to the first item.
function inv_find_medical_sort_tab(gui)
    local g = gui or (ui_inventory and ui_inventory.GUI)
    local total = (g and type(g.sort_btn) == "table") and #g.sort_btn or 0
    if total <= 0 then
        return nil
    end

    if ini_sys and type(ini_sys.r_string_ex) == "function" then
        for i = 1, total do
            local btn = g.sort_btn[i]
            if btn and (btn.IsShown == nil or is_ui_shown_safe(btn)) then
                local ok_s, kinds_str = pcall(ini_sys.r_string_ex, ini_sys, "button_sort_tab_" .. tostring(i), "kinds")
                if ok_s and type(kinds_str) == "string" and string.find(kinds_str, "i_medical", 1, true) then
                    return i
                end
            end
        end
    end

    local default_med_idx = 8
    if default_med_idx <= total then
        local btn = g.sort_btn[default_med_idx]
        if btn and (btn.IsShown == nil or is_ui_shown_safe(btn)) then
            return default_med_idx
        end
    end
    for i = total, 1, -1 do
        local btn = g.sort_btn[i]
        if btn and (btn.IsShown == nil or is_ui_shown_safe(btn)) then
            return i
        end
    end
    return nil
end

local function inv_focus_first_filtered_item(gui)
    if not gui or type(gui.CC) ~= "table" then
        return "none", 0, 512.0, 384.0
    end
    ensure_fg2_cc_hooks(gui)

    local mode = tostring(gui.mode or "inventory")
    local candidate_bags = { "actor_bag" }
    if mode == "trade" and gui.CC["actor_trade_bag"] and is_ui_shown_safe(gui.CC["actor_trade_bag"]) then
        candidate_bags = { "actor_trade_bag", "actor_bag", "npc_trade_bag" }
    elseif mode == "loot" then
        candidate_bags = { "actor_bag", "npc_bag" }
    end

    local cur_bag = type(gui.hover) == "table" and gui.hover.bag or nil
    if cur_bag and cur_bag ~= "actor_equ" and cur_bag ~= "upx" and gui.CC[cur_bag] and is_ui_shown_safe(gui.CC[cur_bag]) then
        local reordered = { cur_bag }
        for i = 1, #candidate_bags do
            if candidate_bags[i] ~= cur_bag then
                table.insert(reordered, candidate_bags[i])
            end
        end
        candidate_bags = reordered
    end

    local target_bag = candidate_bags[1] or "actor_bag"
    local target_cc = gui.CC[target_bag]
    local target_idx = 0
    local target_ci = nil

    for b = 1, #candidate_bags do
        local bname = candidate_bags[b]
        local cc = gui.CC[bname]
        if cc and is_ui_shown_safe(cc) then
            target_bag = bname
            target_cc = cc
            if type(cc.cell) == "table" then
                for idx, ci in ipairs(cc.cell) do
                    local has_item = (ci and (ci.ID ~= nil and ci.ID ~= false or ci.section ~= nil and ci.section ~= false))
                    if ci and has_item and (cc.manual == true or is_ui_shown_safe(ci)) then
                        target_idx = idx
                        target_ci = ci
                        break
                    end
                end
            end
            if target_idx > 0 then
                break
            end
        end
    end

    if target_cc and target_cc.scroll and type(target_cc.scroll.ScrollToBegin) == "function" then
        pcall(target_cc.scroll.ScrollToBegin, target_cc.scroll)
    end

    local tx, ty = 512.0, 384.0
    if target_ci and target_ci.cell then
        local x1, _, _, _, mx, my = get_widget_rect_safe(target_ci.cell)
        if x1 and mx and my then
            tx, ty = mx, my
        end
    elseif target_cc and target_cc.scroll then
        local x1, _, _, _, mx, my = get_widget_rect_safe(target_cc.scroll)
        if x1 and mx and my then
            tx, ty = mx, my
        end
    end

    if type(gui.hover) == "table" and gui.hover.bag and gui.hover.bag ~= target_bag then
        local prev_cc = gui.CC[gui.hover.bag]
        if prev_cc and type(prev_cc.On_Hover) == "function" then
            pcall(prev_cc.On_Hover, prev_cc, false)
        end
    end

    gui.hover = gui.hover or {}
    gui.hover.bag = target_bag
    if target_idx > 0 then
        gui.hover.idx = target_idx
        if target_cc then
            target_cc.selected = target_idx
            if type(target_cc.hover) == "table" then
                target_cc.hover.idx = target_idx
            end
            if type(target_cc.On_Hover) == "function" then
                pcall(target_cc.On_Hover, target_cc, target_idx)
            end
        end
        if type(gui.On_CC_Hover) == "function" then
            pcall(gui.On_CC_Hover, gui, target_bag, target_idx)
        end
    else
        gui.hover.idx = false
        if target_cc and type(target_cc.hover) == "table" then
            target_cc.hover.idx = false
        end
    end

    if SetCursorPosition and vector2 then
        pcall(function() SetCursorPosition(vector2():set(tx, ty)) end)
    end

    return target_bag, target_idx, tx, ty
end

function inv_exec_medicine_filter()
    local gui = ui_inventory and ui_inventory.GUI
    if not gui or not is_ui_shown_safe(gui) or type(gui.sort_btn) ~= "table" or type(gui.On_Sort) ~= "function" then
        return "err:no_sort_tabs"
    end

    local total = #gui.sort_btn
    if total <= 0 then
        return "err:no_sort_tabs"
    end

    local med_idx = inv_find_medical_sort_tab(gui)
    if not med_idx then
        return "err:no_sort_tabs"
    end

    local cur_i = nil
    for i = 1, total do
        local btn = gui.sort_btn[i]
        if btn and type(btn.GetCheck) == "function" and btn:GetCheck() then
            cur_i = i
            break
        end
    end
    if not cur_i then
        cur_i = math.max(1, math.min(total, tonumber(fg2_state.last_sort_idx) or 1))
    end

    local next_i = med_idx
    local mode_tag = "med"
    if cur_i == med_idx then
        local restore_i = tonumber(fg2_state.rb_prev_sort_idx) or 1
        if restore_i < 1 or restore_i > total or restore_i == med_idx then
            restore_i = 1
        end
        local rbtn = gui.sort_btn[restore_i]
        if not (rbtn and (rbtn.IsShown == nil or is_ui_shown_safe(rbtn))) then
            restore_i = 1
        end
        next_i = restore_i
        fg2_state.rb_prev_sort_idx = nil
        mode_tag = "restore"
    else
        fg2_state.rb_prev_sort_idx = cur_i
    end

    -- Strictly 2-step sort switch matching UIInventory:OnKeyboard (ui_inventory.script:4029-4030)
    gui:On_Sort(next_i, true)
    gui:On_Sort(next_i)

    fg2_state.last_sort_idx = next_i
    fg2_state.rb_press_count = fg2_state.rb_press_count + 1
    fg2_state.sort_switch_count = fg2_state.sort_switch_count + 1

    local f_bag, f_idx, tx, ty = inv_focus_first_filtered_item(gui)
    return string.format("ok:rb=%s;sort=%d;prev=%d;bag=%s;idx=%d;cx=%.1f;cy=%.1f", mode_tag, next_i, cur_i, tostring(f_bag), f_idx, tx, ty)
end

function inv_on_button_rb()
    local rw = rw_mod()
    if rw and rw.picker_shown and rw.picker_shown(ui_inventory and ui_inventory.GUI) then
        return rw.picker_step(1)
    end
    local res = dispatch_menu_trigger("button", "RB")
    return res
end

function inv_exec_switch_panel_view()
    local gui = ui_inventory and ui_inventory.GUI
    if not gui or not is_ui_shown_safe(gui) or type(gui.CC) ~= "table" then
        return "panel:0"
    end
    ensure_fg2_cc_hooks(gui)

    local mode = tostring(gui.mode or "inventory")
    local raw_panels = nil
    if mode == "loot" then
        raw_panels = { "actor_bag", "npc_bag" }
    elseif mode == "trade" then
        if gui.CC["actor_trade_bag"] and is_ui_shown_safe(gui.CC["actor_trade_bag"]) then
            raw_panels = { "actor_trade_bag", "npc_trade_bag" }
        else
            raw_panels = { "actor_bag", "npc_trade_bag" }
        end
    elseif mode == "repair" then
        raw_panels = { "actor_bag", "actor_equ", "upx" }
    else
        raw_panels = { "actor_bag", "actor_equ" }
    end

    local panels = {}
    for i = 1, #raw_panels do
        local p = raw_panels[i]
        if p == "upx" then
            local has_upx = false
            if type(gui.upx) == "table" then
                for _, node in pairs(gui.upx) do
                    if node and node.btn and is_ui_shown_safe(node.btn) and (not node.base or is_ui_shown_safe(node.base)) then
                        has_upx = true
                        break
                    end
                end
            end
            if not has_upx and gui.npc_up_repair and is_ui_shown_safe(gui.npc_up_repair) then
                has_upx = true
            end
            if has_upx then
                table.insert(panels, "upx")
            end
        else
            local cc = gui.CC[p]
            if cc and is_ui_shown_safe(cc) then
                table.insert(panels, p)
            end
        end
    end

    if #panels == 0 then
        return "panel:0"
    end

    local cur_panel = (type(gui.hover) == "table" and gui.hover.bag) or fg2_state.last_panel or panels[1]
    local cur_pos_idx = 1
    for i = 1, #panels do
        if panels[i] == cur_panel then
            cur_pos_idx = i
            break
        end
    end
    local next_panel = panels[(cur_pos_idx % #panels) + 1]
    fg2_state.last_panel = next_panel
    fg2_state.panel_switch_count = fg2_state.panel_switch_count + 1

    if next_panel == "upx" then
        local tx, ty = 512.0, 384.0
        local target_idx = 1
        local found_upx = false
        if type(gui.upx) == "table" then
            for idx, node in pairs(gui.upx) do
                if node and node.btn and is_ui_shown_safe(node.btn) and (not node.base or is_ui_shown_safe(node.base)) then
                    local x1, _, _, _, mx, my = get_widget_rect_safe(node.btn)
                    target_idx = idx
                    found_upx = true
                    if x1 and mx and my then
                        tx, ty = mx, my
                    end
                    break
                end
            end
        end
        if not found_upx and gui.npc_up_repair and is_ui_shown_safe(gui.npc_up_repair) then
            local x1, _, _, _, mx, my = get_widget_rect_safe(gui.npc_up_repair)
            if x1 and mx and my then
                tx, ty = mx, my
            end
        end
        if type(gui.hover) == "table" then
            gui.hover.bag = found_upx and "upx" or "npc_up_repair"
            gui.hover.idx = target_idx
        end
        if SetCursorPosition and vector2 then
            pcall(function() SetCursorPosition(vector2():set(tx, ty)) end)
        end
        local num_idx = tonumber(target_idx) or tonumber(tostring(target_idx):match("%d+")) or 0
        return string.format("panel:1;panel=upx;idx=%d;cx=%.1f;cy=%.1f", num_idx, tx, ty)
    end

    local cc = gui.CC[next_panel]
    local target_idx = 0
    local target_ci = nil
    if cc and type(cc.cell) == "table" then
        if cc.selected and cc.cell[cc.selected] and is_ui_shown_safe(cc.cell[cc.selected]) then
            target_idx = cc.selected
            target_ci = cc.cell[cc.selected]
        elseif type(cc.hover) == "table" and cc.hover.idx and cc.cell[cc.hover.idx] and is_ui_shown_safe(cc.cell[cc.hover.idx]) then
            target_idx = cc.hover.idx
            target_ci = cc.cell[cc.hover.idx]
        else
            for idx, ci in ipairs(cc.cell) do
                local active = (cc.manual == true) or (ci and (ci.ID ~= nil or ci.section ~= nil))
                if ci and active and (cc.manual == true or is_ui_shown_safe(ci)) then
                    target_idx = idx
                    target_ci = ci
                    break
                end
            end
        end
    end

    local tx, ty = 512.0, 384.0
    if target_ci and target_ci.cell then
        local x1, _, _, _, mx, my = get_widget_rect_safe(target_ci.cell)
        if x1 and mx and my then
            tx, ty = mx, my
        end
    elseif cc and cc.scroll then
        local x1, _, _, _, mx, my = get_widget_rect_safe(cc.scroll)
        if x1 and mx and my then
            tx, ty = mx, my
        end
    end

    if type(gui.hover) == "table" and gui.hover.bag and gui.hover.bag ~= next_panel then
        local prev_cc = gui.CC[gui.hover.bag]
        if prev_cc and type(prev_cc.On_Hover) == "function" then
            pcall(prev_cc.On_Hover, prev_cc, false)
        end
    end

    if target_idx > 0 then
        gui.hover = gui.hover or {}
        gui.hover.bag = next_panel
        gui.hover.idx = target_idx
        if cc and type(cc.hover) == "table" then
            cc.hover.idx = target_idx
        end
        if cc and type(cc.On_Hover) == "function" then
            pcall(cc.On_Hover, cc, target_idx)
        end
        if type(gui.On_CC_Hover) == "function" then
            pcall(gui.On_CC_Hover, gui, next_panel, target_idx)
        end
    else
        gui.hover = gui.hover or {}
        gui.hover.bag = next_panel
        gui.hover.idx = false
    end

    if SetCursorPosition and vector2 then
        pcall(function() SetCursorPosition(vector2():set(tx, ty)) end)
    end

    return string.format("panel:1;panel=%s;idx=%d;cx=%.1f;cy=%.1f", tostring(next_panel), target_idx, tx, ty)
end

function inv_switch_panel_view()
    local res = dispatch_menu_trigger("button", "Back")
    return res
end

function inv_exec_lb_modifier(active)
    local b = (active == true)
    local changed = (fg2_state.lb_modifier_active ~= b)
    fg2_state.lb_modifier_active = b

    if _G.ui_inventory then
        _G.ui_inventory.show_full_stats = b
    end
    if _G.zz_ui_inventory_better_stats_bars then
        _G.zz_ui_inventory_better_stats_bars.show_full_stats = b
    end

    local gui = ui_inventory and ui_inventory.GUI
    if gui then
        gui.holding_ctrl = b
        if changed and is_ui_shown_safe(gui) then
            if _G.zz_ui_inventory_better_stats_bars and type(_G.zz_ui_inventory_better_stats_bars.update_gui) == "function" then
                pcall(_G.zz_ui_inventory_better_stats_bars.update_gui, gui)
            elseif _G.ui_inventory and type(_G.ui_inventory.update_gui) == "function" then
                pcall(_G.ui_inventory.update_gui, gui)
            else
                gui.update_info = true
            end
        end
        inv_sync_quick_slot_pills(gui)
    end

    return string.format("ok:lb=%d;ctrl=%d;full_stats=%d", b and 1 or 0, (gui and gui.holding_ctrl) and 1 or 0, b and 1 or 0)
end

function inv_set_lb_modifier(active)
    local res = dispatch_menu_trigger("button", "LB", active == true)
    return res
end

-- INV-REWORK-20 (Миша 2026-11-12): RS (нажатие стика) удерживается -> характеристики предмета как при
-- максимальном состоянии: родной флаг show_full_stats (ui_inventory, Ctrl у мыши; utils_ui.script:2720,
-- zz_ui_inventory_better_stats_bars). Без holding_ctrl и без слоя LB (LB+X/LB+Y не включаются).
function inv_set_full_stats(active)
    local b = (active == true)
    if _G.ui_inventory then _G.ui_inventory.show_full_stats = b end
    local bsb = _G.zz_ui_inventory_better_stats_bars
    if bsb then bsb.show_full_stats = b end
    local gui = ui_inventory and ui_inventory.GUI
    if gui and is_ui_shown_safe(gui) then
        if bsb and type(bsb.update_gui) == "function" then
            pcall(bsb.update_gui, gui)
        elseif type(ui_inventory.update_gui) == "function" then
            pcall(ui_inventory.update_gui, gui)
        else
            gui.update_info = true
        end
    end
    return "ok:full_stats=" .. (b and "1" or "0")
end

function inv_is_lb_modifier_active()
    return fg2_state.lb_modifier_active == true
end

-- FG.6k4: Map D-Pad direction (1=Up, 2=Down, 3=Left, 4=Right) to quick slot 1..4 (F1..F4 as in Variant D:
-- Up = F1 (slot 1), Right = F2 (slot 2), Down = F3 (slot 3), Left = F4 (slot 4)).
local DPAD_DIR_TO_QUICK_SLOT = {
    [1] = 1, -- Up    -> F1 (slot_0)
    [4] = 2, -- Right -> F2 (slot_1)
    [2] = 3, -- Down  -> F3 (slot_2)
    [3] = 4, -- Left  -> F4 (slot_3)
}

function inv_dpad_dir_to_quick_slot(dir_code)
    return DPAD_DIR_TO_QUICK_SLOT[tonumber(dir_code) or 0]
end

local function is_item_consumable_for_quickslot(gui, obj, bag, sec)
    if not sec or sec == "" then
        return false
    end
    if type(_G.IsItem) == "function" then
        local ok_it, res_it = pcall(_G.IsItem, "consumable", sec)
        if ok_it then
            return res_it == true
        end
    end
    if gui and type(gui.Cond_Use) == "function" and obj then
        local ok_u, res_u = pcall(gui.Cond_Use, gui, obj, bag)
        if ok_u then
            return res_u == true
        end
    end
    if SYS_GetParam then
        local kind = SYS_GetParam(0, sec, "kind", "") or ""
        if kind == "i_medical" or kind == "i_food" or kind == "i_drink" then
            return true
        end
    end
    return false
end

function inv_assign_quick_slot_dpad(dir_code)
    local gui = ui_inventory and ui_inventory.GUI
    if not gui or not is_ui_shown_safe(gui) then
        return "noop:no_active_inventory"
    end
    local slot_idx = inv_dpad_dir_to_quick_slot(dir_code)
    if not slot_idx then
        return "noop:invalid_dir"
    end
    local bag, idx, cc, ci = inv_find_hovered_cell(gui)
    if not bag or not idx then
        return "noop:no_hovered_cell"
    end

    local obj = nil
    if cc and type(cc.GetObj) == "function" then
        local ok_o, o = pcall(cc.GetObj, cc, idx)
        if ok_o and o then
            obj = o
        end
    end
    if not obj and ci and ci.ID and level and type(level.object_by_id) == "function" then
        local ok_l, o = pcall(level.object_by_id, ci.ID)
        if ok_l and o then
            obj = o
        end
    end

    local sec = nil
    if obj and (type(obj) == "table" or type(obj) == "userdata") and type(obj.section) == "function" then
        local ok_s, s = pcall(obj.section, obj)
        if ok_s and type(s) == "string" and s ~= "" then
            sec = s
        end
    end
    if not sec and ci then
        if type(ci.section) == "string" and ci.section ~= "" then
            sec = ci.section
        elseif type(ci.sec) == "string" and ci.sec ~= "" then
            sec = ci.sec
        end
    end
    if not sec or sec == "" then
        return "noop:no_section"
    end

    if bag ~= "actor_bag" and bag ~= "picker" and bag ~= "actor_trade_bag" then
        return "noop:not_actor_bag"
    end
    -- FIX-LIVE3 p.18: LB + D-pad on a hovered consumable / grenade pins it to the D-pad slot of the wheel
    -- (gp_qaw_patch pins, used with LB + D-pad in the world). Falls back to native F1-F4 quick slots when the
    -- wheel module is unavailable.
    local ok_q, qp = pcall(function() return gp_qaw_patch end)
    if ok_q and type(qp) == "table" and type(qp.pin_item) == "function" then
        local ok_p, pres = pcall(qp.pin_item, sec, tonumber(dir_code))
        if ok_p and type(pres) == "string" and pres ~= "not_pinnable" then
            gui.update_info = true
            return "pin:" .. pres
        end
        if ok_p and pres == "not_pinnable" then
            return "noop:not_consumable"
        end
    end
    if not is_item_consumable_for_quickslot(gui, obj, bag, sec) then
        return "noop:not_consumable"
    end

    -- Native G.A.M.M.A. quick-slot assignment (ui_inventory.script:3452-3455 & UpdateQuick:1733-1748)
    local cmd_str = "slot_" .. tostring(slot_idx - 1) .. " " .. tostring(sec)
    if type(_G.exec_console_cmd) == "function" then
        pcall(_G.exec_console_cmd, cmd_str)
    end
    gui.update_info = true

    local qcc = type(gui.CC) == "table" and gui.CC["actor_quick"] or nil
    if type(gui.UpdateQuick) == "function" then
        pcall(gui.UpdateQuick, gui)
    elseif qcc and type(qcc.AddItemManual) == "function" then
        pcall(qcc.AddItemManual, qcc, nil, sec, slot_idx)
    elseif qcc and type(qcc.cell) == "table" and qcc.cell[slot_idx] then
        qcc.cell[slot_idx].sec = sec
        qcc.cell[slot_idx].section = sec
    end

    fg2_state.quick_assign_count = fg2_state.quick_assign_count + 1
    fg2_state.last_quick_slot = slot_idx
    return string.format("ok:quick_slot=%d;cmd=slot_%d;sec=%s;bag=%s;idx=%d", slot_idx, slot_idx - 1, tostring(sec), tostring(bag), tonumber(idx) or 0)
end

function inv_get_quick_slot_hint_specs(gui)
    local g = gui or (ui_inventory and ui_inventory.GUI)
    local equ_x, equ_y = 375, 0
    if g and g.equ_dialog then
        local x1, y1 = get_widget_rect_safe(g.equ_dialog)
        if x1 and y1 then
            equ_x, equ_y = x1, y1
        end
    end
    local qcc = (g and type(g.CC) == "table") and g.CC["actor_quick"] or nil
    local acts = { "slot_up", "slot_right", "slot_down", "slot_left" }
    local dirs = { 1, 4, 2, 3 }
    local def_cell_x = { 11, 73, 136, 199 }
    local pill_w, pill_h = 32, 16
    local mod_btn = get_menu_button_for_action("TabPrev") or "LB"
    local specs = {}
    for i = 1, 4 do
        local cx1 = equ_x + 10 + def_cell_x[i]
        local cy1 = equ_y + 430
        local cw, ch = 52, 52
        if qcc and type(qcc.cell) == "table" and qcc.cell[i] then
            local wnd = qcc.cell[i].cell or qcc.cell[i]
            local x1, y1, _, _, _, _, w, h = get_widget_rect_safe(wnd)
            if x1 and y1 and w and h then
                cx1, cy1, cw, ch = x1, y1, w, h
            end
        end
        local ux = cx1 + math.floor((cw - pill_w) * 0.5)
        local uy = cy1 - pill_h - 1
        specs[i] = {
            slot_idx = i,
            dir_code = dirs[i],
            btn_name = mod_btn,
            act_name = acts[i],
            ux = ux,
            uy = uy,
            local_x = ux - equ_x,
            local_y = uy - equ_y,
            w = pill_w,
            h = pill_h,
            cell_x = cx1,
            cell_y = cy1,
            cell_w = cw,
            cell_h = ch,
        }
    end
    return specs
end

function inv_sync_quick_slot_pills(gui)
    local g = gui or (ui_inventory and ui_inventory.GUI)
    if not g then
        return false
    end
    local gp_ip = _G.gp_inv_pause
    if type(gp_ip) ~= "table" or type(gp_ip.draw_hint_pill) ~= "function" then
        return false
    end
    if type(gp_ip.update_hint) == "function" and is_ui_shown_safe(g) then
        pcall(gp_ip.update_hint, g)
    end
    local h = type(g._gp_inline_hints) == "table" and g._gp_inline_hints or nil
    local pills = (h and type(h.qslot_pills) == "table") and h.qslot_pills or g._gp_quick_slot_pills
    local specs = inv_get_quick_slot_hint_specs(g)
    if type(pills) ~= "table" or #pills < 4 then
        pills = {}
        for i = 1, 4 do
            local qs = specs[i]
            pills[i] = gp_ip.draw_hint_pill(g, qs.ux, qs.uy, qs.btn_name, qs.act_name, { w = qs.w, h = qs.h, icon_size = 12, pad_x = 2, gap = 2 })
        end
        g._gp_quick_slot_pills = pills
        if h then
            h.qslot_pills = pills
            h.qslot_specs = specs
        end
    end
    local visible = is_gamepad_active() and is_ui_shown_safe(g) and (fg2_state.lb_modifier_active == true or g.holding_ctrl == true)
    for i = 1, 4 do
        local p = pills[i]
        local qs = specs[i]
        if p and qs then
            if type(gp_ip.update_hint_pill) == "function" then
                pcall(gp_ip.update_hint_pill, p, qs.btn_name, qs.act_name)
            end
            if type(gp_ip.move_hint_pill) == "function" then
                pcall(gp_ip.move_hint_pill, p, qs.ux, qs.uy)
            end
            if type(gp_ip.show_hint_pill) == "function" then
                pcall(gp_ip.show_hint_pill, p, visible)
            end
        end
    end
    return visible
end

function get_fg2_status()
    return string.format(
        "ok:lb=%d;props_row=%d;sort=%d;panel=%s;y=%d;x=%d;b_popup=%d;sorts=%d;panels=%d;dd_resets=%d;stack_kept=%d",
        fg2_state.lb_modifier_active and 1 or 0,
        fg2_state.item_props_row,
        fg2_state.last_sort_idx,
        tostring(fg2_state.last_panel),
        fg2_state.y_press_count,
        fg2_state.x_press_count,
        fg2_state.b_popup_close_count,
        fg2_state.sort_switch_count,
        fg2_state.panel_switch_count,
        fg2_state.drag_drop_reset_count,
        fg2_state.stack_focus_kept_count
    )
end

function selftest_fg2_fast_buttons(mode_arg)
    local saved_ui_inv = _G.ui_inventory
    local saved_uui = _G.utils_ui
    local saved_bsb = _G.zz_ui_inventory_better_stats_bars
    local saved_src = bridge_stats.active_source

    bridge_stats.active_source = "gamepad"

    local log_events = {}
    local sort_calls = {}
    local checked_tab = 1
    local props_shown = false
    local picker_shown = false
    local bsb_updates = 0

    _G.zz_ui_inventory_better_stats_bars = {
        show_full_stats = false,
        update_gui = function()
            bsb_updates = bsb_updates + 1
        end,
    }

    local function always_shown()
        return true
    end
    local function make_box(x1, y1, x2, y2)
        return {
            IsShown = always_shown,
            GetAbsoluteRect = function(_, r)
                r.x1, r.y1, r.x2, r.y2 = x1, y1, x2, y2
            end,
        }
    end

    local prop_rows = {
        {
            func = "Action_Drop",
            params = { 501, "actor_bag", "row_0" },
            IsShown = always_shown,
            GetAbsoluteRect = function(_, r) r.x1, r.y1, r.x2, r.y2 = 300, 200, 420, 224 end,
        },
        {
            func = "Action_Drop",
            params = { 501, "actor_bag", "row_1" },
            IsShown = always_shown,
            GetAbsoluteRect = function(_, r) r.x1, r.y1, r.x2, r.y2 = 300, 224, 420, 248 end,
        },
    }

    local mock_clock_ms = 5000
    local cc_proto = {}
    cc_proto.__index = cc_proto
    function cc_proto:On_Select(idx)
        self.selected = idx
    end
    function cc_proto:On_Hover(idx)
        self.hover.idx = idx
    end
    function cc_proto:On_Drag(idx, tg, set)
        if set and idx then
            self.hold.idx = idx
            self.hold.tg = tg
        elseif set and not idx then
            if self.hold.idx and self.hold.idx ~= self.hover.idx then
                table.insert(log_events, "DragDrop:" .. tostring(self.ID) .. ":" .. tostring(self.hold.idx) .. "->" .. tostring(self.hover.idx))
            end
            self.hold.idx = false
            self.hold.tg = 0
        end
    end
    function cc_proto:On_Mouse1(idx)
        mock_clock_ms = mock_clock_ms + 80
        local tg = mock_clock_ms
        if (tg - self.db.tg) < 400 then
            self.db.tg = tg
            table.insert(log_events, "False_DB:" .. tostring(idx))
            return
        end
        self.db.idx = idx
        self.db.tg = tg
        self:On_Select(idx)
        table.insert(log_events, "Mouse1:" .. tostring(idx))
    end
    function cc_proto:RemoveIndex(id, _, _)
        if self.selected == self.indx_id[id] then
            self:On_Select(false)
        end
        self.indx_id[id] = nil
    end

    _G.utils_ui = { UICellContainer = cc_proto }

    local function set_cell_highlight(self_c, on)
        self_c.highlighted = (on == true)
    end
    local cell_1 = {
        ID = 501,
        section = "medkit",
        highlighted = false,
        IsShown = always_shown,
        Highlight = set_cell_highlight,
        cell = make_box(600, 200, 650, 250),
    }
    local cell_2 = {
        ID = 502,
        section = "bandage",
        highlighted = false,
        IsShown = always_shown,
        Highlight = set_cell_highlight,
        cell = make_box(660, 200, 710, 250),
    }

    local actor_bag_cc = setmetatable({
        ID = "actor_bag",
        _gp_force_gamepad = true,
        selected = 1,
        hover = { idx = 1 },
        hold = { idx = false, tg = 0, ico = { Show = function() end } },
        db = { idx = false, tg = 0 },
        indx_id = { [501] = 1, [502] = 2, [503] = 2 },
        cell = { [1] = cell_1, [2] = cell_2 },
        IsShown = always_shown,
    }, cc_proto)

    local actor_equ_cc = setmetatable({
        ID = "actor_equ",
        _gp_force_gamepad = true,
        manual = true,
        selected = 1,
        hover = { idx = 1 },
        hold = { idx = false, tg = 0, ico = {} },
        db = { idx = false, tg = 0 },
        indx_id = { [601] = 1 },
        cell = { [1] = { ID = 601, section = "wpn_ak74", IsShown = always_shown, cell = make_box(350, 200, 430, 300) } },
        IsShown = always_shown,
    }, cc_proto)

    local npc_bag_cc = setmetatable({
        ID = "npc_bag",
        _gp_force_gamepad = true,
        selected = 1,
        hover = { idx = 1 },
        hold = { idx = false, tg = 0, ico = {} },
        db = { idx = false, tg = 0 },
        indx_id = { [701] = 1 },
        cell = { [1] = { ID = 701, section = "ammo_5.45x39_fmj", IsShown = always_shown, cell = make_box(100, 200, 150, 250) } },
        IsShown = always_shown,
    }, cc_proto)

    local mock_gui = {
        mode = "inventory",
        holding_ctrl = false,
        hover = { bag = "actor_bag", idx = 1 },
        CC = {
            actor_bag = actor_bag_cc,
            actor_equ = actor_equ_cc,
            npc_bag = npc_bag_cc,
            actor_trade_bag = actor_bag_cc,
            npc_trade_bag = npc_bag_cc,
            picker = {
                IsShown = function() return picker_shown end,
            },
        },
        sort_btn = {},
        upx = {
            {
                base = { IsShown = always_shown },
                btn = make_box(220, 240, 270, 280),
            },
        },
        IsShown = always_shown,
        Picker_Toggle = function(_, _, _, _, force_hide)
            if force_hide then picker_shown = false end
        end,
        On_Sort = function(self_g, idx, ignore)
            table.insert(sort_calls, { idx = idx, ignore = (ignore == true) })
            if ignore and self_g.sort_btn[idx] then
                self_g.sort_btn[idx]:SetCheck(true)
            end
        end,
        On_CC_Mouse1_DB = function(self_g, bag, idx)
            if self_g.holding_ctrl then
                table.insert(log_events, "Move_All:" .. tostring(bag) .. ":" .. tostring(idx))
            else
                table.insert(log_events, "Mouse1_DB:" .. tostring(bag) .. ":" .. tostring(idx))
            end
        end,
        On_CC_Mouse2 = function(_, bag, idx)
            props_shown = true
            table.insert(log_events, "Mouse2:" .. tostring(bag) .. ":" .. tostring(idx))
        end,
        Action_Drop = function(_, obj_id, bag, row_tag)
            table.insert(log_events, "Action_Drop:" .. tostring(obj_id) .. ":" .. tostring(bag) .. ":" .. tostring(row_tag))
        end,
    }

    for i = 1, 4 do
        local tab_idx = i
        mock_gui.sort_btn[i] = {
            IsShown = always_shown,
            GetCheck = function() return checked_tab == tab_idx end,
            SetCheck = function(_, v) if v then checked_tab = tab_idx end end,
        }
    end

    mock_gui.item_props = {
        owner = mock_gui,
        IsShown = function() return props_shown end,
        OnHide = function() props_shown = false end,
        OnKeyboard = function(self_p, dik, _)
            local esc = (_G.DIK_keys and _G.DIK_keys.DIK_ESCAPE) or 1
            if dik == esc then self_p:OnHide() end
        end,
        list_box = {
            GetSize = function() return #prop_rows end,
            GetItemByIndex = function(_, i) return prop_rows[i + 1] end,
        },
        OnListItemDbClicked = function(self_p)
            local itm = self_p.list_box:GetSelectedItem()
            if itm and itm.func and self_p.owner[itm.func] then
                self_p.owner[itm.func](self_p.owner, unpack(itm.params))
            end
            self_p:OnHide()
        end,
    }

    actor_bag_cc.owner = mock_gui
    actor_equ_cc.owner = mock_gui
    npc_bag_cc.owner = mock_gui

    _G.ui_inventory = {
        GUI = mock_gui,
        show_full_stats = false,
    }

    ensure_fg2_cc_hooks(mock_gui)

    -- Test 1: Short press A (<= 150 ms) vs Hold A (> 150 ms) Drag-and-Drop + db.tg = 0 reset (no false On_Mouse1_DB)
    actor_bag_cc.hover.idx = 1
    actor_bag_cc:On_Drag(1, 1000, true)
    actor_bag_cc.hover.idx = 2
    actor_bag_cc:On_Drag(false, 1080, true) -- 80 ms <= 150 ms -> must NOT DragDrop!
    actor_bag_cc:On_Mouse1(1)
    actor_bag_cc:On_Mouse1(1) -- rapid second click < 400 ms -> must NOT trigger False_DB!

    actor_bag_cc.hover.idx = 1
    actor_bag_cc:On_Drag(1, 2000, true)
    actor_bag_cc:On_Drag(false, 2180, false) -- 180 ms > 150 ms -> drag active!
    actor_bag_cc.hover.idx = 2
    actor_bag_cc:On_Drag(false, 2200, true) -- release -> DragDrop(1->2) + db.tg = 0 + suppress post-drag click
    actor_bag_cc:On_Mouse1(2) -- suppressed post-drag click

    local has_false_db = false
    local drag_drop_count = 0
    local single_click_count = 0
    for _, ev in ipairs(log_events) do
        if string.find(ev, "^False_DB:") then has_false_db = true end
        if ev == "DragDrop:actor_bag:1->2" then drag_drop_count = drag_drop_count + 1 end
        if ev == "Mouse1:1" then single_click_count = single_click_count + 1 end
    end
    local a_drag_ok = (not has_false_db) and (drag_drop_count == 1) and (single_click_count == 2) and (actor_bag_cc.db.tg == 0)

    -- Test 2: Button Y calls On_CC_Mouse1_DB directly without double-click
    mock_gui.hover = { bag = "actor_bag", idx = 1 }
    local y_res = inv_on_button_y()
    local y_ok = (y_res == "ok:y_db;bag=actor_bag;idx=1;ctrl=0")

    -- Test 3: Button X opens item_props, D-Pad steps to row 2 (index 1), A activates row 2, B closes only item_props / picker
    local x_res = inv_on_button_x()
    local x_opened = (props_shown == true) and (string.find(x_res, "^ok:x_props;bag=actor_bag;idx=1") ~= nil)
    local snap_res = cursor_dpad_snap(360, 212, 2) -- D-Pad Down from row 0 (y=212) to row 1 (y=236)
    local a_props_res = inv_on_button_a_in_props()
    local x_a_ok = x_opened and (snap_res == "snap:1;cx=360.0;cy=236.0;kind=prop") and (a_props_res == "handled_item_props:row=1") and (not props_shown)

    -- Re-open item_props and press B -> closes only item_props
    inv_on_button_x()
    local b_res_1 = inv_on_button_b()
    picker_shown = true
    local b_res_2 = inv_on_button_b()
    local b_res_3 = inv_on_button_b()
    local x_b_ok = x_a_ok and (b_res_1 == "closed_item_props") and (not props_shown) and (b_res_2 == "closed_picker") and (not picker_shown) and (b_res_3 == "pass_close_inventory")

    -- Test 4: Triggers LT / RT switch sort_btn strictly in 2 steps (On_Sort(i, true) + On_Sort(i))
    --         and RB switches immediately to medicine tab and restores previous tab on second press (FG.6k3)
    sort_calls = {}
    local rt_res = inv_cycle_sort_tab(1)
    local lt_res = inv_cycle_sort_tab(-1)
    local sort_ok = (rt_res == "ok:sort=2;steps=2")
        and (lt_res == "ok:sort=1;steps=2")
        and (#sort_calls == 4)
        and (sort_calls[1].idx == 2 and sort_calls[1].ignore == true)
        and (sort_calls[2].idx == 2 and sort_calls[2].ignore == false)
        and (sort_calls[3].idx == 1 and sort_calls[3].ignore == true)
        and (sort_calls[4].idx == 1 and sort_calls[4].ignore == false)

    for i = 5, 10 do
        local tab_idx = i
        mock_gui.sort_btn[i] = {
            IsShown = always_shown,
            GetCheck = function() return checked_tab == tab_idx end,
            SetCheck = function(_, v) if v then checked_tab = tab_idx end end,
        }
    end
    sort_calls = {}
    mock_gui.hover = { bag = "actor_bag", idx = 2 }
    -- INV-REWORK-15: RB больше не включает «Медицину»; сама функция фильтра проверяется напрямую
    local rb_res_1 = inv_exec_medicine_filter()
    local rb_res_2 = inv_exec_medicine_filter()
    sort_ok = sort_ok
        and (string.find(rb_res_1, "^ok:rb=med;sort=8;prev=1;bag=actor_bag;idx=1;") ~= nil)
        and (string.find(rb_res_2, "^ok:rb=restore;sort=1;prev=8;bag=actor_bag;idx=1;") ~= nil)
        and (#sort_calls == 4)
        and (sort_calls[1].idx == 8 and sort_calls[1].ignore == true)
        and (sort_calls[2].idx == 8 and sort_calls[2].ignore == false)
        and (sort_calls[3].idx == 1 and sort_calls[3].ignore == true)
        and (sort_calls[4].idx == 1 and sort_calls[4].ignore == false)

    -- Test 5: View panel switching & LB modifier (holding_ctrl + show_full_stats + LB+Y Move_All + LB+X TakeAll / Sell+Buy)
    mock_gui.mode = "inventory"
    mock_gui.hover = { bag = "actor_bag", idx = 1 }
    local v1 = inv_switch_panel_view()
    local v2 = inv_switch_panel_view()
    mock_gui.mode = "loot"
    local v_loot = inv_switch_panel_view()
    mock_gui.mode = "repair"
    mock_gui.hover = { bag = "actor_equ", idx = 1 }
    local v_rep = inv_switch_panel_view()
    local view_ok = (string.find(v1, "^panel:1;panel=actor_equ;") ~= nil)
        and (string.find(v2, "^panel:1;panel=actor_bag;") ~= nil)
        and (string.find(v_loot, "^panel:1;panel=npc_bag;") ~= nil)
        and (string.find(v_rep, "^panel:1;panel=upx;") ~= nil)

    local lb_on = inv_set_lb_modifier(true)
    local lb_flags_ok = inv_is_lb_modifier_active()
        and (mock_gui.holding_ctrl == true)
        and (_G.ui_inventory.show_full_stats == true)
        and (_G.zz_ui_inventory_better_stats_bars.show_full_stats == true)
        and (bsb_updates == 1)

    mock_gui.mode = "loot"
    mock_gui.hover = { bag = "actor_bag", idx = 1 }
    local lb_y_res = inv_on_button_y()
    local lb_x_loot = inv_on_button_x()
    mock_gui.mode = "trade"
    local lb_x_trade = inv_on_button_x()
    mock_gui.mode = "inventory"
    mock_gui.hover = { bag = "actor_bag", idx = 1 }
    local lb_dpad_snap = cursor_dpad_snap(625, 225, 1)
    local lb_q_specs = inv_get_quick_slot_hint_specs(mock_gui)
    local lb_off = inv_set_lb_modifier(false)
    local lb_ok = lb_flags_ok
        and (lb_on == "ok:lb=1;ctrl=1;full_stats=1")
        and (lb_y_res == "ok:y_db;bag=actor_bag;idx=1;ctrl=1")
        and (lb_x_loot ~= "ok:lb_x_loot_take_all")
        and (lb_x_trade ~= "ok:lb_x_trade_sell_buy")
        and (lb_dpad_snap == "snap:0")
        and (type(lb_q_specs) == "table" and #lb_q_specs == 4)
        and (lb_off == "ok:lb=0;ctrl=0;full_stats=0")
        and (not inv_is_lb_modifier_active())

    -- Test 6: Stack shrink (ResetToChild) focus & selection retention in RemoveIndex
    actor_bag_cc.selected = 2
    actor_bag_cc.hover.idx = 2
    mock_gui.hover = { bag = "actor_bag", idx = 2 }
    cell_2.ID = 503 -- ResetToChild promoted child 503 before RemoveIndex(502)
    cell_2.highlighted = false
    actor_bag_cc:RemoveIndex(502, "bandage", 2)
    local stack_ok = (actor_bag_cc.selected == 2)
        and (actor_bag_cc.hover.idx == 2)
        and (mock_gui.hover.bag == "actor_bag" and mock_gui.hover.idx == 2)
        and (actor_bag_cc.indx_id[503] == 2)
        and (cell_2.highlighted == true)

    -- Restore globals
    _G.ui_inventory = saved_ui_inv
    _G.utils_ui = saved_uui
    _G.zz_ui_inventory_better_stats_bars = saved_bsb
    bridge_stats.active_source = saved_src

    local summary = string.format(
        "ok:selftest=%s;a_drag_no_false_db=%s;y_direct_db=%s;x_props_b_close=%s;lt_rt_2step_sort=%s;view_panels=%s;lb_modifier=%s;stack_focus_kept=%s",
        tostring(mode_arg or "fg2"),
        a_drag_ok and "pass" or "fail",
        y_ok and "pass" or "fail",
        x_b_ok and "pass" or "fail",
        sort_ok and "pass" or "fail",
        view_ok and "pass" or "fail",
        lb_ok and "pass" or "fail",
        stack_ok and "pass" or "fail"
    )

    local report = {
        summary = summary,
        a_drag_ok = a_drag_ok,
        y_ok = y_ok,
        x_b_ok = x_b_ok,
        sort_ok = sort_ok,
        view_ok = view_ok,
        lb_ok = lb_ok,
        stack_ok = stack_ok,
        status = get_fg2_status(),
    }

    if printf then
        pcall(printf, "* [Gamepad] gp_bridge_selftest fg2: %s", summary)
    end

    return summary, report
end

-- ============================================================================
-- F4.1 (D11, D33, D49; docs/10-pause-and-transactions.md sec.3-sec.6):
-- Lua-side Transaction Dispatcher (Categories A / B / C / D),
-- Duplicate-A guard while Pending until GE_OWNERSHIP_* / GEG_PLAYER_ITEM2*,
-- Timeout rollback on Device.dwTimeContinual without auto-retry,
-- and StableItemID re-verification for deferred Category C actions.
-- ============================================================================

local txn_state = {
    next_id            = 1,
    records            = {},
    pending_b_by_id    = {},
    started_a          = 0,
    started_b          = 0,
    started_c          = 0,
    started_d          = 0,
    confirmed          = 0,
    failed             = 0,
    cancelled          = 0,
    timed_out          = 0,
    duplicate_a_blocked = 0,
    stale_c_rejected   = 0,
    last_b_delta_frames = 0,
}

local function extract_item_id_and_stable(item_or_ref)
    if type(item_or_ref) == "table" and item_or_ref.object_id ~= nil then
        local id = tonumber(item_or_ref.object_id) or -1
        return id, {
            session_gen  = tonumber(item_or_ref.session_gen) or 1,
            object_id    = id,
            instance_gen = tonumber(item_or_ref.instance_gen) or 1,
        }
    end
    if (type(item_or_ref) == "table" or type(item_or_ref) == "userdata") and type(item_or_ref.id) == "function" then
        local ok_id, id = pcall(item_or_ref.id, item_or_ref)
        if ok_id and type(id) == "number" then
            return id, make_stable_item_id(id)
        end
    end
    if type(item_or_ref) == "number" then
        return item_or_ref, make_stable_item_id(item_or_ref)
    end
    return -1, nil
end

function txn_clear()
    txn_state.next_id = 1
    txn_state.records = {}
    txn_state.pending_b_by_id = {}
    txn_state.started_a = 0
    txn_state.started_b = 0
    txn_state.started_c = 0
    txn_state.started_d = 0
    txn_state.confirmed = 0
    txn_state.failed = 0
    txn_state.cancelled = 0
    txn_state.timed_out = 0
    txn_state.duplicate_a_blocked = 0
    txn_state.stale_c_rejected = 0
    txn_state.last_b_delta_frames = 0
    return true
end

function txn_is_item_locked(item_or_ref)
    local id, stable = extract_item_id_and_stable(item_or_ref)
    if id < 0 then
        return false
    end
    local pending_rec = txn_state.pending_b_by_id[id]
    if pending_rec and pending_rec.state == "Pending" then
        if not stable or not pending_rec.stable_id or pending_rec.stable_id.object_id == stable.object_id then
            return true
        end
    end
    if game and type(game.is_gamepad_item_txn_locked) == "function" then
        local ok_cpp, locked_cpp = pcall(game.is_gamepad_item_txn_locked, id)
        if ok_cpp and locked_cpp == true then
            return true
        end
    end
    return false
end

function txn_begin(category, op_name, item_or_ref, expected_event, timeout_ms, start_frame_opt, start_ms_opt)
    local cat = string.upper(tostring(category or "A"))
    local cur_ms = tonumber(start_ms_opt) or (time_continual and time_continual()) or (time_global and time_global()) or 0
    local cur_frame = tonumber(start_frame_opt) or ((device and (device().frame or device().dwFrame)) or 0)
    local id, stable = extract_item_id_and_stable(item_or_ref)

    if cat == "A" then
        local tid = txn_state.next_id
        txn_state.next_id = tid + 1
        local rec = {
            txn_id = tid,
            category = "A",
            state = "Confirmed",
            op_name = tostring(op_name or "cat_a"),
            item_id = id,
            stable_id = stable,
            start_frame = cur_frame,
            done_frame = cur_frame,
            delta_frames = 0,
            start_time_ms = cur_ms,
            done_time_ms = cur_ms,
            timeout_ms = 0,
            reason = "ok:sync_ui",
        }
        txn_state.records[tid] = rec
        txn_state.started_a = txn_state.started_a + 1
        txn_state.confirmed = txn_state.confirmed + 1
        return true, tid, "Confirmed"
    elseif cat == "B" then
        if id < 0 or not stable then
            txn_state.failed = txn_state.failed + 1
            return false, 0, "err:invalid_stable_id"
        end
        if txn_is_item_locked(stable) then
            txn_state.duplicate_a_blocked = txn_state.duplicate_a_blocked + 1
            return false, 0, "err:duplicate_a_blocked_while_pending"
        end
        local tid = txn_state.next_id
        txn_state.next_id = tid + 1
        local rec = {
            txn_id = tid,
            category = "B",
            state = "Pending",
            op_name = tostring(op_name or "cat_b"),
            item_id = id,
            stable_id = stable,
            expected_event = tostring(expected_event or "ANY_GE"),
            start_frame = cur_frame,
            done_frame = 0,
            delta_frames = 0,
            start_time_ms = cur_ms,
            done_time_ms = 0,
            timeout_ms = tonumber(timeout_ms) or 500,
            reason = "pending:awaiting_ge",
        }
        txn_state.records[tid] = rec
        txn_state.pending_b_by_id[id] = rec
        txn_state.started_b = txn_state.started_b + 1
        return true, tid, "Pending"
    elseif cat == "C" then
        if id < 0 or not stable then
            txn_state.failed = txn_state.failed + 1
            return false, 0, "err:invalid_stable_id"
        end
        if txn_is_item_locked(stable) then
            txn_state.duplicate_a_blocked = txn_state.duplicate_a_blocked + 1
            return false, 0, "err:item_locked_in_category_b"
        end
        local tid = txn_state.next_id
        txn_state.next_id = tid + 1
        local rec = {
            txn_id = tid,
            category = "C",
            state = "Pending",
            op_name = tostring(op_name or "cat_c"),
            item_id = id,
            stable_id = stable,
            expected_event = tostring(expected_event or "DEFERRED"),
            start_frame = cur_frame,
            done_frame = 0,
            delta_frames = 0,
            start_time_ms = cur_ms,
            done_time_ms = 0,
            timeout_ms = 0,
            reason = "pending:deferred_until_unpause",
        }
        txn_state.records[tid] = rec
        txn_state.started_c = txn_state.started_c + 1
        return true, tid, "Pending"
    elseif cat == "D" then
        for _, r in pairs(txn_state.records) do
            if r.state == "Pending" then
                r.state = "Cancelled"
                r.done_frame = cur_frame
                r.delta_frames = (cur_frame >= r.start_frame) and (cur_frame - r.start_frame) or 0
                r.done_time_ms = cur_ms
                r.reason = "cancelled:context_change_d"
                txn_state.cancelled = txn_state.cancelled + 1
            end
        end
        txn_state.pending_b_by_id = {}
        local tid = txn_state.next_id
        txn_state.next_id = tid + 1
        local rec = {
            txn_id = tid,
            category = "D",
            state = "Confirmed",
            op_name = tostring(op_name or "cat_d"),
            item_id = -1,
            start_frame = cur_frame,
            done_frame = cur_frame,
            delta_frames = 0,
            start_time_ms = cur_ms,
            done_time_ms = cur_ms,
            timeout_ms = 0,
            reason = "ok:context_changed_barrier_engaged",
        }
        txn_state.records[tid] = rec
        txn_state.started_d = txn_state.started_d + 1
        txn_state.confirmed = txn_state.confirmed + 1
        return true, tid, "Confirmed"
    end
    return false, 0, "err:unknown_category:" .. tostring(cat)
end

function txn_confirm_event(event_name, item_id, current_frame_opt, now_ms_opt)
    local id = tonumber(item_id) or -1
    local rec = txn_state.pending_b_by_id[id]
    if not rec or rec.state ~= "Pending" then
        return false, 0, "err:no_pending_b_for_item"
    end
    local ev = tostring(event_name or "ANY_GE")
    if rec.expected_event ~= "ANY_GE" and ev ~= "ANY_GE" and rec.expected_event ~= ev then
        return false, 0, "err:event_mismatch"
    end
    local cur_frame = tonumber(current_frame_opt) or ((device and (device().frame or device().dwFrame)) or (rec.start_frame + 1))
    local cur_ms = tonumber(now_ms_opt) or (time_continual and time_continual()) or (time_global and time_global()) or 0
    rec.state = "Confirmed"
    rec.done_frame = cur_frame
    rec.delta_frames = (cur_frame >= rec.start_frame) and (cur_frame - rec.start_frame) or 0
    rec.done_time_ms = cur_ms
    rec.reason = "ok:ge_confirmed:" .. ev
    txn_state.pending_b_by_id[id] = nil
    txn_state.confirmed = txn_state.confirmed + 1
    txn_state.last_b_delta_frames = rec.delta_frames
    return true, rec.txn_id, rec.delta_frames
end

function txn_verify_and_commit_c(txn_id, current_stable_id, current_frame_opt, now_ms_opt)
    local rec = txn_state.records[tonumber(txn_id) or 0]
    if not rec or rec.state ~= "Pending" or rec.category ~= "C" then
        return false, "err:no_pending_c"
    end
    local cur_frame = tonumber(current_frame_opt) or ((device and (device().frame or device().dwFrame)) or rec.start_frame)
    local cur_ms = tonumber(now_ms_opt) or (time_continual and time_continual()) or (time_global and time_global()) or 0
    local expected = rec.stable_id
    if type(current_stable_id) ~= "table"
        or not expected
        or tonumber(current_stable_id.session_gen) ~= tonumber(expected.session_gen)
        or tonumber(current_stable_id.object_id) ~= tonumber(expected.object_id)
        or tonumber(current_stable_id.instance_gen) ~= tonumber(expected.instance_gen)
    then
        rec.state = "Cancelled"
        rec.done_frame = cur_frame
        rec.delta_frames = (cur_frame >= rec.start_frame) and (cur_frame - rec.start_frame) or 0
        rec.done_time_ms = cur_ms
        rec.reason = "err:stale_stable_id"
        txn_state.cancelled = txn_state.cancelled + 1
        txn_state.stale_c_rejected = txn_state.stale_c_rejected + 1
        return false, "err:stale_stable_id"
    end
    rec.state = "Confirmed"
    rec.done_frame = cur_frame
    rec.delta_frames = (cur_frame >= rec.start_frame) and (cur_frame - rec.start_frame) or 0
    rec.done_time_ms = cur_ms
    rec.reason = "ok:deferred_executed"
    txn_state.confirmed = txn_state.confirmed + 1
    return true, "ok:deferred_executed"
end

function txn_cancel(txn_id_or_item_id, reason, current_frame_opt, now_ms_opt)
    local key = tonumber(txn_id_or_item_id) or -1
    local cur_frame = tonumber(current_frame_opt) or ((device and (device().frame or device().dwFrame)) or 0)
    local cur_ms = tonumber(now_ms_opt) or (time_continual and time_continual()) or (time_global and time_global()) or 0
    local rec = txn_state.records[key] or txn_state.pending_b_by_id[key]
    if not rec or rec.state ~= "Pending" then
        return false, "err:not_pending"
    end
    rec.state = "Cancelled"
    rec.done_frame = cur_frame
    rec.delta_frames = (cur_frame >= rec.start_frame) and (cur_frame - rec.start_frame) or 0
    rec.done_time_ms = cur_ms
    rec.reason = tostring(reason or "cancelled")
    if rec.item_id and txn_state.pending_b_by_id[rec.item_id] == rec then
        txn_state.pending_b_by_id[rec.item_id] = nil
    end
    txn_state.cancelled = txn_state.cancelled + 1
    return true, rec.reason
end

function txn_step_timeouts(now_ms_opt, current_frame_opt)
    local cur_ms = tonumber(now_ms_opt) or (time_continual and time_continual()) or (time_global and time_global()) or 0
    local cur_frame = tonumber(current_frame_opt) or ((device and (device().frame or device().dwFrame)) or 0)
    local expired = 0
    for item_id, rec in pairs(txn_state.pending_b_by_id) do
        if rec.state == "Pending" and rec.timeout_ms and rec.timeout_ms > 0 then
            local elapsed = (cur_ms >= rec.start_time_ms) and (cur_ms - rec.start_time_ms) or 0
            if elapsed >= rec.timeout_ms then
                rec.state = "TimedOut"
                rec.done_frame = cur_frame
                rec.delta_frames = (cur_frame >= rec.start_frame) and (cur_frame - rec.start_frame) or 0
                rec.done_time_ms = cur_ms
                rec.reason = "err:timeout_no_autoretry"
                txn_state.pending_b_by_id[item_id] = nil
                txn_state.timed_out = txn_state.timed_out + 1
                expired = expired + 1
            end
        end
    end
    return expired
end

function get_txn_status()
    local pending_b = 0
    for _, r in pairs(txn_state.pending_b_by_id) do
        if r.state == "Pending" then
            pending_b = pending_b + 1
        end
    end
    return string.format(
        "ok:pending_b=%d;started=(A=%d,B=%d,C=%d,D=%d);confirmed=%d;dup_a_blocked=%d;timed_out=%d;stale_c_rejected=%d;last_b_delta_frames=%d",
        pending_b,
        txn_state.started_a,
        txn_state.started_b,
        txn_state.started_c,
        txn_state.started_d,
        txn_state.confirmed,
        txn_state.duplicate_a_blocked,
        txn_state.timed_out,
        txn_state.stale_c_rejected,
        txn_state.last_b_delta_frames
    )
end

function selftest_f41_transactions(mode_arg)
    txn_clear()

    -- 1. Category A: sync UI confirm in same frame (delta_frames = 0)
    local st_a = { session_gen = 1, object_id = 801, instance_gen = 8001 }
    local ok_a, tid_a, state_a = txn_begin("A", "SP_fav", st_a, nil, 0, 100, 1000)
    local cat_a_ok = (ok_a == true) and (tid_a == 1) and (state_a == "Confirmed") and (not txn_is_item_locked(st_a))

    -- 2. Category B: duplicate A blocked while Pending until GEG_PLAYER_ITEM2SLOT on frame +1
    local st_b = { session_gen = 1, object_id = 802, instance_gen = 8002 }
    local ok_b1, tid_b1, state_b1 = txn_begin("B", "Action_Equip", st_b, "GEG_PLAYER_ITEM2SLOT", 500, 200, 2000)
    local locked_during_b = txn_is_item_locked(st_b)
    local ok_b_dup, _, reason_b_dup = txn_begin("B", "Action_Equip_Dup", st_b, "GEG_PLAYER_ITEM2SLOT", 500, 200, 2005)
    local ok_conf, conf_tid, delta_f = txn_confirm_event("GEG_PLAYER_ITEM2SLOT", 802, 201, 2016)
    local unlocked_after_b = not txn_is_item_locked(st_b)
    local cat_b_ok = (ok_b1 == true)
        and (state_b1 == "Pending")
        and locked_during_b
        and (ok_b_dup == false)
        and (reason_b_dup == "err:duplicate_a_blocked_while_pending")
        and (ok_conf == true)
        and (conf_tid == tid_b1)
        and (delta_f == 1)
        and unlocked_after_b

    -- 3. Category B Timeout: unlocks after 500ms on continual clock without auto-retry
    local st_to = { session_gen = 1, object_id = 803, instance_gen = 8003 }
    local ok_to, _, _ = txn_begin("B", "Action_Drop", st_to, "GE_OWNERSHIP_REJECT", 500, 300, 3000)
    local exp_early = txn_step_timeouts(3400, 310)
    local still_locked = txn_is_item_locked(st_to)
    local exp_late = txn_step_timeouts(3500, 320)
    local unlocked_to = not txn_is_item_locked(st_to)
    local cat_to_ok = (ok_to == true) and (exp_early == 0) and still_locked and (exp_late == 1) and unlocked_to

    -- 4. Category C: deferred queue + stale instance_gen rejection
    local st_c_orig = { session_gen = 1, object_id = 804, instance_gen = 8004 }
    local st_c_reused = { session_gen = 1, object_id = 804, instance_gen = 8005 }
    local ok_c1, tid_c1 = txn_begin("C", "EatItem", st_c_orig, "GEG_PLAYER_ITEM_EAT", 0, 400, 4000)
    local ok_c_stale, reason_c_stale = txn_verify_and_commit_c(tid_c1, st_c_reused, 420, 4300)
    local ok_c2, tid_c2 = txn_begin("C", "EatItem", st_c_orig, "GEG_PLAYER_ITEM_EAT", 0, 430, 4400)
    local ok_c_valid = txn_verify_and_commit_c(tid_c2, st_c_orig, 440, 4500)
    local cat_c_ok = (ok_c1 == true)
        and (ok_c_stale == false)
        and (reason_c_stale == "err:stale_stable_id")
        and (ok_c2 == true)
        and (ok_c_valid == true)

    -- 5. Category D: context change cancels pending B and C
    local st_d_item = { session_gen = 1, object_id = 805, instance_gen = 8005 }
    local ok_pre_d = txn_begin("B", "TransferItem", st_d_item, "GE_OWNERSHIP_TAKE", 500, 500, 5000)
    local ok_d = txn_begin("D", "UISleep", nil, nil, 0, 501, 5016)
    local cat_d_ok = (ok_pre_d == true) and (ok_d == true) and (not txn_is_item_locked(st_d_item))

    local summary = string.format(
        "ok:selftest=%s;cat_a=%s;cat_b_dup_guard_delta1=%s;cat_b_timeout_no_retry=%s;cat_c_stale_gen=%s;cat_d_cancel=%s",
        tostring(mode_arg or "txn"),
        cat_a_ok and "pass" or "fail",
        cat_b_ok and "pass" or "fail",
        cat_to_ok and "pass" or "fail",
        cat_c_ok and "pass" or "fail",
        cat_d_ok and "pass" or "fail"
    )

    local report = {
        summary = summary,
        cat_a_ok = cat_a_ok,
        cat_b_ok = cat_b_ok,
        cat_to_ok = cat_to_ok,
        cat_c_ok = cat_c_ok,
        cat_d_ok = cat_d_ok,
        status = get_txn_status(),
    }

    if printf then
        pcall(printf, "* [Gamepad] gp_bridge_selftest txn: %s", summary)
    end

    return summary, report
end

function gp_live_reload_inventory(opts)
    if _G.gp_inv_pause and type(_G.gp_inv_pause.gp_live_reload_inventory) == "function" then
        return _G.gp_inv_pause.gp_live_reload_inventory(opts)
    end
    return "err:no_gp_inv_pause"
end

if _G then
    _G.gp_bridge_selftest = gp_bridge_selftest
    _G.gp_live_reload_inventory = gp_live_reload_inventory
end

function on_game_start()
    -- REL1 / I2.1: run startup self-diagnostics before registering runtime callbacks
    if _G and _G.gp_compat and type(_G.gp_compat.run_startup_diagnostics) == "function" then
        pcall(_G.gp_compat.run_startup_diagnostics)
        if type(_G.gp_compat.is_engine_compatible) == "function" and not _G.gp_compat.is_engine_compatible() then
            return
        end
    end
    -- F3.3 N-2: install D54 SortingPlus safeguard eagerly at game start
    install_d54_sortingplus_safeguard(_G and _G.ui_inventory and _G.ui_inventory.GUI or nil)
    if not (_G and _G.gp_compat and type(_G.gp_compat.is_subsystem_enabled) == "function") or _G.gp_compat.is_subsystem_enabled("pda") then
        pda_call("on_game_start")
    end
    if RegisterScriptCallback then
        RegisterScriptCallback("actor_on_update", on_actor_update)
        RegisterScriptCallback("GUI_on_show", on_gui_change)
        RegisterScriptCallback("GUI_on_hide", on_gui_change)
        RegisterScriptCallback("on_before_key_press", on_before_key_press_observer)
        RegisterScriptCallback("on_option_change", on_option_change_observer)
    end
end


