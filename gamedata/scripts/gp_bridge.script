local function trim_binding_str(s)
    local str = tostring(s or "")
    return (str:gsub("^%s+", ""):gsub("%s+$", ""))
end

function normalize_binding_context(context_name)
    local raw = trim_binding_str(context_name)
    if raw == "" then
        return "World_Gameplay"
    end
    local mapped = BINDING_CONTEXT_ALIASES[string.lower(raw)]
    return mapped or raw
end

function normalize_binding_button(raw_btn)
    local low = string.lower(trim_binding_str(raw_btn))
    if low == "" then
        return nil
    end
    return BINDING_BUTTON_CANONICAL[low]
end

function parse_binding_trigger_spec(spec_str)
    local s = trim_binding_str(spec_str)
    if s == "" then
        return nil
    end
    local low = string.lower(s)
    if low == "unbound" or low == "none" then
        return {
            type = "unbound",
            kind = "unbound",
            button = nil,
            modifier = nil,
            hold_ms = 0,
            raw = "unbound",
        }
    end
    if low:sub(1, 7) == "button:" or low:sub(1, 6) == "press:" or low:sub(1, 4) == "tap:" then
        local colon = s:find(":", 1, true)
        local btn = normalize_binding_button(s:sub(colon + 1))
        if not btn then return nil end
        return {
            type = "button",
            kind = "button",
            button = btn,
            modifier = nil,
            hold_ms = 0,
            raw = "button:" .. btn,
        }
    end
    if low:sub(1, 5) == "hold:" then
        local rest = s:sub(6)
        local colon2 = rest:find(":", 1, true)
        local btn_part = colon2 and rest:sub(1, colon2 - 1) or rest
        local ms_part = colon2 and rest:sub(colon2 + 1) or "300"
        local btn = normalize_binding_button(btn_part)
        if not btn then return nil end
        local ms = math.floor(tonumber(trim_binding_str(ms_part)) or 300)
        if ms < 100 then ms = 100 end
        if ms > 2000 then ms = 2000 end
        return {
            type = "hold",
            kind = "hold",
            button = btn,
            modifier = nil,
            hold_ms = ms,
            raw = string.format("hold:%s:%d", btn, ms),
        }
    end
    if low:sub(1, 6) == "chord:" or s:find("+", 1, true) then
        local rest = (low:sub(1, 6) == "chord:") and s:sub(7) or s
        local sep = rest:find("+", 1, true) or rest:find(":", 1, true)
        if not sep then return nil end
        local mod = normalize_binding_button(rest:sub(1, sep - 1))
        local btn = normalize_binding_button(rest:sub(sep + 1))
        if not mod or not btn then return nil end
        return {
            type = "chord",
            kind = "chord",
            button = btn,
            modifier = mod,
            hold_ms = 0,
            raw = "chord:" .. mod .. "+" .. btn,
        }
    end
    local bare = normalize_binding_button(s)
    if bare then
        return {
            type = "button",
            kind = "button",
            button = bare,
            modifier = nil,
            hold_ms = 0,
            raw = "button:" .. bare,
        }
    end
    return nil
end

function set_custom_binding_profile_path(path)
    custom_binding_profile_path = path
    cached_binding_profile_model = nil
    return true
end

function set_custom_binding_profile_text(ltx_text)
    custom_binding_profile_text = ltx_text
    cached_binding_profile_model = nil
    return true
end

function resolve_binding_profile_path()
    if type(custom_binding_profile_path) == "string" and custom_binding_profile_path ~= "" then
        return custom_binding_profile_path
    end
    if _G.getFS then
        local ok, fs = pcall(_G.getFS)
        if ok and fs and type(fs.update_path) == "function" then
            local ok_p, p = pcall(fs.update_path, fs, "$app_data_root$", "gamepad\\profile.ltx")
            if ok_p and type(p) == "string" and p ~= "" then
                return p
            end
        end
    end
    return "appdata\\gamepad\\profile.ltx"
end

local function read_binding_profile_text(explicit_path)
    if type(custom_binding_profile_text) == "string" then
        return custom_binding_profile_text, "memory"
    end
    local path = explicit_path or resolve_binding_profile_path()
    if type(io) == "table" and type(io.open) == "function" then
        local f = io.open(path, "rb")
        if f then
            local content = f:read("*a")
            f:close()
            return content, path
        end
    end
    return nil, path
end

local function build_binding_profile_model(ltx_text)
    local model = {}
    for ctx_name, def_list in pairs(DEFAULT_CONTEXT_BINDINGS) do
        local ctx_map = {}
        for i = 1, #def_list do
            local entry = def_list[i]
            local trig = parse_binding_trigger_spec(entry.spec)
            if trig and trig.type ~= "unbound" then
                ctx_map[entry.action] = trig
            end
        end
        model[ctx_name] = ctx_map
    end

    if type(ltx_text) == "string" and ltx_text ~= "" then
        local cur_ctx = nil
        for raw_line in ltx_text:gmatch("[^\r\n]+") do
            local line = trim_binding_str(raw_line)
            if line ~= "" and line:sub(1, 1) ~= ";" and line:sub(1, 1) ~= "#" and line:sub(1, 2) ~= "//" then
                if line:sub(1, 1) == "[" then
                    local close_pos = line:find("]", 1, true)
                    local sec_name = close_pos and trim_binding_str(line:sub(2, close_pos - 1)) or ""
                    if sec_name:sub(1, 8) == "context_" then
                        cur_ctx = normalize_binding_context(sec_name:sub(9))
                        if not model[cur_ctx] then
                            model[cur_ctx] = {}
                        end
                    else
                        cur_ctx = nil
                    end
                elseif cur_ctx and model[cur_ctx] then
                    local eq_pos = line:find("=", 1, true)
                    if eq_pos and eq_pos > 1 then
                        local act = trim_binding_str(line:sub(1, eq_pos - 1))
                        local val = trim_binding_str(line:sub(eq_pos + 1))
                        local semi = val:find(";", 1, true)
                        if semi then val = trim_binding_str(val:sub(1, semi - 1)) end
                        local slashes = val:find("//", 1, true)
                        if slashes then val = trim_binding_str(val:sub(1, slashes - 1)) end
                        if act == "PanelSwitch" and cur_ctx == "MenuUI" then
                            act = "SwitchPanel"
                        elseif act == "AmmoType" and cur_ctx == "World_Gameplay" then
                            act = "AmmoTypeNext"
                        end
                        local trig = parse_binding_trigger_spec(val)
                        if trig then
                            local ctx_map = model[cur_ctx]
                            if trig.type == "unbound" then
                                ctx_map[act] = nil
                            else
                                for other_act, other_trig in pairs(ctx_map) do
                                    if other_act ~= act and other_trig.type == trig.type then
                                        if trig.type == "chord" then
                                            if other_trig.modifier == trig.modifier and other_trig.button == trig.button then
                                                ctx_map[other_act] = nil
                                            end
                                        elseif other_trig.button == trig.button then
                                            ctx_map[other_act] = nil
                                        end
                                    end
                                end
                                ctx_map[act] = trig
                            end
                        end
                    end
                end
            end
        end
    end

    return model
end

function reload_binding_profile(explicit_ltx_text)
    if type(explicit_ltx_text) == "string" then
        custom_binding_profile_text = explicit_ltx_text
    end
    local text = read_binding_profile_text()
    cached_binding_profile_model = build_binding_profile_model(text)
    return cached_binding_profile_model
end

local function ensure_binding_profile_model()
    if not cached_binding_profile_model then
        reload_binding_profile()
    end
    return cached_binding_profile_model
end

function get_binding(context_name, action_name)
    local ctx = normalize_binding_context(context_name)
    local act = trim_binding_str(action_name)
    if act == "" then
        return nil
    end
    if act == "PanelSwitch" and ctx == "MenuUI" then
        act = "SwitchPanel"
    elseif act == "AmmoType" and ctx == "World_Gameplay" then
        act = "AmmoTypeNext"
    end
    local model = ensure_binding_profile_model()
    local ctx_map = model and model[ctx]
    local trig = ctx_map and ctx_map[act]
    if not trig then
        return nil
    end
    return {
        type = trig.type,
        kind = trig.kind,
        button = trig.button,
        modifier = trig.modifier,
        hold_ms = trig.hold_ms,
        raw = trig.raw,
    }
end

function get_action_for_trigger(context_name, trigger_type, button_name, modifier_name)
    local ctx = normalize_binding_context(context_name)
    local t_low = string.lower(trim_binding_str(trigger_type))
    if t_low == "tap" or t_low == "press" or t_low == "" then
        t_low = "button"
    end
    local btn = normalize_binding_button(button_name)
    if not btn then
        return nil
    end
    local mod = modifier_name and normalize_binding_button(modifier_name) or nil
    local model = ensure_binding_profile_model()
    local ctx_map = model and model[ctx]
    if not ctx_map then
        return nil
    end
    for act, trig in pairs(ctx_map) do
        if trig.type == t_low and trig.button == btn then
            if t_low == "chord" then
                if trig.modifier == mod then
                    return act
                end
            else
                return act
            end
        end
    end
    return nil
end

function dispatch_world_action(action_name, phase, button_name)
    local act = trim_binding_str(action_name)
    if act == "" then
        return "ignored:empty_action"
    end
    if act == "AmmoWheel" or act == "AmmoType" then
        act = "AmmoTypeNext"
    end
    local ph = string.lower(trim_binding_str(phase or "tap"))
    if ph == "" then ph = "tap" end
    local btn = button_name and normalize_binding_button(button_name) or nil
    if not btn then
        local trig = get_binding("World_Gameplay", act)
        btn = trig and trig.button or nil
    end

    if ph == "release" or ph == "released" then
        if act == "WeaponWheel" and gp_wheel and type(gp_wheel.on_gamepad_wheel_hold_released) == "function" then
            return gp_wheel.on_gamepad_wheel_hold_released(btn)
        elseif act == "Jump" and gp_field and type(gp_field.on_world_action) == "function" then
            return gp_field.on_world_action("Jump", "release", btn)
        end
        return "ignored:release_" .. act
    end

    if act == "ContextUseReload" or act == "AmmoCheck" or act == "FastReload" or act == "FastUpgrade" or act == "ScriptUseTarget" or act == "NextWeapon" then
        if gp_weapon and type(gp_weapon.on_world_action) == "function" then
            return gp_weapon.on_world_action(act, ph, btn)
        end
    end

    if gp_field and type(gp_field.on_world_action) == "function" then
        return gp_field.on_world_action(act, ph, btn)
    end
    return "ignored:unknown_action_" .. act
end

function dispatch_world_trigger(trigger_type, button_name, modifier_name)
    local t_low = string.lower(trim_binding_str(trigger_type or "button"))
    local btn = normalize_binding_button(button_name)
    if not btn then
        return "ignored:invalid_button", nil
    end
    if t_low == "release" or t_low == "released" then
        local wheel_trig = get_binding("World_Gameplay", "WeaponWheel")
        if wheel_trig and wheel_trig.button == btn then
            return dispatch_world_action("WeaponWheel", "release", btn), "WeaponWheel"
        end
        local jump_trig = get_binding("World_Gameplay", "Jump")
        if jump_trig and jump_trig.button == btn then
            return dispatch_world_action("Jump", "release", btn), "Jump"
        end
        return "ignored:no_release_binding:" .. btn, nil
    end
    local act = get_action_for_trigger("World_Gameplay", t_low, btn, modifier_name)
    if not act then
        return "unbound:" .. t_low .. ":" .. tostring(modifier_name and ( tostring(normalize_binding_button(modifier_name)) .. "+" .. btn ) or btn), nil
    end
    return dispatch_world_action(act, t_low, btn), act
end

-- =============================================================================
-- K4 (D61): MenuUI Profile Resolution & Inventory Button Dispatch
-- Maps physical buttons and semantic actions in ContextId::MenuUI so that
-- remapping or swapping buttons (e.g. X <-> Y) in appdata\gamepad\profile.ltx
-- immediately changes inventory and menu screen actions and glyph hints,
-- while preserving the LB modifier layer, RB medicine filter, and LB+D-Pad F1-F4.
-- =============================================================================

local MENU_BUTTON_DEFAULT_ACTION = {
    A     = "Confirm",
    B     = "Back",
    X     = "ContextMenu",
    Y     = "QuickAction",
    LB    = "TabPrev",
    RB    = "TabNext",
    LT    = "PagePrev",
    RT    = "PageNext",
    Back  = "SwitchPanel",
    Start = "Menu",
    L3    = "CancelQueue",
    R3    = "MouseCursor",
}

local MENU_ACTION_CANONICAL = {
    confirm     = "Confirm",
    back        = "Back",
    contextmenu = "ContextMenu",
    quickaction = "QuickAction",
    tabprev     = "TabPrev",
    tabnext     = "TabNext",
    pageprev    = "PagePrev",
    pagenext    = "PageNext",
    switchpanel = "SwitchPanel",
    panelswitch = "SwitchPanel",
    menu        = "Menu",
    cancelqueue = "CancelQueue",
    mousecursor = "MouseCursor",
}

function get_menu_button_for_action(action_name)
    local raw = trim_binding_str(action_name)
    local canon_act = MENU_ACTION_CANONICAL[string.lower(raw)] or raw
    local trig = get_binding("MenuUI", canon_act)
    if trig and trig.button then
        return trig.button
    end
    for def_btn, def_act in pairs(MENU_BUTTON_DEFAULT_ACTION) do
        if def_act == canon_act then
            return def_btn
        end
    end
    return nil
end

function get_menu_action_for_button(button_name, trigger_type, modifier_name)
    local btn = normalize_binding_button(button_name)
    if not btn then
        return nil
    end
    local t_low = string.lower(trim_binding_str(trigger_type or "button"))
    if t_low == "tap" or t_low == "press" or t_low == "" then
        t_low = "button"
    end
    local act = get_action_for_trigger("MenuUI", t_low, btn, modifier_name)
    if act then
        return act
    end
    local model = ensure_binding_profile_model()
    local ctx_map = model and model.MenuUI
    local def_act = (t_low == "button" and not modifier_name) and MENU_BUTTON_DEFAULT_ACTION[btn] or nil
    if def_act and (not ctx_map or ctx_map[def_act] ~= nil) then
        return def_act
    end
    return nil
end

function resolve_menu_button_for_hint(name)
    local raw = trim_binding_str(name)
    if raw == "" then
        return ""
    end
    local canon_act = MENU_ACTION_CANONICAL[string.lower(raw)]
    if canon_act then
        local bound_btn = get_menu_button_for_action(canon_act)
        if bound_btn then
            return (bound_btn == "Back" and raw == "View") and "View" or bound_btn
        end
    end
    local btn = normalize_binding_button(raw)
    local def_act = btn and MENU_BUTTON_DEFAULT_ACTION[btn] or nil
    if def_act then
        local bound_btn = get_menu_button_for_action(def_act)
        if bound_btn and bound_btn ~= btn then
            return (bound_btn == "Back" and raw == "View") and "View" or bound_btn
        end
    end
    return raw
end

function dispatch_menu_action(action_name, arg)
    local raw = trim_binding_str(action_name)
    if raw == "" then
        return "ignored:empty_menu_action"
    end
    local act = MENU_ACTION_CANONICAL[string.lower(raw)] or raw
    if act == "QuickAction" then
        -- INV-REWORK-1: Y прячет/показывает описание (быстрое действие убрано)
        local rw = rw_mod()
        if rw then
            return rw.toggle_desc()
        end
        return inv_exec_quick_action()
    elseif act == "ContextMenu" then
        return inv_exec_context_menu()
    elseif act == "Confirm" then
        return inv_exec_confirm_in_props()
    elseif act == "Back" then
        -- INV-REWORK-4: B in the "apply to" pick mode leaves the pick, the inventory stays open
        local rw = rw_mod()
        if rw and rw.pick_cancel and rw.pick_cancel() then
            return "pick:cancel"
        end
        -- INV-REWORK-14: B in the stats panel returns the frame where it was (inventory stays open)
        if rw and rw.view_back then
            local vb = rw.view_back()
            if vb then return vb end
        end
        local back_res = inv_exec_back()
        if back_res == "closed_picker" and rw and rw.view_after_picker_closed then
            pcall(rw.view_after_picker_closed)
        end
        return back_res
    elseif (act == "TabPrev" or act == "TabNext") and arg ~= false and rw_mod() and rw_mod().picker_step
        and rw_mod().picker_shown and rw_mod().picker_shown(ui_inventory and ui_inventory.GUI) then
        -- REWORK-6: stack menu open -> LB/RB step through its stacks (LB+D-pad quick slots wait)
        return rw_mod().picker_step(act == "TabNext" and 1 or -1)
    elseif act == "TabPrev" then
        if type(arg) == "boolean" then
            return inv_exec_lb_modifier(arg)
        end
        return inv_exec_lb_modifier(not inv_is_lb_modifier_active())
    elseif act == "TabNext" then
        -- INV-REWORK-15 (п.5, Миша 2026-11-12): RB только листает стопку в открытом меню стаков (ветка выше);
        -- прыжок во вкладку «Медицина» (FG.6k3) убран, функция inv_exec_medicine_filter оставлена.
        return "ok:rb=none"
    elseif act == "PagePrev" then
        return inv_exec_cycle_sort_tab(-1)
    elseif act == "PageNext" then
        return inv_exec_cycle_sort_tab(1)
    elseif act == "SwitchPanel" then
        -- INV-REWORK-1: View листает Инвентарь -> Снаряжение -> Характеристики
        local rw = rw_mod()
        if rw then
            return rw.exec_cycle_panel()
        end
        return inv_exec_switch_panel_view()
    elseif act == "CancelQueue" then
        if _G.gp_lifecycle and type(_G.gp_lifecycle.on_l3_cancel_queue) == "function" then
            return _G.gp_lifecycle.on_l3_cancel_queue()
        end
        return nil
    elseif act == "MouseCursor" then
        if _G.gp_cursor and type(_G.gp_cursor.toggle_mouse_mode) == "function" then
            return _G.gp_cursor.toggle_mouse_mode("menu_action")
        end
        return nil
    elseif act == "Menu" then
        return "ok:menu_start"
    end
    return "ignored:unknown_menu_action_" .. act
end

function dispatch_menu_trigger(trigger_type, button_name, arg, modifier_name)
    local t_low = string.lower(trim_binding_str(trigger_type or "button"))
    if t_low == "tap" or t_low == "press" or t_low == "" then
        t_low = "button"
    end
    local btn = normalize_binding_button(button_name)
    if not btn then
        return "ignored:invalid_button", nil
    end
    local act = get_menu_action_for_button(btn, t_low, modifier_name)
    if not act then
        return "unbound:" .. t_low .. ":" .. btn, nil
    end
    return dispatch_menu_action(act, arg), act
end

function on_input_source_changed(new_source_str, prev_source_str, reason_str, time_ms)
    local src = (new_source_str == "gamepad") and "gamepad" or "kbm"
    bridge_stats.active_source = src
    bridge_stats.source_switches = bridge_stats.source_switches + 1
    bridge_stats.last_source_reason = tostring(reason_str or "")
    bridge_stats.last_source_time_ms = tonumber(time_ms) or 0

    for k, fn in pairs(source_listeners) do
        if type(fn) == "function" then
            pcall(fn, src, tostring(prev_source_str or ""), bridge_stats.last_source_reason, bridge_stats.last_source_time_ms)
        end
    end

    -- D1.2b-N1: Dispatch script callback registered via AddScriptCallback("on_gamepad_source_changed")
    if SendScriptCallback then
        pcall(SendScriptCallback, "on_gamepad_source_changed", src, tostring(prev_source_str or ""), bridge_stats.last_source_reason, bridge_stats.last_source_time_ms)
    end

    return "ok:source=" .. src .. ";switches=" .. tostring(bridge_stats.source_switches)
end

function ensure_gui()
    if not ui_inventory then
        return nil, "err:no_ui_inventory_module"
    end

    local created_now = false
    if not ui_inventory.GUI then
        -- L134-136 of ui_inventory.script & L420-422 of custom_functor_autoinject.script:
        -- Create UIInventory instance without ShowDialog(true) and without Register_UI
        ui_inventory.GUI = ui_inventory.UIInventory()
        created_now = true
        bridge_stats.created_headless_count = bridge_stats.created_headless_count + 1
    end

    local gui = ui_inventory.GUI
    if not gui then
        return nil, "err:gui_creation_failed"
    end

    -- Fix C5.1-N3 (D48): ensure_gui() MUST NOT mutate any fields on gui (such as gui.mode),
    -- only creating ui_inventory.GUI if nil.

    local cf_count = 0
    if gui.custom_functor and type(gui.custom_functor) == "table" then
        for k, v in pairs(gui.custom_functor) do
            if v then
                cf_count = cf_count + 1
            end
        end
    end
    bridge_stats.last_custom_functors = cf_count

    return gui, (created_now and "created" or "reused"), cf_count
end

-- Fix C5.1-N1 (D48): Synchronize UIInventory slot & belt containers in the background
-- when UIInventory has not yet been opened in the session, so gui:Action_Equip(obj, "actor_bag")
-- always executes through the full monkey-patch chain (e.g. zzzz_liz_fdda_redone_ui_inventory)
-- without bypassing to raw db.actor:move_to_slot.
function sync_headless_containers_for_equip(gui)
    if not gui then
        return false
    end
    local cc_equ = gui.CC and gui.CC["actor_equ"]
    local has_visible_cells = false
    if cc_equ and type(cc_equ.cell) == "table" then
        for _, ci in pairs(cc_equ.cell) do
            if ci and type(ci.IsShown) == "function" and ci:IsShown() then
                has_visible_cells = true
                break
            end
        end
    end
    -- F3.3 red-team R1: UIInventory:Action_Equip (ui_inventory.script:1253-1261) picks the free slot from
    -- cc.cell[...]:IsShown(). While UIInventory is hidden those cells are NOT refreshed by vanilla, so after the
    -- first sync they go stale (slot changes via hotkeys/wheel/pickup outside the inventory). Re-sync on every
    -- headless equip; when the inventory is shown vanilla keeps the cells fresh itself.
    local gui_shown = false
    if type(gui.IsShown) == "function" then
        local ok_s, s = pcall(gui.IsShown, gui)
        gui_shown = (ok_s and s) and true or false
    end
    if (not has_visible_cells) or (not gui_shown) then
        if type(gui.UpdateSlots) == "function" then
            pcall(gui.UpdateSlots, gui)
        end
        if type(gui.UpdateBelt) == "function" then
            pcall(gui.UpdateBelt, gui)
        end
        bridge_stats.headless_syncs = (bridge_stats.headless_syncs or 0) + 1
        return true
    end
    return false
end

function execute_focus_test_op(item_id, expected_section, action_dir, target_slot)
    bridge_stats.calls = bridge_stats.calls + 1

    local gui, gui_state, cf_count = ensure_gui()
    if not gui then
        return tostring(gui_state)
    end

    if not level or not level.object_by_id then
        return "err:no_level_object_by_id"
    end

    local obj = level.object_by_id(item_id)
    if not obj then
        return "err:object_not_found:" .. tostring(item_id)
    end

    local actual_sec = obj:section()
    if expected_section and expected_section ~= "" and actual_sec ~= expected_section then
        return "err:section_mismatch:" .. tostring(actual_sec) .. "!=" .. tostring(expected_section)
    end

    local checked_obj = gui:CheckItem(obj, "gp_bridge_focus_test")
    if not checked_obj then
        return "err:check_item_failed:" .. tostring(item_id)
    end

    -- Fix C5.1-N3: preserve gui.mode (which may be nil before first inventory open)
    local prev_mode = gui.mode
    if prev_mode == nil then
        gui.mode = "inventory"
    end

    local method_used = "none"
    if action_dir == "to_ruck" then
        gui:Action_UnEquip(checked_obj, "actor_equ")
        method_used = "Action_UnEquip"
    elseif action_dir == "to_slot" then
        -- Fix C5.1-N1 (D48): Always sync slot/belt containers if needed and route through gui:Action_Equip
        sync_headless_containers_for_equip(gui)
        gui:Action_Equip(checked_obj, "actor_bag")
        method_used = "Action_Equip"
    else
        if prev_mode == nil and gui.mode == "inventory" then
            gui.mode = nil
        end
        return "err:unknown_action_dir:" .. tostring(action_dir)
    end

    if prev_mode == nil and gui.mode == "inventory" then
        gui.mode = nil
    end

    bridge_stats.last_op = method_used
    bridge_stats.last_item_id = item_id
    bridge_stats.last_section = actual_sec

    local is_shown = gui:IsShown() and 1 or 0
    return string.format("ok:method=%s;gui=%s;shown=%d;cf=%d;id=%d;sec=%s",
        method_used, tostring(gui_state), is_shown, cf_count or 0, item_id, tostring(actual_sec))
end

function get_bridge_status()
    local gui, gui_state, cf_count = ensure_gui()
    if not gui then
        return tostring(gui_state)
    end
    local is_shown = gui:IsShown() and 1 or 0
    return string.format("ok:calls=%d;headless_created=%d;shown=%d;cf=%d;last_op=%s;last_id=%d;last_sec=%s;active_source=%s;source_switches=%d;last_source_reason=%s;ctx_pushes=%d;before_key_seen=%d",
        bridge_stats.calls,
        bridge_stats.created_headless_count,
        is_shown,
        cf_count or 0,
        tostring(bridge_stats.last_op),
        bridge_stats.last_item_id,
        tostring(bridge_stats.last_section),
        tostring(bridge_stats.active_source),
        bridge_stats.source_switches,
        tostring(bridge_stats.last_source_reason),
        bridge_stats.ctx_hint_pushes or 0,
        bridge_stats.before_key_press_seen or 0)
end

-- D3.2 (REC-4): Read-only Lua context observer without modifying any existing G.A.M.M.A. script.
-- Observes:
--   1. ui_mcm.GUI.k_binder (TextEntry priority 2)
--   2. liz_fdda_input_manager.is_input_disabled (Cutscene_InputBlock priority 4)
--   3. has_alife_info("actor_is_sleeping") (Cutscene_InputBlock priority 4)
--   4. _G._GUIs["UISleep"] / ui_sleep_dialog.GUI (Sleep priority 5)
--   5. Radial wheels: UIHaruQAW(1), UIRadialMenu(2), UI3DSSCamoWheel(3), UIWheelAmmo(4), UIWheelCompanion / idiots_ui(5) (RadialWheel priority 7)
--   6. placeable_furniture.get_state(): HOLDING(2), ADV_CTRL(3), PREVIEW(4) + MCM placement keybinds (Placement_HideoutFurniture priority 8)
--   7. Active modal UI tag (e.g. UIInventory:<mode> or _G._GUIs top name) (MenuUI_Modal priority 10)
-- Pushes flags to C++ via game.set_gamepad_lua_hints(...) ONLY when at least one flag changes (or force == true).

local lua_ctx_cache = {
    initialized = false,
    mcm_bind = false,
    fdda_dis = false,
    sleep_info = false,
    sleep_dlg = false,
    wheel_type = 0,
    placement_state = 0,
    modal_tag = "",
    dik_place = 0,
    dik_collision = 15,
    dik_align = 58,
    dik_controls = 199,
    push_count = 0,
    before_key_seen = 0,
    last_before_key = -1,
    last_before_bind = -1,
    last_before_ret = true
}

local function is_ui_shown_safe(gui_obj)
    if not gui_obj then
        return false
    end
    if type(gui_obj.IsShown) == "function" then
        local ok, res = pcall(gui_obj.IsShown, gui_obj)
        return (ok and res) and true or false
    end
    return false
end

local function check_named_ui(name)
    if Check_UI then
        local ok, res = pcall(Check_UI, name)
        if ok and res then
            return true
        end
    end
    if _G and _G._GUIs and _G._GUIs[name] then
        return is_ui_shown_safe(_G._GUIs[name])
    end
    return false
end

local function sample_radial_wheel_type()
    if gp_weapon_select and gp_weapon_select.is_open() then return 1 end
    -- 1: QuickAction_Haru (haru_quick_action_wheel_mcm.script -> UIHaruQAW)
    if check_named_ui("UIHaruQAW") or (haru_quick_action_wheel_mcm and is_ui_shown_safe(haru_quick_action_wheel_mcm.GUI)) then
        return 1
    end
    -- 2: Interactive_Pie (arm.script -> UIRadialMenu)
    if check_named_ui("UIRadialMenu") or (arm and is_ui_shown_safe(arm.GUI)) then
        return 2
    end
    -- 3: Camo_3DSS (z_3dss_camo_wheel.script -> UI3DSSCamoWheel)
    if check_named_ui("UI3DSSCamoWheel") or (z_3dss_camo_wheel and is_ui_shown_safe(z_3dss_camo_wheel.GUI)) then
        return 3
    end
    -- 4: Ammo (item_weapon.script -> UIWheelAmmo)
    if check_named_ui("UIWheelAmmo") or (item_weapon and is_ui_shown_safe(item_weapon.GUI)) then
        return 4
    end
    -- 5: Companion_Flat (idiots_ui.script -> UIWheelCompanion)
    if check_named_ui("UIWheelCompanion") or (idiots_ui and is_ui_shown_safe(idiots_ui.GUI)) then
        return 5
    end
    return 0
end

local function sample_placement_state()
    if placeable_furniture and type(placeable_furniture.get_state) == "function" then
        local ok, st = pcall(placeable_furniture.get_state)
        if ok and (st == 2 or st == 3 or st == 4) then
            return st
        end
    end
    if check_named_ui("UIAdvancedControls") then
        return 3
    end
    return 0
end

local function sample_modal_tag()
    local stack = _G and _G._UI_stack
    local top_name = type(stack) == "table" and stack[#stack]
    -- PDA1: интерактивный КПК перехватывается gp_pda
    local pda = _G and type(_G.gp_pda) == "table" and _G.gp_pda or nil
    if pda and type(pda.modal_tag) == "function" then
        local ok_p, ptag = pcall(pda.modal_tag)
        if ok_p and type(ptag) == "string" and ptag ~= "" then return ptag end
    end
    -- Field windows and workshop can open over the inventory. Route only to the top dialog.
    local ws = workshop_mod()
    local field_tag = ws and ws.field_modal_tag and ws.field_modal_tag()
    if field_tag then return field_tag end
    if game and game.gamepad_is_top_dialog then
        local g = ws and ws.ws_gui()
        if g and game.gamepad_is_top_dialog(g) then return "UIWorkshop" end
        local f = ws and ws.furn_gui()
        if f and game.gamepad_is_top_dialog(f) then return "UIFurnitureWorkshop" end
        if top_name == "UIWorkshop" or top_name == "UIFurnitureWorkshop" or top_name == "UIMutantLoot"
            or top_name == "UICook" or top_name == "UIRepair" or top_name == "UICookStove" then
            top_name = nil
        end
    elseif top_name == "UIWorkshop" or top_name == "UIFurnitureWorkshop" then
        return top_name
    end
    if ui_inventory and ui_inventory.GUI and is_ui_shown_safe(ui_inventory.GUI) then
        local mode = tostring(ui_inventory.GUI.mode or "inventory")
        return "UIInventory:" .. mode
    end
    if top_name and top_name ~= "" then
        return tostring(top_name)
    end
    if _G and type(_G._GUIs) == "table" then
        for k, v in pairs(_G._GUIs) do
            if is_ui_shown_safe(v) then
                return tostring(k)
            end
        end
    end
    return ""
end

-- MENU-FOCUS P16c: the start-up main menu exists before on_game_start (axr_main.on_game_start runs from
-- _g.start_game_callback = alife start, alife_simulator.cpp:74), so ui_gp_pause never hears main_menu_on_init there.
-- The engine calls sync_context_hints every frame, menus included (GamepadContextDispatcher.cpp:1328), so hook the
-- main menu Update from here until ui_gp_pause reports it is wrapped. Plain global access loads the namespace.
local start_menu_hooked = false
function hook_start_menu()
    if start_menu_hooked or level.present() then return start_menu_hooked end
    local ok, done = pcall(function() return ui_gp_pause.install() end)
    start_menu_hooked = ok and done == true
    return start_menu_hooked
end

function sync_context_hints(force)
    hook_start_menu()
    local mcm_gui = ui_mcm and (ui_mcm.GUI or (gp_mcm and gp_mcm.is_mcm_available and gp_mcm.is_mcm_available() and gp_mcm.get_gui and gp_mcm.get_gui()) or (not (gp_mcm and gp_mcm.is_mcm_available and gp_mcm.is_mcm_available()) and ui_mcm.get_gui and ui_mcm.get_gui()))
    local mcm_bind = (mcm_gui and mcm_gui.k_binder ~= nil) and true or false
    local fdda_dis = (liz_fdda_input_manager and liz_fdda_input_manager.is_input_disabled == true) and true or false
    if fdda_dis and lam2 and type(lam2.is_running) == "function" then
        local ok_r, running = pcall(lam2.is_running)
        local ae_busy = (actor_effects and tonumber(actor_effects.torch_anm_state) and tonumber(actor_effects.torch_anm_state) ~= 0) and true or false
        if ok_r and not running and not ae_busy then
            liz_fdda_input_manager.is_input_disabled = false
            fdda_dis = false
        end
    end

    local sleep_info = false
    if db and db.actor and has_alife_info then
        local ok, res = pcall(has_alife_info, "actor_is_sleeping")
        sleep_info = (ok and res) and true or false
    end

    local sleep_dlg = (check_named_ui("UISleep") or (ui_sleep_dialog and is_ui_shown_safe(ui_sleep_dialog.GUI))) and true or false
    local wheel_type = sample_radial_wheel_type()
    local placement_state = sample_placement_state()
    local modal_tag = sample_modal_tag()

    local dik_place = lua_ctx_cache.dik_place
    local dik_collision = lua_ctx_cache.dik_collision
    local dik_align = lua_ctx_cache.dik_align
    local dik_controls = lua_ctx_cache.dik_controls

    if placement_state ~= 0 then
        if bind_to_dik and key_bindings and key_bindings.kUSE then
            local ok_p, dp = pcall(bind_to_dik, key_bindings.kUSE)
            if ok_p and type(dp) == "number" and dp > 0 then
                dik_place = dp
            end
        end
        if ui_mcm and type(ui_mcm.get) == "function" then
            local ok_c, dc = pcall(ui_mcm.get, "aol_hf/controls/bind_collision")
            if ok_c and tonumber(dc) and tonumber(dc) > 0 then dik_collision = tonumber(dc) end
            local ok_a, da = pcall(ui_mcm.get, "aol_hf/controls/bind_alignment")
            if ok_a and tonumber(da) and tonumber(da) > 0 then dik_align = tonumber(da) end
            local ok_m, dm = pcall(ui_mcm.get, "aol_hf/controls/bind_place_mode")
            if ok_m and tonumber(dm) and tonumber(dm) > 0 then dik_controls = tonumber(dm) end
        end
    end

    local keys_changed = (dik_place ~= lua_ctx_cache.dik_place)
        or (dik_collision ~= lua_ctx_cache.dik_collision)
        or (dik_align ~= lua_ctx_cache.dik_align)
        or (dik_controls ~= lua_ctx_cache.dik_controls)

    local hints_changed = (not lua_ctx_cache.initialized)
        or (force == true)
        or (mcm_bind ~= lua_ctx_cache.mcm_bind)
        or (fdda_dis ~= lua_ctx_cache.fdda_dis)
        or (sleep_info ~= lua_ctx_cache.sleep_info)
        or (sleep_dlg ~= lua_ctx_cache.sleep_dlg)
        or (wheel_type ~= lua_ctx_cache.wheel_type)
        or (placement_state ~= lua_ctx_cache.placement_state)
        or (modal_tag ~= lua_ctx_cache.modal_tag)

    if keys_changed then
        lua_ctx_cache.dik_place = dik_place
        lua_ctx_cache.dik_collision = dik_collision
        lua_ctx_cache.dik_align = dik_align
        lua_ctx_cache.dik_controls = dik_controls
        if game and game.set_gamepad_placement_keys then
            pcall(game.set_gamepad_placement_keys, dik_place, dik_collision, dik_align, dik_controls)
        end
    end

    if hints_changed then
        lua_ctx_cache.initialized = true
        lua_ctx_cache.mcm_bind = mcm_bind
        lua_ctx_cache.fdda_dis = fdda_dis
        lua_ctx_cache.sleep_info = sleep_info
        lua_ctx_cache.sleep_dlg = sleep_dlg
        lua_ctx_cache.wheel_type = wheel_type
        lua_ctx_cache.placement_state = placement_state
        lua_ctx_cache.modal_tag = modal_tag
        lua_ctx_cache.push_count = lua_ctx_cache.push_count + 1
        bridge_stats.ctx_hint_pushes = lua_ctx_cache.push_count

        if game and game.set_gamepad_lua_hints then
            pcall(game.set_gamepad_lua_hints, mcm_bind, fdda_dis, sleep_info, sleep_dlg, wheel_type, placement_state, modal_tag)
        end
        return true
    end

    return false
end

function get_context_hints_status()
    sync_context_hints(false)
    local cpp_ctx = "unknown"
    if game and game.get_gamepad_context_name then
        local ok, res = pcall(game.get_gamepad_context_name)
        if ok and res then cpp_ctx = tostring(res) end
    end
    return string.format(
        "ok:cpp_ctx=%s;pushes=%d;mcm_bind=%d;fdda=%d;sleep_info=%d;sleep_dlg=%d;wheel=%d;placement=%d;modal=%s;before_key_seen=%d;last_key=%d;last_bind=%d;last_ret=%d",
        cpp_ctx,
        lua_ctx_cache.push_count,
        lua_ctx_cache.mcm_bind and 1 or 0,
        lua_ctx_cache.fdda_dis and 1 or 0,
        lua_ctx_cache.sleep_info and 1 or 0,
        lua_ctx_cache.sleep_dlg and 1 or 0,
        lua_ctx_cache.wheel_type,
        lua_ctx_cache.placement_state,
        tostring(lua_ctx_cache.modal_tag),
        lua_ctx_cache.before_key_seen,
        lua_ctx_cache.last_before_key,
        lua_ctx_cache.last_before_bind,
        lua_ctx_cache.last_before_ret and 1 or 0
    )
end

local function on_before_key_press_observer(key, bind, dis, flags)
    lua_ctx_cache.before_key_seen = lua_ctx_cache.before_key_seen + 1
    lua_ctx_cache.last_before_key = tonumber(key) or -1
    lua_ctx_cache.last_before_bind = tonumber(bind) or -1
    lua_ctx_cache.last_before_ret = (flags == nil or flags.ret_value ~= false)
    bridge_stats.before_key_press_seen = lua_ctx_cache.before_key_seen
    sync_context_hints(false)
end

local function on_gui_change(name)
    if flushing_dyn_functors then
        return
    end
    if name == "UIInventory" then
        dyn_functors_dirty = false
        if ensure_fg2_cc_hooks and ui_inventory and ui_inventory.GUI then
            ensure_fg2_cc_hooks(ui_inventory.GUI)
            if _G.gp_inv_rework and _G.gp_inv_rework.on_inventory_shown and is_ui_shown_safe(ui_inventory.GUI) then
                _G.gp_inv_rework.on_inventory_shown(ui_inventory.GUI)
            end
            if not is_ui_shown_safe(ui_inventory.GUI) and inv_set_lb_modifier then
                inv_set_lb_modifier(false)
            end
        end
    end
    sync_context_hints(false)
end

local function on_option_change_observer()
    dyn_functors_dirty = true
end

local function on_actor_update()
    sync_context_hints(false)
end

-- F1.1: StableItemID {session_gen, object_id, instance_gen} helpers for Lua transactions
function make_stable_item_id(object_id)
    local id = tonumber(object_id)
    if not id or id < 0 or id >= 65535 then
        return nil
    end
    local sess_gen = 0
    local inst_gen = 0
    if game and game.get_gamepad_session_gen then
        local ok_s, s = pcall(game.get_gamepad_session_gen)
        if ok_s and s then sess_gen = tonumber(s) or 0 end
    end
    if game and game.get_gamepad_object_instance_gen then
        local ok_i, i = pcall(game.get_gamepad_object_instance_gen, id)
        if ok_i and i then inst_gen = tonumber(i) or 0 end
    end
    if sess_gen == 0 or inst_gen == 0 then
        return nil
    end
    return {
        session_gen  = sess_gen,
        object_id    = id,
        instance_gen = inst_gen,
    }
end

function validate_stable_item_id(ref)
    if type(ref) ~= "table" then
        return false
    end
    local s = tonumber(ref.session_gen) or 0
    local id = tonumber(ref.object_id) or 65535
    local g = tonumber(ref.instance_gen) or 0
    if s <= 0 or id < 0 or id >= 65535 or g <= 0 then
        return false
    end
    if game and game.validate_gamepad_stable_item then
        local ok, valid = pcall(game.validate_gamepad_stable_item, s, id, g)
        return (ok and valid == true) or false
    end
    return false
end

-- ============================================================================
-- FG.1: Virtual Cursor Magnet, Soft Snap, D-Pad Cell Jump & Scroll Preparation
-- ============================================================================

local function get_widget_rect_safe(wnd)
    if not wnd then return nil end
    if wnd.IsShown then
        local ok_s, shown = pcall(wnd.IsShown, wnd)
        if not ok_s or not shown then return nil end
    end
    if Frect and wnd.GetAbsoluteRect then
        local rect = Frect()
        local ok_r = pcall(wnd.GetAbsoluteRect, wnd, rect)
        if ok_r and rect and rect.x1 and rect.x2 and rect.y1 and rect.y2 then
            local w = rect.x2 - rect.x1
            local h = rect.y2 - rect.y1
            if w > 1 and h > 1 then
                return rect.x1, rect.y1, rect.x2, rect.y2, (rect.x1 + rect.x2) * 0.5, (rect.y1 + rect.y2) * 0.5, w, h
            end
        end
    end
    if utils_ui and utils_ui.GetAbsoluteRect then
        local ok_u, pos, size = pcall(utils_ui.GetAbsoluteRect, wnd)
        if ok_u and pos and size and size.x and size.y and size.x > 1 and size.y > 1 then
            local x1 = pos.x
            local y1 = pos.y
            local x2 = x1 + size.x
            local y2 = y1 + size.y
            return x1, y1, x2, y2, x1 + size.x * 0.5, y1 + size.y * 0.5, size.x, size.y
        end
    end
    return nil
end

-- INV-REWORK-1: фильтр целей и разделы View живут в gp_inv_rework.script
function rw_mod()
    local m = _G.gp_inv_rework
    if m and m.is_active and m.is_active() then return m end
    return nil
end

function rw_allow(kind, bag, cc, ci, w)
    local m = rw_mod()
    if not m then return true end
    return m.target_allowed(kind, bag, cc, ci, w)
end

-- INV-REWORK-1 (2026-11-11): в новом режиме инвентаря скрипт отвечает окончательно —
-- иначе движок после "hit:0"/"snap:0" запускает свой обход всех контролов
-- (GamepadContextDispatcher.cpp F5.1) и выделяет вкладки категорий и невидимые кнопки.
function rw_no_hit(cx, cy)
    return string.format("hit:1;cx=%.1f;cy=%.1f;w=0;h=0;kind=none", cx, cy)
end

function rw_stay(cx, cy)
    return string.format("snap:1;cx=%.1f;cy=%.1f;kind=none", cx, cy)
end

-- PDA1: КПК gp_pda.script (перед верстаком и инвентарём)
function pda_mod()
    local m = _G.gp_pda
    return type(m) == "table" and m or nil
end

function pda_call(fn, ...)
    local m = pda_mod()
    local f = m and m[fn]
    if type(f) ~= "function" then return nil end
    local ok, res = pcall(f, ...)
    if ok then return res end
    if printf then printf("! [gp_bridge] gp_pda.%s: %s", tostring(fn), tostring(res)) end
    return nil
end

-- PDA1: движок (GamepadContextDispatcher::StepPdaButtons) — кнопка в КПК; ответ см. gp_pda.pda_button
function pda_button(name, phase)
    local res = pda_call("pda_button", tostring(name or ""), tostring(phase or ""))
    if type(res) == "string" then return res end
    return ""
end

-- WS1 (Миша 2026-11-13): верстак ui_workshop / окошко ui_furniture_workshop — gp_workshop.script
function workshop_mod()
    local m = _G.gp_workshop
    return type(m) == "table" and m or nil
end

-- WS1: движок (GamepadContextDispatcher::StepWorkshopButtons) — кнопка в верстаке; ответ см. gp_workshop.ws_button
function ws_button(name, phase)
    local m = workshop_mod()
    if not (m and m.ws_button) then return "" end
    local ok, res = pcall(m.ws_button, name, phase)
    if ok and type(res) == "string" then return res end
    return ""
end

-- WS1: цель/прыжок/RS верстака (nil — верстак не активен)
function workshop_call(fn, ...)
    local m = workshop_mod()
    local f = m and m[fn]
    if type(f) ~= "function" then return nil end
    local ok, res = pcall(f, ...)
    if ok then return res end
    return nil
end

-- Движок: рамка вместо курсора и прыжки левого стика в инвентаре (cvar gp_inv_focus_frame)
function inv_focus_frame_active()
    -- PDA1: КПК проверяется первым (на карте в режиме «ока» возвращает false)
    local pda = pda_mod()
    if pda and type(pda.is_active) == "function" and pda.is_active() == true then
        return pda_call("focus_frame_active") == true
    end
    -- WS1: верстак и окошко переносного верстака — рамка вместо курсора (gp_workshop)
    local ws = workshop_mod()
    if ws and ws.focus_frame_active and ws.focus_frame_active() then return true end
    local m = _G.gp_inv_rework
    return (m and m.inv_focus_frame_active and m.inv_focus_frame_active()) and true or false
end

-- Движок: правый стик сначала прокручивает описание предмета (true = прокрутка съедена)
-- INV-REWORK-4: engine, every frame while the right stick is tilted: smooth description scroll
-- (y > 0 = stick down, dt in ms); true = consumed, the engine skips its wheel steps
-- INV-REWORK-16 (p.6, Misha 2026-11-12): item details window (ui_itm_details.UIItemSheet, opened by
-- "podrobno" in the item menu) over the inventory: the engine locks the cursor (cursor_locked ->
-- no LS/D-pad/A, no cursor drawn), RS scrolls its scroll view smoothly, B closes it (Esc, engine kQUIT).
SHEET_SCROLL_SPEED = 420
sheet_scroll_state = {}

function item_sheet_gui()
    local m = rawget(_G, "ui_itm_details")
    local g = type(m) == "table" and m.GUI or nil
    if g and is_ui_shown_safe(g) then return g end
    return nil
end

function cursor_locked()
    return item_sheet_gui() ~= nil
end

-- FIX-LIVE2 p.20 (Misha 2026-11-16, 20a): tutorial cards (npe_dialog_tutorial / npe_dialog_codec) are driven
-- by gp_sys_dialogs buttons; under a gamepad the virtual cursor is not drawn there (input stays as is).
-- Engine asks every frame in MenuUI_Modal; moving the mouse makes it the active source and the native cursor returns.
function cursor_hidden()
    for _, mod_name in ipairs({ "npe_dialog_tutorial", "npe_dialog_codec" }) do
        local m = rawget(_G, mod_name)
        local g = type(m) == "table" and m.GUI or nil
        if g and is_ui_shown_safe(g) then return true end
    end
    local sysd = rawget(_G, "gp_sys_dialogs")
    if type(sysd) == "table" and type(sysd.active) == "function" then
        local ok, kind = pcall(sysd.active)
        if ok and type(kind) == "string" and kind:sub(1, 4) == "npe_" then return true end
    end
    return false
end

-- INV-REWORK-17 (p.4, Misha 2026-11-12): buttons in the item details window. Engine
-- StepItemSheetButtons asks on press of LB/RB/Y/A/B; true = consumed. B false = close (Esc).
function sheet_button(name)
    local sheet = item_sheet_gui()
    local m = _G.gp_inv_rework -- not rw_mod(): is_active() is false while the sheet is open
    if not (sheet and type(m) == "table" and m.sheet_button) then return false end
    local ok, res = pcall(m.sheet_button, sheet, tostring(name))
    return ok and res == true
end

function sheet_scroll(sheet, y, dt)
    local sv = sheet and sheet.scroll
    if not (sv and sv.GetCurrentScrollPos and sv.SetScrollPos) then return false end
    local ok, cur = pcall(sv.GetCurrentScrollPos, sv)
    cur = ok and tonumber(cur) or nil
    if not cur then return false end
    local okx, mx = pcall(sv.GetMaxScrollPos, sv)
    local okn, mn = pcall(sv.GetMinScrollPos, sv)
    mx = okx and tonumber(mx) or cur
    mn = okn and tonumber(mn) or 0
    local st = sheet_scroll_state
    if not rawequal(st.wnd, sheet) or st.int ~= cur then
        st = { wnd = sheet, pos = cur, int = cur }
        sheet_scroll_state = st
    end
    local p = st.pos + (tonumber(y) or 0) * SHEET_SCROLL_SPEED * (tonumber(dt) or 0) / 1000
    p = math.max(mn, math.min(mx, p))
    st.pos = p
    local ip = math.floor(p + 0.5)
    if ip ~= cur then pcall(sv.SetScrollPos, sv, ip) end
    local ok2, now = pcall(sv.GetCurrentScrollPos, sv)
    st.int = ok2 and tonumber(now) or ip
    return true
end

function cursor_rs_analog(y, dt)
    local pda = pda_mod()
    if pda and type(pda.is_active) == "function" and pda.is_active() == true then
        return pda_call("rs_analog", y, dt) and true or false
    end
    local sheet = item_sheet_gui()
    if sheet then return sheet_scroll(sheet, y, dt) end
    local ws = workshop_mod()
    if ws and ws.current and ws.current() ~= nil then
        return workshop_call("rs_analog", y, dt) and true or false
    end
    local m = rw_mod()
    if not m or not m.desc_scroll_analog then return false end
    if m.desc_scroll_analog(y, dt) then return true end
    -- INV-REWORK-22: прокрутка списка под курсором попиксельно, без перетекания в соседний список
    if m.cc_scroll_analog then return m.cc_scroll_analog(y, dt) and true or false end
    return false
end

function cursor_rs_override(dir)
    if item_sheet_gui() then return true end
    local m = rw_mod()
    if not m or not m.desc_scroll then return false end
    return m.desc_scroll(dir) and true or false
end

-- INV-REWORK-16 (п.8, скриншот Миши 2026-11-12): у малых слотов снаряжения (детектор, КПК...) полоска
-- состояния ci.bar лежит за краем ci.cell -> рамка не совпадала со слотом. Рамка = клетка + полоска.
-- INV-REWORK-16 (p.8, Misha 2026-11-12): the frame covers the whole dark slot plate (label, item, bar).
-- The plates are painted into ui_inGame2_inventory_back (no widget), so their rects are a table in
-- equipment xml units (cont_equ 273x425, ui_inventory_16.xml:93), measured on a 2000x843 screenshot.
EQU_PLATES = {
    [5] = { 3, 7, 84, 66 }, [12] = { 87, 7, 184, 126 }, [10] = { 187, 7, 271, 66 },
    [2] = { 1, 69, 84, 314 }, [7] = { 87, 129, 184, 314 }, [3] = { 187, 69, 271, 314 },
    [6] = { 1, 317, 42, 366 }, [4] = { 44, 317, 84, 366 }, [13] = { 87, 317, 184, 424 },
    [8] = { 187, 317, 271, 366 }, [1] = { 1, 370, 84, 424 }, [9] = { 187, 370, 271, 424 },
}
EQU_W, EQU_H = 273, 425

function equ_plate_rect(cc, idx)
    local p = EQU_PLATES[idx]
    if not (p and cc and cc.scroll) then return nil end
    local sx1, sy1, sx2, sy2 = get_widget_rect_safe(cc.scroll)
    if not sx1 or sx2 <= sx1 or sy2 <= sy1 then return nil end
    local kx, ky = (sx2 - sx1) / EQU_W, (sy2 - sy1) / EQU_H
    return sx1 + p[1] * kx, sy1 + p[2] * ky, sx1 + p[3] * kx, sy1 + p[4] * ky
end

function equ_frame_rect(bag, ci, x1, y1, x2, y2, cc, idx)
    if bag == "actor_equ" then
        local px1, py1, px2, py2 = equ_plate_rect(cc, idx)
        if px1 then return px1, py1, px2, py2 end
    end
    if bag ~= "actor_equ" or not (ci and ci.bar) then return x1, y1, x2, y2 end
    local bx1, by1, bx2, by2 = get_widget_rect_safe(ci.bar)
    if not bx1 then return x1, y1, x2, y2 end
    return math.min(x1, bx1), math.min(y1, by1), math.max(x2, bx2), math.max(y2, by2)
end

function cursor_query_target(x, y)
    local cx = tonumber(x) or 0
    local cy = tonumber(y) or 0
    local pda_hit = pda_call("query", cx, cy)
    if type(pda_hit) == "string" then return pda_hit end
    if item_sheet_gui() then return "hit:0" end
    local ws_hit = workshop_call("query", cx, cy)
    if type(ws_hit) == "string" then return ws_hit end
    local gui = ui_inventory and ui_inventory.GUI
    if not gui or not is_ui_shown_safe(gui) then
        if _G.gp_screens and _G.gp_screens.cursor_query_target then
            local ok_q, _, q_t = pcall(_G.gp_screens.cursor_query_target, cx, cy)
            if ok_q and type(q_t) == "table" and q_t.cx and q_t.cy then
                local tw = tonumber(q_t.w) or ((tonumber(q_t.x2) or 0) - (tonumber(q_t.x1) or 0))
                local th = tonumber(q_t.h) or ((tonumber(q_t.y2) or 0) - (tonumber(q_t.y1) or 0))
                local tkind = type(q_t.kind) == "string" and q_t.kind ~= "" and q_t.kind or "btn"
                return string.format("hit:1;cx=%.1f;cy=%.1f;w=%.1f;h=%.1f;kind=%s", q_t.cx, q_t.cy, tw, th, tkind)
            end
        end
        return "hit:0"
    end

    -- 1. Open context menu (properties list_box) or W4-TECH-SYS modal buttons have highest priority
    local rw_q = rw_mod()
    if rw_q and type(rw_q.wpn_dlg_query) == "function" then
        local wq = rw_q.wpn_dlg_query(cx, cy)
        if wq then
            local x1, y1, w, h = wq:match("^1;([%-%d%.]+),([%-%d%.]+),([%-%d%.]+),([%-%d%.]+);kind=btn")
            if x1 then
                local nx, ny, nw, nh = tonumber(x1), tonumber(y1), tonumber(w), tonumber(h)
                return string.format("hit:1;cx=%.1f;cy=%.1f;w=%.1f;h=%.1f;kind=btn", nx + nw * 0.5, ny + nh * 0.5, nw, nh)
            end
        end
    end
    local props = (rw_q and type(rw_q.active_custom_props) == "function" and rw_q.active_custom_props()) or gui.item_props
    if props and is_ui_shown_safe(props) and props.list_box then
        local lb = props.list_box
        local ok_sz, sz = pcall(lb.GetSize, lb)
        if ok_sz and type(sz) == "number" and sz > 0 then
            for i = 0, sz - 1 do
                local ok_it, itm = pcall(lb.GetItemByIndex, lb, i)
                if ok_it and itm then
                    local x1, y1, x2, y2, mx, my, w, h = get_widget_rect_safe(itm)
                    if x1 and cx >= x1 and cx <= x2 and cy >= y1 and cy <= y2 then
                        return string.format("hit:1;cx=%.1f;cy=%.1f;w=%.1f;h=%.1f;kind=prop", mx, my, w, h)
                    end
                end
            end
        end
        if rw_mod() then return rw_no_hit(cx, cy) end
        return "hit:0"
    end

    -- 2. Cell containers (occupied cells + equipment/quick slots)
    if type(gui.CC) == "table" then
        for bag_name, cc in pairs(gui.CC) do
            if cc and is_ui_shown_safe(cc) and type(cc.cell) == "table" then
                local sx1, sy1, sx2, sy2 = nil, nil, nil, nil
                if cc.scroll then
                    sx1, sy1, sx2, sy2 = get_widget_rect_safe(cc.scroll)
                end
                if not sx1 or (cx >= sx1 and cx <= sx2 and cy >= sy1 and cy <= sy2) then
                    for ci_idx, ci in pairs(cc.cell) do
                        local cell_active = (cc.manual == true) or (ci and (ci.ID ~= nil or ci.section ~= nil))
                        if ci and cell_active and (cc.manual == true or is_ui_shown_safe(ci)) then
                            local vis = true
                            if cc.IsCellVisible then
                                local ok_v, v = pcall(cc.IsCellVisible, cc, ci)
                                vis = (ok_v and v == true)
                            end
                            if vis and ci.cell and rw_allow("cell", bag_name, cc, ci) then
                                local x1, y1, x2, y2, mx, my, w, h = get_widget_rect_safe(ci.cell)
                                if x1 and cx >= x1 and cx <= x2 and cy >= y1 and cy <= y2 then
                                    x1, y1, x2, y2 = equ_frame_rect(bag_name, ci, x1, y1, x2, y2, cc, ci_idx)
                                    mx, my, w, h = (x1 + x2) * 0.5, (y1 + y2) * 0.5, x2 - x1, y2 - y1
                                    return string.format("hit:1;cx=%.1f;cy=%.1f;w=%.1f;h=%.1f;kind=cell", mx, my, w, h)
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    -- 3. Sort buttons (tab bar); INV-REWORK-1: не цели при геймпаде
    if type(gui.sort_btn) == "table" and rw_allow("sort") then
        for _, btn in pairs(gui.sort_btn) do
            local x1, y1, x2, y2, mx, my, w, h = get_widget_rect_safe(btn)
            if x1 and cx >= x1 and cx <= x2 and cy >= y1 and cy <= y2 then
                return string.format("hit:1;cx=%.1f;cy=%.1f;w=%.1f;h=%.1f;kind=sort", mx, my, w, h)
            end
        end
    end

    -- 4. Upgrade / repair nodes (when upgrade mode is open)
    if type(gui.upx) == "table" and rw_allow("upgr") then
        for _, node in pairs(gui.upx) do
            local btn = node and node.btn
            local x1, y1, x2, y2, mx, my, w, h = get_widget_rect_safe(btn)
            if x1 and cx >= x1 and cx <= x2 and cy >= y1 and cy <= y2 and rw_allow("upgr", nil, nil, nil, btn) then
                return string.format("hit:1;cx=%.1f;cy=%.1f;w=%.1f;h=%.1f;kind=upgr", mx, my, w, h)
            end
        end
    end

    -- 5. Action buttons (Put All, Take All, Trade Buy/Sell, Repair, Stash Rename)
    local action_btns = {
        gui.player_putall,
        gui.npc_takeall,
        gui.player_trade_sell,
        gui.npc_trade_buy,
        gui.npc_up_repair,
        gui._gp_stash_rename_btn,
    }
    for i = 1, 6 do
        local btn = action_btns[i]
        local x1, y1, x2, y2, mx, my, w, h = get_widget_rect_safe(btn)
        if x1 and cx >= x1 and cx <= x2 and cy >= y1 and cy <= y2 and rw_allow("btn", nil, nil, nil, btn) then
            return string.format("hit:1;cx=%.1f;cy=%.1f;w=%.1f;h=%.1f;kind=btn", mx, my, w, h)
        end
    end

    -- 6. INV-REWORK-1: характеристики (раздел «Характеристики»)
    local rw = rw_mod()
    if rw and rw_allow("stat") then
        local st = rw.stat_at(gui, cx, cy)
        if st then
            return string.format("hit:1;cx=%.1f;cy=%.1f;w=%.1f;h=%.1f;kind=stat", st.mx, st.my, st.w, st.h)
        end
    end

    -- 7. INV-REWORK-1: под рамкой пусто — переезд на ближайшую цель раздела, иначе окончательное «нет»
    if rw then
        local t = rw.recover_target and rw.recover_target(gui, cx, cy)
        if t then
            return string.format("hit:1;cx=%.1f;cy=%.1f;w=%.1f;h=%.1f;kind=%s", t.mx, t.my, t.w, t.h, t.kind)
        end
        return rw_no_hit(cx, cy)
    end

    return "hit:0"
end

-- REWORK-6: half-row tolerance (UI units) for "in line" targets of cursor_dpad_snap
DPAD_ALIGN = 20

-- REWORK-7: function of a mod script: exported one, else a local captured as an upvalue of the
-- module's global on_item_drag_dropped (debug.getupvalue, precedent gp_weapon.script:375).
function sci_local(mod, name)
    if type(mod) ~= "table" then return nil end
    if type(mod[name]) == "function" then return mod[name] end
    local host = mod.on_item_drag_dropped
    if type(host) ~= "function" or type(debug) ~= "table" or type(debug.getupvalue) ~= "function" then return nil end
    for i = 1, 255 do
        local n, v = debug.getupvalue(host, i)
        if n == nil then break end
        if n == name and type(v) == "function" then return v end
    end
    return nil
end

-- INV-REWORK-14: next strip of cells below (dir 2) / above (dir 1) the cell under the cursor.
function vertical_strip_pick(candidates, cc, cx, cy, dir)
    local cells, src, src_d = {}, nil, math.huge
    for _, c in ipairs(candidates) do
        if c.kind == "cell" and rawequal(c.cc, cc) and c.y1 and c.y2 then
            cells[#cells + 1] = c
            local inside = c.x1 and cx >= c.x1 and cx <= c.x2 and cy >= c.y1 and cy <= c.y2
            local d = inside and -1 or ((c.mx - cx) ^ 2 + (c.my - cy) ^ 2)
            if d < src_d then src, src_d = c, d end
        end
    end
    if not src then return nil end
    local down = (dir == 2)
    local edge = nil
    for _, c in ipairs(cells) do
        local beyond = down and (c.y1 >= src.y2 - 4) or ((not down) and c.y2 <= src.y1 + 4)
        if beyond and (not edge or (down and c.y1 < edge.y1) or ((not down) and c.y2 > edge.y2)) then edge = c end
    end
    if not edge then return nil end
    local best, best_dx, best_dm = nil, math.huge, math.huge
    for _, c in ipairs(cells) do
        local beyond = down and (c.y1 >= src.y2 - 4) or ((not down) and c.y2 <= src.y1 + 4)
        local in_strip = beyond and (down and c.y1 < edge.y2 or ((not down) and c.y2 > edge.y1))
        if in_strip then
            local x1, x2 = c.x1 or c.mx, c.x2 or c.mx
            local dx = (cx < x1 and x1 - cx) or (cx > x2 and cx - x2) or 0
            local dm = math.abs(c.mx - cx)
            if dx < best_dx or (dx == best_dx and dm < best_dm) then best, best_dx, best_dm = c, dx, dm end
        end
    end
    return best, best_dx
end

-- INV-REWORK-15 (п.7, Миша 2026-11-12): есть ли скрытые прокруткой клетки ниже (dir 2) / выше (dir 1) курсора.
function cc_hidden_beyond(cc, cy, dir)
    if not (cc and type(cc.cell) == "table" and cc.IsCellVisible) then return false end
    for _, ci in pairs(cc.cell) do
        if ci and (ci.ID ~= nil or ci.section ~= nil) and ci.cell then
            local ok_v, v = pcall(cc.IsCellVisible, cc, ci)
            if ok_v and v ~= true then
                local x1, y1, _, y2 = get_widget_rect_safe(ci.cell)
                if not x1 or (dir == 2 and y1 > cy) or (dir == 1 and y2 < cy) then return true end
            end
        end
    end
    return false
end

function cursor_dpad_snap(x, y, dir_code)
    local cx = tonumber(x) or 0
    local cy = tonumber(y) or 0
    local dir = tonumber(dir_code) or 0
    if dir < 1 or dir > 4 then
        return "snap:0"
    end
    local pda_snap = pda_call("snap", cx, cy, dir)
    if type(pda_snap) == "string" then return pda_snap end
    local ws_snap = workshop_call("snap", cx, cy, dir)
    if type(ws_snap) == "string" then return ws_snap end

    local gui = ui_inventory and ui_inventory.GUI
    if not gui or not is_ui_shown_safe(gui) then
        if _G.gp_screens and _G.gp_screens.cursor_dpad_snap then
            local ok_s, _, s_t = pcall(_G.gp_screens.cursor_dpad_snap, dir, cx, cy)
            if ok_s and type(s_t) == "table" and s_t.cx and s_t.cy then
                local skind = type(s_t.kind) == "string" and s_t.kind ~= "" and s_t.kind or "btn"
                return string.format("snap:1;cx=%.1f;cy=%.1f;kind=%s", s_t.cx, s_t.cy, skind)
            end
        end
        return "snap:0"
    end

    -- 0. FG.6k4: When LB modifier is held, D-Pad does not move focus; instead it assigns
    --    the hovered consumable item to quick slots F1-F4 (Up=F1, Right=F2, Down=F3, Left=F4).
    if fg2_state.lb_modifier_active or gui.holding_ctrl then
        if inv_assign_quick_slot_dpad then
            inv_assign_quick_slot_dpad(dir)
        end
        if rw_mod() then return rw_stay(cx, cy) end
        return "snap:0"
    end

    -- 1. If context menu (item_props or UICellPropertiesCustom) is open, step Up/Down along list_box rows
    local rw_d = rw_mod()
    local props = (rw_d and type(rw_d.active_custom_props) == "function" and rw_d.active_custom_props()) or gui.item_props
    if props and is_ui_shown_safe(props) and props.list_box then
        local lb = props.list_box
        local ok_sz, sz = pcall(lb.GetSize, lb)
        if ok_sz and type(sz) == "number" and sz > 0 then
            local rows = {}
            local cur_idx = nil
            local best_dist = 1e12
            for i = 0, sz - 1 do
                local ok_it, itm = pcall(lb.GetItemByIndex, lb, i)
                if ok_it and itm then
                    local x1, y1, x2, y2, mx, my = get_widget_rect_safe(itm)
                    if x1 then
                        table.insert(rows, { mx = mx, my = my, y1 = y1, y2 = y2, lb_idx = i })
                        local dy = math.abs(cy - my)
                        if dy < best_dist then
                            best_dist = dy
                            cur_idx = #rows
                        end
                    end
                end
            end
            if #rows > 0 then
                local target_idx = cur_idx or 1
                if dir == 1 then -- Up
                    target_idx = math.max(1, target_idx - 1)
                elseif dir == 2 then -- Down
                    target_idx = math.min(#rows, target_idx + 1)
                end
                local r = rows[target_idx]
                if inv_set_props_selected_row then
                    inv_set_props_selected_row(r.lb_idx)
                end
                if SetCursorPosition and vector2 then
                    pcall(function() SetCursorPosition(vector2():set(r.mx, r.my)) end)
                end
                return string.format("snap:1;cx=%.1f;cy=%.1f;kind=prop", r.mx, r.my)
            end
        end
        if rw_mod() then return rw_stay(cx, cy) end
        return "snap:0"
    end

    if rw_d and type(rw_d.modal_or_tech_dpad_snap) == "function" then
        local msnap = rw_d.modal_or_tech_dpad_snap(gui, cx, cy, dir)
        if type(msnap) == "string" then
            local tx, ty = msnap:match("^([%-%d%.]+),([%-%d%.]+)$")
            if tx and ty then
                local nx, ny = tonumber(tx), tonumber(ty)
                if SetCursorPosition and vector2 then
                    pcall(function() SetCursorPosition(vector2():set(nx, ny)) end)
                end
                return string.format("snap:1;cx=%.1f;cy=%.1f;kind=upgr", nx, ny)
            end
            if rw_mod() then return rw_stay(cx, cy) end
            return "snap:0"
        end
    end

    -- 2. Collect visible targets across all shown containers, sort buttons, upgrade nodes, action buttons
    local candidates = {}
    local active_cc = nil

    if type(gui.CC) == "table" then
        for bag_name, cc in pairs(gui.CC) do
            if cc and is_ui_shown_safe(cc) and type(cc.cell) == "table" then
                if cc.scroll then
                    local sx1, sy1, sx2, sy2 = get_widget_rect_safe(cc.scroll)
                    if sx1 and cx >= sx1 and cx <= sx2 and cy >= sy1 and cy <= sy2 then
                        active_cc = cc
                    end
                end
                for _, ci in pairs(cc.cell) do
                    local cell_active = (cc.manual == true) or (ci and (ci.ID ~= nil or ci.section ~= nil))
                    if ci and cell_active and (cc.manual == true or is_ui_shown_safe(ci)) then
                        local vis = true
                        if cc.IsCellVisible then
                            local ok_v, v = pcall(cc.IsCellVisible, cc, ci)
                            vis = (ok_v and v == true)
                        end
                        if vis and ci.cell and rw_allow("cell", bag_name, cc, ci) then
                            local x1, y1, x2, y2, mx, my = get_widget_rect_safe(ci.cell)
                            if x1 then
                                if not active_cc and (cc.scroll or cc.Scroll_SetPos) and cx >= x1 and cx <= x2 and cy >= y1 and cy <= y2 then
                                    active_cc = cc
                                end
                                table.insert(candidates, { mx = mx, my = my, x1 = x1, x2 = x2, y1 = y1, y2 = y2, kind = "cell", cc = cc })
                            end
                        end
                    end
                end
            end
        end
    end

    if type(gui.sort_btn) == "table" and rw_allow("sort") then
        for _, btn in pairs(gui.sort_btn) do
            local x1, y1, x2, y2, mx, my = get_widget_rect_safe(btn)
            if x1 then
                table.insert(candidates, { mx = mx, my = my, kind = "sort" })
            end
        end
    end

    if type(gui.upx) == "table" and rw_allow("upgr") then
        for _, node in pairs(gui.upx) do
            local btn = node and node.btn
            local x1, y1, x2, y2, mx, my = get_widget_rect_safe(btn)
            if x1 and rw_allow("upgr", nil, nil, nil, btn) then
                table.insert(candidates, { mx = mx, my = my, kind = "upgr" })
            end
        end
    end

    local action_btns = {
        gui.player_putall,
        gui.npc_takeall,
        gui.player_trade_sell,
        gui.npc_trade_buy,
        gui.npc_up_repair,
        gui._gp_stash_rename_btn,
    }
    for i = 1, 6 do
        local btn = action_btns[i]
        local x1, y1, x2, y2, mx, my = get_widget_rect_safe(btn)
        if x1 and rw_allow("btn", nil, nil, nil, btn) then
            table.insert(candidates, { mx = mx, my = my, kind = "btn" })
        end
    end

    -- INV-REWORK-1: характеристики как цели ходьбы
    local rw_m = rw_mod()
    if rw_m and rw_allow("stat") then
        for _, st in ipairs(rw_m.collect_stat_targets(gui)) do
            table.insert(candidates, { mx = st.mx, my = st.my, kind = "stat", stat = st.name })
        end
    end

    -- INV-REWORK-14: vertical move in the active bag goes to the nearest strip below/above.
    -- Old row grouping split items of different heights (a small scope slightly above a long rifle
    -- became its own "row") and the frame jumped across the bag (Misha's video INV8 04:16, LS down).
    -- Strip = every cell that starts before the nearest cell in that direction ends (down) / ends
    -- after it starts (up); inside the strip the cell closest horizontally to the cursor wins.
    -- INV-REWORK-15 (п.7): ближайшая видимая клетка полосы лежит сбоку, а прямо под курсором ряд ещё
    -- скрыт прокруткой -> не прыгать вбок, а прокрутить рюкзак (ветка FG.6c ниже).
    local force_scroll = false
    if (dir == 1 or dir == 2) and active_cc and not active_cc.manual then
        local chosen, chosen_dx = vertical_strip_pick(candidates, active_cc, cx, cy, dir)
        if chosen and (chosen_dx or 0) > 0 and cc_hidden_beyond(active_cc, cy, dir) then
            force_scroll = true
        elseif chosen then
            return string.format("snap:1;cx=%.1f;cy=%.1f;kind=cell", chosen.mx, chosen.my)
        end
    end

    local dir_x = (dir == 3 and -1) or (dir == 4 and 1) or 0
    local dir_y = (dir == 1 and -1) or (dir == 2 and 1) or 0
    local best = nil
    local best_score = 1e12
    local best_in_active_cc = nil
    local best_in_active_score = 1e12

    for _, c in ipairs(candidates) do
        local vx = c.mx - cx
        local vy = c.my - cy
        local dist_sq = vx * vx + vy * vy
        if dist_sq >= 9.0 then
            local primary = vx * dir_x + vy * dir_y
            local cross = math.abs(vx * (-dir_y) + vy * dir_x)
            -- INV-REWORK-16 (p.3, Misha's video INV10 06:00, LS right): a tall item (battery 1x2) next to
            -- the row had its centre half a row lower and lost/won against the next item by ~1 point,
            -- so the frame skipped it or not. Horizontal: cross = distance from the cursor line to the
            -- item's vertical span (0 when the line crosses it).
            if dir_x ~= 0 and c.y1 and c.y2 then
                cross = math.max(0, c.y1 - cy, cy - c.y2)
            end
            if primary >= 4.0 and cross <= primary * 0.75 + 8.0 then
                -- REWORK-6: target in line with the direction always wins over a diagonal one
                local score = primary + cross * 2.35
                -- Prefer nearby targets without skipping closer items for a distant aligned one.
                -- Prefer staying inside the current scrollable container on Up/Down
                if active_cc and rawequal(c.cc, active_cc) then
                    score = score * 0.85
                    if score < best_in_active_score then
                        best_in_active_score = score
                        best_in_active_cc = c
                    end
                end
                if score < best_score then
                    best_score = score
                    best = c
                end
            end
        end
    end

    if (dir == 1 or dir == 2) and active_cc then
        if best_in_active_cc and not force_scroll then
            best = best_in_active_cc
        else
            -- FG.6c: At top/bottom visible edge of active_cc, scroll by row using UICellContainer
            -- mechanism (scroll_pos / scroll:GetCurrentScrollPos + Scroll_SetPos, step = grid_size + grid_line)
            -- and keep focus inside active_cc if hidden rows exist in direction `dir`.
            local base_sz = tonumber(active_cc.grid_size) or tonumber(active_cc.cell_size) or 50
            local line_sz = tonumber(active_cc.grid_line) or 4
            local step_px = base_sz + line_sz

            local cur_pos = nil
            if type(active_cc.scroll_pos) == "number" then
                cur_pos = active_cc.scroll_pos
            elseif active_cc.Scroll_GetPos then
                local ok_p, p = pcall(active_cc.Scroll_GetPos, active_cc)
                if ok_p and type(p) == "number" then
                    cur_pos = p
                end
            elseif active_cc.scroll and active_cc.scroll.GetCurrentScrollPos then
                local ok_p, p = pcall(active_cc.scroll.GetCurrentScrollPos, active_cc.scroll)
                if ok_p and type(p) == "number" then
                    cur_pos = p
                end
            end

            local min_pos = 0
            if active_cc.scroll and active_cc.scroll.GetMinScrollPos then
                local ok_min, mn = pcall(active_cc.scroll.GetMinScrollPos, active_cc.scroll)
                if ok_min and type(mn) == "number" then
                    min_pos = mn
                end
            end

            local vis_before = {}
            local has_hidden = false
            local anchor_cell = nil
            local anchor_my = nil
            for _, ci in pairs(active_cc.cell) do
                local cell_active = (active_cc.manual == true) or (ci and (ci.ID ~= nil or ci.section ~= nil))
                if ci and cell_active and (active_cc.manual == true or is_ui_shown_safe(ci)) then
                    local vis = true
                    if active_cc.IsCellVisible then
                        local ok_v, v = pcall(active_cc.IsCellVisible, active_cc, ci)
                        vis = (ok_v and v == true)
                    end
                    if vis then
                        vis_before[ci] = true
                        if not anchor_cell and ci.cell then
                            local x1, _, _, _, _, my = get_widget_rect_safe(ci.cell)
                            if x1 then
                                anchor_cell = ci.cell
                                anchor_my = my
                            end
                        end
                    else
                        has_hidden = true
                    end
                end
            end

            local scroll_best = nil
            if has_hidden and type(cur_pos) == "number" and active_cc.Scroll_SetPos then
                for mult = 1, 3 do
                    local new_pos = (dir == 1) and math.max(min_pos, cur_pos - step_px * mult) or (cur_pos + step_px * mult)
                    if new_pos ~= cur_pos then
                        pcall(active_cc.Scroll_SetPos, active_cc, new_pos, true)
                        local cell_shift_y = 0
                        if anchor_cell and anchor_my then
                            local ax1, _, _, _, _, after_my = get_widget_rect_safe(anchor_cell)
                            if ax1 and after_my then
                                cell_shift_y = after_my - anchor_my
                            end
                        end
                        local ref_cy = cy + cell_shift_y
                        local scroll_best_score = 1e12
                        for _, ci in pairs(active_cc.cell) do
                            local cell_active = (active_cc.manual == true) or (ci and (ci.ID ~= nil or ci.section ~= nil))
                            if ci and cell_active and (active_cc.manual == true or is_ui_shown_safe(ci)) then
                                local vis = true
                                if active_cc.IsCellVisible then
                                    local ok_v, v = pcall(active_cc.IsCellVisible, active_cc, ci)
                                    vis = (ok_v and v == true)
                                end
                                if vis and ci.cell then
                                    local x1, _, _, _, mx, my = get_widget_rect_safe(ci.cell)
                                    if x1 then
                                        local newly_vis = not vis_before[ci]
                                        local primary = (my - ref_cy) * dir_y
                                        local cross = math.abs(mx - cx)
                                        if (newly_vis and primary >= -2.0) or (primary >= 4.0) then
                                            local score = math.max(4.0, primary) + cross * 2.0
                                            if score < scroll_best_score then
                                                scroll_best_score = score
                                                scroll_best = { mx = mx, my = my, kind = "cell", cc = active_cc }
                                            end
                                        end
                                    end
                                end
                            end
                        end
                        if scroll_best then
                            active_cc.fix_want = nil
                            if active_cc.scroll_tg ~= nil then
                                active_cc.scroll_tg = 0
                            end
                            best = scroll_best
                            break
                        end
                    end
                end
                if not scroll_best then
                    pcall(active_cc.Scroll_SetPos, active_cc, cur_pos, true)
                end
            end

            -- If no scroll occurred (e.g. already at end) but another visible row exists in active_cc
            -- in direction `dir` (for example a partially filled last row in distant columns), snap to it
            -- before leaving the grid for sort/action buttons.
            if not scroll_best and not active_cc.manual then
                local wide_best = nil
                local wide_score = 1e12
                for _, c in ipairs(candidates) do
                    if rawequal(c.cc, active_cc) then
                        local primary = (c.my - cy) * dir_y
                        local cross = math.abs(c.mx - cx)
                        if primary >= step_px * 0.5 then
                            local score = primary + cross * 2.35
                            if score < wide_score then
                                wide_score = score
                                wide_best = c
                            end
                        end
                    end
                end
                if wide_best then
                    best = wide_best
                end
            end
        end
    end

    if best then
        local by = best.my
        -- INV-REWORK-16 (p.3): horizontal step keeps the cursor on its row line inside a tall target,
        -- so the next step right/left stays in the same row instead of drifting to the row below
        if dir_x ~= 0 and best.y1 and best.y2 and best.y2 - best.y1 > 8 then
            by = math.max(best.y1 + 4, math.min(best.y2 - 4, cy))
        end
        return string.format("snap:1;cx=%.1f;cy=%.1f;kind=%s", best.mx, by, best.kind)
    end
    if rw_mod() then return rw_stay(cx, cy) end
    return "snap:0"
end

function cursor_prepare_scroll(x, y)
    local cx = tonumber(x) or 0
    local cy = tonumber(y) or 0
    local gui = ui_inventory and ui_inventory.GUI
    if not gui or not is_ui_shown_safe(gui) or type(gui.CC) ~= "table" then
        return false
    end
    local prepared = false
    for _, cc in pairs(gui.CC) do
        if cc and is_ui_shown_safe(cc) then
            if cc.scroll then
                local x1, y1, x2, y2 = get_widget_rect_safe(cc.scroll)
                if not x1 or (cx >= x1 and cx <= x2 and cy >= y1 and cy <= y2) then
                    cc.scroll_tg = 0
                    prepared = true
                end
            else
                cc.scroll_tg = 0
                prepared = true
            end
        end
    end
    return prepared
end

-- ============================================================================
-- F3.1 (D03, D07, D48-D54): Contours 1-2 Item Context Actions Bridge
--   Contour 1: Section LTX actions use1_functor / use1_action_functor .. use10_functor / use10_action_functor
--              (UIInventory.properties["custom_1".."custom_10"] + standard UIInventory.properties).
--   Contour 2: All 33 active custom functors in G.A.M.M.A. bench + 1 retired QAW functor (34 cataloged in FP.1):
--              - 27 active custom_functor_autoinject.add_functor (+ 1 retired add_to_qaw per D45/D58/Option A)
--              - 2 active rax_dynamic_custom_functor.add_functor (SP_fav, SP_junk) with GUI_on_show flush & D54 safeguard
--              - 4 active direct UIInventory:Name_Custom / Action_Custom wrappers (item_exo_device, ammo_maker, campfire_placeable, wait)
-- ============================================================================

local CUSTOM_FUNCTORS_CATALOG = {
