local orig_execute_functor = nil

local function d54_execute_functor_wrapper(self, obj, bag, prop_cmd, funct, extra1, ...)
    if type(obj) == "number" and level and level.object_by_id then
        obj = level.object_by_id(obj)
    end
    local props = self and self.properties
    local sp_fav_precond = props and props["DYN_FUNC_SP_fav"] and props["DYN_FUNC_SP_fav"].precondition1 and props["DYN_FUNC_SP_fav"].precondition1[2]
    local sp_junk_precond = props and props["DYN_FUNC_SP_junk"] and props["DYN_FUNC_SP_junk"].precondition1 and props["DYN_FUNC_SP_junk"].precondition1[2]
    local sp_mod_precond = zzz_rax_sortingplus_mcm and zzz_rax_sortingplus_mcm.menu_precond
    if funct and (funct == sp_fav_precond or funct == sp_junk_precond or (sp_mod_precond and funct == sp_mod_precond)) then
        -- D54 safeguard: zzz_rax_sortingplus_mcm.script:608 declares menu_precond(obj, mode, bag)
        -- with mode and bag swapped compared to rax_dynamic_custom_functor.script:75 funct(obj, bag, self.mode).
        -- Pass self.mode as the 2nd argument and bag as the 3rd argument so mode ~= "repair" works accurately.
        bridge_stats.d54_safeguard_hits = (bridge_stats.d54_safeguard_hits or 0) + 1
        return obj and funct(obj, self.mode, bag, ...)
    end
    if orig_execute_functor then
        return orig_execute_functor(self, obj, bag, prop_cmd, funct, extra1, ...)
    end
    return obj and funct and funct(obj, bag, self.mode, ...)
end

function install_d54_sortingplus_safeguard(gui)
    local target_cls = (ui_inventory and ui_inventory.UIInventory) or nil
    if (type(target_cls) == "table" or type(target_cls) == "userdata") and type(target_cls.execute_functor) == "function" and target_cls.execute_functor ~= d54_execute_functor_wrapper then
        orig_execute_functor = target_cls.execute_functor
        target_cls.execute_functor = d54_execute_functor_wrapper
    end
    if gui and type(gui.execute_functor) == "function" and gui.execute_functor ~= d54_execute_functor_wrapper then
        orig_execute_functor = gui.execute_functor
        gui.execute_functor = d54_execute_functor_wrapper
    end
    return (orig_execute_functor ~= nil)
end

function ensure_dynamic_functors_flushed(gui, force_flush)
    if not gui or type(gui.properties) ~= "table" then
        return false
    end
    local has_dyn = (gui.properties["DYN_FUNC_SP_fav"] ~= nil) and (gui.properties["DYN_FUNC_SP_junk"] ~= nil)
    if has_dyn and not dyn_functors_dirty and force_flush ~= true then
        gui.__gp_dyn_flushed = true
    end
    if (force_flush == true or dyn_functors_dirty or not gui.__gp_dyn_flushed) and (SendScriptCallback or (_G and _G.rax_dynamic_custom_functor)) then
        local saved_mode = gui.mode
        local saved_sort_junk_ready = gui.SortJunkTradeReady
        local had_rax_hl = (type(rax_inventory_highlights_mcm) == "table")
        local saved_rax_hl_enabled = had_rax_hl and rax_inventory_highlights_mcm.ENABLED or nil
        local saved_global_enabled = _G and _G.ENABLED
        -- F3.3 N-1: when UI is not shown and rax_dynamic_custom_functor.GUI_on_show is directly available,
        -- call it directly without firing global GUI_on_show("UIInventory") to third-party subscribers.
        gui.mode = "__gp_bridge_flush__"
        flushing_dyn_functors = true
        if not is_ui_shown_safe(gui) and _G and type(_G.rax_dynamic_custom_functor) == "table" and type(_G.rax_dynamic_custom_functor.GUI_on_show) == "function" then
            pcall(_G.rax_dynamic_custom_functor.GUI_on_show, "UIInventory")
        elseif SendScriptCallback then
            pcall(SendScriptCallback, "GUI_on_show", "UIInventory")
        end
        flushing_dyn_functors = false
        gui.mode = saved_mode
        if not is_ui_shown_safe(gui) then
            gui.SortJunkTradeReady = saved_sort_junk_ready
            if had_rax_hl then
                rax_inventory_highlights_mcm.ENABLED = saved_rax_hl_enabled
            end
            if _G then
                _G.ENABLED = saved_global_enabled
            end
        end
        gui.__gp_dyn_flushed = true
        dyn_functors_dirty = false
        bridge_stats.dyn_flushes = (bridge_stats.dyn_flushes or 0) + 1
    end
    install_d54_sortingplus_safeguard(gui)
    return (gui.properties["DYN_FUNC_SP_fav"] ~= nil) and (gui.properties["DYN_FUNC_SP_junk"] ~= nil)
end

function resolve_item_object(item_or_ref)
    if item_or_ref == nil then
        return nil, -1, "err:nil_item"
    end
    -- 1. StableItemID table {session_gen, object_id, instance_gen} from F1.1
    if type(item_or_ref) == "table" and item_or_ref.session_gen ~= nil and item_or_ref.object_id ~= nil and item_or_ref.instance_gen ~= nil then
        if not validate_stable_item_id(item_or_ref) then
            return nil, tonumber(item_or_ref.object_id) or -1, "err:stale_stable_item_id"
        end
        local id = tonumber(item_or_ref.object_id)
        if not level or not level.object_by_id then
            return nil, id, "err:no_level_object_by_id"
        end
        local obj = level.object_by_id(id)
        if not obj then
            return nil, id, "err:object_not_found:" .. tostring(id)
        end
        return obj, id, nil
    end
    -- 2. Direct game_object (table or userdata with :id() method)
    if (type(item_or_ref) == "table" or type(item_or_ref) == "userdata") and type(item_or_ref.id) == "function" then
        local ok_id, id = pcall(item_or_ref.id, item_or_ref)
        if ok_id and type(id) == "number" then
            return item_or_ref, id, nil
        end
    end
    -- 3. Numeric object_id
    if type(item_or_ref) == "number" then
        if not level or not level.object_by_id then
            return nil, item_or_ref, "err:no_level_object_by_id"
        end
        local obj = level.object_by_id(item_or_ref)
        if not obj then
            return nil, item_or_ref, "err:object_not_found:" .. tostring(item_or_ref)
        end
        return obj, item_or_ref, nil
    end
    return nil, -1, "err:invalid_item_ref"
end

local function translate_action_name(raw_name)
    local s = tostring(raw_name or "")
    if s == "" then
        return ""
    end
    if game and type(game.translate_string) == "function" then
        local ok, tr = pcall(game.translate_string, s)
        if ok and type(tr) == "string" and tr ~= "" then
            return tr
        end
    end
    return s
end

local function get_sorted_property_keys(props_tbl)
    local keys = {}
    for k, v in pairs(props_tbl) do
        if type(v) == "table" then
            table.insert(keys, k)
        end
    end
    table.sort(keys, function(a, b)
        local ia = tonumber(props_tbl[a] and props_tbl[a].index) or 9999
        local ib = tonumber(props_tbl[b] and props_tbl[b].index) or 9999
        if ia ~= ib then
            return ia < ib
        end
        return tostring(a) < tostring(b)
    end)
    return keys
end

local function classify_property_contour(gui, prop_key, obj)
    local k_str = tostring(prop_key or "")
    if string.find(k_str, "^DYN_FUNC_") then
        local fn_name = string.gsub(k_str, "^DYN_FUNC_", "")
        return 2, "rax_dynamic", fn_name
    end
    local custom_idx = tonumber(string.match(k_str, "^custom_(%d+)$"))
    if custom_idx then
        if gui and type(gui.custom_functor) == "table" and gui.custom_functor[custom_idx] then
            local cf = gui.custom_functor[custom_idx]
            return 2, "autoinject", tostring(cf.name or k_str)
        end
        local sec = (obj and type(obj.section) == "function" and obj:section()) or ""
        if custom_idx == 3 and item_exo_device and type(item_exo_device.check_remove_psu) == "function" and obj and item_exo_device.check_remove_psu(obj) then
            return 2, "direct_wrapper", "item_exo_device_remove_psu"
        end
        if custom_idx == 4 and ammo_maker and type(ammo_maker.check_batch) == "function" and obj and ammo_maker.check_batch(obj) then
            return 2, "direct_wrapper", "ammo_maker_batch_disassemble"
        end
        if custom_idx == 9 and campfire_placeable and type(campfire_placeable.axes) == "table" and campfire_placeable.axes[sec] then
            return 2, "direct_wrapper", "campfire_placeable_gather_wood"
        end
        if custom_idx == 9 and wait and type(wait.items) == "table" and wait.items[sec] then
            return 2, "direct_wrapper", "wait_action"
        end
        return 1, "ltx_custom", "use" .. tostring(custom_idx) .. "_functor"
    end
    return 1, "standard", k_str
end

local function evaluate_property_allowed(gui, props, checked_obj, act_bag, active_mode)
    if type(props) ~= "table" then
        return false
    end
    local bag_allowed = true
    if props.cont then
        bag_allowed = props.cont[act_bag] and true or false
    end
    if props.cont_func and props.cont_func[1] and type(gui[props.cont_func[1]]) == "function" then
        local ok_c, res_c = pcall(gui[props.cont_func[1]], gui, checked_obj, act_bag, unpack(props.cont_func))
        bag_allowed = (ok_c and res_c) and true or false
    end

    local mode_allowed = true
    if props.mode then
        mode_allowed = props.mode[active_mode] and true or false
    end
    if props.mode_func and props.mode_func[1] and type(gui[props.mode_func[1]]) == "function" then
        local ok_m, res_m = pcall(gui[props.mode_func[1]], gui, checked_obj, act_bag, unpack(props.mode_func))
        mode_allowed = (ok_m and res_m) and true or false
    end

    if not (mode_allowed and bag_allowed) then
        return false
    end

    local cond = true
    local k = 1
    while cond and props["precondition" .. k] do
        local precond = props["precondition" .. k]
        if precond[1] and type(gui[precond[1]]) == "function" then
            local ok_p, res_p = pcall(gui[precond[1]], gui, checked_obj, act_bag, unpack(precond))
            cond = (ok_p and res_p) and true or false
        else
            cond = false
        end
        k = k + 1
    end
    return cond
end

function get_custom_functors_catalog()
    local out = {}
    for i = 1, #CUSTOM_FUNCTORS_CATALOG do
        local src = CUSTOM_FUNCTORS_CATALOG[i]
        out[i] = {
            id = src.id,
            name = src.name,
            kind = src.kind,
            active_in_bench = src.active_in_bench,
            override_bags = src.override_bags,
            script = src.script,
            predicate = src.predicate,
            action = src.action,
            call_path = src.call_path,
        }
    end
    return out
end

function collect_item_actions(item_or_ref, bag, mode_override)
    local obj, id, err = resolve_item_object(item_or_ref)
    if not obj then
        return nil, err
    end

    local gui, gui_state = ensure_gui()
    if not gui then
        return nil, tostring(gui_state)
    end
    if type(gui.properties) ~= "table" then
        return nil, "err:no_gui_properties"
    end

    ensure_dynamic_functors_flushed(gui, false)

    local act_bag = tostring(bag or "actor_bag")
    local checked_obj = (type(gui.CheckItem) == "function") and gui:CheckItem(obj, "InitProperties " .. act_bag) or obj
    if not checked_obj then
        return nil, "err:check_item_failed:" .. tostring(id)
    end

    local prev_mode = gui.mode
    local active_mode = tostring((mode_override and mode_override ~= "" and mode_override) or prev_mode or "inventory")
    local temp_mode_set = false
    if gui.mode ~= active_mode then
        gui.mode = active_mode
        temp_mode_set = true
    end

    local actions = {}
    local sorted_keys = get_sorted_property_keys(gui.properties)

    -- Exact UIInventory:InitProperties evaluation path (ui_inventory.script:795-848)
    for _, n in ipairs(sorted_keys) do
        local props = gui.properties[n]
        if evaluate_property_allowed(gui, props, checked_obj, act_bag, active_mode) then
            local raw_name = props.name or ""
            local func_name = props.name_func
            if func_name and func_name[1] and type(gui[func_name[1]]) == "function" then
                local ok_n, res_n = pcall(gui[func_name[1]], gui, id, act_bag, unpack(func_name))
                if ok_n and res_n then
                    raw_name = res_n
                end
            end

            local func_action = props.action
            if raw_name and raw_name ~= "" and func_action and func_action[1] and type(gui[func_action[1]]) == "function" then
                local contour_num, contour_kind, functor_name = classify_property_contour(gui, n, checked_obj)
                local action_params = { id, act_bag, unpack(func_action) }
                table.insert(actions, {
                    id = n,
                    index = tonumber(props.index) or 0,
                    contour = contour_num,
                    kind = contour_kind,
                    functor_name = functor_name,
                    raw_name = raw_name,
                    name = translate_action_name(raw_name),
                    action_func = func_action[1],
                    action_params = action_params,
                    bag = act_bag,
                    mode = active_mode,
                    item_id = id,
                    stable_id = make_stable_item_id(id),
                })
            end
        end
    end

    if temp_mode_set and gui.mode == active_mode then
        gui.mode = prev_mode
    end

    bridge_stats.last_collected_actions = #actions
    return actions, "ok"
end

local function find_property_key_by_action_id(gui, action_id)
    if not gui or type(gui.properties) ~= "table" or not action_id then
        return nil
    end
    local key_str = tostring(action_id)
    if gui.properties[key_str] then
        return key_str
    end
    if gui.properties["DYN_FUNC_" .. key_str] then
        return "DYN_FUNC_" .. key_str
    end
    if type(gui.custom_functor_names) == "table" and gui.custom_functor_names[key_str] then
        local slot = gui.custom_functor_names[key_str]
        local cand = "custom_" .. tostring(slot)
        if gui.properties[cand] then
            return cand
        end
    end
    return nil
end

function invoke_item_action(item_or_ref, action_id_or_entry, bag, mode_override)
    if type(action_id_or_entry) == "table" and type(action_id_or_entry.stable_id) == "table" then
        if not validate_stable_item_id(action_id_or_entry.stable_id) then
            return false, "err:stale_stable_item_id"
        end
    end

    local obj, id, err = resolve_item_object(item_or_ref)
    if not obj then
        return false, err
    end

    if type(action_id_or_entry) == "table" and action_id_or_entry.item_id ~= nil and tonumber(action_id_or_entry.item_id) ~= id then
        return false, "err:entry_item_mismatch"
    end

    -- F4.1: block duplicate A / item action while item is locked in a Pending Category B transaction
    if txn_is_item_locked and txn_is_item_locked(item_or_ref) then
        return false, "err:txn_locked_pending:" .. tostring(id)
    end

    local gui, gui_state = ensure_gui()
    if not gui then
        return false, tostring(gui_state)
    end
    if type(gui.properties) ~= "table" then
        return false, "err:no_gui_properties"
    end

    ensure_dynamic_functors_flushed(gui, false)

    local act_bag = tostring(bag or (type(action_id_or_entry) == "table" and action_id_or_entry.bag) or "actor_bag")
    local checked_obj = (type(gui.CheckItem) == "function") and gui:CheckItem(obj, "gp_bridge_invoke " .. act_bag) or obj
    if not checked_obj then
        return false, "err:check_item_failed:" .. tostring(id)
    end

    local prev_mode = gui.mode
    local eff_mode = mode_override or (type(action_id_or_entry) == "table" and action_id_or_entry.mode) or nil
    local active_mode = tostring((eff_mode and eff_mode ~= "" and eff_mode) or prev_mode or "inventory")
    local temp_mode_set = false
    if gui.mode ~= active_mode then
        gui.mode = active_mode
        temp_mode_set = true
    end

    local prop_key = nil
    local action_func = nil
    local action_params = nil

    if type(action_id_or_entry) == "table" and action_id_or_entry.action_func and type(action_id_or_entry.action_params) == "table" then
        prop_key = tostring(action_id_or_entry.id or action_id_or_entry.functor_name or "entry")
        -- F3.3 N-3: re-verify precondition on gui.properties[real_key] even when invoked with a pre-built record table
        local real_key = find_property_key_by_action_id(gui, prop_key)
        if real_key and gui.properties[real_key] then
            if not evaluate_property_allowed(gui, gui.properties[real_key], checked_obj, act_bag, active_mode) then
                if temp_mode_set and gui.mode == active_mode then
                    gui.mode = prev_mode
                end
                return false, "err:precondition_failed:" .. tostring(real_key)
            end
        end
        action_func = action_id_or_entry.action_func
        action_params = { id, act_bag }
        for i = 3, #action_id_or_entry.action_params do
            action_params[i] = action_id_or_entry.action_params[i]
        end
    else
        prop_key = find_property_key_by_action_id(gui, action_id_or_entry)
        if prop_key and gui.properties[prop_key] and gui.properties[prop_key].action then
            if not evaluate_property_allowed(gui, gui.properties[prop_key], checked_obj, act_bag, active_mode) then
                if temp_mode_set and gui.mode == active_mode then
                    gui.mode = prev_mode
                end
                return false, "err:precondition_failed:" .. tostring(prop_key)
            end
            local fa = gui.properties[prop_key].action
            action_func = fa[1]
            action_params = { id, act_bag, unpack(fa) }
        end
    end

    if not action_func or type(gui[action_func]) ~= "function" then
        if temp_mode_set and gui.mode == active_mode then
            gui.mode = prev_mode
        end
        return false, "err:action_not_found:" .. tostring(action_id_or_entry)
    end

    -- Fix C5.1-N1: if the invoked action is Action_Equip, sync headless containers first
    if action_func == "Action_Equip" then
        sync_headless_containers_for_equip(gui)
    end

    -- Exact UICellProperties:OnListItemDbClicked invocation path (utils_ui.script:3426):
    -- self.owner[item.func](self.owner, unpack(item.params))
    local ok_act, act_err = pcall(gui[action_func], gui, unpack(action_params))

    if temp_mode_set and gui.mode == active_mode then
        gui.mode = prev_mode
    end

    if not ok_act then
        return false, "err:action_exception:" .. tostring(act_err)
    end

    bridge_stats.calls = bridge_stats.calls + 1
    bridge_stats.last_op = tostring(action_func) .. ":" .. tostring(prop_key)
    bridge_stats.last_invoked_action = tostring(prop_key)
    bridge_stats.last_item_id = id
    bridge_stats.last_section = (type(checked_obj.section) == "function" and checked_obj:section()) or ""

    return true, "ok:invoked=" .. tostring(prop_key)
end

-- Helper functions for modular self-test of Contours 1-2 (gp_bridge_selftest "1-2")
local selftest_ltx_state = {
    active_slot = 0,
    name_hits = {},
    action_hits = {},
}

local function selftest_ltx_name_fn(obj)
    local slot = selftest_ltx_state.active_slot
    selftest_ltx_state.name_hits[slot] = (selftest_ltx_state.name_hits[slot] or 0) + 1
    return "st_gp_selftest_ltx_" .. tostring(slot)
end

local function selftest_ltx_action_fn(obj)
    local slot = selftest_ltx_state.active_slot
    selftest_ltx_state.action_hits[slot] = (selftest_ltx_state.action_hits[slot] or 0) + 1
end

local function selftest_mock_item_id(self)
    return self._id
end

local function selftest_mock_item_section(self)
    return self._section
end

local function selftest_mock_item_name(self)
    return self._section .. "_" .. tostring(self._id)
end

function selftest_contours_1_2(mode_arg)
    local gui, gui_state = ensure_gui()
    if not gui or type(gui.properties) ~= "table" then
        return string.format("err:selftest_no_gui:%s", tostring(gui_state)), nil
    end

    ensure_dynamic_functors_flushed(gui, true)

    -- 1. Contour 1 verification: LTX use1_functor / use1_action_functor .. use10_functor / use10_action_functor
    selftest_ltx_state.active_slot = 0
    selftest_ltx_state.name_hits = {}
    selftest_ltx_state.action_hits = {}

    _G.__gp_selftest_ltx = {
        name_fn = selftest_ltx_name_fn,
        action_fn = selftest_ltx_action_fn,
    }

    local synth_id = 65530
    local synth_sec = "__gp_selftest_ltx_item"
    local synth_obj = {
        _id = synth_id,
        _section = synth_sec,
        id = selftest_mock_item_id,
        section = selftest_mock_item_section,
        name = selftest_mock_item_name,
    }
    local _ = synth_obj:name()

    local orig_sys_get = _G.SYS_GetParam
    local orig_obj_by_id = level and level.object_by_id
    local orig_check_item = gui.CheckItem
    local orig_play_snd = gui.PlaySND
    local orig_item_update = gui.On_Item_Update

    _G.SYS_GetParam = function(typ, sec, param, def)
        if sec == synth_sec then
            local slot = selftest_ltx_state.active_slot
            if param == ("use" .. tostring(slot) .. "_functor") then
                return "__gp_selftest_ltx.name_fn"
            elseif param == ("use" .. tostring(slot) .. "_action_functor") then
                return "__gp_selftest_ltx.action_fn"
            elseif param == ("use" .. tostring(slot) .. "_modes") then
                return "inventory,loot"
            elseif param == ("use" .. tostring(slot) .. "_containers") then
                return "actor_bag,actor_equ"
            elseif param == ("use" .. tostring(slot) .. "_allow_db") then
                return true
            end
            return def
        end
        if orig_sys_get then
            return orig_sys_get(typ, sec, param, def)
        end
        return def
    end

    if level then
        level.object_by_id = function(q_id)
            if q_id == synth_id then
                return synth_obj
            end
            return orig_obj_by_id and orig_obj_by_id(q_id) or nil
        end
    end

    gui.CheckItem = function(self_gui, item_arg, msg)
        if rawequal(item_arg, synth_obj) or rawequal(item_arg, synth_id) then
            return synth_obj
        end
        return orig_check_item and orig_check_item(self_gui, item_arg, msg) or item_arg
    end
    gui.PlaySND = function(self_gui, snd, vol)
        if selftest_ltx_state.active_slot > 0 then
            return
        end
        if orig_play_snd then
            return orig_play_snd(self_gui, snd, vol)
        end
    end
    gui.On_Item_Update = function(self_gui)
        if selftest_ltx_state.active_slot > 0 then
            return
        end
        if orig_item_update then
            return orig_item_update(self_gui)
        end
    end

    local ltx_passed = 0
    local ltx_results = {}
    for slot = 1, 10 do
        selftest_ltx_state.active_slot = slot
        local prop_key = "custom_" .. tostring(slot)
        local db_ok = (type(gui.DB_Custom) ~= "function") or (gui:DB_Custom(synth_obj, "actor_bag", nil, slot) == true)
        local acts, _ = collect_item_actions(synth_obj, "actor_bag", "inventory")
        local found_entry = nil
        if type(acts) == "table" then
            for _, a in ipairs(acts) do
                if a.id == prop_key then
                    found_entry = a
                    break
                end
            end
        end
        local inv_ok = false
        if found_entry then
            inv_ok = invoke_item_action(synth_obj, found_entry, "actor_bag", "inventory")
        end
        local slot_ok = db_ok
            and (found_entry ~= nil)
            and (found_entry.raw_name == ("st_gp_selftest_ltx_" .. tostring(slot)))
            and inv_ok
            and ((selftest_ltx_state.name_hits[slot] or 0) >= 1)
            and ((selftest_ltx_state.action_hits[slot] or 0) == 1)
        if slot_ok then
            ltx_passed = ltx_passed + 1
        end
        ltx_results[slot] = {
            slot = slot,
            prop_key = prop_key,
            passed = slot_ok,
            name_hits = selftest_ltx_state.name_hits[slot] or 0,
            action_hits = selftest_ltx_state.action_hits[slot] or 0,
        }
    end
    selftest_ltx_state.active_slot = 0

    -- 2. Contour 2 verification: 33 active functors + 1 retired add_to_qaw = 34 cataloged
    local catalog = get_custom_functors_catalog()
    local active_verified = 0
    local retired_verified = 0
    for _, entry in ipairs(catalog) do
        if not entry.active_in_bench then
            local not_in_autoinject = not (gui.custom_functor_names and gui.custom_functor_names[entry.name])
            entry.verified = not_in_autoinject
            if entry.verified then
                retired_verified = retired_verified + 1
            end
        elseif entry.kind == "autoinject" then
            local slot = gui.custom_functor_names and gui.custom_functor_names[entry.name]
            local cf = slot and gui.custom_functor and gui.custom_functor[slot]
            local prop = slot and gui.properties["custom_" .. tostring(slot)]
            entry.slot = slot
            entry.verified = (type(cf) == "table")
                and (type(cf.cond_name) == "function")
                and (type(cf.func_name) == "function")
                and (type(cf.cond_action) == "function")
                and (type(cf.func_action) == "function")
                and (type(prop) == "table")
            if entry.verified then
                active_verified = active_verified + 1
            end
        elseif entry.kind == "rax_dynamic" then
            local dyn_key = "DYN_FUNC_" .. entry.name
            local prop = gui.properties[dyn_key]
            entry.slot = dyn_key
            entry.verified = (type(prop) == "table")
                and (type(prop.precondition1) == "table" and prop.precondition1[1] == "execute_functor" and type(prop.precondition1[2]) == "function")
                and (type(prop.action) == "table" and prop.action[1] == "execute_functor" and type(prop.action[2]) == "function")
            if entry.verified then
                active_verified = active_verified + 1
            end
        elseif entry.kind == "direct_wrapper" then
            local wrapper_ok = (type(gui.Name_Custom) == "function") and (type(gui.Action_Custom) == "function")
            entry.verified = wrapper_ok
            if entry.verified then
                active_verified = active_verified + 1
            end
        end
    end

    -- 3. D54 safeguard verification on DYN_FUNC_SP_fav / DYN_FUNC_SP_junk
    local d54_ok = false
    local sp_fav_prop = gui.properties["DYN_FUNC_SP_fav"]
    if sp_fav_prop and sp_fav_prop.precondition1 and type(sp_fav_prop.precondition1[2]) == "function" and type(gui.execute_functor) == "function" then
        local precond_fn = sp_fav_prop.precondition1[2]
        local saved_mode = gui.mode
        gui.mode = "inventory"
        local allow_inv = gui:execute_functor(synth_obj, "actor_bag", "execute_functor", precond_fn) and true or false
        gui.mode = "repair"
        local allow_rep = gui:execute_functor(synth_obj, "actor_bag", "execute_functor", precond_fn) and true or false
        gui.mode = saved_mode
        -- In repair mode, menu_precond(obj, mode, bag) MUST return false when D54 safeguard passes self.mode as 2nd arg!
        d54_ok = (allow_inv == true) and (allow_rep == false)
    end

    -- 4. F1.1 StableItemID stale reference rejection verification
    local stale_ref = { session_gen = 999999, object_id = synth_id, instance_gen = 999999 }
    local stale_ok, stale_err = invoke_item_action(stale_ref, "custom_1", "actor_bag", "inventory")
    local stable_guard_ok = (stale_ok == false) and (stale_err == "err:stale_stable_item_id")

    -- Restore temporary hooks
    _G.SYS_GetParam = orig_sys_get
    if level then
        level.object_by_id = orig_obj_by_id
    end
    gui.CheckItem = orig_check_item
    gui.PlaySND = orig_play_snd
    gui.On_Item_Update = orig_item_update
    _G.__gp_selftest_ltx = nil

    local summary = string.format(
        "ok:selftest=%s;ltx=%d/10;active_functors=%d/33;retired_qaw=%d/1;total_catalog=%d/34;d54_repair_guard=%s;stable_id_guard=%s",
        tostring(mode_arg or "1-2"),
        ltx_passed,
        active_verified,
        retired_verified,
        active_verified + retired_verified,
        d54_ok and "pass" or "fail",
        stable_guard_ok and "pass" or "fail"
    )

    local report = {
        summary = summary,
        ltx_passed = ltx_passed,
        ltx_results = ltx_results,
        active_verified = active_verified,
        retired_verified = retired_verified,
        total_catalog = #catalog,
        d54_ok = d54_ok,
        stable_guard_ok = stable_guard_ok,
        catalog = catalog,
    }

    if printf then
        pcall(printf, "* [Gamepad] gp_bridge_selftest: %s", summary)
    end

    return summary, report
end

function gp_bridge_selftest(mode_arg)
    local m = tostring(mode_arg or "1-2")
    if m == "3-4" then
        return selftest_contours_3_4("3-4")
    elseif m == "fg2" then
        return selftest_fg2_fast_buttons("fg2")
    elseif m == "txn" or m == "f41" then
        return selftest_f41_transactions("txn")
    elseif m == "all" then
        local s12, r12 = selftest_contours_1_2("1-2")
        local s34, r34 = selftest_contours_3_4("3-4")
        local sfg2, rfg2 = selftest_fg2_fast_buttons("fg2")
        local stxn, rtxn = selftest_f41_transactions("txn")
        local combined_summary = string.format("ok:selftest=all;c12=(%s);c34=(%s);fg2=(%s);txn=(%s)", tostring(s12), tostring(s34), tostring(sfg2), tostring(stxn))
        return combined_summary, { c12 = r12, c34 = r34, fg2 = rfg2, txn = rtxn, summary = combined_summary }
    end
    return selftest_contours_1_2(m)
end

-- ============================================================================
-- F3.2 (D03, D07, D48, D52, D54): Contours 3-4 ("Apply To..." Read-Only Preview
-- & Confirm + 7 Monkey-Patch Chains) & Fixes C5.1-N1, C5.1-N3
--   Contour 3: Two-step "Apply To..." (Read-only predicate matrix across all
--              compatible pair rules + Cond_Attach; NEVER trial-calls
--              SendScriptCallback("ActorMenu_on_item_drag_drop", ...) or
--              parts_match_item; shows toast "Ne k chemu primenit (CP1251)" if empty).
--   Contour 4: All 7 monkey-patch chains on UIInventory & UIWorkshopCraft.
-- ============================================================================

