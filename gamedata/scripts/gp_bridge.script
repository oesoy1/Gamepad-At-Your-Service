_GP_FILE_MARKER = "GAYS_REL1_20261114"
-- C5.1: InventoryBackendBridge prototype (gp_bridge.script)
-- Headless bridge to ui_inventory.GUI without ShowDialog or Register_UI

local bridge_stats = {
    calls = 0,
    created_headless_count = 0,
    last_op = "none",
    last_item_id = -1,
    last_section = "",
    last_custom_functors = 0,
    last_collected_actions = 0,
    last_invoked_action = "none",
    d54_safeguard_hits = 0,
    dyn_flushes = 0,
    headless_syncs = 0,
    apply_to_previews = 0,
    apply_to_confirms = 0,
    apply_to_empty_toasts = 0,
    last_toast_msg = "",
    active_source = "kbm",
    source_switches = 0,
    last_source_reason = "init",
    last_source_time_ms = 0
}

local source_listeners = {}
local dyn_functors_dirty = true
local flushing_dyn_functors = false

-- D1.2b-N1: Register custom script callback name in dynamic_callbacks.lua intercepts table
-- so RegisterScriptCallback("on_gamepad_source_changed", fn) works for any subscriber.
if AddScriptCallback and not (axr_main and axr_main.intercepts and axr_main.intercepts["on_gamepad_source_changed"]) then
    AddScriptCallback("on_gamepad_source_changed")
end

-- D2.2 (D39): Ensure the "Gamepad" tab wrapper in ui_options_gamepad.script is installed
-- even when Options is opened directly from the Main Menu before on_game_start().
if ui_options_gamepad and ui_options_gamepad.on_xml_read then
    pcall(ui_options_gamepad.on_xml_read)
end

function register_source_listener(name, fn)
    if not name or type(fn) ~= "function" then
        return false
    end
    source_listeners[name] = fn
    return true
end

function unregister_source_listener(name)
    if not name then
        return false
    end
    source_listeners[name] = nil
    return true
end

function get_active_source()
    if game and game.get_active_input_source then
        local ok, res = pcall(game.get_active_input_source)
        if ok and res and res ~= "" then
            bridge_stats.active_source = res
            return res
        end
    end
    return bridge_stats.active_source
end

function is_gamepad_active()
    if game and game.is_gamepad_active_source then
        local ok, res = pcall(game.is_gamepad_active_source)
        if ok and type(res) == "boolean" then
            bridge_stats.active_source = res and "gamepad" or "kbm"
            return res
        end
    end
    return bridge_stats.active_source == "gamepad"
end

function get_source_switches_1m()
    if game and game.get_input_source_switches_1m then
        local ok, res = pcall(game.get_input_source_switches_1m)
        if ok and type(res) == "number" then
            return res
        end
    end
    return bridge_stats.source_switches
end

-- D5.1: Gamepad glyph set & button prompt helpers
function get_glyph_set()
    if game and game.get_gamepad_glyph_set then
        local ok, res = pcall(game.get_gamepad_glyph_set)
        if ok and type(res) == "string" and res ~= "" then
            return res
        end
    end
    return "xbox"
end

function get_glyph_override()
    if game and game.get_gamepad_glyph_override then
        local ok, res = pcall(game.get_gamepad_glyph_override)
        if ok and type(res) == "string" and res ~= "" then
            return res
        end
    end
    return "auto"
end

function set_glyph_override(style_name)
    local style = tostring(style_name or "auto")
    if game and game.set_gamepad_glyph_override then
        local ok, res = pcall(game.set_gamepad_glyph_override, style)
        if ok and res == true then
            return true
        end
    end
    if exec_console_cmd then
        exec_console_cmd("gp_glyphs " .. style)
        return true
    end
    return false
end

function get_action_glyph(action_name)
    if not action_name then
        return ""
    end
    local resolved = tostring(action_name)
    if resolve_menu_button_for_hint then
        resolved = resolve_menu_button_for_hint(resolved)
    end
    if game and game.get_gamepad_action_glyph then
        local ok, res = pcall(game.get_gamepad_action_glyph, resolved)
        if ok and type(res) == "string" then
            return res
        end
    end
    return ""
end

function get_action_icon(action_name)
    if not action_name then
        return ""
    end
    local resolved = tostring(action_name)
    if resolve_menu_button_for_hint then
        resolved = resolve_menu_button_for_hint(resolved)
    end
    if game and game.get_gamepad_action_icon then
        local ok, res = pcall(game.get_gamepad_action_icon, resolved)
        if ok and type(res) == "string" then
            return res
        end
    end
    return ""
end

