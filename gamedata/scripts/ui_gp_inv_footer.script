-- The footer atlas contains native-size category art, surface bevels and font glyphs.
-- Button badges use Dot Marks atlases via gp_icons (ICONS-1, 2026-11-14).
local ATLAS = "ui\\ui_gp_xbox_graphite_p12"
local LABEL_IDS = { take = "ui_gp_inv_hint_select", remove = "ui_gp_inv_hint_unequip", description = "ui_gp_inv_hint_desc", menu = "ui_gp_inv_hint_menu", section = "ui_gp_inv_hint_section" }
local LABEL_EN = { take = "Take", remove = "Remove", description = "Details", menu = "Menu", section = "Section" }
local function tr_label(k)
    local id = LABEL_IDS[k]
    if id and game and game.translate_string then
        local ok, s = pcall(game.translate_string, id)
        if ok and type(s) == "string" and s ~= "" and s ~= id then return s end
    end
    return LABEL_EN[k] or k
end
-- Видимая высота значков в базовых единицах футера (при 1080p u=1: кружок 25 px = прежним 28*0.914, плашка LT/RT 25x41 px = INV-REWORK-26)
local CMD_VIS_H = 25
local TRIG_VIS_H = 25
local COLORS = { normal = {216,216,210}, quiet = {168,171,165}, heavy = {240,106,66},
    available = {8,9,8}, selected = {241,241,235}, disabled = {112,115,109} }

local function px(value)
    return math.floor(value + 0.5)
end

local function sprite(parent)
    local w = CUIStatic()
    w:SetAutoDelete(true)
    w:Enable(false)
    w:SetStretchTexture(true)
    w:InitTexture(ATLAS)
    parent:AttachChild(w)
    return w
end

local function badge_sprite(parent)
    local w = CUIStatic()
    w:SetAutoDelete(true)
    w:Enable(false)
    w:SetStretchTexture(true)
    parent:AttachChild(w)
    return w
end

local function draw(w, f, x, y, width, height, tx, ty, tw, th, color)
    local left, top = px(x), px(y)
    local right, bottom = px(x + width), px(y + height)
    w:SetWndPos(vector2():set(left / f.sx, top / f.sy))
    w:SetWndSize(vector2():set((right-left) / f.sx, (bottom-top) / f.sy))
    w:SetTextureRect(Frect():set(tx, ty, tx+tw, ty+th))
    w:SetTextureColor(GetARGB(255, color and color[1] or 255, color and color[2] or 255, color and color[3] or 255))
    w:Show(true)
end

local function glyphs(text, ink)
    ink = ink or 8
    local run, cursor, first, last = {}, 0, nil, 0
    for i = 1, #text do
        local g = GLYPHS[text:byte(i)] or GLYPHS[63]
        if g[3] > 0 then
            local x = cursor + g[5]
            local ink_left = x + g[ink]
            first = math.min(first or ink_left, ink_left)
            last = math.max(last, x + g[ink+1])
            run[#run+1] = {g, x}
        end
        cursor = cursor + g[7]
    end
    return { run = run, offset = first or 0, width = last - (first or 0) }
end

local function draw_text(f, group, text, x, baseline, color, scale)
    local run = text.run
    local u = scale or f.unit
    for i, entry in ipairs(run) do
        local g, offset = entry[1], entry[2]
        group[i] = group[i] or sprite(f.root)
        draw(group[i], f, x + (offset-text.offset)*u, baseline+g[6]*u, g[3]*u,g[4]*u,g[1],g[2],g[3],g[4],color)
    end
    for i = #run + 1, #group do group[i]:Show(false) end
    return px(text.width*u)
end

local function remember_native(f, gui)
    for _, g in ipairs({gui.player_weight_cap, gui.player_weight, gui.player_weight_max}) do
        f.native[#f.native+1] = {w = g, shown = g:IsShown()}
    end
    for _, g in ipairs(gui.sort_num or {}) do
        f.native[#f.native+1] = {w = g, shown = g:IsShown()}
    end
    for i, b in ipairs(gui.sort_btn or {}) do
        local p = b:GetWndPos()
        f.buttons[i] = { w = b, x = p.x, y = p.y, width = b:GetWidth(), height = b:GetHeight() }
    end
end

local function set_buttons(f, enabled)
    local u = f.unit
    for i, b in ipairs(f.buttons) do
        if enabled then
            local left = px(f.base + (69 + (i-1)*50)*u)
            local right = px(f.base + (69 + i*50)*u)
            local top, bottom = px(f.axis-16*u), px(f.axis+16*u)
            b.w:SetWndPos(vector2():set(left/f.sx-f.sort_x,top/f.sy-f.sort_y))
            b.w:SetWndSize(vector2():set((right-left)/f.sx,(bottom-top)/f.sy))
        else
            b.w:SetWndPos(vector2():set(b.x,b.y))
            b.w:SetWndSize(vector2():set(b.width,b.height))
        end
    end
end

local function create(gui, rects, dev)
    local sx, sy = dev.width/1024, dev.height/768
    local left = px(rects.rail.left*sx)
    local right = px(rects.rail.right*sx)
    local top = px(rects.rail.top*sy)
    local panel_left = px((rects.ply.x+12)*sx)
    local panel_right = px((rects.ply.x+rects.ply.w-7.8)*sx)
    local unit = math.min(dev.height/1080, (right-left)/639, (panel_right-panel_left)/893)
    local root = CUIWindow()
    root:SetAutoDelete(true)
    root:Enable(false)
    gui:AttachChild(root)
    local f = { root=root, sx=sx, sy=sy, unit=unit, base=(left+right-639*unit)*0.5,
        axis=top+20*unit, rail_left=left, rail_right=right, panel_left=panel_left, panel_right=panel_right,
        sort_x=rects.equ.x+rects.sort.x, sort_y=rects.equ.y+rects.sort.y,
        native={}, buttons={}, categories={}, digits={}, badges={}, text={}, cache={} }
    remember_native(f, gui)
    local surface_height = px(top+40*unit) - top
    f.surface = sprite(root)
    draw(f.surface, f, left, top, right-left, surface_height, 2,68,639,40)
    f.command_surface = sprite(root)
    -- Cover the inner bevels up to the black frame. Keep the command and weight anchors inset.
    local command_left = px((rects.ply.x+8.4)*sx)
    local command_right = px((rects.ply.x+rects.ply.w-4.2)*sx)
    draw(f.command_surface, f, command_left, top, command_right-command_left, surface_height, 2,258,893,40)
    for i = 1, 10 do
        f.categories[i] = sprite(root)
        f.digits[i] = {}
    end
    f.indicator = sprite(root)
    for i = 1, 6 do f.badges[i] = badge_sprite(root) end
    for i = 1, 7 do f.text[i] = {} end
    set_buttons(f, true)
    return f
end

local function binding(semantic)
    return gp_bridge and gp_bridge.resolve_menu_button_for_hint and gp_bridge.resolve_menu_button_for_hint(semantic) or semantic
end

local function icon_scale_k()
    local ic = _G.gp_icons
    return (ic and ic.scale_k) and ic.scale_k() or 1.0
end

local function menu_hints_visible()
    local ic = _G.gp_icons
    return (not ic or not ic.hints_visible) or ic.hints_visible("menu")
end

local function icon_revision()
    local ic = _G.gp_icons
    return (ic and ic.revision) and ic.revision() or 0
end

local function badge_tex(token, semantic)
    local ic = _G.gp_icons
    if ic and ic.tex then return ic.tex(token, "round") end
    return gp_bridge and gp_bridge.get_action_icon and gp_bridge.get_action_icon(semantic) or nil
end

local function badge_metrics(token, base_vis_h)
    local vis_h = (base_vis_h or CMD_VIS_H) * icon_scale_k()
    local ic = _G.gp_icons
    if ic and ic.dims then
        local vw, vh, tw, th = ic.dims(token, "round")
        if vw and vh and vh > 0 then
            local k = vis_h / vh
            local vis_w = vw * k
            local box_w = tw * k
            local box_h = th * k
            return vis_w, vis_h, box_w, box_h, (box_w - vis_w) * 0.5
        end
    end
    return vis_h, vis_h, vis_h, vis_h, 0
end

local function place_badge(w, f, box_x, box_y, box_w, box_h, texture)
    if texture and texture ~= "" and w ~= nil then
        w:InitTexture(texture)
        local left, top = px(box_x), px(box_y)
        local right, bottom = px(box_x + box_w), px(box_y + box_h)
        w:SetWndPos(vector2():set(left / f.sx, top / f.sy))
        w:SetWndSize(vector2():set((right - left) / f.sx, (bottom - top) / f.sy))
        w:SetTextureColor(GetARGB(255, 255, 255, 255))
        w:Show(true)
    elseif w ~= nil then
        w:Show(false)
    end
end

local function refresh_categories(f, active)
    local u = f.unit
    for i, tab in ipairs(f.categories) do
        local button = f.buttons[i] and f.buttons[i].w
        local selected = button and button:GetCheck()
        local color = selected and COLORS.selected or COLORS.available
        if not selected and button and button.IsEnabled and not button:IsEnabled() then color = COLORS.disabled end
        local x = f.base + (94+(i-1)*50)*u
        draw(tab,f,x-16*u,f.axis-14*u,32*u,28*u,2+(i-1)*36,2,32,28,color)
        if selected then draw(f.indicator,f,x-9*u,f.axis+15*u,18*u,2*u,652,72,18,2) end
        if not active then
            local digit = glyphs(tostring(i))
            -- These are key labels, small and at the corner of their category.
            draw_text(f,f.digits[i],digit,x+11*u,f.axis+14*u,COLORS.quiet,u*0.48)
        else
            for _, w in ipairs(f.digits[i]) do w:Show(false) end
        end
    end
end

local function refresh_row(f, gui, active, glyph_set, bag, a_text)
    local u = f.unit
    local taken = bag == "actor_equ"
    -- INV-REWORK-1: A — по предмету (Надеть/Снять/Использовать...), Y «Описание», View «Раздел», X «Меню»
    local labels = {a_text or tr_label(taken and "remove" or "take"), tr_label("description"), tr_label("section"), tr_label("menu")}
    local weight, limit = gui.player_weight:GetText() or "", gui.player_weight_max:GetText() or ""
    -- INV-REWORK-21: вес одной цифрой "63.9 / 68.7" (решение Миши 2026-11-12)
    local w1, w2 = weight:match("%d+[%.,]?%d*"), limit:match("%d+[%.,]?%d*")
    if w1 and w2 then weight, limit = w1 .. " / " .. w2, "" end
    local native_color = gui.player_weight:GetTextColor() % 16777216
    local color = native_color == 0xff3200 and COLORS.heavy or COLORS.normal
    local baseline = f.axis+8*u
    -- INV-REWORK-1: без слов «Общий вес» — только числа (решение Миши 2026-11-11)
    local weight_runs = {glyphs(""),glyphs(weight,color == COLORS.heavy and 12 or 8),glyphs(limit,10)}
    local wx = f.panel_right-14*u
    for _,w in ipairs(f.text[4]) do w:Show(false) end
    for i = 3,2,-1 do
        local run = weight_runs[i]
        wx = wx - run.width*u
        draw_text(f,f.text[3+i],run,wx,baseline,i == 3 and COLORS.quiet or color)
        if i > 2 then wx = wx-12*u end
    end
    local x = f.panel_left+14*u
    local show_commands = active and not (gui.player_putall and gui.player_putall:IsShown())
    local run = {glyphs(labels[1]),glyphs(labels[2]),glyphs(labels[3]),glyphs(labels[4])}
    local button_names = {"A","Y","View","X"}
    local slots = { {b=1,t=1}, {b=2,t=2}, {b=6,t=7}, {b=3,t=3} }
    local tokens, metrics, icons_adv = {}, {}, 0
    for i = 1, 4 do
        tokens[i] = binding(button_names[i])
        local vw, vh, bw, bh, pad_x = badge_metrics(tokens[i], CMD_VIS_H)
        local adv = vw + 13
        metrics[i] = { vw = vw, vh = vh, bw = bw, bh = bh, pad_x = pad_x, adv = adv }
        icons_adv = icons_adv + adv
    end
    -- Four commands; the gap shrinks before anything is hidden.
    local text_w = run[1].width+run[2].width+run[3].width+run[4].width
    local gap = 40
    local function needed_for(g) return (icons_adv+g*3+text_w)*u end
    while gap > 20 and wx - (x + needed_for(gap)) < 32*u do gap = gap - 4 end
    -- Weight is right-aligned and cannot move the commands. If exceptional
    -- strings cannot fit, keep the weight readable rather than overlap it.
    show_commands = show_commands and wx - (x + needed_for(gap)) >= 32*u
    for i = 1,4 do
        local slot = slots[i]
        if show_commands then
            local m = metrics[i]
            local tex = badge_tex(tokens[i], button_names[i])
            place_badge(
                f.badges[slot.b], f,
                x + (1.5 - m.pad_x) * u,
                f.axis - m.bh * 0.5 * u,
                m.bw * u, m.bh * u, tex
            )
            x = x+m.adv*u
            draw_text(f,f.text[slot.t],run[i],x,baseline,COLORS.normal)
            x = x+(run[i].width+gap)*u
        else
            f.badges[slot.b]:Show(false)
            for _,w in ipairs(f.text[slot.t]) do w:Show(false) end
        end
    end
end

function update(gui, hints, active, bag)
    if not gui or gui.mode ~= "inventory" or not gui.player_weight_cap or not gui.player_weight or not gui.player_weight_max then
        if hints and hints.pixel_footer then destroy(gui,hints) end
        return false
    end
    local dev = device()
    local f = hints.pixel_footer
    if f and (f.sx ~= dev.width/1024 or f.sy ~= dev.height/768) then
        destroy(gui, hints)
        f = nil
    end
    if not f then
        f = create(gui,hints.rects,dev)
        hints.pixel_footer = f
    end
    f.root:Show(true)
    for _, g in ipairs(f.native) do g.w:Show(false) end
    for _, w in pairs({hints.lt_icon,hints.rt_icon,hints.bottom_bar}) do w:Show(false) end
    local glyph_set = gp_bridge and gp_bridge.get_glyph_set and gp_bridge.get_glyph_set() or "xbox"
    local rev = icon_revision()
    local show_hints = active and menu_hints_visible() and true or false
    local selected = 0
    local states = 0
    for i, b in ipairs(f.buttons) do
        if b.w:GetCheck() then selected = i end
        if b.w.IsEnabled and not b.w:IsEnabled() then states = states + 2^i end
    end
    local category_key = tostring(active)..":"..selected..":"..states
    if category_key ~= f.cache.category then
        f.indicator:Show(false)
        refresh_categories(f,active)
        f.cache.category = category_key
    end
    local u = f.unit
    local trigger_key = table.concat({ tostring(show_hints), glyph_set, tostring(rev), binding("LT"), binding("RT") }, "|")
    if trigger_key ~= f.cache.triggers then
        if show_hints then
            -- Center each hint in the visible gap from frame to category silhouette.
            local first_edge = f.base + (94 - 16 + 4)*u
            local last_edge = f.base + (544 - 16 + 29)*u
            local lt_tok, rt_tok = binding("LT"), binding("RT")
            local _, _, lt_bw, lt_bh = badge_metrics(lt_tok, TRIG_VIS_H)
            local _, _, rt_bw, rt_bh = badge_metrics(rt_tok, TRIG_VIS_H)
            local lt_cx = (f.rail_left + first_edge) * 0.5
            local rt_cx = (f.rail_right + last_edge) * 0.5
            place_badge(f.badges[4], f, lt_cx - lt_bw * 0.5 * u, f.axis - lt_bh * 0.5 * u, lt_bw * u, lt_bh * u, badge_tex(lt_tok, "LT"))
            place_badge(f.badges[5], f, rt_cx - rt_bw * 0.5 * u, f.axis - rt_bh * 0.5 * u, rt_bw * u, rt_bh * u, badge_tex(rt_tok, "RT"))
        else
            f.badges[4]:Show(false)
            f.badges[5]:Show(false)
        end
        f.cache.triggers = trigger_key
    end
    local a_text = nil
    if show_hints and gp_inv_rework and gp_inv_rework.hovered_a_label then
        local ok, res = pcall(gp_inv_rework.hovered_a_label, gui)
        if ok and type(res) == "string" then a_text = res end
    end
    local row_key = table.concat({ tostring(show_hints), glyph_set, tostring(rev), binding("A"), binding("Y"), binding("X"), binding("View"), tostring(bag=="actor_equ"), tostring(a_text),
        tostring(gui.player_putall and gui.player_putall:IsShown()), gui.player_weight:GetText() or "",
        gui.player_weight_max:GetText() or "", tostring(gui.player_weight:GetTextColor()) }, "|")
    if row_key ~= f.cache.row then
        refresh_row(f,gui,show_hints,glyph_set,bag,a_text)
        f.cache.row = row_key
    end
    return true
end

function hide(hints)
    if hints and hints.pixel_footer then hints.pixel_footer.root:Show(false) end
end

function destroy(gui,hints)
    local f = hints and hints.pixel_footer
    if not f then return end
    f.root:Show(false)
    set_buttons(f,false)
    for _, entry in ipairs(f.native) do entry.w:Show(entry.shown) end
    gui:DetachChild(f.root)
    hints.pixel_footer = nil
end

