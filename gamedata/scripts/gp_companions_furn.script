PENDING_RECOVER_MS = 600
DIM_ALPHA = 110
CIRCLE_K = 1.5
STRIP_ICON_H = 18
STRIP_GAP_PX = 8
STRIP_ITEM_GAP_PX = 26

local DIR_UP = 1
local DIR_DOWN = 2
local DIR_LEFT = 3
local DIR_RIGHT = 4

