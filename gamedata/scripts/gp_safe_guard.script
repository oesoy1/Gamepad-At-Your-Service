_GP_FILE_MARKER = "GAYS_REL1_20261114"
--[[
    gp_safe_guard.script  --  Step S1: Global Safe Frame & Input Handler Guard ("Core Armor")

    Purpose:
      Wraps all entry points, per-frame callbacks (`actor_on_update`, `Update`), button/key
      handlers, UI lifecycle hooks, and C++ -> Lua bridge functions across all `gp_*.script`
      modules in a protective `pcall` armor.
      1. If any unexpected runtime error occurs inside gamepad logic during a frame or button
         press, the game does NOT crash (`CScriptEngine::lua_pcall_failed`) and does NOT hang --
         the problematic frame/action is safely skipped and a safe fallback value is returned.
      2. Writes a clear diagnostic message to the engine log with anti-spam rate-limiting
         (if the same error repeats every frame, it logs immediately once and then summarizes
         periodically instead of flooding the log).
      3. Forwards crash/error reports to `gp_failover` (emergency KBM failover) and
         `gp_error_log` (structured error report writer) whenever those modules are present.
--]]

local ANTI_SPAM_WINDOW_MS = 5000
local ANTI_SPAM_SUMMARY_STEP = 50

local TARGET_MODULES = {
    "gp_bridge",
    "gp_compat",
    "gp_field",
    "gp_weapon",
    "gp_wheel_arm",
    "gp_wheel",
    "gp_pda",
    "gp_screens",
    "gp_inv_pause",
    "gp_lifecycle",
    "gp_toasts",
    "gp_testkit",
}

local CLASS_METHODS_TO_GUARD = {
    gp_wheel_arm = {
        AbstractRadialMenu = { "Update", "OnKeyboard", "OnClick", "Close", "Reset", "SetCellState", "AnimateCell" },
    },
    gp_wheel = {
        QuickActionWheel      = { "Update", "OnKeyboard", "OnMouseWheel", "OnClick", "Close", "Open", "Reset", "AnimateCell", "ApplyHoveredSector", "UpdateHeaderText" },
        ItemWheelOption       = { "update", "execute", "is_enabled", "get_text" },
        SlotWheelOption       = { "update", "execute", "is_enabled", "get_text" },
        AttachmentWheelOption = { "update", "execute", "is_enabled", "get_text" },
        DetectorWheelOption   = { "update", "execute", "is_enabled", "get_text" },
        QDetectorWheelOption  = { "update", "execute", "is_enabled", "get_text" },
        AmmoWheelOption       = { "update", "execute", "is_enabled", "get_text" },
        ActionWheelOption     = { "update", "execute", "is_enabled", "get_text" },
        CompanionWheelOption  = { "update", "execute", "is_enabled", "get_text" },
    },
    gp_testkit = {
        UIGpTestTicker      = { "Update" },
        UIGpTestQuestionWnd = { "Update", "OnKeyboard", "SelectOption", "OnAbortClicked", "CloseWindow" },
    },
}

