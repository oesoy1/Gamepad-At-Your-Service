_GP_FILE_MARKER = "GAYS_REL1_20261114"
-- gp_ui_tune.script — ядро редактора интерфейса (шаг UIDBG, этап Э1).
-- Документ: docs/ui/debug-menu/ПРОМПТ — дебаг-меню интерфейса.md (§4 решения Р1–Р15, §5 архитектура).
-- Здесь НЕТ ни одного вызова ImGui: реестр экранов и элементов, правки сеанса, отмена, профили ltx,
-- пересчёт координат, пределы значений (Р3б), доступ к редактору (Р3), перевод cp1251 -> UTF-8 (§5.4).
-- Вид (окно ImGui) — gp_ui_editor.script. Файл в Windows-1251 (исходник в UTF-8: build/uidbg-src).
--
-- Слои профиля (Р4а): базовый configs\gamepad\ui_layout_base.ltx (с модом, только чтение)
--   -> пользовательский appdata\gamepad\ui-layout\user.ltx (правки игрока) -> сеанс (несохранённые правки).
-- Сеанс — рабочая копия пользовательского слоя: «Сохранить» пишет его в user.ltx целиком.
-- Секция "<id>" — общая правка; "<id>@21x9" и т.п. — необязательная поправка для одного соотношения (Р13).
-- Ключи секции: dx, dy, dw, dh (сдвиги в единицах элемента), color / text_color ("a,r,g,b").
-- Единицы элемента: "ui_kx" — UI-единицы 1024x768, по X умножаются на kx = (4/3)/(w/h), чтобы сдвиг
--   выглядел одинаково на 16:9 и 21:9 (§5.6 п.2); "ui" — UI-единицы без поправки; "px" — экранные пиксели.

local VERSION = 1
local ALPHA_MIN = 26          -- 10% от 255 (Р3б)
local EDGE_PX = 8             -- элемент не может уйти за край кадра дальше, чем на 8 px внутри (Р3б)
local MIN_PX = 4              -- минимальный размер 4x4 px (Р3б)
local KEYS_NUM = { "dx", "dy", "dw", "dh" }
local KEYS_CLR = { "color", "text_color" }

local screens = {}            -- id -> spec
local screen_order = {}
local tracked = {}            -- id -> CUIWindow, который рисуют слои мода через tune_rect
local snap = {}               -- id -> { wnd = окно, x, y, w, h, color, text_color } исходная геометрия ui_window
local base_layer = {}         -- секция -> { ключ -> значение }
local user_layer = {}
local session = {}
local undo_stack = {}
local dirty = false
local native_view = false     -- «родной вид»: правки не применяются (для сравнения А/Б, этап Э3)
local generation = 0          -- растёт при любой правке, слои мода по нему понимают, что пора перерисоваться
local u8_cache = {}
local loaded = false
local custom_paths = nil      -- для тестов: { base = ..., user = ..., flat = ... }

-- ---------------------------------------------------------------------------------------------
-- Служебное: координаты, соотношение сторон, перевод строк
-- ---------------------------------------------------------------------------------------------
function screen_size()
    local w, h = 1920, 1080
    if device then
        local ok, d = pcall(device)
        if ok and d and tonumber(d.width) and tonumber(d.height) and d.width > 0 and d.height > 0 then
            w, h = d.width, d.height
        end
    end
    return w, h
end

function kx()
    local w, h = screen_size()
    return (4 / 3) / (w / h)
end

function px_to_ui(px, py)
    local w, h = screen_size()
    return (tonumber(px) or 0) * 1024 / w, (tonumber(py) or 0) * 768 / h
end

function ui_to_px(x, y)
    local w, h = screen_size()
    return (tonumber(x) or 0) * w / 1024, (tonumber(y) or 0) * h / 768
end

-- Сколько UI-единиц в одном экранном пикселе (по X и по Y). На 2560x1080 это 0.4 и 0.711.
function screen_px_step()
    local w, h = screen_size()
    return 1024 / w, 768 / h
end

-- Корзина соотношения сторон для поправок "@..." (Р13).
function aspect_bucket()
    local w, h = screen_size()
    local a = w / h
    local best, best_d = "16x9", nil
    for _, b in ipairs({ { "4x3", 4 / 3 }, { "16x10", 16 / 10 }, { "16x9", 16 / 9 }, { "21x9", 64 / 27 }, { "32x9", 32 / 9 } }) do
        local d = math.abs(a - b[2])
        if not best_d or d < best_d then best, best_d = b[1], d end
    end
    return best
end

-- Перевод экранных пикселей в единицы элемента (для стрелок и перетаскивания).
function px_delta_to_units(unit, dpx, dpy)
    local sx, sy = screen_px_step()
    dpx, dpy = tonumber(dpx) or 0, tonumber(dpy) or 0
    if unit == "px" then return dpx, dpy end
    if unit == "ui" then return dpx * sx, dpy * sy end
    return dpx * sx / kx(), dpy * sy
end

-- Перевод сдвига элемента в UI-единицы (обратное к px_delta_to_units без перехода в пиксели).
function units_to_ui(unit, dx, dy)
    dx, dy = tonumber(dx) or 0, tonumber(dy) or 0
    if unit == "px" then
        local sx, sy = screen_px_step()
        return dx * sx, dy * sy
    end
    if unit == "ui" then return dx, dy end
    return dx * kx(), dy
end

-- cp1251 -> UTF-8 для подписей ImGui (§5.4): ImGui ждёт UTF-8, а Lua-строки игры в cp1251.
local CP_EXTRA = { [0xA8] = 0x0401, [0xB8] = 0x0451, [0xB9] = 0x2116, [0x96] = 0x2013, [0x97] = 0x2014,
    [0xAB] = 0x00AB, [0xBB] = 0x00BB, [0xA0] = 0x00A0 }
local function utf8_char(cp)
    if cp < 0x800 then
        return string.char(0xC0 + math.floor(cp / 64), 0x80 + cp % 64)
    end
    return string.char(0xE0 + math.floor(cp / 4096), 0x80 + math.floor(cp / 64) % 64, 0x80 + cp % 64)
end
function u8(s)
    s = tostring(s or "")
    local c = u8_cache[s]
    if c then return c end
    local out = s:gsub("[\128-\255]", function(ch)
        local b = ch:byte()
        if b >= 0xC0 then return utf8_char(0x0410 + b - 0xC0) end
        local cp = CP_EXTRA[b]
        return cp and utf8_char(cp) or "?"
    end)
    u8_cache[s] = out
    return out
end

-- ---------------------------------------------------------------------------------------------
-- Доступ к редактору (Р3): галочка «Редактор интерфейса» в настройках геймпада или запуск с -dbg.
-- ---------------------------------------------------------------------------------------------
function is_debug_build()
    if rawget(_G, "DEV_DEBUG") == true then return true end
    if command_line then
        local ok, cl = pcall(command_line)
        if ok and type(cl) == "string" and cl:find("-dbg", 1, true) then return true end
    end
    return false
end

function is_editor_option_on()
    if ui_options and type(ui_options.get) == "function" then
        local ok, v = pcall(ui_options.get, "control/gamepad/gp_ui_editor")
        if ok and v ~= nil then return v == true or v == "true" or v == 1 end
    end
    return false
end

function is_editor_allowed()
    return is_debug_build() or is_editor_option_on()
end

-- ---------------------------------------------------------------------------------------------
-- Реестр экранов и элементов
-- ---------------------------------------------------------------------------------------------
-- spec: { title = "...", detect = function() return gui|nil end }
function register_screen(id, spec)
    if not screens[id] then screen_order[#screen_order + 1] = id end
    spec = spec or {}
    spec.id = id
    spec.elements = (screens[id] and screens[id].elements) or spec.elements or {}
    spec.by_id = (screens[id] and screens[id].by_id) or {}
    screens[id] = spec
    for _, el in ipairs(spec.elements) do spec.by_id[el.id] = el end
    return spec
end

-- el: { id, title, kind = "ui_window"|"tracked", unit, caps = {pos,size,color,text_color},
--       get = function(gui) return окно end (ui_window), owner = id_панели (tracked, необязательно) }
function register_element(screen_id, el)
    local s = screens[screen_id] or register_screen(screen_id, { title = screen_id })
    if s.by_id[el.id] then
        for i, old in ipairs(s.elements) do
            if old.id == el.id then s.elements[i] = el end
        end
    else
        s.elements[#s.elements + 1] = el
    end
    el.unit = el.unit or "ui_kx"
    el.caps = el.caps or { pos = true, size = true }
    el.screen = screen_id
    s.by_id[el.id] = el
    return el
end

function get_screen(id) return screens[id] end
function list_screens() return screen_order end
function list_elements(screen_id)
    local s = screens[screen_id]
    return s and s.elements or {}
end

function find_element(id)
    for _, sid in ipairs(screen_order) do
        local el = screens[sid].by_id[id]
        if el then return el end
    end
    return nil
end

function detect_active_screen()
    for _, sid in ipairs(screen_order) do
        local s = screens[sid]
        if s.detect then
            local ok, gui = pcall(s.detect)
            if ok and gui then return sid, gui end
        end
    end
    return nil, nil
end

-- Окно элемента: для ui_window — из экземпляра экрана, для tracked — последнее, что рисовал слой мода.
function element_window(el, gui)
    if el.kind == "tracked" then return tracked[el.id] end
    if el.get and gui then
        local ok, w = pcall(el.get, gui)
        if ok then return w end
    end
    return nil
end

local function shown(w)
    if not w then return false end
    if type(w.IsShown) == "function" then
        local ok, v = pcall(w.IsShown, w)
        return ok and v == true
    end
    return true
end

function element_visible(el, gui)
    local w = element_window(el, gui)
    if not shown(w) then return false end
    if el.owner then
        local oel = find_element(el.owner)
        if oel and not shown(element_window(oel, gui)) then return false end
    end
    return true
end

-- Живые границы в UI-единицах: x1, y1, x2, y2 (или nil).
function element_rect(el, gui)
    local w = element_window(el, gui)
    if not w or type(w.GetAbsoluteRect) ~= "function" then return nil end
    local r = Frect():set(0, 0, 0, 0)
    local ok = pcall(w.GetAbsoluteRect, w, r)
    if not ok then return nil end
    return r.x1, r.y1, r.x2, r.y2
end

-- Выбор по точке (UI-единицы): все видимые элементы, содержащие точку, от меньшего к большему по площади.
function pick_at(screen_id, gui, ux, uy)
    local hits = {}
    for _, el in ipairs(list_elements(screen_id)) do
        if element_visible(el, gui) then
            local x1, y1, x2, y2 = element_rect(el, gui)
            if x1 and ux >= x1 and ux <= x2 and uy >= y1 and uy <= y2 then
                hits[#hits + 1] = { el = el, area = (x2 - x1) * (y2 - y1) }
            end
        end
    end
    table.sort(hits, function(a, b)
        if a.area ~= b.area then return a.area < b.area end
        return a.el.id < b.el.id
    end)
    local out = {}
    for i, h in ipairs(hits) do out[i] = h.el end
    return out
end

-- Повторный щелчок в ту же точку выбирает следующий по площади элемент.
function pick_next(screen_id, gui, ux, uy, current_id)
    local list = pick_at(screen_id, gui, ux, uy)
    if #list == 0 then return nil end
    for i, el in ipairs(list) do
        if el.id == current_id then return list[(i % #list) + 1] end
    end
    return list[1]
end

-- ---------------------------------------------------------------------------------------------
-- Правки: слои, сеанс, отмена
-- ---------------------------------------------------------------------------------------------
local function copy_layer(src)
    local dst = {}
    for sec, kv in pairs(src or {}) do
        dst[sec] = {}
        for k, v in pairs(kv) do dst[sec][k] = v end
    end
    return dst
end

-- Итоговые значения элемента: базовый -> базовый@корзина -> сеанс -> сеанс@корзина.
function get_override(id)
    if native_view then return {} end
    ensure_loaded()
    local out = {}
    local b = aspect_bucket()
    for _, layer in ipairs({ base_layer, session }) do
        for _, sec in ipairs({ id, id .. "@" .. b }) do
            for k, v in pairs(layer[sec] or {}) do out[k] = v end
        end
    end
    return out
end

local function bump()
    generation = generation + 1
end

function get_generation() return generation end
function is_dirty() return dirty end

-- scope: nil — общая правка, "bucket" — только для текущего соотношения сторон.
function set_override(id, key, value, scope, no_undo)
    ensure_loaded()
    local sec = (scope == "bucket") and (id .. "@" .. aspect_bucket()) or id
    session[sec] = session[sec] or {}
    local old = session[sec][key]
    if old == value then return false end
    if not no_undo then
        undo_stack[#undo_stack + 1] = { sec = sec, key = key, old = old }
    end
    session[sec][key] = value
    if next(session[sec]) == nil then session[sec] = nil end
    dirty = true
    bump()
    return true
end

-- Несколько ключей одним шагом отмены (перетаскивание, стрелки).
function set_overrides(id, kv, scope)
    local group = {}
    local changed = false
    for k, v in pairs(kv) do
        local sec = (scope == "bucket") and (id .. "@" .. aspect_bucket()) or id
        local old = session[sec] and session[sec][k]
        if set_override(id, k, v, scope, true) then
            group[#group + 1] = { sec = sec, key = k, old = old }
            changed = true
        end
    end
    if changed then undo_stack[#undo_stack + 1] = { group = group } end
    return changed
end

local function undo_one(e)
    session[e.sec] = session[e.sec] or {}
    session[e.sec][e.key] = e.old
    if next(session[e.sec]) == nil then session[e.sec] = nil end
end

function undo()
    local e = table.remove(undo_stack)
    if not e then return false end
    if e.group then
        for i = #e.group, 1, -1 do undo_one(e.group[i]) end
    elseif e.reset then
        for sec, kv in pairs(e.reset) do session[sec] = kv end
    else
        undo_one(e)
    end
    dirty = true
    bump()
    return true
end

function undo_depth() return #undo_stack end

-- «Сбросить элемент» = значение базового профиля (Р4а): снимаем общую правку и все поправки "@...".
function reset_element(id)
    ensure_loaded()
    local removed = {}
    for sec, kv in pairs(session) do
        if sec == id or sec:sub(1, #id + 1) == id .. "@" then removed[sec] = kv end
    end
    if next(removed) == nil then return false end
    for sec in pairs(removed) do session[sec] = nil end
    undo_stack[#undo_stack + 1] = { reset = removed }
    dirty = true
    bump()
    return true
end

function reset_screen(screen_id)
    local any = false
    for _, el in ipairs(list_elements(screen_id)) do
        if reset_element(el.id) then any = true end
    end
    return any
end

function set_native_view(flag)
    native_view = flag and true or false
    bump()
end
function is_native_view() return native_view end

-- ---------------------------------------------------------------------------------------------
-- Пределы значений (Р3б)
-- ---------------------------------------------------------------------------------------------
-- Прямоугольник в UI-единицах: не меньше 4x4 px и не дальше края кадра, чем на 8 px внутри.
function clamp_rect_ui(x1, y1, x2, y2)
    local sx, sy = screen_px_step()
    local min_w, min_h = MIN_PX * sx, MIN_PX * sy
    if x2 - x1 < min_w then x2 = x1 + min_w end
    if y2 - y1 < min_h then y2 = y1 + min_h end
    local edge_x, edge_y = EDGE_PX * sx, EDGE_PX * sy
    local dx, dy = 0, 0
    if x2 < edge_x then dx = edge_x - x2 elseif x1 > 1024 - edge_x then dx = (1024 - edge_x) - x1 end
    if y2 < edge_y then dy = edge_y - y2 elseif y1 > 768 - edge_y then dy = (768 - edge_y) - y1 end
    return x1 + dx, y1 + dy, x2 + dx, y2 + dy
end

-- Прозрачность видимого элемента не ниже 10%.
function clamp_alpha(a)
    a = math.floor((tonumber(a) or 255) + 0.5)
    if a < ALPHA_MIN then return ALPHA_MIN end
    if a > 255 then return 255 end
    return a
end

-- Новый сдвиг элемента с учётом пределов. base = {x1,y1,x2,y2} — родные границы (без правок) в UI.
function clamp_delta(el, base, dx, dy, dw, dh)
    if not base then return dx, dy, dw, dh end
    local ox, oy = units_to_ui(el.unit, dx, dy)
    local ow, oh = units_to_ui(el.unit, dw, dh)
    local x1, y1 = base[1] + ox, base[2] + oy
    local x2, y2 = base[3] + ox + ow, base[4] + oy + oh
    local cx1, cy1, cx2, cy2 = clamp_rect_ui(x1, y1, x2, y2)
    local kxu = (el.unit == "ui" and 1) or (el.unit == "px" and screen_px_step()) or kx()
    local _, syu = screen_px_step()
    local kyu = (el.unit == "px") and syu or 1
    local ndx = dx + (cx1 - x1) / kxu
    local ndy = dy + (cy1 - y1) / kyu
    local ndw = dw + ((cx2 - cx1) - (x2 - x1)) / kxu
    local ndh = dh + ((cy2 - cy1) - (y2 - y1)) / kyu
    return ndx, ndy, ndw, ndh
end

-- Сдвинуть/растянуть элемент (одним шагом отмены, с пределами).
function move_element(el, gui, ddx, ddy, ddw, ddh)
    local o = get_override(el.id)
    local dx = (tonumber(o.dx) or 0) + (ddx or 0)
    local dy = (tonumber(o.dy) or 0) + (ddy or 0)
    local dw = (tonumber(o.dw) or 0) + (ddw or 0)
    local dh = (tonumber(o.dh) or 0) + (ddh or 0)
    local base = native_rect(el, gui)
    dx, dy, dw, dh = clamp_delta(el, base, dx, dy, dw, dh)
    return set_overrides(el.id, { dx = round3(dx), dy = round3(dy), dw = round3(dw), dh = round3(dh) })
end

function round3(v)
    return math.floor((tonumber(v) or 0) * 1000 + 0.5) / 1000
end

-- Родные (без правок) границы элемента в UI: текущие минус применённый сдвиг.
function native_rect(el, gui)
    local x1, y1, x2, y2 = element_rect(el, gui)
    if not x1 then return nil end
    local o = get_override(el.id)
    local ox, oy = units_to_ui(el.unit, o.dx, o.dy)
    local ow, oh = units_to_ui(el.unit, o.dw, o.dh)
    return { x1 - ox, y1 - oy, x2 - ox - ow, y2 - oy - oh }
end

-- ---------------------------------------------------------------------------------------------
-- Применение
-- ---------------------------------------------------------------------------------------------
-- Крючок для слоёв мода, которые сами считают позицию (ui_gp_native.rect): вернуть x, y, w, h с правкой.
-- Без правок возвращает те же числа — поведение побайтово прежнее.
function tune_rect(id, wnd, x, y, w, h)
    if wnd then tracked[id] = wnd end
    ensure_loaded()
    local o = get_override(id)
    if o.dx == nil and o.dy == nil and o.dw == nil and o.dh == nil then return x, y, w, h end
    local el = find_element(id)
    local unit = el and el.unit or "ui_kx"
    local ox, oy = units_to_ui(unit, o.dx, o.dy)
    local ow, oh = units_to_ui(unit, o.dw, o.dh)
    return x + ox, y + oy, w + ow, h + oh
end

function parse_color(s)
    if type(s) ~= "string" then return nil end
    local a, r, g, b = s:match("^%s*(%d+)%s*,%s*(%d+)%s*,%s*(%d+)%s*,%s*(%d+)%s*$")
    if not a then return nil end
    return clamp_byte(a), clamp_byte(r), clamp_byte(g), clamp_byte(b)
end

function clamp_byte(v)
    v = math.floor((tonumber(v) or 0) + 0.5)
    if v < 0 then return 0 end
    if v > 255 then return 255 end
    return v
end

function color_to_string(a, r, g, b)
    return string.format("%d,%d,%d,%d", clamp_alpha(a), clamp_byte(r), clamp_byte(g), clamp_byte(b))
end

function argb_split(c)
    c = tonumber(c) or 0
    local a = math.floor(c / 16777216) % 256
    local r = math.floor(c / 65536) % 256
    local g = math.floor(c / 256) % 256
    local b = c % 256
    return a, r, g, b
end

-- Родное окно игры (ui_window): запомнить исходную геометрию при первой встрече с этим окном,
-- затем ставить «исходная + сдвиг». Повторный вызов без изменений ничего не портит.
function apply_window(el, wnd)
    if not wnd then return false end
    local s = snap[el.id]
    if not s or not rawequal(s.wnd, wnd) then  -- luabind: у окон нет __eq, только rawequal
        local p = wnd:GetWndPos()
        s = { wnd = wnd, x = p.x, y = p.y, w = wnd:GetWidth(), h = wnd:GetHeight() }
        if el.caps.color and type(wnd.GetTextureColor) == "function" then s.color = wnd:GetTextureColor() end
        if el.caps.text_color and type(wnd.GetTextColor) == "function" then s.text_color = wnd:GetTextColor() end
        snap[el.id] = s
    end
    local o = get_override(el.id)
    local ox, oy = units_to_ui(el.unit, o.dx, o.dy)
    local ow, oh = units_to_ui(el.unit, o.dw, o.dh)
    wnd:SetWndPos(vector2():set(s.x + ox, s.y + oy))
    wnd:SetWndSize(vector2():set(s.w + ow, s.h + oh))
    for _, key in ipairs(KEYS_CLR) do
        if el.caps[key] and s[key] ~= nil then
            local a, r, g, b = parse_color(o[key])
            local c = a and GetARGB(a, r, g, b) or s[key]
            if key == "color" then wnd:SetTextureColor(c) else wnd:SetTextColor(c) end
        end
    end
    return true
end

-- Применить правки ко всем родным окнам экрана; tracked-элементы перерисует invalidate экрана.
function apply_screen(screen_id, gui)
    local s = screens[screen_id]
    if not s or not gui then return 0 end
    local n = 0
    for _, el in ipairs(s.elements) do
        if el.kind ~= "tracked" and apply_window(el, element_window(el, gui)) then n = n + 1 end
    end
    if s.invalidate then pcall(s.invalidate, gui) end
    return n
end

-- Исходный цвет элемента (для поля «Оформление», когда правки цвета нет).
function native_color(el, gui, key)
    local s = snap[el.id]
    if s and s[key] ~= nil then return argb_split(s[key]) end
    local w = element_window(el, gui)
    if w then
        local fn = (key == "color") and w.GetTextureColor or w.GetTextColor
        if type(fn) == "function" then
            local ok, c = pcall(fn, w)
            if ok and c then return argb_split(c) end
        end
    end
    return 255, 255, 255, 255
end

-- ---------------------------------------------------------------------------------------------
-- Профили (Р4, Р4а): разбор, сборка, чтение, запись
-- ---------------------------------------------------------------------------------------------
function parse(text)
    local layer, meta = {}, {}
    local cur = nil
    for line in (tostring(text or "") .. "\n"):gmatch("([^\r\n]*)\r?\n") do
        local l = line:gsub(";.*$", ""):gsub("^%s+", ""):gsub("%s+$", "")
        local sec = l:match("^%[([^%]]+)%]$")
        if sec then
            cur = sec
            if cur ~= "meta" then layer[cur] = layer[cur] or {} end
        elseif cur and l ~= "" then
            local k, v = l:match("^([%w_]+)%s*=%s*(.-)$")
            if k then
                if cur == "meta" then
                    meta[k] = v
                elseif k == "color" or k == "text_color" then
                    if parse_color(v) then layer[cur][k] = v end
                else
                    local n = tonumber(v)
                    if n then layer[cur][k] = n end
                end
            end
        end
    end
    for sec, kv in pairs(layer) do
        if next(kv) == nil then layer[sec] = nil end
    end
    return layer, meta
end

local function fmt_num(v)
    local s = string.format("%.3f", v):gsub("0+$", ""):gsub("%.$", "")
    if s == "-0" then s = "0" end
    return s
end

function serialize(layer)
    local secs = {}
    for sec in pairs(layer or {}) do secs[#secs + 1] = sec end
    table.sort(secs)
    local out = { "[meta]", "version = " .. VERSION, "" }
    for _, sec in ipairs(secs) do
        out[#out + 1] = "[" .. sec .. "]"
        for _, k in ipairs(KEYS_NUM) do
            local v = layer[sec][k]
            if v ~= nil then out[#out + 1] = k .. " = " .. fmt_num(v) end
        end
        for _, k in ipairs(KEYS_CLR) do
            local v = layer[sec][k]
            if v ~= nil then out[#out + 1] = k .. " = " .. v end
        end
        out[#out + 1] = ""
    end
    return table.concat(out, "\r\n")
end

function set_custom_paths(t) custom_paths = t end

local function fs_path(root, rel)
    if getFS then
        local ok, fs = pcall(getFS)
        if ok and fs and type(fs.update_path) == "function" then
            local ok_p, p = pcall(fs.update_path, fs, root, rel)
            if ok_p and type(p) == "string" and p ~= "" then return p end
        end
    end
    return nil
end

function profile_path(which)
    if custom_paths and custom_paths[which] then return custom_paths[which] end
    if which == "base" then return fs_path("$game_config$", "gamepad\\ui_layout_base.ltx") end
    if which == "flat" then return fs_path("$app_data_root$", "gamepad\\ui_layout_user.ltx") end
    if which == "backup" then return fs_path("$app_data_root$", "gamepad\\ui-layout\\user.bak.ltx") end
    return fs_path("$app_data_root$", "gamepad\\ui-layout\\user.ltx")
end

function read_file(path)
    if not path or type(io) ~= "table" or type(io.open) ~= "function" then return nil end
    local f = io.open(path, "rb")
    if not f then return nil end
    local t = f:read("*a")
    f:close()
    return t
end

-- Запись с запретом путей проекта (как ui_gp_controls.is_path_forbidden_for_write, D37).
function write_file(path, text)
    if not path then return false, "no_path" end
    if ui_gp_controls and type(ui_gp_controls.is_path_forbidden_for_write) == "function" then
        local forbidden, reason = ui_gp_controls.is_path_forbidden_for_write(path)
        if forbidden then return false, reason end
    end
    if type(io) ~= "table" or type(io.open) ~= "function" then return false, "io_unavailable" end
    local f = io.open(path, "wb")
    if not f then return false, "open_failed" end
    f:write(text)
    f:close()
    return true, "ok"
end

-- Загрузить базовый и пользовательский слои; сеанс = копия пользовательского.
function load_profiles()
    base_layer = parse(read_file(profile_path("base")))
    local utext = read_file(profile_path("user")) or read_file(profile_path("flat"))
    user_layer = parse(utext)
    session = copy_layer(user_layer)
    undo_stack = {}
    dirty = false
    loaded = true
    bump()
    return true
end

function ensure_loaded()
    if not loaded then load_profiles() end
end

-- Сохранить сеанс в user.ltx (если папки нет — в запасной плоский файл).
function save_profile()
    local text = serialize(session)
    local ok, why = write_file(profile_path("user"), text)
    local path = profile_path("user")
    if not ok then
        path = profile_path("flat")
        ok, why = write_file(path, text)
    end
    if ok then
        user_layer = copy_layer(session)
        dirty = false
    end
    return ok, why, path
end

-- Кнопка «Сбросить интерфейс» (Р3б): копия текущего user.ltx в user.bak.ltx, пустой профиль, сеанс пуст.
function reset_interface()
    ensure_loaded()
    local cur = read_file(profile_path("user")) or read_file(profile_path("flat"))
    if cur and cur ~= "" then write_file(profile_path("backup"), cur) end
    session, user_layer, undo_stack = {}, {}, {}
    local text = serialize({})
    local ok = write_file(profile_path("user"), text)
    if read_file(profile_path("flat")) then write_file(profile_path("flat"), text) end
    dirty = false
    bump()
    reapply_active()
    return ok
end

function get_layers() return base_layer, user_layer, session end

-- Секции профиля, которых нет в реестре (устаревшие ID, §8): для вкладки «Профиль».
function stale_sections()
    local out = {}
    for _, layer in ipairs({ base_layer, session }) do
        for sec in pairs(layer) do
            local id = sec:match("^([^@]+)")
            if not find_element(id) then out[#out + 1] = sec end
        end
    end
    table.sort(out)
    return out
end

-- ---------------------------------------------------------------------------------------------
-- Жизненный цикл
-- ---------------------------------------------------------------------------------------------
function reapply_active()
    local sid, gui = detect_active_screen()
    if sid then return apply_screen(sid, gui) end
    return 0
end

-- Применять профиль при каждом открытии экрана (Р4).
function on_gui_show(name)
    ensure_loaded()
    for _, sid in ipairs(screen_order) do
        local s = screens[sid]
        if s.gui_names and s.gui_names[tostring(name)] and s.detect then
            local ok, gui = pcall(s.detect)
            if ok and gui then apply_screen(sid, gui) end
        end
    end
end

-- ---------------------------------------------------------------------------------------------
-- Экран «Настройки» (этап Э1): родные окна UIOptions + страницы геймпада ui_gp_native.
-- ---------------------------------------------------------------------------------------------
local function options_detect()
    if gp_screens_ext and type(gp_screens_ext.detect_options_or_mcm_screen) == "function" then
        local ok, kind, dlg = pcall(gp_screens_ext.detect_options_or_mcm_screen)
        if ok and kind == "options" then return dlg end
        return nil
    end
    local g = ui_options and ui_options.GUI
    if shown(g) then return g end
    return nil
end

local function options_invalidate(gui)
    if ui_gp_native and type(ui_gp_native.relayout) == "function" then pcall(ui_gp_native.relayout) end
end

local function tr_str(id, fb)
    if game and type(game.translate_string) == "function" then
        local ok, s = pcall(game.translate_string, id)
        if ok and type(s) == "string" and s ~= "" and s ~= id then return s end
    end
    return fb
end

local OPTIONS_WINDOWS = {
    { "background", "ui_gp_uidbg_opt_bg",         "Backdrop",              { pos = true, size = true, color = true } },
    { "dialog",     "ui_gp_uidbg_opt_dialog",     "Full settings dialog",  { pos = true, size = true } },
    { "btn_accept", "ui_gp_uidbg_opt_accept",     "\"Apply\" button",      { pos = true, size = true } },
    { "btn_reset",  "ui_gp_uidbg_opt_reset",      "\"Reset\" button",      { pos = true, size = true } },
    { "btn_cancel", "ui_gp_uidbg_opt_cancel",     "\"Cancel\" button",     { pos = true, size = true } },
    { "pending",    "ui_gp_uidbg_opt_pending",    "Unsaved changes notice",{ pos = true, size = true, text_color = true } },
    { "scroll_opt", "ui_gp_uidbg_opt_scroll",     "Options list",          { pos = true, size = true } },
    { "preset_cap", "ui_gp_uidbg_opt_preset_cap", "\"Preset\" label",      { pos = true, size = true, color = true } },
    { "preset",     "ui_gp_uidbg_opt_preset",     "Preset box",            { pos = true, size = true } },
}

-- Страницы геймпада: элементы, которые ui_gp_native раскладывает через rect(..., id).
local GP_PAGES = {
    { "options.gpc.panel",      "ui_gp_uidbg_gpc_panel", "Gamepad: buttons page panel", nil },
    { "options.gpc.pad",        "ui_gp_uidbg_gpc_pad",   "Gamepad: controller image",   "options.gpc.panel" },
    { "options.gpc.help.card",  "ui_gp_uidbg_gpc_card",  "Gamepad: hint card",          "options.gpc.panel" },
    { "options.gpc.help.title", "ui_gp_uidbg_gpc_title", "Gamepad: hint title",         "options.gpc.panel" },
    { "options.gpc.help.long",  "ui_gp_uidbg_gpc_long",  "Gamepad: long hint",          "options.gpc.panel" },
    { "options.gpa.panel",      "ui_gp_uidbg_gpa_panel", "Gamepad: aiming panel",       nil },
    { "options.gpa.info.title", "ui_gp_uidbg_gpa_title", "Aiming: info header",         "options.gpa.panel" },
    { "options.gpa.info.line",  "ui_gp_uidbg_gpa_line",  "Aiming: limits line",         "options.gpa.panel" },
    { "options.gpa.help.long",  "ui_gp_uidbg_gpa_long",  "Aiming: long hint",           "options.gpa.panel" },
}

function register_builtin_screens()
    register_screen("options", { title = tr_str("ui_gp_uidbg_scr_options", "Settings"),
        title_id = "ui_gp_uidbg_scr_options", title_fb = "Settings",
        detect = options_detect, invalidate = options_invalidate, gui_names = { UIOptions = true } })
    for _, w in ipairs(OPTIONS_WINDOWS) do
        local field = w[1]
        register_element("options", { id = "options." .. field, title = tr_str(w[2], w[3]),
            title_id = w[2], title_fb = w[3], kind = "ui_window", unit = "ui_kx",
            caps = w[4], get = function(gui) return gui[field] end })
    end
    for _, p in ipairs(GP_PAGES) do
        register_element("options", { id = p[1], title = tr_str(p[2], p[3]),
            title_id = p[2], title_fb = p[3], kind = "tracked", unit = "ui_kx", owner = p[4],
            caps = { pos = true, size = true } })
    end
    for _, pfx in ipairs({ "gpc", "gpa" }) do
        for i = 1, 4 do
            local owner = "options." .. pfx .. ".panel"
            local page_id = (pfx == "gpc") and "ui_gp_uidbg_page_buttons" or "ui_gp_uidbg_page_aiming"
            local page_fb = (pfx == "gpc") and "buttons" or "aiming"
            local page = tr_str(page_id, page_fb)
            register_element("options", { id = "options." .. pfx .. ".foot.icon." .. i, kind = "tracked",
                title = string.format(tr_str("ui_gp_uidbg_foot_icon_fmt", "Bottom bar (%s): icons %d"), page, i),
                title_id = "ui_gp_uidbg_foot_icon_fmt", title_fb = "Bottom bar (%s): icons %d",
                title_page_id = page_id, title_page_fb = page_fb, title_idx = i,
                unit = "ui_kx", owner = owner })
            register_element("options", { id = "options." .. pfx .. ".foot.label." .. i, kind = "tracked",
                title = string.format(tr_str("ui_gp_uidbg_foot_label_fmt", "Bottom bar (%s): label %d"), page, i),
                title_id = "ui_gp_uidbg_foot_label_fmt", title_fb = "Bottom bar (%s): label %d",
                title_page_id = page_id, title_page_fb = page_fb, title_idx = i,
                unit = "ui_kx", owner = owner })
        end
    end
end

-- Для тестов: вернуть ядро в исходное состояние.
function reset_state()
    screens, screen_order, tracked, snap = {}, {}, {}, {}
    base_layer, user_layer, session, undo_stack = {}, {}, {}, {}
    dirty, native_view, loaded, generation, custom_paths = false, false, false, 0, nil
    register_builtin_screens()
end

function on_game_start()
    register_builtin_screens()
    ensure_loaded()
    RegisterScriptCallback("GUI_on_show", on_gui_show)
end

register_builtin_screens()
