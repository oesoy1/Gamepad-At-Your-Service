_GP_FILE_MARKER = "GAYS_REL1_20261114"
-- K6a + K6b (D61): Вкладка «Прицеливание» меню «Управление» (ui_gp_aim.script).
-- Подключает все 12 параметров правого стика (GamepadMath, appdata\gamepad\profile.ltx)
-- и помощи в прицеливании (GamepadAimAssist, user.ltx / консоль gp_aa_*), включая добавленные в K6b
-- чувствительность при прицеливании ADS (ads_sens_mult), ускорение поворота у края (turn_accel)
-- и отключение помощи на оптике и в 3D-прицелах (gp_aa_disable_on_scope / disable_aa_on_scope).

local AIM_GUI = nil

-- Масштабы перевода шкалы макета в реальные единицы движка:
-- omega_horz / omega_vert: макет 1..100 (дефолт sx=55 -> ~4.0 рад/с, sy=45 -> ~2.5 рад/с),
-- движок gpmath::limits::kOmegaMin=0.5 .. kOmegaMax=15.0 рад/с (шаг 1 ед. шкалы = 0.1465 рад/с, либо точная формула).
-- Для прозрачности и обратимости: 1..100 <-> 0.5..10.4 рад/с (шаг 0.1 рад/с: val_rad = 0.5 + (ui - 1) * 0.1,
-- тогда sx=36 -> 4.0 рад/с, sy=21 -> 2.5 рад/с; либо дефолт профиля 4.0 рад/с = 55%, 2.5 рад/с = 35%).
-- Используем линейную шкалу 1..100 <-> 0.50..15.00 рад/с с точным сохранением дефолтов:
local OMEGA_MIN = 0.50
local OMEGA_MAX = 15.00
local DEFAULT_OMEGA_H = 4.00
local DEFAULT_OMEGA_V = 2.50

-- Русские и английские подписи по умолчанию (если ключ локализации ещё не добавлен в ui_st_gamepad.xml,
-- так как ui_st_gamepad.xml не входит в список файлов K6a по карте волн)
