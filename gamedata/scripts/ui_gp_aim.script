	ui_gp_ctrl_title             = "CONTROLS",
	ui_gp_tab_world              = "World",
	ui_gp_tab_menu               = "Inventory & Menus",
	ui_gp_tab_aim                = "Aiming",
	ui_gp_btn_reset              = "[Y] Reset",
	ui_gp_btn_close              = "[B] Close",
	ui_gp_aim_grp_look           = "Right Stick Look",
	ui_gp_aim_grp_dz             = "Deadzones",
	ui_gp_aim_grp_aa             = "Aim Assist",
	ui_gp_aim_grp_curve          = "Response Curve",
	ui_gp_aim_grp_stick          = "Stick",
	ui_gp_aim_sx                 = "Horizontal Sensitivity",
	ui_gp_aim_sy                 = "Vertical Sensitivity",
	ui_gp_aim_ads                = "ADS Sensitivity Multiplier",
	ui_gp_aim_acc                = "Edge Acceleration",
	ui_gp_aim_curve              = "Response Curve",
	ui_gp_aim_inv                = "Invert Vertical Look",
	ui_gp_aim_dzi                = "Inner Deadzone (Anti-Drift)",
	ui_gp_aim_dzo                = "Outer Threshold (Full Tilt)",
	ui_gp_aim_assist             = "Assist Mode",
	ui_gp_aim_fric               = "Target Slowdown (Friction)",
	ui_gp_aim_mag                = "ADS Aim Pull",
	ui_gp_aim_scope              = "Disable in Scopes & 3D Optics",
	ui_gp_aim_curve_lin          = "Linear",
	ui_gp_aim_curve_exp          = "Smooth",
	ui_gp_aim_curve_s            = "S-Curve",
	ui_gp_aim_off                = "Off",
	ui_gp_aim_on                 = "On",
	ui_gp_aim_yes                = "Yes",
	ui_gp_aim_no                 = "No",
	ui_gp_aim_aa_off             = "Off",
	ui_gp_aim_aa_low             = "Low",
	ui_gp_aim_aa_mid             = "Medium",
	ui_gp_aim_aa_high            = "High",
	ui_gp_aim_cap_curve          = "Horizontal: stick tilt, vertical: turn speed. Shaded bands show deadzones.",
	ui_gp_aim_cap_stick          = "Inner circle: deadzone, outer circle: full tilt. Changes apply immediately.",
	ui_gp_aim_k6b_locked         = "unavailable",
	ui_gp_aim_info_curve         = "Horiz: %d%%  |  Vert: %d%%  |  Deadzone: %d%%-%d%%",
	ui_gp_aim_info_stick         = "Stick tilt: %d%%   ->   Camera response: %d%%",
	ui_gp_aim_footer_hint        = "Up/Down: Select Row  |  Left/Right: Adjust  |  LB/RB: Tab  |  Y: Reset  |  B: Close",
}

local function tr(id)
	if game and type(game.translate_string) == "function" then
		local ok, s = pcall(game.translate_string, id)
		if ok and type(s) == "string" and s ~= "" and s ~= id then
			return s
		end
	end
	return FALLBACK_EN[id] or id
end

local function clamp(v, lo, hi)
	v = tonumber(v) or lo
	if v < lo then return lo end
	if v > hi then return hi end
	return v
end

local function round_int(v)
	return math.floor((tonumber(v) or 0) + 0.5)
end

local function exec_cmd(cmd)
	if not cmd or cmd == "" then return false end
	if type(_G.get_console) == "function" then
		local ok_c, con = pcall(_G.get_console)
		if ok_c and con and type(con.execute) == "function" then
			local ok_e = pcall(con.execute, con, cmd)
			if ok_e then return true end
		end
	end
	if type(_G.exec_console_cmd) == "function" then
		local ok_x = pcall(_G.exec_console_cmd, cmd)
		if ok_x then return true end
	end
	return false
end

local function get_con_float(name, def)
	if type(_G.get_console) == "function" then
		local ok_c, con = pcall(_G.get_console)
		if ok_c and con and type(con.get_float) == "function" then
			local ok_f, v = pcall(con.get_float, con, name)
			if ok_f and type(v) == "number" then
				return v
			end
		end
	end
	return def
end

local function get_con_token(name, def)
	if type(_G.get_console) == "function" then
		local ok_c, con = pcall(_G.get_console)
		if ok_c and con then
			if type(con.get_token) == "function" then
				local ok_t, v = pcall(con.get_token, con, name)
				if ok_t and type(v) == "string" and v ~= "" then
					return v
				end
			end
			if type(con.get_string) == "function" then
				local ok_s, v = pcall(con.get_string, con, name)
				if ok_s and type(v) == "string" and v ~= "" then
					return v
				end
			end
		end
	end
	return def
end

-- Перевод угловой скорости omega (0.5..15.0 рад/с) <-> шкала UI (1..100)
function omega_to_ui(omega_rad)
	local w = clamp(tonumber(omega_rad) or DEFAULT_OMEGA_H, OMEGA_MIN, OMEGA_MAX)
	local t = (w - OMEGA_MIN) / (OMEGA_MAX - OMEGA_MIN)
	return clamp(round_int(1 + t * 99), 1, 100)
end

function ui_to_omega(ui_val)
	local u = clamp(tonumber(ui_val) or 50, 1, 100)
	local t = (u - 1) / 99.0
	return tonumber(string.format("%.4f", OMEGA_MIN + t * (OMEGA_MAX - OMEGA_MIN)))
end

-- Определение пути к appdata\gamepad\profile.ltx (решение D37)
function resolve_profile_ltx_path()
	if type(_G.getFS) == "function" then
		local ok_fs, fs = pcall(_G.getFS)
		if ok_fs and fs and type(fs.update_path) == "function" then
			local ok_p, p = pcall(fs.update_path, fs, "$app_data_root$", "gamepad\\profile.ltx")
			if ok_p and type(p) == "string" and p ~= "" then
				return p
			end
		end
	end
	return "appdata\\gamepad\\profile.ltx"
end

-- Чтение секции [right_stick] (и omega_horz/omega_vert/ads_sens_mult/turn_accel/disable_aa_on_scope из [profile] / [right_stick]) из текста profile.ltx
function parse_right_stick_from_ltx(ltx_text)
	local res = {
		deadzone            = 0.15,
		saturation          = 0.95,
		curve               = "linear",
		gamma               = 2.0,
		s_exponent          = 2.0,
		invert_x            = false,
		invert_y            = false,
		omega_horz          = DEFAULT_OMEGA_H,
		omega_vert          = DEFAULT_OMEGA_V,
		ads_sens_mult       = 0.70,
		turn_accel          = 0.30,
		disable_aa_on_scope = true,
	}
	if type(ltx_text) ~= "string" or ltx_text == "" then
		return res
	end
	local cur_sec = ""
	for raw_line in string.gmatch(ltx_text, "[^\r\n]+") do
		local line = string.gsub(raw_line, ";.*$", "")
		line = string.match(line, "^%s*(.-)%s*$") or ""
		if line ~= "" then
			local sec = string.match(line, "^%[([^%]]+)%]$")
			if sec then
				cur_sec = string.lower(string.match(sec, "^%s*(.-)%s*$") or "")
			elseif cur_sec == "right_stick" or cur_sec == "profile" then
				local k, v = string.match(line, "^([^=]+)=(.*)$")
				if k and v then
					k = string.lower(string.match(k, "^%s*(.-)%s*$") or "")
					v = string.lower(string.match(v, "^%s*(.-)%s*$") or "")
					if k == "omega_horz" then
						local n = tonumber(v)
						if n then res.omega_horz = clamp(n, OMEGA_MIN, OMEGA_MAX) end
					elseif k == "omega_vert" then
						local n = tonumber(v)
						if n then res.omega_vert = clamp(n, OMEGA_MIN, OMEGA_MAX) end
					elseif k == "ads_sens_mult" then
						local n = tonumber(v)
						if n then res.ads_sens_mult = clamp(n, 0.10, 1.50) end
					elseif k == "turn_accel" then
						local n = tonumber(v)
						if n then res.turn_accel = clamp(n, 0.00, 1.00) end
					elseif k == "disable_aa_on_scope" then
						res.disable_aa_on_scope = not (v == "0" or v == "false" or v == "off")
					elseif cur_sec == "right_stick" then
						if k == "deadzone" then
							local n = tonumber(v)
							if n then res.deadzone = clamp(n, 0.0, 0.30) end
						elseif k == "saturation" then
							local n = tonumber(v)
							if n then res.saturation = clamp(n, 0.70, 1.00) end
						elseif k == "curve" then
							if v == "power" or v == "1" then
								res.curve = "power"
							elseif v == "scurve" or v == "2" then
								res.curve = "scurve"
							elseif v == "twozone" or v == "3" then
								res.curve = "twozone"
							else
								res.curve = "linear"
							end
						elseif k == "gamma" then
							local n = tonumber(v)
							if n then res.gamma = clamp(n, 0.5, 4.0) end
						elseif k == "s_exponent" then
							local n = tonumber(v)
							if n then res.s_exponent = clamp(n, 0.5, 4.0) end
						elseif k == "invert_x" then
							res.invert_x = (v == "1" or v == "true" or v == "on")
						elseif k == "invert_y" then
							res.invert_y = (v == "1" or v == "true" or v == "on")
						end
					end
				end
			end
		end
	end
	if res.saturation < res.deadzone + 0.05 then
		res.saturation = clamp(res.deadzone + 0.05, 0.70, 1.00)
	end
	return res
end

