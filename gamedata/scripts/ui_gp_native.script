local function is_cyrillic_locale()
    if ui_options and type(ui_options.curr_localization) == "function" then
        local ok, loc = pcall(ui_options.curr_localization)
        if ok and type(loc) == "string" then
            return loc == "rus" or loc == "ukr"
        end
    end
    if type(_G.get_console) == "function" then
        local ok_c, con = pcall(_G.get_console)
        if ok_c and con and type(con.get_string) == "function" then
            local ok_s, lang = pcall(con.get_string, con, "g_language")
            if ok_s and type(lang) == "string" and lang ~= "" then
                return lang == "rus" or lang == "ukr"
            end
        end
    end
    return true
end

-- ---------------------------------------------------------------------------------------------
-- Small helpers
-- ---------------------------------------------------------------------------------------------
local function clr(a, r, g, b) return GetARGB(a, r, g, b) end
local function tr(key)
    if not key or key == "" then return "" end
    local res = game and game.translate_string and game.translate_string(key) or key
    if res == key then
        local fb = is_cyrillic_locale() and FALLBACK_RU[key] or FALLBACK_EN[key]
        if fb then return fb end
    end
    return res
end
-- id (UIDBG, docs/ui/debug-menu): optional stable name for the UI editor; gp_ui_tune adds the saved
-- offsets and remembers the window. Without an id (or without saved offsets) the numbers stay as passed.
local function rect(w, x, y, width, height, id)
    if not w then return end
    if id and gp_ui_tune and gp_ui_tune.tune_rect then
        x, y, width, height = gp_ui_tune.tune_rect(id, w, x, y, width, height)
    end
    w:SetWndPos(vector2():set(x, y))
    w:SetWndSize(vector2():set(width, height))
end
local function show(w, flag) if w then w:Show(flag and true or false) end end
local function use_native_menu_focus()
    return (game and game.is_gamepad_active_source and game.is_gamepad_active_source()) and true or false
end
local function icon_scale_k()
    if _G.gp_icons and type(_G.gp_icons.scale_k) == "function" then
        local ok, k = pcall(_G.gp_icons.scale_k)
        if ok and type(k) == "number" and k > 0 then return k end
    end
    return 1.0
end
local function menu_hints_visible()
    if _G.gp_icons and type(_G.gp_icons.hints_visible) == "function" then
        local ok, vis = pcall(_G.gp_icons.hints_visible, "menu")
        if ok then return vis ~= false end
    end
    return true
end
local function footer_hints_visible()
    if not menu_hints_visible() then return false end
    if _G.game and type(_G.game.is_gamepad_active_source) == "function" then
        return use_native_menu_focus()
    end
    return true
end
local function icons_revision()
    if _G.gp_icons and type(_G.gp_icons.revision) == "function" then
        local ok, r = pcall(_G.gp_icons.revision)
        if ok and type(r) == "number" then return r end
    end
    return 0
end
local function menu_pulse(tag)
    if _G.game and type(_G.game.gamepad_menu_pulse) == "function" then
        pcall(_G.game.gamepad_menu_pulse, tag or "menu_hold")
    end
end
local function xmlh()
    if not X then
        X = CScriptXmlInit()
        X:ParseFile("ui_gp_native.xml")
    end
    return X
end
-- Width (UI x units) of a shape that must look as wide as one UI y unit is tall on the current screen.
local function kx()
    local aspect = 16 / 9
    if device then
        local ok, d = pcall(device)
        if ok and d and tonumber(d.width) and tonumber(d.height) and d.height > 0 then
            aspect = d.width / d.height
        end
    end
    return (4 / 3) / aspect
end
local function txt(parent, tpl, x, y, width, height, color)
    local t = xmlh():InitTextWnd(tpl, parent)
    rect(t, x, y, width, height)
    if color then t:SetTextColor(color) end
    return t
end
local function fill(parent, x, y, width, height, color)
    local s = CUIStatic()
    s:SetAutoDelete(true)
    rect(s, x, y, width, height)
    s:InitTexture("ui_gp_solid_white")
    s:SetStretchTexture(true)
    s:SetTextureColor(color)
    parent:AttachChild(s)
    return s
end
local function icon(parent, x, y, width, height, tex)
    local s = CUIStatic()
    s:SetAutoDelete(true)
    rect(s, x, y, width, height)
    s._gp_tex = tex
    s:InitTexture(tex)
    s:SetStretchTexture(true)
    parent:AttachChild(s)
    return s
end
local function set_tex(s, tex)
    if s and s._gp_tex ~= tex then
        s._gp_tex = tex
        s:InitTexture(tex)
        s:SetStretchTexture(true)
    end
end
-- Icon of a pad button (B8): exclusively via gp_icons.tex / gp_icons.dims when loaded; neutral white Dot Marks fallback otherwise.
local function button_icon(family, glyph_prefix, slot_id)
    if _G.gp_icons and type(_G.gp_icons.tex) == "function" then
        local asp = 1
        if type(_G.gp_icons.dims) == "function" then
            local _, _, tw, th = _G.gp_icons.dims(slot_id, "round")
            if tw and th and th > 0 then asp = tw / th end
        end
        return _G.gp_icons.tex(slot_id, "round"), asp
    end
    local tag = (family == "playstation") and "ps"
        or (family == "nintendo" and "nintendo" or (family == "generic" and "generic" or "xbox"))
    return "ui_gp_white_" .. tag .. "_" .. (GLYPH_SUFFIX[slot_id] or "south"), 1
end
local function align_icon_and_label(base_h, cy, tex, asp, label_h, font_name, k)
    local align = _G.gp_hint_align
    if align and type(align.px_w) == "function" and type(align.px_h) == "function" and type(align.label_y) == "function" then
        local h_sc = base_h * ((type(align.icon_scale) == "function") and align.icon_scale(tex) or 1)
        local sh = 1080
        if type(align.screen) == "function" then
            local _, s_h = align.screen()
            if tonumber(s_h) and tonumber(s_h) > 0 then sh = tonumber(s_h) end
        end
        local ratio = asp or 1
        local px_h = math.max(8, math.floor(h_sc * sh / 768 + 0.5))
        local px_w = (ratio == 1) and px_h or math.max(8, math.floor(px_h * ratio + 0.5))
        local iw, ih = align.px_w(px_w), align.px_h(px_h)
        local iy = (type(align.snap_y) == "function") and align.snap_y(cy - ih * 0.5) or (cy - ih * 0.5)
        local ly = align.label_y(iy + ih * 0.5, label_h, font_name or "letterica16")
        return iw, ih, iy, ly
    end
    local ih = base_h
    local iw = base_h * (k or kx()) * (asp or 1)
    return iw, ih, cy - ih * 0.5, cy - label_h * 0.5
end
local function copy_state(src)
    local dst = {}
    for k, v in pairs(src or {}) do dst[k] = v end
    return dst
end

-- Bottom hint bar: one dark strip, "icon + word" items aligned on cap-height line (B8) + white X-hold bar (B4).
local function build_footer(w, n, items)
    n.foot_bg = fill(w, 0, 578, PANEL_W, 26, clr(170, 12, 12, 12))
    n.foot_ln = fill(w, 0, 578, PANEL_W, 1, clr(120, 150, 150, 150))
    n.foot = {}
    local slot_w = PANEL_W / #items
    local init_tex = button_icon("xbox", nil, "A")
    n.x_slot_idx = nil
    for i, it in ipairs(items) do
        local f = { item = it, icons = {}, x = (i - 1) * slot_w + 8, slot_w = slot_w }
        for j, btn_id in ipairs(it.buttons) do
            local btex = button_icon("xbox", nil, btn_id)
            f.icons[j] = icon(w, f.x, 583, 12, 16, btex or init_tex)
            if btn_id == "X" then n.x_slot_idx = i end
        end
        f.label = txt(w, "t16", f.x, 582, slot_w - 14, 18, clr(255, 200, 200, 200))
        f.label:SetText(tr(it.label))
        n.foot[i] = f
    end
    n.hold_track = fill(w, 10, 600, 72, 3, clr(110, 70, 70, 75))
    n.hold_fill  = fill(w, 10, 600, 2,  3, clr(245, 245, 245, 250))
    show(n.hold_track, false)
    show(n.hold_fill, false)
end
local function sync_footer_hold_bar(n)
    if not (n and n.hold_track and n.hold_fill) then return end
    local vis = footer_hints_visible() and x_hold.active and x_hold.progress > 0
    if vis then
        local f = n.foot[n.x_slot_idx or 2] or n.foot[1]
        local bx = f and f.x or 10
        local bw = math.max(32, math.min(96, (f and f.slot_w or 100) - 16))
        if bx + bw > PANEL_W - 4 then bw = math.max(16, PANEL_W - 4 - bx) end
        local fw = math.max(2, math.floor(bw * math.min(1, x_hold.progress) + 0.5))
        rect(n.hold_track, bx, 600, bw, 3)
        rect(n.hold_fill,  bx, 600, fw, 3)
        show(n.hold_track, true)
        show(n.hold_fill, true)
    else
        show(n.hold_track, false)
        show(n.hold_fill, false)
    end
end
local function layout_footer(n, family, glyph_prefix, pfx)
    local k = kx()
    local vis = footer_hints_visible()
    n.hints_vis = vis
    local base_h = math.min(20, 16 * math.min(1.25, icon_scale_k()))
    local cy = 591
    show(n.foot_bg, vis)
    show(n.foot_ln, vis)
    for i, f in ipairs(n.foot) do
        local icon_id = pfx and (pfx .. ".foot.icon." .. i) or nil
        local x = f.x
        local line_ly = 582
        for j, id in ipairs(f.item.buttons) do
            local tex, asp = button_icon(family, glyph_prefix, id)
            local iw, ih, iy, ly = align_icon_and_label(base_h, cy, tex, asp, 18, "letterica16", k)
            if iy < 579 then iy = 579 end
            if iy + ih > 603 then ih = math.max(10, 603 - iy) end
            line_ly = math.max(579, math.min(587, ly))
            set_tex(f.icons[j], tex)
            rect(f.icons[j], x, iy, iw, ih, icon_id)
            show(f.icons[j], vis)
            x = x + iw + 2
        end
        local max_lbl_w = math.max(24, math.min(f.slot_w - (x - f.x) - 4, PANEL_W - (x + 3) - 2))
        rect(f.label, x + 3, line_ly, max_lbl_w, 18, pfx and (pfx .. ".foot.label." .. i) or nil)
        show(f.label, vis)
    end
    sync_footer_hold_bar(n)
end
local function cancel_options()
    if owner and owner.OnButton_Cancel then owner:OnButton_Cancel() end
    return true
end
local function accept_options()
    if owner and owner.OnButton_Accept then owner:OnButton_Accept() end
    return true
end
local function update_pending()
    if owner and owner.UpdatePending then owner:UpdatePending() end
end

-- ---------------------------------------------------------------------------------------------
-- Pages "In the world" / "Inventory and menus": table Button | Press | Hold + one controller
-- ---------------------------------------------------------------------------------------------
-- Display model: group titles and slot rows in table order; four identical d-pad rows of the menu
-- context are folded into one. Returns rows, navigation order (slot indexes) and the folded flag.
function build_row_model(vm)
    local ctx = (vm.context == "menu") and "menu" or "world"
    local merged = false
    if ctx == "menu" then
        merged = true
        for _, id in ipairs({ "DU", "DL", "DR", "DD" }) do
            local s = vm.slot_by_id and vm.slot_by_id[id]
            if not s or s.tap_action_id ~= "NavigateCells" or s.hold_action_id then merged = false end
        end
    end
    local allowed = {}
    for _, g in ipairs(GROUPS[ctx]) do allowed[g] = true end
    local by = {}
    for i, s in ipairs(vm.slots or {}) do
        if not (merged and (s.id == "DL" or s.id == "DR" or s.id == "DD")) then
            local g = ACT_GROUP[s.tap_action_id or ""] or ACT_GROUP[s.hold_action_id or ""] or "common"
            if not allowed[g] then g = "common" end
            by[g] = by[g] or {}
            table.insert(by[g], { idx = i, sd = s, merged = (merged and s.id == "DU") })
        end
    end
    local rows, nav = {}, {}
    for _, g in ipairs(GROUPS[ctx]) do
        if by[g] then
            rows[#rows + 1] = { group = g }
            for _, r in ipairs(by[g]) do
                rows[#rows + 1] = r
                nav[#nav + 1] = r.idx
            end
        end
    end
    return rows, nav, merged
end
-- Slot index of the selected table row (a folded d-pad row is represented by D-pad Up).
local function selected_row_idx(w, merged)
    local idx = w.selected_slot_idx or 1
    local sd = w.view_model and w.view_model.slots and w.view_model.slots[idx]
    if merged and sd and (sd.id == "DL" or sd.id == "DR" or sd.id == "DD") then
        local du = w.view_model.slot_by_id and w.view_model.slot_by_id.DU
        for i, s in ipairs(w.view_model.slots) do
            if s == du then return i end
        end
    end
    return idx
end

local function build_controls(w)
    if w._n then return w._n end
    local x = xmlh()
    local n = { rows = {}, groups = {}, help = {}, model = {}, nav = {}, help_open = true } -- FIX-LIVE2 6a: help always on
    show(w.back, false)
    w:SetWindowName("gp_native_controls")
    n.cap = x:InitFrameLine("cap", w)
    n.cap_t = txt(w, "t16", 8, 0, 420, 15)
    x:InitFrameLine("hdr_1", w)
    x:InitFrameLine("hdr_2", w)
    x:InitFrameLine("hdr_3", w)
    txt(w, "t_hdr", 4, 20, 86, 15):SetText(tr("ui_gp_n_col_btn"))
    txt(w, "t_hdr", 96, 20, 122, 15):SetText(tr("ui_gp_n_col_tap"))
    txt(w, "t_hdr", 224, 20, 114, 15):SetText(tr("ui_gp_n_col_hold"))
    n.frame = x:InitFrame("frame", w)
    for i = 1, MAX_GROUPS do
        n.groups[i] = txt(w, "t_group", 3, 0, 330, 20)
    end
    for i = 1, MAX_ROWS do
        local r = {}
        r.cell = fill(w, 0, 0, 10, ROW_H, clr(55, 255, 255, 255))
        r.mark = fill(w, 2, 0, 2, ROW_H, clr(255, 255, 255, 255))
        r.icon = icon(w, 7, 0, 12, 16, button_icon("xbox", nil, "A"))
        r.name = txt(w, "t16", 32, 0, 58, ROW_H)
        r.name:SetWindowName("gp_native_row_" .. i)
        r.tap  = txt(w, "t16", 96, 0, 122, ROW_H)
        r.hold = txt(w, "t16", 224, 0, 114, ROW_H)
        r.btn  = x:Init3tButton("row_btn", w)
        local name = "gp_n_row_" .. i
        w:Register(r.btn, name)
        w:AddCallback(name, ui_events.BUTTON_CLICKED, function()
            local rec = n.rowrec and n.rowrec[i]
            if rec then w:OnSlotClicked(rec.idx) end
        end, w)
        n.rows[i] = r
    end
    n.pad = icon(w, SIDE_X, 20, SIDE_W, SIDE_W, "ui_gp_native_pad_LT")
    n.pad_disc = icon(w, SIDE_X, 20, 14, 14, "ui_gp_circle_disc")
    n.pad_ring = icon(w, SIDE_X, 20, 22, 22, "ui_gp_circle_ring")
    n.pad_disc:SetTextureColor(clr(195, 232, 232, 238))
    n.pad_ring:SetTextureColor(clr(245, 245, 245, 250))
    show(n.pad_disc, false)
    show(n.pad_ring, false)
    n.card = x:InitFrame("frame", w)
    n.help_title = txt(w, "t18", 0, 0, 100, 20)
    for i = 1, MAX_HELP do
        n.help[i] = txt(w, "t16", 0, 0, 100, 18, clr(255, 200, 200, 200))
    end
    n.help_long = txt(w, "t16w", 0, 0, 100, 60)
    n.status = txt(w, "t_status", 2, 554, PANEL_W - 4, 18)
    build_footer(w, n, {
        { buttons = { "A" },        label = "ui_gp_n_f_change" },
        { buttons = { "X" },        label = "ui_gp_n_f_hold" },
        { buttons = { "LB", "RB" }, label = "ui_gp_n_f_tab" },
        { buttons = { "B" },        label = "ui_gp_n_f_close" },
    })
    w._n = n
    return n
end

function layout_controls(w)
    if not w._native_owner or not w.view_model then return end
    local n = build_controls(w)
    n.menu_pad_focus = use_native_menu_focus()
    n.icon_rev = icons_revision()
    local vm = w.view_model
    local family = w.pad_family or vm.pad_family or "xbox"
    local glyph_prefix = vm.pad_spec and vm.pad_spec.glyph_prefix or nil
    local k = kx()
    rect(w, 0, 0, PANEL_W, PANEL_H, "options.gpc.panel")
    n.cap_t:SetText(tr("ui_gp_n_cap") .. "  -  " .. tr("ui_gp_n_tab_" .. (vm.context == "menu" and "menu" or "world")))

    local rows, nav, merged = build_row_model(vm)
    n.model, n.nav, n.merged = rows, nav, merged
    n.rowrec = {}
    local sel_idx = selected_row_idx(w, merged)
    local capturing = (w.remap_state == "capturing")
    local sub = capturing and (w.capture_sub_kind or "tap") or (w.selected_sub_kind or "tap")
    local blink = (math.floor((time_global and time_global() or 0) / 200) % 2) == 0
    local c_norm, c_sel, c_dim = clr(255, 170, 170, 170), clr(255, 240, 240, 240), clr(255, 120, 120, 120)
    local c_warn = clr(255, 250, 150, 75)

    local y, gi, ri = 38, 0, 0
    local sel_sd = nil
    for _, rec in ipairs(rows) do
        if rec.group then
            gi = gi + 1
            local g = n.groups[gi]
            if g then
                rect(g, 3, y + 3, 330, 20)
                g:SetText(tr("ui_gp_n_grp_" .. rec.group))
                show(g, true)
            end
            y = y + GROUP_STEP
        else
            ri = ri + 1
            local r = n.rows[ri]
            if r then
                local sd = rec.sd
                local is_sel = (rec.idx == sel_idx)
                n.rowrec[ri] = rec
                if is_sel then sel_sd = sd end
                local tex, asp = button_icon(family, glyph_prefix, sd.id)
                set_tex(r.icon, tex)
                local r_bh = math.min(18, 15 * math.min(1.2, icon_scale_k()))
                local iw, ih, iy, ly = align_icon_and_label(r_bh, y + ROW_H * 0.5, tex, asp, ROW_H, "letterica16", k)
                if iw > 23 then iw = 23 end
                rect(r.icon, 7, math.max(0, iy), iw, ih)
                rect(r.name, 32, math.max(0, ly), 58, ROW_H)
                rect(r.tap, 96, y, 122, ROW_H)
                rect(r.hold, 224, y, 114, ROW_H)
                rect(r.btn, 0, y, TABLE_W, ROW_H)
                rect(r.mark, 2, y, 2, ROW_H)
                if sub == "hold" and not sd.locked then
                    rect(r.cell, 221, y, 117, ROW_H)
                else
                    rect(r.cell, 93, y, 126, ROW_H)
                end
                local name = rec.merged and tr("ui_gp_n_dpad")
                    or ((family == "xbox") and (SHORT[sd.id] or sd.id) or sd.button_title)
                r.name:SetText(name)
                local tap_text = sd.tap_text or ""
                local hold_text = (sd.hold_text and sd.hold_text ~= "") and sd.hold_text or tr("ui_gp_n_none")
                if sd.locked then hold_text = tr("ui_gp_n_fixed") end
                local c_tap, c_hold = is_sel and c_sel or c_norm, is_sel and c_sel or c_norm
                if sd.locked then c_hold = c_dim end
                if capturing and w.capture_slot_id == sd.id then
                    if sub == "hold" then
                        hold_text, c_hold = tr("ui_gp_ctrl_capture_slot"), c_warn
                    else
                        tap_text, c_tap = tr("ui_gp_ctrl_capture_slot"), c_warn
                    end
                elseif w.IsSlotFlashing and w:IsSlotFlashing(sd.id) then
                    c_tap = blink and c_sel or c_norm
                    c_hold = c_tap
                end
                r.tap:SetText(tap_text)
                r.hold:SetText(hold_text)
                r.name:SetTextColor(is_sel and c_sel or c_norm)
                r.tap:SetTextColor(c_tap)
                r.hold:SetTextColor(c_hold)
                show(r.mark, is_sel and not n.menu_pad_focus)
                show(r.cell, is_sel)
                for _, key in ipairs({ "icon", "name", "tap", "hold", "btn" }) do show(r[key], true) end
            end
            y = y + ROW_STEP
        end
    end
    for i = gi + 1, MAX_GROUPS do show(n.groups[i], false) end
    for i = ri + 1, MAX_ROWS do
        local r = n.rows[i]
        for _, key in ipairs({ "icon", "name", "tap", "hold", "btn", "mark", "cell" }) do show(r[key], false) end
    end

    -- One controller on the right; the selected button is lit grey/white (ui_gp_native_pad_* states).
    sel_sd = sel_sd or w:GetSelectedSlot()
    local pw = SIDE_W
    local ph = pw * 0.75 / k
    if ph > 300 then
        ph = 300
        pw = ph * k / 0.75
    end
    local pad_x = SIDE_X + (SIDE_W - pw) / 2
    rect(n.pad, pad_x, 20, pw, ph, "options.gpc.pad")
    if sel_sd and family == "xbox" then
        set_tex(n.pad, "ui_gp_native_pad_" .. sel_sd.id)
        show(n.pad_disc, false)
        show(n.pad_ring, false)
    else
        local base_tex = (family == "playstation") and "ui_gp_pad_ps"
            or ((family == "generic") and "ui_gp_pad_generic"
            or ((vm.pad_spec and vm.pad_spec.texture) or "ui_gp_pad_xbox"))
        set_tex(n.pad, base_tex)
        local anchors = (family == "playstation") and PAD_ANCHORS_PS or PAD_ANCHORS_XBOX
        local aid = (sel_sd and merged and sel_sd.id == "DU") and "DPad" or (sel_sd and sel_sd.id or nil)
        local anc = aid and anchors[aid] or nil
        if anc then
            local ppos = n.pad:GetWndPos()
            local cx = ppos.x + (anc[1] / PAD_BASE_W) * n.pad:GetWidth()
            local cy_m = ppos.y + (anc[2] / PAD_BASE_H) * n.pad:GetHeight()
            local rw, rh = 22 * k, 22
            local dw, dh = 14 * k, 14
            rect(n.pad_ring, math.max(0, math.min(PANEL_W - rw, cx - rw * 0.5)), math.max(0, cy_m - rh * 0.5), rw, rh)
            rect(n.pad_disc, math.max(0, math.min(PANEL_W - dw, cx - dw * 0.5)), math.max(0, cy_m - dh * 0.5), dw, dh)
            show(n.pad_ring, true)
            show(n.pad_disc, true)
        else
            show(n.pad_ring, false)
            show(n.pad_disc, false)
        end
    end

    -- Help card under the controller: name, press / hold, chords; Y opens the long text.
    local cy = 20 + ph + 6
    local lines = {}
    local long_text = ""
    if sel_sd then
        local folded = merged and sel_sd.id == "DU"
        n.help_title:SetText(folded and tr("ui_gp_n_dpad") or sel_sd.button_title)
        lines[#lines + 1] = tr("ui_gp_n_tap") .. ": " .. (sel_sd.tap_text or "")
        if sel_sd.locked then
            long_text = tr("ui_gp_n_locked_why")
        else
            lines[#lines + 1] = tr("ui_gp_n_hold") .. ": "
                .. ((sel_sd.hold_text and sel_sd.hold_text ~= "") and sel_sd.hold_text or tr("ui_gp_n_none"))
            if n.help_open then long_text = tr("ui_gp_n_help_slot") end
        end
        for _, c in ipairs(vm.chords or {}) do
            if c.modifier == sel_sd.id or c.button == sel_sd.id or (folded and c.button == "DPad") then
                lines[#lines + 1] = c.chip_text
            end
        end
    else
        n.help_title:SetText("")
    end
    rect(n.help_title, SIDE_X + 6, cy + 6, SIDE_W - 12, 20, "options.gpc.help.title")
    local ly = cy + 30
    for i = 1, MAX_HELP do
        local h = n.help[i]
        if lines[i] then
            rect(h, SIDE_X + 6, ly, SIDE_W - 12, 18)
            h:SetText(lines[i])
            show(h, true)
            ly = ly + 18
        else
            show(h, false)
        end
    end
    local long_h = (long_text ~= "") and math.min(84, math.max(18, 540 - ly - 6)) or 0
    rect(n.help_long, SIDE_X + 6, ly + 6, SIDE_W - 12, math.max(18, long_h), "options.gpc.help.long")
    n.help_long:SetText(long_text)
    show(n.help_long, long_text ~= "")
    -- The card is as tall as its text, so no empty frame hangs under the controller.
    rect(n.card, SIDE_X - 2, cy, SIDE_W + 2, math.min(550 - cy, (ly - cy) + 8 + ((long_h > 0) and (long_h + 6) or 0)), "options.gpc.help.card")

    if capturing then
        n.status:SetText(tr("ui_gp_ctrl_capture_prompt"))
    elseif w.remap_state == "confirm_reset" then
        n.status:SetText(tr("ui_gp_ctrl_reset_confirm"))
    elseif type(w.status_message) == "string" and w.status_message ~= "" then
        n.status:SetText(w.status_message)
    else
        n.status:SetText("")
    end
    layout_footer(n, family, glyph_prefix, "options.gpc")
end

-- Selection instead of a cursor: up/down walks the table rows, left/right picks Press / Hold.
function navigate_controls(w, dir)
    if w.remap_state ~= "browse" then return false end
    local n = w._n
    if not n or #n.nav == 0 then return false end
    local sub = w.selected_sub_kind or "tap"
    if dir == "left" or dir == "right" then
        local sd = w:GetSelectedSlot()
        w.selected_sub_kind = (dir == "right" and not (sd and sd.locked)) and "hold" or "tap"
        w:RefreshView()
        return true
    end
    if dir ~= "up" and dir ~= "down" then return false end
    local cur = selected_row_idx(w, n.merged)
    local pos = 1
    for i, idx in ipairs(n.nav) do
        if idx == cur then pos = i break end
    end
    pos = pos + ((dir == "up") and -1 or 1)
    if pos < 1 then pos = #n.nav end
    if pos > #n.nav then pos = 1 end
    w:SelectSlotByIndex(n.nav[pos])
    local sd = w:GetSelectedSlot()
    w.selected_sub_kind = (sub == "hold" and not (sd and sd.locked)) and "hold" or "tap"
    w:RefreshView()
    return true
end

-- ---------------------------------------------------------------------------------------------
-- Page "Aiming": stock sliders / lists / radio buttons + response curve graph
-- ---------------------------------------------------------------------------------------------
function aim_dirty_count()
    if not (aim and aim_applied and aim.state) then return 0 end
    local c = 0
    for k, v in pairs(aim.state) do
        if aim_applied[k] ~= v then c = c + 1 end
    end
    return c
end
local function aim_row_index(w, id)
    for i, row in ipairs(w.rows or {}) do
        if row.spec.id == id then return i end
    end
    return nil
end
-- Change a value without touching the engine: it is applied by the stock "Apply" button (BRIEF 5.3).
function aim_set(w, id, val)
    local st = w.state
    if id == "dzi" and tonumber(val) and val > (st.dzo - 5) then val = st.dzo - 5 end
    if id == "dzo" and tonumber(val) and val < (st.dzi + 5) then val = st.dzi + 5 end
    st[id] = val
    local idx = aim_row_index(w, id)
    if idx then w.selected_idx = idx end
    w:RefreshUI()
    update_pending()
    return true
end
function aim_step(w, dir)
    local row = w.rows[w.selected_idx or 1]
    if not row then return false end
    local real = ui_gp_aim.apply_param_to_engine
    ui_gp_aim.apply_param_to_engine = function() return true end
    local ok = ui_gp_aim.adjust_param(w.state, row.spec.id, dir)
    ui_gp_aim.apply_param_to_engine = real
    w:RefreshUI()
    update_pending()
    return ok
end
function aim_move(w, delta)
    local n = w._n
    if not n or #n.order == 0 then return false end
    local pos = 1
    for i, idx in ipairs(n.order) do
        if idx == w.selected_idx then pos = i break end
    end
    pos = ((pos - 1 + delta) % #n.order) + 1
    w.selected_idx = n.order[pos]
    w:RefreshUI()
    return true
end
function aim_reset_defaults(w)
    w.state = ui_gp_aim.get_default_aim_state()
    w:RefreshUI()
    update_pending()
    return true
end
local function bool_options(spec)
    -- Radio order is always "Off, On" whatever the order in the spec is.
    local off, on = nil, nil
    for _, o in ipairs(spec.options or {}) do
        if o.val == false then off = o elseif o.val == true then on = o end
    end
    if off and on and #spec.options == 2 then return { off, on } end
    return nil
end

local function build_aim(w)
    if w._n then return w._n end
    local x = xmlh()
    local n = { rows = {}, groups = {}, order = {}, points = {}, dashes = {}, help_open = true } -- FIX-LIVE2 6a
    show(w.back, false)
    w:SetWindowName("gp_native_aim")
    n.cap = x:InitFrameLine("cap", w)
    n.cap_t = txt(w, "t16", 8, 0, 420, 15)
    x:InitFrameLine("hdr_a1", w)
    x:InitFrameLine("hdr_a2", w)
    txt(w, "t_hdr", 4, 20, 150, 15):SetText(tr("ui_gp_n_col_param"))
    txt(w, "t_hdr", 168, 20, 160, 15):SetText(tr("ui_gp_n_col_value"))
    n.frame = x:InitFrame("frame", w)

    local y = 38
    for _, grp in ipairs(AIM_GROUPS) do
        local members = {}
        for _, id in ipairs(grp.params) do
            local idx = aim_row_index(w, id)
            if idx and w.rows[idx].spec.supported ~= false then members[#members + 1] = idx end
        end
        if #members > 0 then
            local g = txt(w, "t_group", 3, y + 3, 330, 20)
            g:SetText(tr("ui_gp_n_grp_aim_" .. grp.id))
            n.groups[#n.groups + 1] = g
            y = y + GROUP_STEP
            for _, idx in ipairs(members) do
                local spec = w.rows[idx].spec
                local r = { idx = idx, spec = spec, y = y }
                r.mark = fill(w, 2, y, 2, 22, clr(255, 255, 255, 255))
                r.cap = txt(w, "t16", 8, y, 156, 22)
                r.cap:SetWindowName("gp_native_row_" .. idx)
                r.cap:SetText(tr("ui_gp_n_aim_" .. spec.id))
                if spec.kind == "slider" then
                    r.track = x:InitTrackBar("track", w)
                    rect(r.track, 166, y + 3, 132, 16)
                    r.track:SetStep(spec.step)
                    r.track:SetOptFBounds(spec.min, spec.max)
                    r.value = txt(w, "t16c", 298, y, 40, 22)
                    r.knob = fill(w, 166, y + 20, 8, 2, clr(255, 255, 255, 255))
                else
                    local radio = bool_options(spec)
                    if radio then
                        r.radio = {}
                        for j, o in ipairs(radio) do
                            local e = { opt = o }
                            e.btn = x:InitCheck("radio_btn", w)
                            rect(e.btn, 166 + (j - 1) * 84, y, 26, 22)
                            e.lbl = txt(w, "t16", 194 + (j - 1) * 84, y, 54, 22, clr(255, 200, 200, 200))
                            e.lbl:SetText(tr(o.label_id))
                            local name = "gp_n_radio_" .. spec.id .. "_" .. j
                            w:Register(e.btn, name)
                            w:AddCallback(name, ui_events.BUTTON_CLICKED, function()
                                aim_set(w, spec.id, o.val)
                            end, w)
                            r.radio[j] = e
                        end
                    else
                        r.list = x:InitComboBox("list", w)
                        rect(r.list, 166, y, 170, 22)
                        for j, o in ipairs(spec.options or {}) do
                            r.list:AddItem(tr(o.label_id), j)
                        end
                        local name = "gp_n_list_" .. spec.id
                        w:Register(r.list, name)
                        w:AddCallback(name, ui_events.LIST_ITEM_SELECT, function()
                            local o = spec.options[r.list:CurrentID()]
                            if o then aim_set(w, spec.id, o.val) end
                        end, w)
                    end
                end
                n.rows[#n.rows + 1] = r
                n.order[#n.order + 1] = idx
                y = y + 26
            end
        end
    end

    -- Response curve graph: axes 0..100%, dashed linear reference, dead zones, live input point.
    n.g_title = txt(w, "t18", SIDE_X, 20, SIDE_W, 20)
    n.g_title:SetText(tr("ui_gp_n_graph_title"))
    n.g_bg    = fill(w, 0, 0, 10, 10, clr(140, 0, 0, 0))
    n.g_dz_l  = fill(w, 0, 0, 10, 10, clr(45, 255, 255, 255))
    n.g_dz_r  = fill(w, 0, 0, 10, 10, clr(45, 255, 255, 255))
    n.g_axis_x = fill(w, 0, 0, 10, 1, clr(255, 170, 170, 170))
    n.g_axis_y = fill(w, 0, 0, 1, 10, clr(255, 170, 170, 170))
    for i = 1, 16 do n.dashes[i] = fill(w, 0, 0, 2, 2, clr(255, 110, 110, 110)) end
    for i = 1, 61 do n.points[i] = fill(w, 0, 0, 2, 2, clr(255, 235, 235, 235)) end
    n.g_live = fill(w, 0, 0, 5, 5, clr(255, 255, 255, 255))
    n.g_y100 = txt(w, "t_hdr", 0, 0, 40, 14)
    n.g_y100:SetText("100%")
    n.g_x0   = txt(w, "t_hdr", 0, 0, 40, 14)
    n.g_x0:SetText("0%")
    n.g_x100 = txt(w, "t_hdr", 0, 0, 40, 14)
    n.g_x100:SetText("100%")
    n.g_xcap = txt(w, "t16", 0, 0, 100, 18)
    n.g_xcap:SetText(tr("ui_gp_n_graph_x"))
    n.g_ycap = txt(w, "t16", 0, 0, 100, 18)
    n.g_ycap:SetText(tr("ui_gp_n_graph_y"))
    n.info_title = txt(w, "t18", 0, 0, 100, 20)
    n.info_line  = txt(w, "t16", 0, 0, 100, 18, clr(255, 200, 200, 200))
    n.help_long  = txt(w, "t16w", 0, 0, 100, 60)
    n.status = txt(w, "t_status", 2, 554, PANEL_W - 4, 18)
    build_footer(w, n, {
        { buttons = { "DL", "DR" }, label = "ui_gp_n_f_change" },
        { buttons = { "LB", "RB" }, label = "ui_gp_n_f_tab" },
        { buttons = { "B" },        label = "ui_gp_n_f_close" },
    })
    w._n = n
    return n
end

local function graph_geometry()
    local k = kx()
    local gw = 196
    local gh = gw / k
    if gh > 250 then
        gh = 250
        gw = gh * k
    end
    return SIDE_X + 24, 62, gw, gh, k
end
local function layout_live_dot(w)
    local n = w._n
    if not n then return end
    local gx, gy, gw, gh, k = graph_geometry()
    local rx, ry = tonumber(w.live_rx) or 0, tonumber(w.live_ry) or 0
    local t = math.min(1, math.sqrt(rx * rx + ry * ry))
    local v = ui_gp_aim.eval_response_curve(w.state, t)
    rect(n.g_live, gx + t * gw - 3 * k, gy + gh - v * gh - 3, 6 * k, 6)
end

function layout_aim(w)
    if not w._native_owner then return end
    local n = build_aim(w)
    n.menu_pad_focus = use_native_menu_focus()
    n.icon_rev = icons_revision()
    local st = w.state or {}
    rect(w, 0, 0, PANEL_W, PANEL_H, "options.gpa.panel")
    n.cap_t:SetText(tr("ui_gp_n_cap") .. "  -  " .. tr("ui_gp_n_tab_aim"))
    local c_norm, c_sel = clr(255, 170, 170, 170), clr(255, 240, 240, 240)
    local sel_row = nil
    for _, r in ipairs(n.rows) do
        local spec = r.spec
        local is_sel = (r.idx == w.selected_idx)
        if is_sel then sel_row = r end
        show(r.mark, is_sel and not n.menu_pad_focus)
        r.cap:SetTextColor(is_sel and c_sel or c_norm)
        local v = st[spec.id]
        if r.track then
            local num = tonumber(v) or spec.min
            if not (r.track.IsCursorOverWindow and r.track:IsCursorOverWindow()) then
                r.track:SetFValue(num)
            end
            r.value:SetText(tostring(num) .. tostring(spec.unit or ""))
            local ratio = (num - spec.min) / math.max(1, spec.max - spec.min)
            rect(r.knob, 166 + ratio * 124, r.y + 20, 8, 2)
            show(r.knob, is_sel)
        elseif r.radio then
            for _, e in ipairs(r.radio) do
                e.btn:SetCheck(e.opt.val == v)
                e.lbl:SetTextColor((e.opt.val == v) and c_sel or c_norm)
            end
        elseif r.list then
            for _, o in ipairs(spec.options or {}) do
                if o.val == v then r.list:SetText(tr(o.label_id)) end
            end
        end
    end

    local gx, gy, gw, gh, k = graph_geometry()
    rect(n.g_bg, gx, gy, gw, gh)
    rect(n.g_axis_x, gx, gy + gh, gw, 1)
    rect(n.g_axis_y, gx, gy, 1, gh)
    local dzi = math.max(0, math.min(0.30, (tonumber(st.dzi) or 15) / 100))
    local dzo = math.max(0.70, math.min(1.00, (tonumber(st.dzo) or 95) / 100))
    rect(n.g_dz_l, gx, gy, dzi * gw, gh)
    rect(n.g_dz_r, gx + dzo * gw, gy, (1 - dzo) * gw, gh)
    show(n.g_dz_l, dzi > 0)
    show(n.g_dz_r, dzo < 1)
    for i, d in ipairs(n.dashes) do
        local t = (i - 0.5) / #n.dashes
        rect(d, gx + t * gw - k, gy + gh - t * gh - 1, 2 * k, 2)
    end
    for i, p in ipairs(n.points) do
        local t = (i - 1) / (#n.points - 1)
        local v = ui_gp_aim.eval_response_curve(st, t)
        rect(p, gx + t * gw - k, gy + gh - v * gh - 1, 2 * k, 2)
    end
    layout_live_dot(w)
    rect(n.g_y100, gx - 22, gy - 2, 22, 14)
    rect(n.g_x0, gx - 2, gy + gh + 2, 30, 14)
    rect(n.g_x100, gx + gw - 18, gy + gh + 2, 30, 14)
    rect(n.g_ycap, gx + 4, gy + 2, gw - 8, 18)
    rect(n.g_xcap, gx + 36, gy + gh + 1, gw - 60, 18)

    local iy = gy + gh + 28
    rect(n.info_title, SIDE_X, iy, SIDE_W, 20, "options.gpa.info.title")
    rect(n.info_line, SIDE_X, iy + 22, SIDE_W, 18, "options.gpa.info.line")
    rect(n.help_long, SIDE_X, iy + 46, SIDE_W, math.max(18, 548 - iy - 46), "options.gpa.help.long")
    if sel_row then
        local spec = sel_row.spec
        n.info_title:SetText(tr("ui_gp_n_aim_" .. spec.id))
        if spec.kind == "slider" then
            n.info_line:SetText(tostring(spec.min) .. tostring(spec.unit or "") .. " ... "
                .. tostring(spec.max) .. tostring(spec.unit or ""))
        else
            n.info_line:SetText("")
        end
    else
        n.info_title:SetText("")
        n.info_line:SetText("")
    end
    n.help_long:SetText(n.help_open and tr("ui_gp_n_help_aim") or "")
    show(n.help_long, n.help_open)
    n.status:SetText("")
    local family = (controls and controls.pad_family) or ui_gp_controls.resolve_pad_family("auto")
    local spec = ui_gp_controls.get_pad_image_spec(family)
    layout_footer(n, family, spec and spec.glyph_prefix, "options.gpa")
end
-- Mouse drag of a stock track bar has no callback, so poll it like ui_options.UIOptions:Update does.
local function poll_aim_tracks(w)
    local n = w._n
    if not n then return end
    for _, r in ipairs(n.rows) do
        if r.track and r.track.IsCursorOverWindow and r.track:IsCursorOverWindow() then
            local spec = r.spec
            local raw = tonumber(r.track:GetFValue()) or spec.min
            local snapped = spec.min + math.floor((raw - spec.min) / spec.step + 0.5) * spec.step
            snapped = math.max(spec.min, math.min(spec.max, snapped))
            if snapped ~= w.state[spec.id] then
                aim_set(w, spec.id, snapped)
                return
            end
        end
    end
end
-- FIX-LIVE2 6a: toggle_help removed - the help card is always shown on the gamepad tabs.

-- ---------------------------------------------------------------------------------------------
-- Page "Other settings" (GPSET-2, BRIEF 11.1..11.5): Vibration, Icons & Hints, Controls, Gamepad, Debug
-- ---------------------------------------------------------------------------------------------
local function now_ms()
    if _G.game and type(_G.game.get_time_continual) == "function" then
        local ok, t = pcall(_G.game.get_time_continual)
        if ok and type(t) == "number" then return t end
    end
    if type(_G.time_global) == "function" then
        local ok, t = pcall(_G.time_global)
        if ok and type(t) == "number" then return t end
    end
    return 0
end

local function exec_cmd(cmd)
    if not cmd or cmd == "" then return false end
    if type(_G.get_console) == "function" then
        local ok_c, con = pcall(_G.get_console)
        if ok_c and con and type(con.execute) == "function" then
            local ok_e = pcall(con.execute, con, cmd)
            if ok_e then return true end
        end
    end
    if type(_G.exec_console_cmd) == "function" then
        local ok_x = pcall(_G.exec_console_cmd, cmd)
        if ok_x then return true end
    end
    return false
end

local function read_con_float(name, def)
    if type(_G.get_console) == "function" then
        local ok_c, con = pcall(_G.get_console)
        if ok_c and con then
            if type(con.get_float) == "function" then
                local ok_f, v = pcall(con.get_float, con, name)
                if ok_f and type(v) == "number" then return v end
            end
            if type(con.get_integer) == "function" then
                local ok_i, v = pcall(con.get_integer, con, name)
                if ok_i and type(v) == "number" then return v end
            end
        end
    end
    return def
end

local function read_con_bool(name, opt_id, def)
    if ui_options and type(ui_options.get) == "function" and opt_id then
        local ok_o, v = pcall(ui_options.get, opt_id)
        if ok_o and v ~= nil then
            return (v == true or v == 1 or v == "true" or v == "1")
        end
    end
    if type(_G.get_console) == "function" then
        local ok_c, con = pcall(_G.get_console)
        if ok_c and con then
            if type(con.get_bool) == "function" then
                local ok_b, v = pcall(con.get_bool, con, name)
                if ok_b and type(v) == "boolean" then return v end
            end
            if type(con.get_integer) == "function" then
                local ok_i, v = pcall(con.get_integer, con, name)
                if ok_i and type(v) == "number" then return v ~= 0 end
            end
        end
    end
    return def
end

local function has_gp_icons()
    return _G.gp_icons ~= nil and type(_G.gp_icons.get_icon_style) == "function"
end

local function has_source_mode_api()
    return _G.game ~= nil
        and type(_G.game.get_gamepad_source_mode) == "function"
        and type(_G.game.set_gamepad_source_mode) == "function"
end

local function query_active_pad_name()
    if _G.game and type(_G.game.gamepad_get_active_name) == "function" then
        local ok, name = pcall(_G.game.gamepad_get_active_name)
        if ok and type(name) == "string" then
            local trimmed = name:gsub("^%s+", ""):gsub("%s+$", "")
            if trimmed ~= "" then return trimmed end
        end
    end
    return nil
end

local function has_active_pad_name()
    return query_active_pad_name() ~= nil
end

local function query_active_pad_power()
    if _G.game and type(_G.game.gamepad_get_power_info) == "function" then
        local ok, a, b = pcall(_G.game.gamepad_get_power_info)
        if ok then
            local st, pct
            if type(a) == "table" then
                st = tostring(a.state or "unknown")
                pct = tonumber(a.percent or a.pct or -1) or -1
            else
                st = tostring(a or "unknown")
                pct = tonumber(b) or -1
            end
            if st ~= "" and st ~= "disconnected" and st ~= "unknown" then
                return st, pct
            end
        end
    end
    return nil, -1
end

local function format_pad_power_text()
    local st, pct = query_active_pad_power()
    if not st then return nil end
    if st == "wired" or st == "no_battery" then
        return tr("ui_gp_oth_pwr_wired")
    elseif st == "charged" then
        return tr("ui_gp_oth_pwr_charged")
    elseif st == "charging" then
        if pct >= 0 and pct <= 100 then
            return string.format("%d%% (%s)", math.floor(pct + 0.5), tr("ui_gp_oth_pwr_charging"))
        end
        return tr("ui_gp_oth_pwr_charging")
    elseif st == "on_battery" then
        if pct >= 0 and pct <= 100 then
            return string.format("%d%%", math.floor(pct + 0.5))
        end
        return tr("ui_gp_oth_pwr_battery")
    end
    if pct >= 0 and pct <= 100 then
        return string.format("%d%%", math.floor(pct + 0.5))
    end
    return nil
end

local function has_active_pad_power()
    return format_pad_power_text() ~= nil
end

