-- UI-Settings-v2 (docs/ui/gamepad-settings-v2/BRIEF.md): gamepad pages inside the stock UIOptions window.
-- ASCII source. The old windows UIGpControlsWnd / UIGpAimWnd stay as the logic owners (remap state machine,
-- profile.ltx writer, aim state); their own widgets are hidden and replaced by stock-styled ones built here.
-- Layout is in the 1024x768 UI space of ui_options_16.xml; the right panel is "tab_size" (340,55,573,606).

local installed = false
local owner     = nil      -- UIOptions instance that currently hosts the pages
local controls  = nil      -- UIGpControlsWnd
local aim       = nil      -- UIGpAimWnd
local other     = nil      -- UIGpOtherWnd (GPSET-2: "Other settings" page)
local active    = nil      -- the window that is shown now (controls / aim / other / nil)
local cur_tab   = "world"
local aim_applied   = nil  -- snapshot of the engine state; aim.state holds pending (not applied) values
local other_applied = nil  -- snapshot of the engine state; other.state holds pending (not applied) values
local X         = nil      -- CScriptXmlInit for ui_gp_native.xml

local PATH      = "control/gamepad"
local TABS      = { "world", "menu", "aim", "other" }
local PANEL_W, PANEL_H = 573, 606
local TABLE_W   = 340
local SIDE_X, SIDE_W = 348, 225
local ROW_H, ROW_STEP, GROUP_STEP = 18, 21, 26
local MAX_ROWS, MAX_GROUPS, MAX_HELP = 20, 6, 8

