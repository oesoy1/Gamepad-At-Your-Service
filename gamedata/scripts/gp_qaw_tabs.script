_GP_FILE_MARKER = "GAYS_REL1_20261114"
-- Actions for Haru dynamic tabs.
local gc = game.translate_string
local function tr(key, fallback)
    if not key then return fallback end
    local value = gc(key)
    return value and value ~= key and value or fallback
end
local function safe_foreign_call(key, fn, ...)
    return gp_compat.safe_call(key, fn, ...)
end
local ActionWheelOption, CompanionWheelOption = {}, {}
function ActionWheelOption:new(action_id, label_id, fallback_label, icon_sec, fn_exec, fn_enabled, fn_dynamic_label)
    self = setmetatable({}, {__index = self})
    self.action_id = action_id
    self.label_id = label_id
    self.fallback_label = fallback_label or action_id
    self.section = icon_sec or "device_pda_1"
    self.fn_exec = fn_exec
    self.fn_enabled = fn_enabled
    self.fn_dynamic_label = fn_dynamic_label
    self:update()
    return self
end

function ActionWheelOption:update()
end

function ActionWheelOption:is_enabled()
    if self.fn_enabled then
        return self.fn_enabled() == true
    end
    return true
end

function ActionWheelOption:get_text()
    local base = tr(self.label_id, self.fallback_label)
    if self.fn_dynamic_label then
        local extra = self.fn_dynamic_label()
        if extra and extra ~= "" then
            return base .. " (" .. extra .. ")"
        end
    end
    return base
end

function ActionWheelOption:execute()
    if not self:is_enabled() then return end
    if self.fn_exec then
        self.fn_exec()
    end
end

