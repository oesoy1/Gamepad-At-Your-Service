_GP_FILE_MARKER = "GAYS_REL1_20261114"
-- ============================================================================
-- gp_inv_rework.script — INV-REWORK-1 (ТЗ docs/ui/live-layout/inventory-gamepad-rework-spec.md)
-- Инвентарь под геймпад (только при активном геймпаде, все режимы ui_inventory.GUI):
--   * одинарное A = логика двойного клика On_CC_Mouse1_DB (надеть/снять/использовать/переложить),
--     перетаскивание (drag) с геймпада не начинается; в режиме repair A = одиночный клик (дерево апгрейдов);
--   * Y прячет/показывает описание предмета (флаг живёт до закрытия игры, не в сохранении);
--   * View листает 3 раздела: Инвентарь -> Снаряжение (слоты, пояс, быстрые слоты) -> Характеристики;
--     ходьба (крестовина/левый стик) только по целям активного раздела, вкладки сортировки не цели,
--     пустые слоты снаряжения не цели;
--   * характеристики — цели ходьбы (kind=stat);
--   * описание: фиксированная высота DESC_H, слева от рамки (справа, если слева нет места),
--     прокрутка правым стиком, если текст не влезает;
--   * подпись A в нижней полосе по предмету (a_label).
-- Движок (UICursor.cpp/GamepadContextDispatcher.cpp, cvar gp_inv_focus_frame) рисует белую рамку
-- вокруг цели вместо золотого курсора и прыгает левым стиком, пока inv_focus_frame_active() == true.
-- Файл: Windows-1251 без BOM.
-- ============================================================================

ENABLED = true

-- Подбирается вживую (F5): высота окна описания в единицах UI 1024x768 и зазор до рамки.
DESC_H = 260
DESC_GAP = 6
DESC_PAD = 10
DESC_SCROLL_LINES = 3

-- REWORK-5: "picker" — меню стаков (UIInventory:Picker_Toggle), раздел есть, только пока меню открыто
-- W4-TECH-SYS: "tech" — левая панель техника (кнопка починки npc_up_repair + дерево узлов upx)
PANEL_ORDER = { "inv", "equ", "picker", "stats", "tech" }
EQU_BAGS = { actor_equ = true, actor_belt = true, actor_quick = true }
-- Окно-родитель каждого контейнера/кнопки (ui_inventory.script:357-451): цель видна, только если
-- показан и сам виджет, и его панель (скрытые панели торговли/обыска/ремонта держат свои
-- Show(true) — отсюда «невидимые полосы» и переходы в чужие разделы, разбор 2026-11-11).
BAG_PARENT = { actor_bag = "player_dialog", actor_trade = "player_dialog", actor_trade_bag = "player_dialog",
    npc_bag = "npc_dialog", npc_trade = "npc_dialog", npc_trade_bag = "npc_dialog",
    actor_equ = "equ_dialog", actor_belt = "equ_dialog", actor_quick = "equ_dialog", picker = "equ_dialog" }
BTN_PARENT = { player_putall = "player_dialog", player_trade_sell = "player_trade",
    npc_takeall = "npc_dialog", npc_trade_buy = "npc_trade", npc_up_repair = "npc_up_dialog" }
UI_W, UI_H = 1024, 768

state = {
    desc_hidden = false,
    panel = "inv",
    last_stat = nil,
    panel_switches = 0,
    desc_toggles = 0,
    single_a = 0,
}

local LABELS_RU = { use = "Использовать", equip = "Надеть", unequip = "Снять", move = "Переложить",
    select = "Выбрать", action = "Действие", description = "Описание", section = "Раздел", menu = "Меню", replace = "Заменить", install = "Установить", charge = "Зарядить", load = "Зарядить", place = "Положить", apply = "Применить",
    repair = "Починить", back = "Назад", close = "Закрыть", clear_cart = "Очистить корзину", clear_short = "Очист.",
    rename_stash = "Переименовать", move_part = "Перенести часть...",
    wpn_ammo_title = "В оружии остались патроны", wpn_unload_sell = "Разрядить и продать",
    wpn_sell_loaded = "Продать как есть", cancel = "Отмена" }
local LABELS_EN = { use = "Use", equip = "Equip", unequip = "Remove", move = "Move",
    select = "Select", action = "Action", description = "Details", section = "Section", menu = "Menu", replace = "Replace", install = "Install", charge = "Charge", load = "Load", place = "Place", apply = "Apply",
    repair = "Repair", back = "Back", close = "Close", clear_cart = "Clear cart", clear_short = "Clear",
    rename_stash = "Rename", move_part = "Move part...",
    wpn_ammo_title = "Weapon still has ammo", wpn_unload_sell = "Unload and sell",
    wpn_sell_loaded = "Sell as is", cancel = "Cancel" }

-- ---------------------------------------------------------------------------
-- Общие помощники
-- ---------------------------------------------------------------------------

local function shown(w)
    if not w or not w.IsShown then return false end
    local ok, res = pcall(w.IsShown, w)
    return ok and res == true
end

function get_gui()
    local g = ui_inventory and ui_inventory.GUI
    if g and shown(g) then return g end
    return nil
end

function is_gamepad()
    if gp_bridge and gp_bridge.is_gamepad_active then
        local ok, res = pcall(gp_bridge.is_gamepad_active)
        return ok and res == true
    end
    return false
end

function is_active()
    return ENABLED == true and get_gui() ~= nil and is_gamepad() and not sheet_open()
end

-- INV-REWORK-16 (п.6): окно «Подробно» поверх инвентаря — рамки и кнопок инвентаря нет
function sheet_open()
    local f = gp_bridge and gp_bridge.item_sheet_gui
    return type(f) == "function" and f() ~= nil or false
end

-- Вызывается движком каждый кадр (GamepadContextDispatcher::StepVirtualCursor через gp_bridge).
function inv_focus_frame_active()
    if not is_active() then return false end
    local gui = get_gui()
    if msg_box_shown(gui) or qty_dlg_shown() then return false end
    return true
end

function widget_rect(w)
    if not shown(w) then return nil end
    if Frect and w.GetAbsoluteRect then
        local r = Frect()
        local ok = pcall(w.GetAbsoluteRect, w, r)
        if ok and r and r.x1 and r.x2 and (r.x2 - r.x1) > 1 and (r.y2 - r.y1) > 1 then
            return { x1 = r.x1, y1 = r.y1, x2 = r.x2, y2 = r.y2 }
        end
    end
    return nil
end

local function is_russian()
    local s = game and game.translate_string and game.translate_string("ui_total_weight") or ""
    return type(s) == "string" and s:find("[\192-\255]") ~= nil
end

function label(key)
    local id = "ui_gp_inv_act_" .. tostring(key or "")
    if LABELS_EN[key] and game and game.translate_string then
        local ok, s = pcall(game.translate_string, id)
        local w_ok, w_s = pcall(game.translate_string, "ui_total_weight")
        if ok and type(s) == "string" and s ~= "" and s ~= id and (not w_ok or s ~= w_s) then
            return s
        end
    end
    local t = is_russian() and LABELS_RU or LABELS_EN
    return t[key] or key
end

-- ---------------------------------------------------------------------------
-- Разделы (View) и цели
-- ---------------------------------------------------------------------------

function bag_panel(bag)
    if bag == "picker" then return "picker" end
    return EQU_BAGS[bag] and "equ" or "inv"
end

function picker_shown(gui)
    return gui and type(gui.CC) == "table" and shown(gui.CC.picker) or false
end

function get_panel()
    return state.panel
end

function set_panel(p)
    for _, name in ipairs(PANEL_ORDER) do
        if name == p then
            state.panel = p
            return true
        end
    end
    return false
end

function reset_panel()
    state.panel = "inv"
end

-- Ячейка — цель ходьбы, если в ней предмет (пустые клетки и пустые слоты не цели, решение Миши 2026-11-11).
function cell_is_target(cc, ci)
    if not ci then return false end
    return ci.ID ~= nil and ci.ID ~= false
end

-- Прямоугольник виден на экране UI 1024x768 и не вырожден.
function on_screen(r)
    return r ~= nil and (r.x2 - r.x1) >= 4 and (r.y2 - r.y1) >= 4
        and r.x2 > 0 and r.x1 < UI_W and r.y2 > 0 and r.y1 < UI_H
end

-- Панель-родитель показана (нет записи — не проверяем).
function parent_shown(gui, field)
    if not field then return true end
    local w = gui and gui[field]
    if w == nil then return true end
    return shown(w)
end

function btn_name(gui, w)
    if not gui or not w then return nil end
    for name in pairs(BTN_PARENT) do
        if rawequal(gui[name], w) then return name end
    end
    return nil
end

-- Фильтр для gp_bridge.cursor_query_target / cursor_dpad_snap. w — виджет кнопки/узла (btn/upgr).
function target_allowed(kind, bag, cc, ci, w)
    if not is_active() then return true end
    local gui = get_gui()
    if wpn_dlg_shown() then
        if kind ~= "btn" or not w then return false end
        return wpn_dlg_is_btn(w)
    end
    if qty_dlg_shown() or msg_box_shown(gui) then return false end
    if state.pick then
        -- режим выбора «на что применить»: рамка ходит только по допустимым целям (рюкзак и снаряжение)
        -- INV-REWORK-12: слоты снаряжения для удержания A по оружию — и пустые (ci.ID == nil)
        if is_pick_slot(bag, ci) then
            return parent_shown(gui, BAG_PARENT[bag]) and on_screen(widget_rect(ci.cell))
        end
        if kind ~= "cell" or not ci or not ci.ID or not state.pick.targets[ci.ID] then return false end
        if not parent_shown(gui, BAG_PARENT[bag]) then return false end
        if ci.IsShown and not shown(ci) then return false end
        return on_screen(widget_rect(ci.cell))
    end
    local p = state.panel
    if kind == "sort" then return false end
    if kind == "prop" then return true end
    if gui and gui.mode == "repair" then
        if p == "tech" then
            if kind == "upgr" then
                if not parent_shown(gui, "npc_up_dialog") then return false end
                return w == nil or on_screen(widget_rect(w))
            end
            if kind == "btn" then
                if w ~= nil and not rawequal(w, gui.npc_up_repair) then return false end
                return parent_shown(gui, "npc_up_dialog") and (w == nil or on_screen(widget_rect(w)))
            end
            return false
        end
        if kind == "upgr" then return false end
        if kind == "btn" and w ~= nil and rawequal(w, gui.npc_up_repair) then return false end
    end
    if kind == "cell" then
        if not cell_is_target(cc, ci) then return false end
        if bag_panel(bag) ~= p then return false end
        if not parent_shown(gui, BAG_PARENT[bag]) then return false end
        if ci.IsShown and not shown(ci) then return false end
        return on_screen(widget_rect(ci.cell))
    end
    if kind == "stat" then return p == "stats" end
    -- btn (Взять всё/Купить/Продать/Переименовать тайник), upgr — часть раздела «Инвентарь»
    if p ~= "inv" then return false end
    if w ~= nil then
        if not on_screen(widget_rect(w)) then return false end
        if kind == "btn" then
            if gui and rawequal(w, gui._gp_stash_rename_btn) then
                return gui.mode == "loot" and parent_shown(gui, "npc_dialog")
            end
            local name = btn_name(gui, w)
            if name and not parent_shown(gui, BTN_PARENT[name]) then return false end
        elseif kind == "upgr" then
            if not parent_shown(gui, "npc_up_dialog") then return false end
        end
    end
    return true
end

-- Рамка характеристики: от значка до начала соседней характеристики в той же строке
-- (база gui.stat[name].base шире колонки и залезала на соседа — «кривые рамки», 2026-11-11).
STAT_PAD = 3
STAT_GAP = 6

function collect_stat_targets(gui)
    local out = {}
    if not gui or type(gui.stat) ~= "table" then return out end
    for name, v in pairs(gui.stat) do
        local r = v and widget_rect(v.base)
        if r and on_screen(r) then
            local ico = widget_rect(v.ico_base)
            local x1, y1, y2 = r.x1, r.y1, r.y2
            if ico then
                x1 = ico.x1
                y1 = math.min(y1, ico.y1)
                y2 = math.max(y2, ico.y2)
            end
            out[#out + 1] = { name = name, x1 = x1 - STAT_PAD, y1 = y1 - STAT_PAD, x2 = r.x2, y2 = y2 + STAT_PAD }
        end
    end
    table.sort(out, function(a, b)
        local ma, mb = (a.y1 + a.y2) * 0.5, (b.y1 + b.y2) * 0.5
        if math.abs(ma - mb) > 4 then return ma < mb end
        if a.x1 ~= b.x1 then return a.x1 < b.x1 end
        return tostring(a.name) < tostring(b.name)
    end)
    -- INV-REWORK-13 (рентген 2026-11-12): br_class и br_mitigation занимают одно место -> одна цель
    local uniq = {}
    for _, t in ipairs(out) do
        local p = uniq[#uniq]
        if not (p and math.abs(p.x1 - t.x1) < 1 and math.abs(p.y1 - t.y1) < 1) then uniq[#uniq + 1] = t end
    end
    out = uniq
    local function same_row(a, b)
        return a and b and math.abs((a.y1 + a.y2) * 0.5 - (b.y1 + b.y2) * 0.5) <= 4
    end
    for i, t in ipairs(out) do
        local n, pv = out[i + 1], out[i - 1]
        if same_row(n, t) and n.x1 > t.x1 then
            t.x2 = math.min(t.x2, n.x1 - STAT_GAP)
        elseif same_row(pv, t) then
            -- последняя в строке: база шире колонки и вылезала за панель («сон») -> ширина соседа слева
            t.x2 = math.min(t.x2, t.x1 + (pv.x2 - pv.x1))
        end
        t.mx, t.my = (t.x1 + t.x2) * 0.5, (t.y1 + t.y2) * 0.5
        t.w, t.h = t.x2 - t.x1, t.y2 - t.y1
    end
    return out
end

function stat_at(gui, x, y)
    for _, t in ipairs(collect_stat_targets(gui)) do
        if x >= t.x1 and x <= t.x2 and y >= t.y1 and y <= t.y2 then
            state.last_stat = t.name
            return t
        end
    end
    return nil
end

-- Первая цель раздела (по экрану сверху вниз, слева направо).
function first_target(gui, panel)
    if panel == "stats" then
        local list = collect_stat_targets(gui)
        for _, t in ipairs(list) do
            if t.name == state.last_stat then return t end
        end
        return list[1]
    end
    if type(gui.CC) ~= "table" then return nil end
    -- Сначала выделенная/наведённая ячейка этого раздела
    for bag, cc in pairs(gui.CC) do
        if bag_panel(bag) == panel and shown(cc) and type(cc.cell) == "table" then
            local idx = cc.selected or (type(cc.hover) == "table" and cc.hover.idx) or nil
            local ci = idx and cc.cell[idx]
            if ci and cell_is_target(cc, ci) then
                local r = widget_rect(ci.cell)
                if r and (not cc.IsCellVisible or cc:IsCellVisible(ci)) then
                    return { mx = (r.x1 + r.x2) * 0.5, my = (r.y1 + r.y2) * 0.5, bag = bag, idx = idx }
                end
            end
        end
    end
    local best = nil
    for bag, cc in pairs(gui.CC) do
        if bag_panel(bag) == panel and shown(cc) and type(cc.cell) == "table" then
            for idx, ci in pairs(cc.cell) do
                if cell_is_target(cc, ci) and (cc.manual == true or shown(ci)) and ci.cell then
                    local vis = true
                    if cc.IsCellVisible then
                        local ok_v, v = pcall(cc.IsCellVisible, cc, ci)
                        vis = ok_v and v == true
                    end
                    local r = vis and widget_rect(ci.cell)
                    if r then
                        local t = { mx = (r.x1 + r.x2) * 0.5, my = (r.y1 + r.y2) * 0.5, bag = bag, idx = idx }
                        if not best or t.my < best.my - 2 or (math.abs(t.my - best.my) <= 2 and t.mx < best.mx) then
                            best = t
                        end
                    end
                end
            end
        end
    end
    if best or panel ~= "inv" then return best end
    -- Пустой рюкзак: кнопки действий
    for _, btn in ipairs({ gui.npc_takeall, gui.npc_trade_buy, gui.player_trade_sell, gui.npc_up_repair, gui.player_putall }) do
        local r = widget_rect(btn)
        local name = btn_name(gui, btn)
        if r and on_screen(r) and (not name or parent_shown(gui, BTN_PARENT[name])) then
            return { mx = (r.x1 + r.x2) * 0.5, my = (r.y1 + r.y2) * 0.5 }
        end
    end
    return nil
end

-- Все цели активного раздела (те же фильтры, что у gp_bridge): {mx,my,w,h,kind}.
function panel_targets(gui)
    local out = {}
    if not gui then return out end
    local p = state.panel
    if p == "picker" and not picker_shown(gui) then
        -- меню стаков закрылось — рамка возвращается в рюкзак
        state.panel = "inv"
        p = "inv"
    end
    if wpn_dlg_shown() then
        return wpn_dlg_targets()
    end
    if qty_dlg_shown() or msg_box_shown(gui) then return out end
    if p == "stats" then
        for _, t in ipairs(collect_stat_targets(gui)) do
            out[#out + 1] = { mx = t.mx, my = t.my, w = t.w, h = t.h, kind = "stat" }
        end
        return out
    end
    if p == "tech" then
        if gui.npc_up_repair and target_allowed("btn", nil, nil, nil, gui.npc_up_repair) then
            local r = widget_rect(gui.npc_up_repair)
            if r then
                out[#out + 1] = { mx = (r.x1 + r.x2) * 0.5, my = (r.y1 + r.y2) * 0.5,
                    w = r.x2 - r.x1, h = r.y2 - r.y1, kind = "btn" }
            end
        end
        if type(gui.upx) == "table" then
            for _, node in pairs(gui.upx) do
                local b = node and node.btn
                if b and (not node.base or shown(node.base)) and target_allowed("upgr", nil, nil, nil, b) then
                    local r = widget_rect(b)
                    if r then
                        out[#out + 1] = { mx = (r.x1 + r.x2) * 0.5, my = (r.y1 + r.y2) * 0.5,
                            w = r.x2 - r.x1, h = r.y2 - r.y1, kind = "upgr" }
                    end
                end
            end
        end
        return out
    end
    if type(gui.CC) == "table" then
        for bag, cc in pairs(gui.CC) do
            if shown(cc) and type(cc.cell) == "table" then
                for _, ci in pairs(cc.cell) do
                    if ci and ci.cell and (not cc.IsCellVisible or cc:IsCellVisible(ci))
                        and target_allowed("cell", bag, cc, ci) then
                        local r = widget_rect(ci.cell)
                        if r then
                            out[#out + 1] = { mx = (r.x1 + r.x2) * 0.5, my = (r.y1 + r.y2) * 0.5,
                                w = r.x2 - r.x1, h = r.y2 - r.y1, kind = "cell" }
                        end
                    end
                end
            end
        end
    end
    if p == "inv" then
        for name in pairs(BTN_PARENT) do
            local b = gui[name]
            if b and target_allowed("btn", nil, nil, nil, b) then
                local r = widget_rect(b)
                if r then
                    out[#out + 1] = { mx = (r.x1 + r.x2) * 0.5, my = (r.y1 + r.y2) * 0.5,
                        w = r.x2 - r.x1, h = r.y2 - r.y1, kind = "btn" }
                end
            end
        end
        local rb = gui._gp_stash_rename_btn
        if rb and target_allowed("btn", nil, nil, nil, rb) then
            local r = widget_rect(rb)
            if r then
                out[#out + 1] = { mx = (r.x1 + r.x2) * 0.5, my = (r.y1 + r.y2) * 0.5,
                    w = r.x2 - r.x1, h = r.y2 - r.y1, kind = "btn" }
            end
        end
    end
    return out
end

function nearest_target(gui, x, y)
    local best, best_d = nil, nil
    for _, t in ipairs(panel_targets(gui)) do
        local dx, dy = t.mx - x, t.my - y
        local d = dx * dx + dy * dy
        if not best_d or d < best_d then
            best, best_d = t, d
        end
    end
    return best
end

local function move_cursor(x, y)
    if SetCursorPosition and vector2 then
        pcall(function() SetCursorPosition(vector2():set(x, y)) end)
        return true
    end
    return false
end

-- Под рамкой пусто (открытие инвентаря, предмет съеден/переложен): рамка сама переезжает на
-- ближайшую цель раздела (решение Миши 2026-11-11); раздел пуст — nil (движок гасит рамку).
-- INV-REWORK-20 (Миша 2026-11-12): (1) после разборки/применения рамка сразу на инструмент
-- (state.ret_tool), без промежуточного прыжка на ближайший предмет; (2) кончилась стопка — соседняя
-- рамка: предмет левее в той же строке (предыдущий по списку), иначе ближайший.
RECOVER_ROW_TOL = 20

function recover_target(gui, x, y)
    x, y = tonumber(x) or 0, tonumber(y) or 0
    local r = state.ret_tool
    if r and not state.pick then
        local tg = find_cell(gui, function(ci) return ci.ID == r.id end)
        if tg then
            x, y = tg.mx, tg.my
            state.ret_tool = nil
            state.last_return = "tool"
            state.tool_returns = (state.tool_returns or 0) + 1
        end
    end
    local t = nil
    if not r or state.ret_tool then
        for _, c in ipairs(panel_targets(gui)) do
            if math.abs(c.my - y) <= RECOVER_ROW_TOL and c.mx < x and (not t or c.mx > t.mx) then t = c end
        end
    end
    t = t or nearest_target(gui, x, y)
    if not t then return nil end
    move_cursor(t.mx, t.my)
    state.recovers = (state.recovers or 0) + 1
    return t
end

-- ---------------------------------------------------------------------------
-- INV-REWORK-14 (решения Миши 2026-11-12, п.5/п.6):
--   * короткое View — только снаряжение <-> рюкзак (из характеристик/меню стопки — назад, где была);
--   * удержание View 800 мс (движок: заполнение рамки как у A) — «вход/выход»: открыто меню стопки —
--     рамка в него, иначе в характеристики; повторное удержание или B — обратно туда, где была;
--   * вход в снаряжение — правое оружие (actor_equ клетка 3), пусто — левое (клетка 2), затем первый слот;
--   * вход в рюкзак — последний выбранный там предмет (state.last_inv_id), нет его — начало списка.
-- ---------------------------------------------------------------------------
EQU_ENTRY_CELLS = { 3, 2 }

local function rect_target(r, bag, idx)
    return { mx = (r.x1 + r.x2) * 0.5, my = (r.y1 + r.y2) * 0.5, x1 = r.x1, y1 = r.y1, bag = bag, idx = idx }
end

local function cell_visible(cc, ci)
    if not cc.IsCellVisible then return true end
    local ok, v = pcall(cc.IsCellVisible, cc, ci)
    return ok and v == true
end

-- Цель по клетке bag#idx (только с предметом и видимая) или nil.
function cell_target(gui, bag, idx)
    local cc = gui and type(gui.CC) == "table" and gui.CC[bag]
    local ci = cc and shown(cc) and type(cc.cell) == "table" and cc.cell[idx]
    if not (ci and ci.cell and cell_is_target(cc, ci) and cell_visible(cc, ci)) then return nil end
    local r = widget_rect(ci.cell)
    return r and rect_target(r, bag, idx) or nil
end

-- Цель по id предмета в контейнерах раздела panel или nil.
function target_by_id(gui, panel, id)
    if not (gui and id and type(gui.CC) == "table") then return nil end
    for bag, cc in pairs(gui.CC) do
        if bag_panel(bag) == panel and shown(cc) and type(cc.cell) == "table" then
            for idx, ci in pairs(cc.cell) do
                if ci and ci.ID == id then return cell_target(gui, bag, idx) end
            end
        end
    end
    return nil
end

-- Самая верхняя левая цель раздела (без предпочтения выделенной клетки).
TOP_ROW_TOL = 12

function top_target(gui, panel)
    local best = nil
    for bag, cc in pairs(gui.CC or {}) do
        if bag_panel(bag) == panel and shown(cc) and type(cc.cell) == "table" then
            for idx in pairs(cc.cell) do
                local t = cell_target(gui, bag, idx)
                -- INV-REWORK-16 (п.4, скриншот Миши 2026-11-12): по ВЕРХНЕМУ краю и левому краю, а не по
                -- центру — маленький IRONS справа (центр выше) обгонял длинную винтовку слева вверху
                if t and (not best or t.y1 < best.y1 - TOP_ROW_TOL
                    or (math.abs(t.y1 - best.y1) <= TOP_ROW_TOL and t.x1 < best.x1)) then
                    best = t
                end
            end
        end
    end
    return best
end

function equ_entry_target(gui)
    for _, idx in ipairs(EQU_ENTRY_CELLS) do
        local t = cell_target(gui, "actor_equ", idx)
        if t then return t end
    end
    return top_target(gui, "equ")
end

function inv_entry_target(gui)
    return target_by_id(gui, "inv", state.last_inv_id) or top_target(gui, "inv") or first_target(gui, "inv")
end

function hovered_id(gui)
    local h = gui and gui.hover
    local cc = type(h) == "table" and h.bag and type(gui.CC) == "table" and gui.CC[h.bag]
    local ci = cc and type(cc.cell) == "table" and cc.cell[h.idx]
    return ci and ci.ID or nil, h and h.bag
end

-- Запомнить, где рамка, перед уходом из раздела.
function remember_spot(gui)
    local id, bag = hovered_id(gui)
    if state.panel == "inv" and id and bag_panel(bag) == "inv" then state.last_inv_id = id end
    local x, y = cursor_xy()
    return { panel = state.panel, id = id, mx = x, my = y }
end

function goto_panel(gui, p, t)
    if type(gui.hover) == "table" and gui.hover.bag and gui.CC and gui.CC[gui.hover.bag] then
        local prev = gui.CC[gui.hover.bag]
        if prev.On_Hover then pcall(prev.On_Hover, prev, false) end
    end
    state.panel = p
    state.panel_switches = state.panel_switches + 1
    move_cursor(t.mx, t.my)
    return string.format("panel:1;panel=%s;cx=%.1f;cy=%.1f", p, t.mx, t.my)
end

-- Назад туда, где рамка была до входа в характеристики/меню стопки.
function view_return(gui)
    local r = state.view_ret or { panel = "inv" }
    state.view_ret = nil
    local p = (r.panel == "equ") and "equ" or "inv"
    local t = target_by_id(gui, p, r.id)
    if not t and r.mx then
        state.panel = p
        t = nearest_target(gui, r.mx, r.my)
    end
    t = t or (p == "equ" and equ_entry_target(gui) or inv_entry_target(gui))
    if not t then return "panel:0" end
    return goto_panel(gui, p, t)
end

-- View коротко: снаряжение <-> рюкзак (в repair: рюкзак -> снаряжение -> техник -> рюкзак).
function exec_cycle_panel()
    local gui = get_gui()
    if not gui or modal_open(gui) then return "panel:0" end
    if state.panel == "stats" or state.panel == "picker" then return view_return(gui) end
    if is_two_side(gui) then return zone_cycle(gui) end
    if gui.mode == "repair" then return repair_cycle_panel(gui) end
    local dest = (state.panel == "equ") and "inv" or "equ"
    remember_spot(gui)
    local t = (dest == "equ") and equ_entry_target(gui) or inv_entry_target(gui)
    if not t then return "panel:0" end
    return goto_panel(gui, dest, t)
end

-- ---------------------------------------------------------------------------
-- INV-REWORK-21 (решения Миши 2026-11-12): обыск (gui.mode "loot") и торговля ("trade").
--   * View по кругу: сторона НПС (ящик / товары торговца) -> снаряжение -> рюкзак игрока -> снова НПС;
--     вход в сторону - левая верхняя клетка; пустая сторона пропускается. Корзины торговли - только LS/крестовина.
--   * При открытии рамка - в левой верхней клетке ящика/товаров; пусто - в рюкзаке игрока.
--   * Обыск: RB коротко = "Взять всё" (LMode_TakeAll), удержание RB (как у A: 0,3 с паузы + анимация,
--     кольцо вокруг значка RB на кнопке) = автолутер z_auto_looter с настройками MCM; у напарника автолутера нет
--     (RB = сразу "Взять всё"); LB = "Сложить всё" (LMode_PutAll, у напарника - как в игре, с проверкой веса).
--   * Торговля: RB = купить корзину торговца (TMode_Buy), LB = продать свою корзину (TMode_Sell);
--     пустая корзина - "нельзя" (тряска рамки + короткая вибрация, deny()).
--   * Окно "не хватает денег" (gui.message_box) закрывается A или B.
-- ---------------------------------------------------------------------------
NPC_SIDE = { npc_bag = true, npc_trade = true, npc_trade_bag = true }
NPC_ZONE = { npc_bag = true, npc_trade_bag = true }
ACTOR_ZONE = { actor_bag = true, actor_trade_bag = true }
ZONE_NEXT = { npc = "equ", equ = "actor", actor = "npc" }
OPEN_PLACE_TRIES = 10

function is_two_side(gui)
    return gui ~= nil and (gui.mode == "loot" or gui.mode == "trade")
end

function is_side_mode(gui)
    return gui ~= nil and (gui.mode == "loot" or gui.mode == "trade" or gui.mode == "repair")
end

function zone_of(gui)
    if state.panel == "equ" then return "equ" end
    local _, bag = hovered_id(gui)
    if bag and NPC_SIDE[bag] then return "npc" end
    return "actor"
end

-- Левая верхняя клетка среди контейнеров bags (по верхнему и левому краю, как top_target).
function top_target_bags(gui, bags)
    local best = nil
    for bag, cc in pairs(gui.CC or {}) do
        if bags[bag] and shown(cc) and type(cc.cell) == "table" then
            for idx in pairs(cc.cell) do
                local t = cell_target(gui, bag, idx)
                if t and (not best or t.y1 < best.y1 - TOP_ROW_TOL
                    or (math.abs(t.y1 - best.y1) <= TOP_ROW_TOL and t.x1 < best.x1)) then
                    best = t
                end
            end
        end
    end
    return best
end

function zone_entry(gui, z)
    if z == "equ" then return equ_entry_target(gui) end
    return top_target_bags(gui, z == "npc" and NPC_ZONE or ACTOR_ZONE)
end

function zone_cycle(gui)
    local z = zone_of(gui)
    local dest = ZONE_NEXT[z]
    while dest ~= z do
        local t = zone_entry(gui, dest)
        if t then
            state.zone_switches = (state.zone_switches or 0) + 1
            return goto_panel(gui, dest == "equ" and "equ" or "inv", t) .. ";zone=" .. dest
        end
        dest = ZONE_NEXT[dest]
    end
    return "panel:0"
end

function drain_open_place(gui)
    local n = state.open_place
    if not n then return false end
    state.open_place = (n > 1) and (n - 1) or nil
    if not is_active() then return false end
    local t = zone_entry(gui, "npc") or zone_entry(gui, "actor")
    if not t then return false end
    state.open_place = nil
    state.panel = "inv"
    move_cursor(t.mx, t.my)
    return true
end

function ensure_msg_box_hooks(gui)
    if not gui then return false end
    for _, field in ipairs({ "message_box", "message_box_up" }) do
        local mb = gui[field]
        if mb and not mb._gp_tpl_hooked and type(mb.InitMessageBox) == "function" then
            mb._gp_tpl_hooked = true
            local orig = mb.InitMessageBox
            mb.InitMessageBox = function(self, tpl, ...)
                self._gp_tpl = tpl
                return orig(self, tpl, ...)
            end
        end
    end
    return true
end

function active_msg_box(gui)
    if not gui then return nil, nil end
    if gui.message_box_up and shown(gui.message_box_up) then return gui.message_box_up, "up" end
    if gui.message_box and shown(gui.message_box) then return gui.message_box, "main" end
    return nil, nil
end

function msg_box_shown(gui)
    local mb = active_msg_box(gui)
    return mb ~= nil
end

function close_msg_box(gui)
    local mb = active_msg_box(gui)
    if not mb then return false end
    if mb.HideDialog then pcall(mb.HideDialog, mb) elseif mb.Show then pcall(mb.Show, mb, false) end
    if gui and type(gui.Discard) == "function" then pcall(gui.Discard, gui) end
    state.msg_closes = (state.msg_closes or 0) + 1
    return true
end

-- W4-TECH-SYS: обработка A / X / B на модальных окнах подтверждения ремонта (gui.message_box)
-- и апгрейда (gui.message_box_up). При согласии вызывает штатные gui:RMode_UpgradeYes() / gui:RMode_RepairYes()
-- со всеми обёртками G.A.M.M.A. (mags_patches, aol_mp412_monkeypatches, z_3d_scopes, z_mark_switch).
function on_msg_box_button(btn)
    local gui = get_gui()
    local mb, kind = active_msg_box(gui)
    if not mb then return nil end
    local b = tostring(btn or "")
    local is_yes_no = (kind == "up") or (gui.mode == "repair" and mb._gp_tpl == "message_box_yes_no")
    if b == "B" then
        close_msg_box(gui)
        return "closed_item_props"
    end
    if is_yes_no then
        if b == "A" or b == "X" then
            if mb.HideDialog then pcall(mb.HideDialog, mb) elseif mb.Show then pcall(mb.Show, mb, false) end
            state.msg_confirms = (state.msg_confirms or 0) + 1
            if kind == "up" then
                if type(gui.RMode_UpgradeYes) == "function" then gui:RMode_UpgradeYes() end
            else
                if type(gui.RMode_RepairYes) == "function" then gui:RMode_RepairYes() end
            end
            return "handled_item_props:msg_yes"
        end
        return nil
    end
    -- Одиночное окно ОК («Недостаточно денег» и пр.)
    if b == "A" then
        close_msg_box(gui)
        return "handled_item_props:msg_ok"
    end
    if b == "X" then
        return "handled_modal:msg_noop"
    end
    return nil
end

-- INV-REWORK-27 (Миша 2026-11-13: «LB в торговле не работает при выбранной категории LT/RT»):
-- фильтр категории прячет/пересобирает клетки (cc.cell), а сам TMode_Buy (ui_inventory.script:2864) переносит
-- по cc.indx_id. Корзина считается по indx_id, клетки - только запасной путь (старые/заглушечные контейнеры).
function cart_empty(gui, bag)
    local cc = gui and type(gui.CC) == "table" and gui.CC[bag]
    if cc and type(cc.indx_id) == "table" then return next(cc.indx_id) == nil end
    if not (cc and type(cc.cell) == "table") then return true end
    for _, ci in pairs(cc.cell) do
        if cell_is_target(cc, ci) then return false end
    end
    return true
end

function autoloot_allowed(gui)
    if not (gui and gui.mode == "loot") or gui.npc_is_companion then return false end
    local al = z_auto_looter
    return type(al) == "table" and type(al.auto_looter) == "function"
end

function side_call(gui, method)
    if type(gui[method]) ~= "function" then return deny() end
    gui[method](gui)
    state.side_actions = (state.side_actions or 0) + 1
    state.last_side = method
    return true
end

-- INV-REWORK-22 (Миша 2026-11-12): кнопка плеча = сторона панели. Панель NPC/ящика слева -> LB
-- (взять всё / купить, удержание = автолутер), панель игрока справа -> RB (сложить всё / продать).
-- Движок (StepInventoryButtons, LB нажата): "hold" - ждать удержания (кольцо на значке LB),
-- "done" - уже выполнено, "" - обычная обработка LB (модификатор пачки).
function lb_press()
    if not is_active() or state.pick then return "" end
    local gui = get_gui()
    if qty_dlg_shown() then
        qty_dlg_step(-5)
        return "done"
    end
    if wpn_dlg_shown() or active_custom_props() then return "done" end
    if not is_two_side(gui) then return "" end
    -- INV-REWORK-27: в торговле LB - всегда «Купить»; меню стопки, оставшееся после переключения категории
    -- (TMode_ResetInventories -> Picker_Toggle), закрывается, а не забирает LB в модификатор пачки.
    if picker_shown(gui) then
        if gui.mode ~= "trade" or type(gui.Picker_Toggle) ~= "function" then return "" end
        pcall(gui.Picker_Toggle, gui, nil, nil, nil, true)
    end
    if close_msg_box(gui) then return "done" end
    if gui.mode == "trade" then
        if cart_empty(gui, "npc_trade") then deny() else side_call(gui, "TMode_Buy") end
        return "done"
    end
    if autoloot_allowed(gui) then
        state.lb_hold = true
        return "hold"
    end
    side_call(gui, "LMode_TakeAll")
    return "done"
end

function lb_hold_tap()
    if not state.lb_hold then return false end
    state.lb_hold = nil
    local gui = get_gui()
    if not gui then return false end
    return side_call(gui, "LMode_TakeAll")
end

function lb_hold_fire()
    if not state.lb_hold then return false end
    state.lb_hold = nil
    local gui = get_gui()
    if not autoloot_allowed(gui) then return false end
    local npc = gui.GetPartner and gui:GetPartner()
    local al = z_auto_looter
    if not npc or (al.is_placable_stash and al.is_placable_stash(npc)) then return deny() end
    local ok = pcall(al.auto_looter, nil, npc)
    state.autoloots = (state.autoloots or 0) + 1
    return ok
end

-- Движок (StepInventoryButtons, RB нажата): "done" - RB забрали (сложить всё / продать / закрыть окно),
-- "" - обычная обработка RB (меню стопки и пр.).
function rb_press()
    if not is_active() or state.pick then return "" end
    local gui = get_gui()
    if qty_dlg_shown() then
        qty_dlg_step(5)
        return "done"
    end
    if wpn_dlg_shown() or active_custom_props() then return "done" end
    if not is_two_side(gui) then return "" end
    if picker_shown(gui) then
        if gui.mode ~= "trade" or type(gui.Picker_Toggle) ~= "function" then return "" end
        pcall(gui.Picker_Toggle, gui, nil, nil, nil, true)
    end
    if close_msg_box(gui) then return "done" end
    if gui.mode == "trade" then
        if cart_empty(gui, "actor_trade") then deny() else side_call(gui, "TMode_Sell") end
        return "done"
    end
    side_call(gui, "LMode_PutAll")
    return "done"
end

-- INV-REWORK-21 + W4-TECH-SYS: подсказки двухпанельных окон (loot / trade / repair, E14 + gp_icons).
SIDE_BTNS = {
    loot = { lb = "npc_takeall", rb = "player_putall" },
    trade = { lb = "npc_trade_buy", rb = "player_trade_sell" },
}
SIDE_BTN_DY_PX = { npc_trade_buy = -4.5, player_trade_sell = -4.5 }
SIDE_PLATE_BTNS = { npc_takeall = true, player_putall = true }
SIDE_PLATE_TEX = "ui_inGame2_big_inventory_button"
SIDE_SHOULDER_BOX = { x1 = 11.29, y1 = 13.71, x2 = 116.71, y2 = 114.29, cell = 128 }
SIDE_TEX = { rb = "ui_gp_dark_xbox_rshoulder", lb = "ui_gp_dark_xbox_lshoulder", A = "ui_gp_dark_xbox_south",
    B = "ui_gp_dark_xbox_east", Y = "ui_gp_dark_xbox_north", View = "ui_gp_dark_xbox_back", X = "ui_gp_dark_xbox_west",
    L3 = "ui_gp_dark_xbox_lstick", Menu = "ui_gp_dark_xbox_start" }
SIDE_FONT = "letterica18"
SIDE_WEIGHT_FONT = "letterica16"
SIDE_BTN_FONT = "graffiti22"
local function al()
    return _G.gp_hint_align
end
local function ic_mod()
    return rawget(_G, "gp_icons")
end
SIDE_ICON_PX = 28
SIDE_TXT_PX = 11
SIDE_GAP_PX = 34
SIDE_TIGHT_PX = 20
SIDE_WEIGHT_PAD_PX = 26 -- отступ веса от правого края панели (px макета)
SIDE_PAD_PX = 42 -- INV-REWORK-25: отступ от левого края полосы
SIDE_MAX_SLOTS = 6
-- {кнопка, подпись, короткая подпись (если не влезает)}
-- INV-REWORK-28: в обыске значок X убран, Y - всегда «Описание».
-- W4-TECH-SYS: кнопки перечитываются динамически через gp_bridge.resolve_menu_button_for_hint + gp_icons (E14).
SIDE_ROW = {
    loot = {
        { "A", "Transfer", "Transfer", id = "ui_gp_inv_side_transfer" },
        { "Y", "Details", "Details", id = "ui_gp_inv_side_desc" },
        { "View", "Panel", "Panel", id = "ui_gp_inv_side_panel" },
    },
    trade = {
        { "A", "Cart", "Cart", id = "ui_gp_inv_side_to_cart" },
        { "Y", "Details", "Info", id = "ui_gp_inv_side_desc", short_id = "ui_gp_inv_side_desc_short" },
        { "View", "Panel", "Panel", id = "ui_gp_inv_side_panel" },
        { "X", "Menu", "Menu", id = "ui_gp_inv_side_menu" },
    },
    repair = {
        { "A", "Select", "Select", id = "ui_gp_inv_act_select" },
        { "Y", "Details", "Info", id = "ui_gp_inv_side_desc", short_id = "ui_gp_inv_side_desc_short" },
        { "View", "Panel", "Panel", id = "ui_gp_inv_side_panel" },
        { "X", "Menu", "Menu", id = "ui_gp_inv_side_menu" },
    },
}

local function side_tr(id, fb)
    if id and game and game.translate_string then
        local ok, s = pcall(game.translate_string, id)
        local w_ok, w_s = pcall(game.translate_string, "ui_total_weight")
        if ok and type(s) == "string" and s ~= "" and s ~= id and (not w_ok or s ~= w_s) then
            return s
        end
    end
    return fb
end
SIDE_ICON_W = 15 -- ширина значка в ед. UI; side_metrics пересчитывает под экран
SIDE_ROW_Y = 737 -- как нижняя полоса gp_inv_pause (ед. player_dialog)
SIDE_ROW_CY = SIDE_ROW_Y + 10.5 -- средняя линия нижней полосы

function side_resolve_btn(semantic)
    local s = tostring(semantic or "")
    local sl = s:lower()
    if sl == "lb" or sl == "rb" or sl == "l3" or sl == "r3" then
        return s
    end
    local fn = gp_bridge and gp_bridge.resolve_menu_button_for_hint
    if type(fn) == "function" then
        local ok, r = pcall(fn, s)
        if ok and type(r) == "string" and r ~= "" then return r end
    end
    return s
end

function side_scale_k()
    local ic = ic_mod()
    return (ic and type(ic.scale_k) == "function") and ic.scale_k() or 1.0
end

function side_hints_visible()
    local ic = ic_mod()
    return (not ic or type(ic.hints_visible) ~= "function") or ic.hints_visible("menu")
end

function side_icon_tex(semantic)
    local tok = side_resolve_btn(semantic)
    local ic = ic_mod()
    if ic and type(ic.tex) == "function" then
        local ok, t = pcall(ic.tex, tok, "round")
        if ok and type(t) == "string" and t ~= "" then return t end
    end
    return SIDE_TEX[tok] or SIDE_TEX[semantic] or SIDE_TEX.A
end

local function side_sync_shoulder_box(token)
    local ic = ic_mod()
    if ic and type(ic.dims) == "function" then
        local ok, _, _, tw, th = pcall(ic.dims, token or "lb", "round")
        if ok and tw and th and tw > 0 and th > 0 then
            local pad = tonumber(ic.PAD) or 3
            SIDE_SHOULDER_BOX.x1 = 128 * pad / tw
            SIDE_SHOULDER_BOX.y1 = 128 * pad / th
            SIDE_SHOULDER_BOX.x2 = 128 * (tw - pad) / tw
            SIDE_SHOULDER_BOX.y2 = 128 * (th - pad) / th
            SIDE_SHOULDER_BOX.cell = 128
            return SIDE_SHOULDER_BOX
        end
    end
    SIDE_SHOULDER_BOX.x1, SIDE_SHOULDER_BOX.y1, SIDE_SHOULDER_BOX.x2, SIDE_SHOULDER_BOX.y2, SIDE_SHOULDER_BOX.cell = 11.29, 13.71, 116.71, 114.29, 128
    return SIDE_SHOULDER_BOX
end

function side_icon_box_dims(semantic, base_h)
    local tok = side_resolve_btn(semantic)
    local dev = device and device()
    local sw = math.max(1, dev and dev.width or 2560)
    local shh = math.max(1, dev and dev.height or 1080)
    local sk = side_scale_k()
    local h = base_h * sk
    local ic = ic_mod()
    if ic and type(ic.dims) == "function" then
        local ok, _, _, tw, th = pcall(ic.dims, tok, "round")
        if ok and tw and th and th > 0 then
            local h_px = h * shh / 768
            local w_px = h_px * (tw / th)
            return w_px * 1024 / sw, h
        end
    end
    return SIDE_ICON_W * (h / math.max(1e-4, base_h)), h
end

local function side_pad()
    if gp_bridge and gp_bridge.is_gamepad_active then
        local ok, v = pcall(gp_bridge.is_gamepad_active)
        return ok and v == true
    end
    return false
end

local function side_metrics()
    local dev = device and device()
    local w = math.max(1, dev and dev.width or 2560)
    local h = math.max(1, dev and dev.height or 1080)
    local ux = h / 1080 * 1024 / w
    local px = al() and al().icon_px(SIDE_ICON_PX) or SIDE_ICON_PX * h / 1080
    SIDE_ICON_W = px * 1024 / w
    return px * 768 / h, 9.0 * ux, ux
end

function side_line(cy, ih, bh, font)
    local a = al()
    local y = a and a.snap_y(cy - ih * 0.5) or (cy - ih * 0.5)
    local mid = y + ih * 0.5
    local ty = a and a.label_y(mid, bh, font or SIDE_FONT) or (mid - bh * 0.5)
    return y, ty
end

local function side_set_tex(s, tex)
    if not s or not tex or s._gp_tex == tex then return end
    s:InitTexture(tex)
    s._gp_tex = tex
end

local function side_static(gui, tex)
    local s = CUIStatic()
    s:SetAutoDelete(true)
    s:Enable(false)
    s:SetStretchTexture(true)
    if tex then side_set_tex(s, tex) end
    gui:AttachChild(s)
    return s
end

local function side_text(gui)
    local s = CUITextWnd()
    s:SetAutoDelete(true)
    s:Enable(false)
    local fnt = GetFontLetterica18Russian and GetFontLetterica18Russian()
    if fnt then s:SetFont(fnt) end
    s:SetTextColor(GetARGB(235, 220, 220, 220))
    pcall(s.SetVTextAlignment, s, 1) -- valCenter
    gui:AttachChild(s)
    return s
end

local function place(s, x, y, w, h)
    s:SetWndPos(vector2():set(x, y))
    s:SetWndSize(vector2():set(math.max(w, 1), math.max(h, 1)))
    s:Show(true)
end

local function side_widgets(gui)
    local sh = state.side
    if sh and rawequal(sh.gui, gui) then return sh end
    sh = { gui = gui, rb = side_static(gui, side_icon_tex("rb")), lb = side_static(gui, side_icon_tex("lb")), icons = {}, texts = {} }
    for i = 1, SIDE_MAX_SLOTS do
        sh.icons[i] = side_static(gui, nil)
        sh.texts[i] = side_text(gui)
    end
    sh.meas = side_text(gui) -- невидимый: мерить ширину подписей
    sh.meas:Show(false)
    state.side = sh
    return sh
end

local function side_restore_weights()
    local saved = state.side_wsaved
    if not saved then return end
    for w, orig in pairs(saved) do
        if w then
            if orig.pos and w.SetWndPos then pcall(w.SetWndPos, w, vector2():set(orig.pos.x, orig.pos.y)) end
            if orig.w and orig.h and w.SetWndSize then pcall(w.SetWndSize, w, vector2():set(orig.w, orig.h)) end
            if orig.align and w.SetTextAlignment then pcall(w.SetTextAlignment, w, orig.align) end
            if orig.cap and orig.cap.Show then pcall(orig.cap.Show, orig.cap, true) end
            if orig.maxw and orig.maxw.Show then pcall(orig.maxw.Show, orig.maxw, true) end
        end
    end
    state.side_wsaved = nil
    state.side_wdone = nil
end

function side_hide(sh)
    side_restore_weights()
    stash_rename_hide(sh and sh.gui)
    if not sh then return false end
    sh.rb:Show(false)
    sh.lb:Show(false)
    for i = 1, #sh.icons do
        sh.icons[i]:Show(false)
        sh.texts[i]:Show(false)
    end
    sh.lb_rect = nil
    sh.a_rect = nil
    sh.x_rect = nil
    sh.view_rect = nil
    return true
end

local function side_btn_icon(gui, s, name, icon_h, key)
    local btn = name and gui[name]
    local r = btn and shown(btn) and parent_shown(gui, BTN_PARENT[name]) and widget_rect(btn)
    if not r then s:Show(false) return nil end
    local tex = side_icon_tex(key or "rb")
    side_set_tex(s, tex)
    side_sync_shoulder_box(key or "lb")
    local a = al()
    local k = (a and a.icon_scale and a.icon_scale(tex) or 1) * side_scale_k()
    local h = k > 1 and icon_h * k or math.min(icon_h, (r.y2 - r.y1) - 2)
    local sk = tonumber(side_scale_k()) or 1
    local w = side_icon_box_dims(key or "rb", h / math.max(1e-4, sk))
    if SIDE_PLATE_BTNS[name] and k > 1 then
        local x, y = side_plate_icon(r, h, w)
        place(s, x, y, w, h)
        return r, { x1 = x, y1 = y, x2 = x + w, y2 = y + h }
    end
    local cy = (r.y1 + r.y2) * 0.5 + (a and a.xmid_below(SIDE_BTN_FONT) or 0)
        + (SIDE_BTN_DY_PX[name] or 0) * 768 / ((device and device().height) or 1080)
    local x = a and a.snap_x(r.x1 + 6) or (r.x1 + 6)
    local y = side_line(cy, h, h)
    place(s, x, y, w, h)
    return r, { x1 = x, y1 = y, x2 = x + w, y2 = y + h }
end

function side_plate_icon(r, h, w)
    local dev = device and device()
    local sw = math.max(1, dev and dev.width or 2560)
    local shh = math.max(1, dev and dev.height or 1080)
    local b = SIDE_SHOULDER_BOX
    local cell_px = h * shh / 768
    local w_px = w and (w * sw / 1024) or cell_px
    local plate_px = (r.y2 - r.y1) * shh / 768
    local gap_px = math.max(0, (plate_px - cell_px * (b.y2 - b.y1) / b.cell) * 0.5)
    local cy = (r.y1 + r.y2) * 0.5 + ((b.cell - b.y1 - b.y2) * 0.5) * (h / b.cell)
    local a = al()
    local x = r.x1 + (gap_px - w_px * b.x1 / b.cell) * 1024 / sw
    if a then x = a.snap_x(x) end
    local y = side_line(cy, h, h)
    return x, y
end

function side_takeall_plate(gui)
    local btn = gui and gui.mode == "loot" and gui.npc_takeall
    if not btn or state.takeall_plate == btn then return false end
    if not pcall(btn.InitTexture, btn, SIDE_PLATE_TEX) then return false end
    pcall(btn.SetStretchTexture, btn, true)
    state.takeall_plate = btn
    return true
end

function side_label_w(tx, s, char_w)
    tx:SetText(s)
    tx:SetWndSize(vector2():set(0, math.max(1, tx:GetHeight())))
    pcall(tx.AdjustWidthToText, tx)
    local w = tx:GetWidth()
    if not w or w <= 0 then w = #s * char_w end
    return w
end

function side_fit(row, avail, char_w, ux, widths)
    ux = ux or 1
    local wf = type(char_w) == "function" and char_w or function(s) return #s * char_w end
    local txt, wide, tight = SIDE_TXT_PX * ux, SIDE_GAP_PX * ux, SIDE_TIGHT_PX * ux
    local function need(keep, short, gap)
        local n = 0
        for i, it in ipairs(row) do
            local iw = (type(widths) == "table" and widths[i]) or SIDE_ICON_W
            n = n + iw + (i > 1 and gap or 0)
            if i <= keep then n = n + txt + wf(short and (it[3] or it[2]) or it[2]) end
        end
        return n
    end
    if need(#row, false, wide) <= avail then return #row, false, wide end
    if need(#row, false, tight) <= avail then return #row, false, tight end
    for keep = #row, 0, -1 do
        if need(keep, true, tight) <= avail then return keep, true, tight end
    end
    return -1, true, tight
end

local function num(s)
    return s and tostring(s):match("%d+[%.,]?%d*")
end

local function txt_of(w)
    return w and w.GetText and w:GetText() or ""
end

function side_weight(value, cap, maxw, use_max, dialog)
    if not (value and value.SetText) then return false end
    state.side_wsaved = state.side_wsaved or {}
    if not state.side_wsaved[value] then
        local p0 = value.GetWndPos and value:GetWndPos()
        state.side_wsaved[value] = {
            pos = p0 and { x = p0.x, y = p0.y } or nil,
            w = value.GetWidth and value:GetWidth() or nil,
            h = value.GetHeight and value:GetHeight() or nil,
            cap = cap,
            maxw = maxw,
        }
    end
    local cur = txt_of(value)
    local done = cur:find("/", 1, true) ~= nil or (state.side_wdone and state.side_wdone[value] == cur)
    if not done then
        local v, m = num(cur), use_max and maxw and num(txt_of(maxw))
        if not v then return false end
        value:SetText(m and (v .. " / " .. m) or v)
    end
    if maxw then maxw:Show(false) end
    if cap then cap:Show(false) end
    if value.SetTextAlignment then pcall(value.SetTextAlignment, value, 0) end
    pcall(value.SetVTextAlignment, value, 1)
    local vp = value:GetWndPos()
    local bh = value:GetHeight()
    local tw = value:GetWidth()
    local vr = widget_rect(value)
    value:SetWndSize(vector2():set(0, bh))
    if pcall(value.AdjustWidthToText, value) and value:GetWidth() > 0 then tw = value:GetWidth() end
    local x = vp.x
    local dr = dialog and widget_rect(dialog)
    if dr then
        local dev = device and device()
        local ux = (dev and dev.height or 1080) / 1080 * 1024 / math.max(1, dev and dev.width or 1920)
        local right = math.min(dr.x2, UI_W) - SIDE_WEIGHT_PAD_PX * ux
        local parent_x = vr and (vr.x1 - vp.x) or dr.x1
        x = right - parent_x - tw
    end
    local _, ty = side_line(SIDE_ROW_CY, bh, bh, SIDE_WEIGHT_FONT)
    value:SetWndPos(vector2():set(x, ty))
    value:SetWndSize(vector2():set(math.max(1, tw + 2), bh))
    state.side_wdone = state.side_wdone or {}
    state.side_wdone[value] = txt_of(value)
    return true
end

local function translate_side_row(raw_row)
    local out = {}
    for i, it in ipairs(raw_row) do
        out[i] = { it[1], side_tr(it.id, it[2]), side_tr(it.short_id or it.id, it[3] or it[2]) }
    end
    return out
end

function side_build_row(gui)
    local base = SIDE_ROW[gui and gui.mode]
    if not base then return nil end
    if gui.mode == "repair" then
        local a_txt = repair_focus_a_label(gui)
        local y_long = state.desc_hidden and label("description") or side_tr(base[2].id, base[2][2])
        local y_short = state.desc_hidden and label("description") or side_tr(base[2].short_id or base[2].id, base[2][3] or y_long)
        local v_txt = side_tr(base[3].id, base[3][2])
        if state.panel == "tech" then
            return {
                { "A", a_txt, a_txt },
                { "Y", y_long, y_short },
                { "View", v_txt, v_txt },
                { "B", label("back"), label("back") },
            }
        end
        return {
            { "A", a_txt, a_txt },
            { "Y", y_long, y_short },
            { "View", v_txt, v_txt },
            { "X", side_tr(base[4].id, base[4][2]), side_tr(base[4].short_id or base[4].id, base[4][3] or base[4][2]) },
        }
    end
    local out = translate_side_row(base)
    if gui.mode == "trade" and trade_carts_nonempty(gui) then
        out[#out + 1] = { "L3", label("clear_cart"), label("clear_short") }
    elseif gui.mode == "loot" and stash_is_personal(gui) then
        out[#out + 1] = { "L3", label("rename_stash"), label("rename_stash") }
    end
    return out
end

function side_hints_sync(gui)
    local sh = state.side
    if is_two_side(gui) then side_takeall_plate(gui) end
    if not is_side_mode(gui) or not side_pad() or not side_hints_visible() then
        return side_hide(sh)
    end
    stash_rename_ui_sync(gui)
    local btns = SIDE_BTNS[gui.mode]
    sh = side_widgets(gui)
    local icon_h, char_w, ux = side_metrics()
    if btns then
        local _, lb_rect = side_btn_icon(gui, sh.lb, btns.lb, icon_h, "lb")
        sh.lb_rect = lb_rect
        sh._rb_r = side_btn_icon(gui, sh.rb, btns.rb, icon_h, "rb")
    else
        sh.lb:Show(false)
        sh.rb:Show(false)
        sh.lb_rect = nil
        sh._rb_r = nil
    end
    local rb_r = sh._rb_r
    pcall(side_weight, gui.player_weight, gui.player_weight_cap, gui.player_weight_max, true, gui.player_dialog)
    if gui.mode ~= "repair" then
        pcall(side_weight, gui.npc_weight, gui.npc_weight_cap, gui.npc_weight_max, gui.npc_is_companion == true,
            gui.npc_dialog)
    end
    local pd = widget_rect(gui.player_dialog)
    local wr = widget_rect(gui.player_weight)
    if not (pd and wr) then
        for i = 1, #sh.icons do sh.icons[i]:Show(false) sh.texts[i]:Show(false) end
        return false
    end
    local cy = pd.y1 + SIDE_ROW_CY
    local x = (gui.mode == "loot" and rb_r) and (rb_r.x2 + SIDE_TIGHT_PX * ux) or (pd.x1 + SIDE_PAD_PX * ux)
    local row = side_build_row(gui)
    if not row then
        for i = 1, #sh.icons do sh.icons[i]:Show(false) sh.texts[i]:Show(false) end
        return false
    end
    local widths, heights = {}, {}
    for i, it in ipairs(row) do
        widths[i], heights[i] = side_icon_box_dims(it[1], icon_h)
    end
    local limit = wr.x1 - SIDE_GAP_PX * ux
    local function meas(s) return side_label_w(sh.meas, s, char_w) end
    local keep, short, gap = side_fit(row, limit - x, meas, ux, widths)
    sh.a_rect, sh.x_rect, sh.view_rect = nil, nil, nil
    for i = 1, #sh.icons do
        local it = row[i]
        local ic, tx = sh.icons[i], sh.texts[i]
        if not it or keep < 0 then
            ic:Show(false) tx:Show(false)
        else
            local iw, ih = widths[i], heights[i]
            local y1, ty = side_line(cy, ih, ih)
            side_set_tex(ic, side_icon_tex(it[1]))
            if al() then x = al().snap_x(x) end
            place(ic, x, y1, iw, ih)
            if it[1] == "A" then
                sh.a_rect = { x1 = x, y1 = y1, x2 = x + iw, y2 = y1 + ih }
            elseif it[1] == "X" then
                sh.x_rect = { x1 = x, y1 = y1, x2 = x + iw, y2 = y1 + ih }
            elseif it[1] == "View" then
                sh.view_rect = { x1 = x, y1 = y1, x2 = x + iw, y2 = y1 + ih }
            end
            x = x + iw
            if i <= keep then
                local lbl = short and (it[3] or it[2]) or it[2]
                local w = meas(lbl)
                tx:SetText(lbl)
                place(tx, x + SIDE_TXT_PX * ux, ty, w + 2, ih)
                x = x + SIDE_TXT_PX * ux + w
            else
                tx:Show(false)
            end
            x = x + gap
        end
    end
    return true
end

function side_icon_rect(btn)
    local sh = state.side
    local r = sh and (tostring(btn) == "lb" and sh.lb_rect or tostring(btn) == "a" and sh.a_rect
        or tostring(btn) == "x" and sh.x_rect or tostring(btn) == "view" and sh.view_rect)
    if not r then return "" end
    return string.format("%.1f,%.1f,%.1f,%.1f", r.x1, r.y1, r.x2, r.y2)
end

-- Движок (StepInventoryButtons, кнопка View): true — нажатие ловим сами (короткое на отпускании, удержание 800 мс).
function view_hold_press()
    local gui = get_gui()
    if modal_open(gui) then return false end
    return is_active()
end

-- FIX-LIVE2 п.32 (Миша 2026-11-16): в своём рюкзаке удержание View открывает КПК (рюкзак закрывается,
-- КПК достаётся, когда руки освободятся); прежний переход к характеристикам — LB + View (view_lb_chord).
-- В обыске/торговле/ремонте удержание View по-прежнему ведёт к характеристикам.
function view_hold_fire()
    local gui = get_gui()
    if not gui or modal_open(gui) then return "panel:0" end
    if state.panel == "stats" or state.panel == "picker" then return view_return(gui) end
    if gui.mode == "inventory" then
        request_pda()
        if gui.Close then pcall(gui.Close, gui) end
        return "panel:0"
    end
    return view_lb_chord()
end

-- C++ StepInventoryButtons: LB + View в рюкзаке.
function view_lb_chord()
    local gui = get_gui()
    if not gui or modal_open(gui) then return "panel:0" end
    if state.panel == "stats" or state.panel == "picker" then return view_return(gui) end
    local dest = picker_shown(gui) and "picker" or "stats"
    local t = first_target(gui, dest)
    if not t then
        deny()
        return "panel:0"
    end
    state.view_ret = remember_spot(gui)
    return goto_panel(gui, dest, t)
end

-- INV-REWORK-15 (решение Миши 2026-11-12, макет docs/ui/mockups/inv-rework/view-hold/index.html, вариант 4
-- «Уголки»; INV-REWORK-17 — две вертикальные полоски по бокам панели, растут от центра вверх и вниз):
-- анимация удержания View рисуется у панели характеристик или меню стопки, а не на ячейке. Движок спрашивает прямоугольник при нажатии View: "x1,y1,x2,y2" в ед. UI или nil.
VIEW_RECT_PAD = 6

-- FIX-LIVE2 п.32/33: отложенный КПК. pda_wait = { t0 = мс, hidden = рюкзак уже был закрыт }.
-- actor_on_update ждёт, пока рюкзак закрыт и lam2 (анимации FDDA) свободен, затем gp_field.on_3d_pda_tap(true).
-- Сброс: смерть, повторное открытие рюкзака после закрытия, PDA_WAIT_MAX_MS.
pda_wait = nil
PDA_WAIT_MAX_MS = 6000

local function lam2_mod()
    return rawget(_G, "lam2")
end

local function inv_shown(gui)
    if not gui or not gui.IsShown then return false end
    local ok, s = pcall(gui.IsShown, gui)
    return ok and s and true or false
end

-- true, пока FDDA проигрывает закрытие рюкзака (имя фазы backpack_close; тег у всех фаз — backpack_open).
function backpack_closing()
    local l = lam2_mod()
    if not l or not l.get_current_action then return false end
    local ok, a = pcall(l.get_current_action)
    if not ok or type(a) ~= "table" then return false end
    if a.name == "backpack_close" then return true end
    return a.name == "backpack_idle" and not inv_shown(get_gui())
end

function request_pda()
    pda_wait = { t0 = now_ms(), hidden = false }
    return true
end

-- C++ мировой View (PdaFullToggle) на нажатии: true -> жест «коротко = рюкзак, удержание = КПК».
function view_world_press()
    return backpack_closing()
end

function view_world_hold()
    return request_pda()
end

-- FIX-LIVE3 п.19 (Миша 2026-11-16): мировой View открыл рюкзак сразу (идёт анимация backpack_open), а кнопку
-- держат 0,4 с -> закрыть рюкзак и открыть КПК, когда руки освободятся. C++ зовёт по сырой маске View.
function view_world_hold_late()
    local actor = db and db.actor
    if not actor then return false end
    request_pda()
    pda_wait.close_inv = true
    local gui = get_gui()
    if inv_shown(gui) and gui.Close then pcall(gui.Close, gui) end
    return true
end

function pda_wait_tick()
    local w = pda_wait
    if not w then return "idle" end
    local actor = db and db.actor
    if not actor then pda_wait = nil; return "cancel:no_actor" end
    if actor.alive then
        local ok, alive = pcall(actor.alive, actor)
        if ok and not alive then pda_wait = nil; return "cancel:dead" end
    end
    if now_ms() - (w.t0 or 0) > PDA_WAIT_MAX_MS then pda_wait = nil; return "cancel:timeout" end
    if inv_shown(get_gui()) then
        if w.hidden then pda_wait = nil; return "cancel:reopened" end
        if w.close_inv then
            -- п.19: рюкзак открылся позже удержания View (окно ещё не успело появиться) — закрываем его
            local gui = get_gui()
            if gui and gui.Close then pcall(gui.Close, gui) end
        end
        return "wait:inventory"
    end
    w.hidden = true
    local l = lam2_mod()
    if l and l.is_running then
        local ok, run = pcall(l.is_running)
        if ok and run then return "wait:hands" end
    end
    pda_wait = nil
    if gp_field and gp_field.on_3d_pda_tap then pcall(gp_field.on_3d_pda_tap, true) end
    return "fire"
end

function actor_on_update()
    if pda_wait then pda_wait_tick() end
end

function on_game_start()
    if RegisterScriptCallback then RegisterScriptCallback("actor_on_update", actor_on_update) end
end

function view_hold_rect()
    local gui = get_gui()
    if not gui then return nil end
    local dest = state.panel
    if dest ~= "stats" and dest ~= "picker" then dest = picker_shown(gui) and "picker" or "stats" end
    local x1, y1, x2, y2
    local function add(r)
        if not r then return end
        x1 = math.min(x1 or r.x1, r.x1); y1 = math.min(y1 or r.y1, r.y1)
        x2 = math.max(x2 or r.x2, r.x2); y2 = math.max(y2 or r.y2, r.y2)
    end
    if dest == "stats" then
        for _, t in ipairs(collect_stat_targets(gui)) do add(t) end
    else
        local cc = gui.CC and gui.CC.picker
        if cc and type(cc.cell) == "table" then
            for _, ci in pairs(cc.cell) do
                if ci and ci.cell and (not ci.IsShown or shown(ci)) then add(widget_rect(ci.cell)) end
            end
        end
    end
    if not x1 then return nil end
    return string.format("%.1f,%.1f,%.1f,%.1f", x1 - VIEW_RECT_PAD, y1 - VIEW_RECT_PAD, x2 + VIEW_RECT_PAD, y2 + VIEW_RECT_PAD)
end

-- INV-REWORK-17 п.6 (Миша 2026-11-12): удержание A/View — кольцо и вокруг значка кнопки в нижней строке
-- подсказок у веса (ui_gp_inv_footer: badges[1] = A «Использовать/Действие», badges[6] = View «Раздел»).
-- Движок спрашивает при нажатии: "x1,y1,x2,y2" в ед. UI или "" (строки нет/скрыта).
HOLD_ICON_BADGE = { a = 1, view = 6, x = 3 } -- INV-REWORK-19: X = badges[3] (ui_gp_inv_footer: слоты A,Y,X,View = 1,2,3,6)

function hold_icon_rect(btn)
    if tostring(btn) == "lb" then return side_icon_rect("lb") end
    if tostring(btn) == "a" and is_side_mode(get_gui()) then return side_icon_rect("a") end
    if tostring(btn) == "x" and is_side_mode(get_gui()) then return side_icon_rect("x") end
    if tostring(btn) == "view" and is_side_mode(get_gui()) then return side_icon_rect("view") end
    local gui = get_gui()
    local h = gui and gui._gp_inline_hints
    local f = type(h) == "table" and h.pixel_footer
    local i = HOLD_ICON_BADGE[tostring(btn)]
    local w = i and type(f) == "table" and type(f.badges) == "table" and f.badges[i]
    local r = w and widget_rect(w)
    if not r then return "" end
    return string.format("%.1f,%.1f,%.1f,%.1f", r.x1, r.y1, r.x2, r.y2)
end

-- B в характеристиках или в левой панели техника: назад к предмету, инвентарь не закрывать ("panel:return").
function view_back()
    local gui = get_gui()
    if not gui then return nil end
    if gui.mode == "repair" and state.panel == "tech" then
        repair_return_from_tech(gui)
        return "panel:return"
    end
    if state.panel ~= "stats" then return nil end
    view_return(gui)
    return "panel:return"
end

-- B закрыл меню стопки, в которое рамка вошла удержанием View: вернуть рамку.
function view_after_picker_closed()
    local gui = get_gui()
    if not gui or not state.view_ret or state.panel ~= "picker" then return false end
    return view_return(gui) ~= "panel:0"
end

-- INV-REWORK-14 (п.4): мышь -> геймпад: рамка сразу на ближайший к курсору предмет любого раздела.
function nearest_any(gui, x, y, panels)
    local saved = state.panel
    local best, best_p, best_d = nil, nil, nil
    for _, p in ipairs(panels or PANEL_ORDER) do
        if p ~= "picker" or picker_shown(gui) then
            state.panel = p
            local t = nearest_target(gui, x, y)
            if t then
                local d = (t.mx - x) ^ 2 + (t.my - y) ^ 2
                if not best_d or d < best_d then best, best_p, best_d = t, p, d end
            end
        end
    end
    state.panel = saved
    return best, best_p
end

SOURCE_SNAP_PANELS = { "inv" }

local function clear_transient_holds()
    state.pending_confirm = nil
    state.pending_belt = nil
    state.pick = nil
    state.hold_source = nil
    state.x_source = nil
    state.lb_hold = nil
    state.stash_rename = nil
    state.reopen = nil
    if qty_dlg_cancel then qty_dlg_cancel() end
    if wpn_dlg_cancel then wpn_dlg_cancel() end
    clear_pick_highlights()
    clear_hover_highlights()
end

function on_source_changed(src)
    if src ~= "gamepad" then
        clear_transient_holds()
        return false
    end
    if not ENABLED then return false end
    local gui = get_gui()
    if not gui or state.pick then return false end
    local x, y = cursor_xy()
    -- INV-REWORK-15 (п.3, Миша 2026-11-12): только рюкзак — не снаряжение и не характеристики
    local t, p = nearest_any(gui, x, y, SOURCE_SNAP_PANELS)
    if not t then return false end
    state.panel = p
    move_cursor(t.mx, t.my)
    state.source_snaps = (state.source_snaps or 0) + 1
    return true
end

-- ---------------------------------------------------------------------------
-- Одинарное A (решение Миши: перекладывания нет, надеть/снять/использовать/перенести — одно нажатие A)
-- ---------------------------------------------------------------------------

function single_a_enabled()
    return ENABLED == true and is_gamepad()
end

-- The engine delays A until release, matching the 800 ms menu hold timing.
function a_hold_press()
    local gui = get_gui()
    if on_msg_box_button("A") then
        state.hold_source = { msg = true }
        return true
    end
    if modal_open(gui) or (gui and gui.mode == "repair") then
        return false
    end
    if state.pick then
        -- INV-REWORK-12: A по слоту-цели (в т. ч. пустому) ловим сами: у пустой клетки нет предмета
        local scc, sidx = pick_slot_at(gui, cursor_xy())
        if scc then
            state.hold_source = { cc = scc, idx = sidx, slot = true }
            return true
        end
    end
    local h = gui and gui.hover
    local cc = h and gui.CC and gui.CC[h.bag]
    local ci = cc and cc.cell and cc.cell[h.idx]
    if not (ci and ci.ID and cc.GetObj) then return false end
    if is_two_side(gui) and not picker_shown(gui) then
        -- INV-REWORK-22: обыск/торговля - A переносит предмет (тап: один, удержание: все такие), не надевает
        state.hold_source = { cc = cc, idx = h.idx, id = ci.ID, bag = h.bag, side = true }
        return true
    end
    state.hold_source = { cc = cc, idx = h.idx, id = ci.ID }
    return true
end

-- INV-REWORK-22 (Миша 2026-11-12): в ящике/торговле A = перенос в другой ящик/корзину. Тап - один предмет
-- (UIInventory:Action_Move), удержание - все такие же (Action_Move_All). Надеть из ящика/у торговца - только меню X.
-- W4-TECH-SYS (В23, В25): тост с причиной при отказе (no_trade / перевес тайника) и диалог разрядки оружия в торговле.
function side_move(gui, src, all)
    local ci = src.cc.cell and src.cc.cell[src.idx]
    if not gui or not is_two_side(gui) or not ci or ci.ID ~= src.id then return deny() end
    local obj = src.cc:GetObj(src.idx)
    if not obj then return deny() end
    -- FIX-LIVE1 п.7: проверка «можно продать» только в торговле; в ящике IsTradable() без trade_profile всегда false
    -- и A в тайнике ложно писал «Тайник переполнен» (контекстное меню шло мимо этой проверки).
    if gui.mode == "trade" and ((ci.flags and ci.flags.no_trade) or (src.cc.IsTradable and not src.cc:IsTradable(obj))) then
        emit_move_deny_toast(gui, obj, src.bag, ci)
        return deny()
    end
    if not gui:Cond_Move(obj, src.bag) then
        emit_move_deny_toast(gui, obj, src.bag, ci)
        return deny()
    end
    if gui.mode == "trade" and (src.bag == "actor_trade_bag" or src.bag == "actor_bag")
        and weapon_has_ammo_or_mag(obj) then
        wpn_dlg_open(gui, src, all)
        return true
    end
    if all and gui.Cond_Childs and gui:Cond_Childs(obj, src.bag) then
        gui:Action_Move_All(obj, src.bag)
    else
        gui:Action_Move(obj, src.bag)
    end
    state.side_actions = (state.side_actions or 0) + 1
    state.last_side = all and "move_all" or "move"
    return true
end

function a_hold_tap()
    local src = state.hold_source
    state.hold_source = nil
    if not src then return false end
    if src.msg then return true end
    local gui = get_gui()
    if src.side then return side_move(gui, src, false) end
    if src.slot then
        state.pending_confirm = { cc = src.cc, idx = src.idx }
        return true
    end
    local ci = src.cc.cell and src.cc.cell[src.idx]
    if not gui or not ci or ci.ID ~= src.id then return deny() end
    state.pending_confirm = { cc = src.cc, idx = src.idx }
    return true
end

function a_hold_fire()
    local src = state.hold_source
    state.hold_source = nil
    if not src then return false end
    if src.msg then return true end
    if src.slot then
        -- удержание по слоту-цели в режиме выбора = то же, что нажатие
        state.pending_confirm = { cc = src.cc, idx = src.idx }
        return true
    end
    local gui = get_gui()
    if src.side then return side_move(gui, src, true) end
    local ci = src.cc.cell and src.cc.cell[src.idx]
    if not gui or gui.mode ~= "inventory" or not ci or ci.ID ~= src.id then return deny() end
    local obj = src.cc:GetObj(src.idx)
    local bag = src_bag(src.cc)
    local list = obj and apply_targets(gui, obj, bag) or {}
    if obj then
        for _, ft in ipairs(battery_force_targets(gui, obj, bag)) do list[#list + 1] = ft end
        list = filter_ammo_targets(obj, list)
    end
    local slots, slot_bag = nil, nil
    if obj then slots, slot_bag = slot_targets(gui, obj, bag) end
    if #list == 0 and not slots then return deny() end
    return start_pick(gui, obj, bag, list, slots, slot_bag)
end

-- ---------------------------------------------------------------------------
-- INV-REWORK-19 (Миша 2026-11-12): удержание X (1,0 с, пауза 300 мс, как у A) = дополнительное действие предмета.
-- Короткое X — родное меню предмета, но теперь на отпускании (решает движок: x_hold_press == true).
-- Строки берём из родного меню X: gp_bridge.collect_item_actions(obj, bag) — те же свойства
-- UIInventory.properties и порядок, что в UIInventory:InitProperties. В дополнительные НЕ входят:
--   основное (то, что делает A: use, to_slot, to_ruck, move, move_all, donate, свойство с useN_allow_db),
--   «применить к» (attach_1..3 — удержание A), выбросить (drop, drop_all — защита от случайного удержания),
--   «Подробно» и отладочные строки, установка подсумка/патронташа/скошенного прицела (удержание A),
--   служебные переключатели (избранное/мусор, автолутер, избранные детали).
-- Таблица действий по категориям: docs/kb/inv-hold-x-actions.md.
-- ---------------------------------------------------------------------------
X_STD_SKIP = { use = true, to_slot = true, to_ruck = true, move = true, move_all = true, donate = true,
    attach_1 = true, attach_2 = true, attach_3 = true, drop = true, drop_all = true }
X_FUNCTOR_SKIP = { ["ui_itm_details.menu_details"] = true, ["ui_debug_launcher.menu_cond_inc"] = true,
    ["ui_debug_launcher.menu_cond_dec"] = true, ["ui_debug_launcher.menu_release"] = true,
    -- «прикрепить подсумок / патронташ / скошенный прицел к ...» — «применить к», это удержание A (правила 8, 10, 11)
    ["mag_pouches.precond_install"] = true, ["speed_loaders.precond_install_rifle"] = true,
    ["speed_loaders.precond_install_shotgun"] = true, ["scripted_canted_irons.precond_install"] = true }
X_FUNCTOR_DISASSEMBLY = "item_parts.menu_disassembly"
X_SERVICE = { SP_fav = true, SP_junk = true, auto_looter_config_disassemble = true, auto_looter_config_loot = true,
    parts_favoriter = true, add_to_qaw = true }
X_TIER_SPECIFIC, X_TIER_DISASSEMBLY, X_TIER_SERVICE = 1, 2, 3

-- X сейчас привязана к «Контекстное меню» (по умолчанию да); иначе кнопку не перехватываем.
function x_binding_is_menu()
    local f = gp_bridge and gp_bridge.get_menu_action_for_button
    if type(f) ~= "function" then return true end
    local ok, act = pcall(f, "X", "button")
    if not ok then return true end
    return string.lower(tostring(act)) == "contextmenu"
end

-- Нажатие X: true — ждём (короткое откроет меню на отпускании, удержание сработает через x_hold_fire).
-- INV-REWORK-22: диагностика удержания X (Миша: «не работает», причина статически не найдена) - в лог пишем,
-- почему X не захвачена и что нашли при срабатывании. Префикс "[gp_inv_rework] xhold".
local function xlog(fmt, ...)
    if printf then pcall(printf, "[gp_inv_rework] xhold " .. fmt, ...) end
end

-- INV-REWORK-24 (Миша 2026-11-12: «удержание X у торговца и в ящике не работает»): те же правила в торговле
-- и обыске/ящике - одно доп. действие выполняется, несколько - родное меню только из доп. строк.
X_HOLD_MODES = { inventory = true, trade = true, loot = true }

function x_hold_press()
    state.x_source = nil
    local gui = get_gui()
    if not (ENABLED == true and gui and X_HOLD_MODES[gui.mode]) then
        xlog("press: skip (enabled=%s gui=%s mode=%s)", tostring(ENABLED), tostring(gui ~= nil), tostring(gui and gui.mode))
        return false
    end
    if state.pick or sheet_open() or gui.holding_ctrl or shown(gui.item_props) or modal_open(gui) then
        xlog("press: skip (pick=%s sheet=%s ctrl=%s props=%s)", tostring(state.pick ~= nil), tostring(sheet_open()),
            tostring(gui.holding_ctrl), tostring(shown(gui.item_props)))
        return false
    end
    if not x_binding_is_menu() then
        xlog("press: skip (X not bound to context menu)")
        return false
    end
    local h = gui.hover
    local cc = h and gui.CC and gui.CC[h.bag]
    local ci = cc and cc.cell and cc.cell[h.idx]
    if not (ci and ci.ID and cc.GetObj) then
        xlog("press: skip (no item under cursor, hover=%s)", tostring(h and h.bag))
        return false
    end
    state.x_source = { cc = cc, idx = h.idx, id = ci.ID }
    xlog("press: captured bag=%s idx=%s", tostring(h.bag), tostring(h.idx))
    return true
end

-- Короткое X отпущено до срабатывания: источник сбрасываем, меню откроет движок (inv_on_button_x).
function x_hold_tap()
    local had = state.x_source ~= nil
    state.x_source = nil
    return had
end

-- Ярус записи меню: nil — не дополнительное, 1 — особое действие предмета, 2 — разборка, 3 — служебное.
function x_entry_tier(gui, obj, bag, e)
    local id = tostring(e.id)
    if X_STD_SKIP[id] then return nil end
    local n = tonumber(id:match("^custom_(%d+)$"))
    if X_SERVICE[e.functor_name] then return X_TIER_SERVICE end
    if not n then return X_TIER_SPECIFIC end
    -- свойство с useN_allow_db — это двойной клик (A), не дополнительное
    if type(gui.DB_Custom) == "function" then
        local ok, db = pcall(gui.DB_Custom, gui, obj, bag, nil, n)
        if ok and db then return nil end
    end
    if e.kind == "ltx_custom" and SYS_GetParam then
        local ok, f = pcall(SYS_GetParam, 0, obj:section(), "use" .. n .. "_functor")
        if ok and f then
            if X_FUNCTOR_SKIP[f] then return nil end
            if f == X_FUNCTOR_DISASSEMBLY then return X_TIER_DISASSEMBLY end
        end
    end
    return X_TIER_SPECIFIC
end

-- Дополнительные действия предмета: записи gp_bridge.collect_item_actions с полем x_tier (1 или 2), в порядке меню.
function x_extras(gui, obj, bag)
    local collect = gp_bridge and gp_bridge.collect_item_actions
    if type(collect) ~= "function" then return {} end
    local ok, list = pcall(collect, obj, bag)
    local out = {}
    if not ok or type(list) ~= "table" then return out end
    for _, e in ipairs(list) do
        local tier = x_entry_tier(gui, obj, bag, e)
        if tier and tier < X_TIER_SERVICE then
            e.x_tier = tier
            out[#out + 1] = e
        end
    end
    return out
end

-- Правило выбора (предложение для Миши): одно особое действие — сразу; особых несколько — родное меню X только из
-- дополнительных строк; особых нет, а есть разборка — разборка; ничего — nil («нельзя»).
function x_choose(extras)
    local special = 0
    local first
    for _, e in ipairs(extras) do
        if e.x_tier == X_TIER_SPECIFIC then
            special = special + 1
            first = first or e
        end
    end
    if special == 1 then return "run", first end
    if special > 1 then return "menu", extras end
    return extras[1] and "run" or nil, extras[1]
end

-- Удержание X дошло до 1,0 с. Возвращает строку для движка: "x:..." или "ok:x_menu;cx=..;cy=.." (меню открыто).
-- INV-REWORK-20 (Миша 2026-11-12): разборка по удержанию X — всегда без предупреждения
-- «зажмите клавишу» (опция control/general/disassembly_warning: item_parts.script:86, zzz_dit.script:88);
-- мышью — как в игре. На время вызова ui_options.get отдаёт для этой опции false.
DIS_WARNING_OPT = "control/general/disassembly_warning"

function suppress_dis_warning()
    local uo = rawget(_G, "ui_options")
    if not (type(uo) == "table" and type(uo.get) == "function") then return function() end end
    local orig = uo.get
    uo.get = function(k, ...)
        if k == DIS_WARNING_OPT then return false end
        return orig(k, ...)
    end
    return function() uo.get = orig end
end

function x_hold_fire()
    local src = state.x_source
    state.x_source = nil
    if not src then return "x:none" end
    local gui = get_gui()
    local ci = src.cc.cell and src.cc.cell[src.idx]
    if not gui or not X_HOLD_MODES[gui.mode] or state.pick or sheet_open() or not ci or ci.ID ~= src.id then
        deny()
        return "x:deny"
    end
    local obj = src.cc:GetObj(src.idx)
    if not obj then
        deny()
        return "x:deny"
    end
    local bag = src_bag(src.cc)
    local extras = x_extras(gui, obj, bag)
    local how, e = x_choose(extras)
    xlog("fire: item=%s bag=%s extras=%d how=%s", tostring(obj:section()), tostring(bag), #extras, tostring(how))
    for _, x in ipairs(extras) do
        xlog("  extra id=%s kind=%s functor=%s tier=%s", tostring(x.id), tostring(x.kind), tostring(x.functor_name), tostring(x.x_tier))
    end
    if how == "run" then
        local inv = gp_bridge and gp_bridge.invoke_item_action
        local ok, res = false, nil
        if type(inv) == "function" then
            local restore = suppress_dis_warning()
            ok, res = pcall(inv, obj, e, bag)
            restore()
        end
        xlog("  run: ok=%s res=%s", tostring(ok), tostring(res))
        if ok and res == true then
            state.x_runs = (state.x_runs or 0) + 1
            state.x_last = tostring(e.functor_name or e.id)
            return "x:run;" .. state.x_last
        end
    elseif how == "menu" then
        local open = gp_bridge and gp_bridge.open_extras_menu
        local ok, res = false, nil
        if type(open) == "function" then ok, res = pcall(open, obj, src.cc, src.idx, e) end
        if ok and type(res) == "string" and res:find("^ok:x_menu") then
            state.x_menus = (state.x_menus or 0) + 1
            return res
        end
    end
    deny()
    return "x:deny"
end

-- INV-REWORK-12 (решения Миши 4a/4c, 2026-11-11): удержание A из рюкзака — выбор места рамкой:
--   оружие (и прочее, что надевается в слот) — слоты actor_equ; пустой — положить, занятый — заменить
--   (старый предмет в рюкзак). Тот же путь, что UIInventory:On_CC_DragDrop «Ruck to Slot»;
--   артефакт — доступные ячейки пояса actor_belt (без заглушки blocker_arty, UIInventory:UpdateBelt);
--   занятая — замена: старый в рюкзак, новый move_to_belt (движок кладёт его в конец пояса).
-- Возвращает набор индексов клеток {[idx]=true} и имя контейнера, или nil.
function belt_targets(gui)
    local belt = gui and gui.CC and gui.CC.actor_belt
    if not (belt and type(belt.cell) == "table") then return nil end
    local set, any = {}, false
    for i in pairs(belt.cell) do
        local b = gui.blocker_arty and gui.blocker_arty[i]
        if not (b and b.IsShown and b:IsShown()) then
            set[i] = true
            any = true
        end
    end
    if not any then return nil end
    return set, "actor_belt"
end

function slot_targets(gui, obj, bag)
    if bag ~= "actor_bag" or not (gui and gui.CC and obj and obj.section) then return nil end
    if is_kind(IsArtefact, obj) then return belt_targets(gui) end
    if not (gui.slot_cell and gui.CC.actor_equ) then return nil end
    if gui.Cond_Equip then
        local ok, r = pcall(gui.Cond_Equip, gui, obj, bag)
        if not (ok and r) then return nil end
    end
    local slot = tonumber(SYS_GetParam and SYS_GetParam(2, obj:section(), "slot") or nil)
    if not slot or slot < 0 then return nil end
    local set, any = {}, false
    for _, i in ipairs(gui.slot_cell[slot + 1] or {}) do
        set[i] = true
        any = true
    end
    if not any then return nil end
    return set, "actor_equ"
end

function is_pick_slot(bag, ci)
    local pk = state.pick
    return pk and pk.slots and bag == pk.slot_bag and ci and ci.indx and pk.slots[ci.indx] and true or false
end

-- Место-цель под курсором: cc, idx или nil.
function pick_slot_at(gui, x, y)
    local pk = state.pick
    local cc = pk and pk.slots and gui and gui.CC and gui.CC[pk.slot_bag]
    if not (cc and type(cc.cell) == "table") then return nil end
    for idx in pairs(pk.slots) do
        local ci = cc.cell[idx]
        local r = ci and ci.cell and widget_rect(ci.cell)
        if r and x >= r.x1 and x <= r.x2 and y >= r.y1 and y <= r.y2 then return cc, idx end
    end
    return nil
end

function do_slot(gui, src_id, idx, bag)
    bag = bag or "actor_equ"
    local obj = level and level.object_by_id and level.object_by_id(src_id)
    local cc = gui and gui.CC and gui.CC[bag]
    if not (obj and cc and db and db.actor) then return deny() end
    local ok = pcall(function()
        local obj_in = cc:GetObj(idx)
        if obj_in then db.actor:move_to_ruck(obj_in) end
        if bag == "actor_belt" and obj_in then
            -- INV-REWORK-13: пояс освобождается не в этом кадре (move_to_belt сразу после
            -- move_to_ruck не срабатывал: старый снимался, новый не вставал) -> через Update
            state.pending_belt = { id = src_id, at = now_ms() + BELT_RETRY_MS, tries = 0 }
        elseif bag == "actor_belt" then
            db.actor:move_to_belt(obj)
        else
            db.actor:move_to_slot(obj, idx)
        end
        if itms_manager and itms_manager.play_item_sound then itms_manager.play_item_sound(obj) end
    end)
    if not ok then return deny() end
    state.slot_moves = (state.slot_moves or 0) + 1
    return true
end

function on_confirm(cc, idx, orig_on_mouse1)
    local gui = cc and cc.owner or (ui_inventory and ui_inventory.GUI)
    if gui and gui.mode == "repair" then
        -- R7 + W4-TECH-SYS (В26): одиночный клик открывает дерево апгрейдов и переводит фокус к технику
        local res = orig_on_mouse1(cc, idx)
        repair_after_item_select(gui, cc, idx)
        return res
    end
    if cc.db then
        cc.db.tg = 0
        cc.db.idx = false
    end
    if cc.On_Select then cc:On_Select(idx) end
    state.single_a = state.single_a + 1
    -- CRASH-REPAIR 2026-11-11: действие (использовать/надеть) не выполняем внутри нажатия A —
    -- оно приходит из обработки геймпада движком; предмет может закрыть инвентарь и открыть
    -- другое окно (ремнабор -> UIRepair -> вылет). Выполняем в UIInventory:Update (как клик мышью).
    state.pending_confirm = { cc = cc, idx = idx }
    return nil
end

-- Выполнить отложенное действие A (вызывается из UIInventory:Update).
function weapon_has_free_slot(gui, cc, idx)
    local obj = cc and cc.GetObj and cc:GetObj(idx)
    if not is_kind(IsWeapon, obj) or cc.ID ~= "actor_bag" then return true end
    local slot = (SYS_GetParam(2, obj:section(), "slot") or -1) + 1
    local slots = gui.slot_cell and gui.slot_cell[slot] or {}
    local equ = gui.CC and gui.CC.actor_equ
    for _, i in ipairs(slots) do
        local ci = equ and equ.cell and equ.cell[i]
        if ci and ci.IsShown and not ci:IsShown() then return true end
    end
    return false
end

function drain_confirm()
    local p = state.pending_confirm
    if not p then return false end
    state.pending_confirm = nil
    local cc = p.cc
    local gui = cc.owner or (ui_inventory and ui_inventory.GUI)
    local acc, aidx = cc, p.idx
    if gui and not state.pick then
        open_picker(gui, cc, p.idx)
        -- REWORK-7: стак, выбранный LB/RB (зелёное выделение), вместо первого
        acc, aidx = pick_sel_target(gui, cc, p.idx)
    end
    if state.pick then
        pick_confirm(gui, cc, p.idx)
    elseif gui and prefer_attach(gui, acc, aidx) then
        -- обвес/прицел: родное «использовать» его не ставит (баг игры), ставим как перетаскивание
    elseif gui and not weapon_has_free_slot(gui, acc, aidx) then
        -- INV-REWORK-13 (Миша 2026-11-12): оба слота заняты -> замена в правом слоте
        weapon_replace_right(gui, acc, aidx)
    elseif gui and belt_full_pick(gui, acc, aidx) then
        -- INV-REWORK-13: артефакт при полном поясе -> сразу выбор ячейки (без удержания)
    elseif not gui or has_native_action(gui, acc, aidx) then
        if acc.Callback then
            acc:Callback("On_CC_Mouse1_DB", acc.ID, aidx)
        end
    else
        tap_apply(gui, acc, aidx)
    end
    if cc.db then
        cc.db.tg = 0
        cc.db.idx = false
    end
    return true
end

-- ---------------------------------------------------------------------------
-- INV-REWORK-4: нажатие A без родного действия (решения Миши 2026-11-11):
--   обвес/прицел/глушитель — на первое подходящее оружие (сначала в руках, потом слоты, потом рюкзак);
--   патроны — в первый подходящий магазин (не в оружие), магазин — в первое подходящее оружие;
--   батарейка — один подходящий прибор: заряжать сразу, несколько — выбор рамкой;
--   прочие пары (разборка, контейнеры и т. п.) — только выбором; нет действия — рамка «нельзя».
-- Совместимость и выполнение — gp_bridge.check_pair_compatibility_readonly / confirm_apply_to
-- (тот же путь, что UIInventory:On_CC_DragDrop).
-- ---------------------------------------------------------------------------

BATTERY_RULES = { item_device_battery = true, battery_force = true, item_exo_device_battery_psu = true, z_3dss_thermal_battery = true }
AUTO_RULES = { cond_attach = true, item_weapon_scope = true, scripted_canted_irons = true,
    magazines_drag_drop = true, speed_loaders = true, mag_pouches = true }
ATTACH_RULES = { cond_attach = true, item_weapon_scope = true, scripted_canted_irons = true }
SLOT_COUNT = 13

-- REWORK-5: A на стопке (несколько стаков) открывает меню стаков, действие идёт из первого стака;
-- в само меню — по View (раздел "picker"). Уже открытое меню другой ячейки закрываем.
function open_picker(gui, cc, idx)
    if cc.ID ~= "actor_bag" or type(gui.Picker_Toggle) ~= "function" then return false end
    local ci = type(cc.cell) == "table" and cc.cell[idx]
    if not (ci and ci.HasChild and ci:HasChild()) then return false end
    local pk = type(gui.CC) == "table" and gui.CC.picker
    if pk and shown(pk) and type(pk.parent) == "table" and pk.parent.bag == cc.ID and pk.parent.idx == idx then
        return true
    end
    if pk and shown(pk) and gui.Picker_Update then pcall(gui.Picker_Update, gui, true) end
    local ok = pcall(gui.Picker_Toggle, gui, cc.ID, idx)
    state.picker_opens = (state.picker_opens or 0) + 1
    if not picker_shown(gui) and pk then
        -- INV-REWORK-15 (п.5, Миша 2026-11-12): меню стопки на A всегда, если стаков больше одного.
        -- Родной Picker_Toggle (ui_inventory.script:2258) не открывает его для предметов без
        -- полоски состояния (еда, аптечки) — та же подготовка, что у него в конце (2267-2284).
        ok = pcall(force_picker, gui, cc, idx, ci, pk)
    end
    return ok and picker_shown(gui)
end

function force_picker(gui, cc, idx, ci, pk)
    local obj = level and level.object_by_id and level.object_by_id(ci.ID)
    if not obj or type(pk.Reinit) ~= "function" then return false end
    local t = { obj }
    for id in pairs(type(ci.childs) == "table" and ci.childs or {}) do
        local o = level.object_by_id(id)
        if o then t[#t + 1] = o end
    end
    if #t < 2 then return false end
    if gui.mode == "trade" and cc.trade_profile and dup_table then pk.trade_profile = dup_table(cc.trade_profile) end
    pk:Reinit(t)
    pk:Show(true)
    if type(pk.parent) ~= "table" then pk.parent = {} end
    pk.parent.bag = cc.ID
    pk.parent.idx = idx
    if time_global then gui.tg_m1 = time_global() end
    state.picker_forced = (state.picker_forced or 0) + 1
    return true
end

-- Сумка, из которой берётся предмет: ячейка меню стаков принадлежит ячейке рюкзака.
function src_bag(cc)
    if cc.ID == "picker" then
        return type(cc.parent) == "table" and cc.parent.bag or "actor_bag"
    end
    return cc.ID
end

-- Обвес/прицел/глушитель: сразу на первое подходящее оружие, раньше родного действия.
function prefer_attach(gui, cc, idx)
    local bag = src_bag(cc)
    if gui.mode ~= "inventory" or (bag ~= "actor_bag" and bag ~= "actor_equ") then return false end
    local ok, obj = pcall(function() return cc.GetObj and cc:GetObj(idx) end)
    if not ok or not obj then return false end
    -- Weapon as source must keep its native A equip action.
    if is_kind(IsWeapon, obj) then return false end
    local list = {}
    for _, t in ipairs(apply_targets(gui, obj, bag)) do
        if ATTACH_RULES[t.rule] then list[#list + 1] = t end
    end
    local t = scope_first_free(obj, list) or list[1]
    if t then return do_apply(obj:id(), bag, t) end
    return false
end

-- INV-REWORK-18 п.2 (Миша 2026-11-12): прицел, подходящий к обоим оружиям в слотах, надевается сначала
-- туда, где прицела ещё нет. Прицел в GAMMA — смена секции оружия: у оружия с прицелом section ~=
-- parent_section (item_weapon.attach_scope/detach_scope); для прицелов-аддонов — weapon_is_scope().
function is_scope_item(obj, t)
    if t and t.rule == "item_weapon_scope" then return true end
    local ok, cls = pcall(SYS_GetParam, 0, obj:section(), "class")
    return ok and cls == "WP_SCOPE"
end

function weapon_has_scope(o)
    if not o then return false end
    local sec = o:section()
    local ok, parent = pcall(SYS_GetParam, 0, sec, "parent_section")
    if ok and parent and parent ~= "" and parent ~= sec then return true end
    if o.weapon_is_scope then
        local okw, r = pcall(o.weapon_is_scope, o)
        if okw and r then return true end
    end
    return false
end

function scope_first_free(obj, list)
    if not (list[1] and is_scope_item(obj, list[1])) then return nil end
    for _, t in ipairs(list) do
        if t.bag == "actor_equ" and t.obj and not weapon_has_scope(t.obj) then return t end
    end
    return nil
end

-- Магазин полон: patrons в magazine_binder (mags_storage) >= max_mag_size секции магазина.
function mag_full(o)
    local mb = rawget(_G, "magazine_binder")
    if not o or type(mb) ~= "table" or type(mb.get_data) ~= "function" then return false end
    local ok, full = pcall(function()
        local d = mb.get_data(o:id())
        if type(d) ~= "table" or type(d.loaded) ~= "table" then return false end
        local cap = tonumber(SYS_GetParam(2, d.section or o:section(), "max_mag_size"))
        return cap ~= nil and #d.loaded >= cap
    end)
    return ok and full == true
end

-- REWORK-7 (решение Миши 2026-11-12): LB/RB при открытом меню стаков двигают СВОЁ зелёное выделение
-- по стакам (по порядку слева направо), рамка стиком остаётся где была; A на этой же стопке в рюкзаке
-- берёт выбранный стак. Выделение помнит владельца меню (сумка:ячейка) и id предмета стака.
local function picker_of(gui)
    local pk = gui and type(gui.CC) == "table" and gui.CC.picker
    if pk and shown(pk) and type(pk.cell) == "table" then return pk end
    return nil
end

local function picker_owner(pk)
    local p = type(pk.parent) == "table" and pk.parent or {}
    if not p.bag or not p.idx then return nil, nil end
    return tostring(p.bag) .. ":" .. tostring(p.idx), p
end

-- id предмета первого стака (его подсвечивает зелёным сама игра, UIInventory:Picker_Update)
local function owner_stack_id(gui, p)
    local cc = p and type(gui.CC) == "table" and gui.CC[p.bag]
    local ci = cc and type(cc.cell) == "table" and cc.cell[p.idx]
    return ci and ci.ID or nil
end

function picker_step(d)
    local gui = get_gui()
    local pk = picker_of(gui)
    if not pk then return "picker:0" end
    local list = {}
    for idx, ci in pairs(pk.cell) do
        if ci and ci.ID and ci.cell and cell_is_target(pk, ci) and (not ci.IsShown or shown(ci)) then
            local r = widget_rect(ci.cell)
            if r then list[#list + 1] = { idx = idx, id = ci.ID, mx = (r.x1 + r.x2) * 0.5, my = (r.y1 + r.y2) * 0.5 } end
        end
    end
    if #list == 0 then return "picker:0" end
    table.sort(list, function(a, b) if a.my ~= b.my then return a.my < b.my end return a.mx < b.mx end)
    local owner, p = picker_owner(pk)
    local sel = state.pick_sel
    local cur_id = (sel and sel.owner == owner) and sel.id or owner_stack_id(gui, p)
    local cur = nil
    for i, t in ipairs(list) do if t.id == cur_id then cur = i end end
    local i
    if cur then i = ((cur - 1 + d) % #list) + 1 else i = (d > 0) and 1 or #list end
    state.pick_sel = { owner = owner, id = list[i].id }
    state.picker_steps = (state.picker_steps or 0) + 1
    paint_pick_sel(gui)
    return string.format("picker:1;i=%d;n=%d;id=%s", i, #list, tostring(list[i].id))
end

-- Каждый кадр после UIInventory:Update (там игра снова красит первый стак): зелёный — только выбранный.
function paint_pick_sel(gui)
    local pk = picker_of(gui)
    local sel = state.pick_sel
    local owner, p = nil, nil
    if pk then owner, p = picker_owner(pk) end
    if sel and (not pk or sel.owner ~= owner or not (pk.GetCell_ID and pk:GetCell_ID(sel.id))) then
        state.pick_sel, sel = nil, nil
    end
    local painted = state.pick_painted
    if not sel then
        state.pick_painted = nil
        return false
    end
    local first = owner_stack_id(gui, p)
    local function hl(id, on)
        local ci = id and pk:GetCell_ID(id)
        if ci and ci.Highlight then ci:Highlight(on, "green") end
    end
    if painted and painted ~= sel.id and painted ~= first then hl(painted, false) end
    if first and first ~= sel.id then hl(first, false) end
    hl(sel.id, true)
    state.pick_painted = sel.id
    return true
end

-- A на стопке-владельце меню: ячейка выбранного стака в меню (иначе — та же ячейка рюкзака).
function pick_sel_target(gui, cc, idx)
    local pk = picker_of(gui)
    local sel = state.pick_sel
    if not pk or not sel or cc.ID == "picker" or not pk.GetCell_ID then return cc, idx end
    local owner = picker_owner(pk)
    if sel.owner ~= owner or owner ~= tostring(cc.ID) .. ":" .. tostring(idx) then return cc, idx end
    local pi = pk:GetCell_ID(sel.id, true)
    if not pi then return cc, idx end
    state.pick_sel_uses = (state.pick_sel_uses or 0) + 1
    return pk, pi
end

function charge_of(o)
    local ok, c = pcall(function() return o:condition() end)
    return ok and tonumber(c) or 1
end

function deny()
    state.denies = (state.denies or 0) + 1
    if game and game.gamepad_inv_focus_deny then pcall(game.gamepad_inv_focus_deny) end
    return false
end

-- Проверки свойства двойного клика как в On_CC_Mouse1_DB (ui_inventory.script:3672-3705).
function custom_allowed(gui, props, obj, bag)
    if props.cont and not props.cont[bag] then return false end
    local f = props.cont_func
    if f and f[1] and gui[f[1]] and not gui[f[1]](gui, obj, bag, unpack(f)) then return false end
    if props.mode and not props.mode[gui.mode] then return false end
    f = props.mode_func
    if f and f[1] and gui[f[1]] and not gui[f[1]](gui, obj, bag, unpack(f)) then return false end
    local k = 1
    while props["precondition" .. k] do
        local pc = props["precondition" .. k]
        if not (pc[1] and gui[pc[1]] and gui[pc[1]](gui, obj, bag, unpack(pc))) then return false end
        k = k + 1
    end
    return true
end

-- Есть ли у предмета действие двойного клика (как UIInventory:On_CC_Mouse1_DB). Ошибка — считаем, что есть.
function has_native_action(gui, cc, idx)
    local ok, res = pcall(function()
        if cc.ID == "actor_quick" then return true end
        local obj = cc.GetObj and cc:GetObj(idx)
        if not obj then return true end
        local bag = cc.ID
        if gui.Picker_Ownership then bag = gui:Picker_Ownership(bag, idx, obj) end
        if gui:Item_On_Mode("use", bag) and gui:Cond_Use(obj, bag) then return true end
        if gui:Item_On_Mode("to_slot", bag) and gui:Cond_Equip(obj, bag) then return true end
        if gui:Item_On_Mode("to_ruck", bag) then return true end
        if gui:Item_On_Mode("move", bag) and gui:Cond_Move(obj, bag) then return true end
        local props = type(gui.properties) == "table" and gui.properties or {}
        local i = 1
        while props["custom_" .. i] ~= nil do
            if gui.DB_Custom and gui:DB_Custom(obj, bag, nil, i) and custom_allowed(gui, props["custom_" .. i], obj, bag) then
                return true
            end
            i = i + 1
        end
        return false
    end)
    return (not ok) or res == true
end

-- Кандидаты по порядку: предмет в руках, слоты, рюкзак (ячейки по порядку).
function ordered_candidates(gui)
    local out, seen = {}, {}
    local function add(obj, bag)
        if not obj or type(obj.id) ~= "function" then return end
        local id = obj:id()
        if seen[id] then return end
        seen[id] = true
        out[#out + 1] = { obj = obj, bag = bag }
    end
    local actor = db and db.actor
    if actor then
        if actor.active_item then add(actor:active_item(), "actor_equ") end
        if actor.item_in_slot then
            for slot = 1, SLOT_COUNT do add(actor:item_in_slot(slot), "actor_equ") end
        end
    end
    local cc = gui and type(gui.CC) == "table" and gui.CC.actor_bag
    if cc and type(cc.cell) == "table" then
        local idxs = {}
        for idx in pairs(cc.cell) do if type(idx) == "number" then idxs[#idxs + 1] = idx end end
        table.sort(idxs)
        for _, idx in ipairs(idxs) do
            local ci = cc.cell[idx]
            if ci and ci.ID and level and level.object_by_id then add(level.object_by_id(ci.ID), "actor_bag") end
        end
    end
    return out
end

function apply_targets(gui, obj, bag)
    local list = {}
    local check = gp_bridge and gp_bridge.check_pair_compatibility_readonly
    if not check then return list end
    local src = obj:id()
    for _, c in ipairs(ordered_candidates(gui)) do
        if c.obj:id() ~= src then
            local ok, good, rule = pcall(check, obj, bag, c.obj, c.bag, gui)
            if ok and good then
                list[#list + 1] = { id = c.obj:id(), obj = c.obj, bag = c.bag, rule = tostring(rule) }
            end
        end
    end
    return list
end

function is_kind(fn, o)
    if type(fn) ~= "function" then return false end
    local ok, r = pcall(fn, o)
    return ok and r and true or false
end

-- Решение по списку целей: "apply" + цель, "pick" (выбор рамкой) или nil (делать нечего).
function choose_apply(obj, list)
    if #list == 0 then return nil end
    local first = list[1]
    if BATTERY_RULES[first.rule] then
        -- REWORK-5: сначала надетый прибор с наименьшим зарядом, иначе один — сразу, несколько — выбор
        local best, best_c = nil, nil
        for _, t in ipairs(list) do
            if BATTERY_RULES[t.rule] and t.bag == "actor_equ" and t.obj then
                local c = charge_of(t.obj)
                if not best_c or c < best_c then best, best_c = t, c end
            end
        end
        if best then return "apply", best end
        if #list == 1 then return "apply", first end
        return "pick", nil
    end
    local ammo = is_kind(IsAmmo, obj)
    for _, t in ipairs(list) do
        -- патроны — в магазин (не полный, REWORK-6), а не досылать в оружие
        if AUTO_RULES[t.rule] and not (ammo and (is_kind(IsWeapon, t.obj) or mag_full(t.obj))) then return "apply", t end
    end
    -- REWORK-7: патроны, а все магазины полны -> «нельзя» (тряска + вибрация), без выбора рамкой
    if ammo then return nil end
    return "pick", nil
end

function do_apply(src_id, src_bag, t)
    if t.rule == "battery_force" then
        local r = battery_swap(src_id, t)
        if r then remember_return(src_id, t) end
        return r
    end
    local reopen = false
    if t.rule == "magazines_drag_drop" then
        -- INV-REWORK-13: патроны -> магазин: после зарядки меню стопки патронов вернётся
        local so = level and level.object_by_id and level.object_by_id(src_id)
        if so and is_kind(IsAmmo, so) then remember_reopen(so:section()); reopen = true end
    end
    local fn = gp_bridge and gp_bridge.confirm_apply_to
    if not fn then return deny() end
    local ok, res, msg = pcall(fn, src_id, src_bag, t.id, t.bag)
    state.last_apply = tostring(msg or res)
    if not (ok and res) then return deny() end
    state.applies = (state.applies or 0) + 1
    if not reopen then remember_return(src_id, t) end
    return true
end

function tap_apply(gui, cc, idx)
    local bag = src_bag(cc)
    if gui.mode ~= "inventory" or (bag ~= "actor_bag" and bag ~= "actor_equ") then return deny() end
    local obj = cc.GetObj and cc:GetObj(idx)
    if not obj then return deny() end
    local list = apply_targets(gui, obj, bag)
    local how, t = choose_apply(obj, list)
    if how == "apply" then return do_apply(obj:id(), bag, t) end
    if how == "pick" then return start_pick(gui, obj, bag, list) end
    return deny()
end

-- Режим выбора цели (основа будущего удержания A): рамка только по целям, A — применить, B — отмена.
function clear_pick_highlights()
    for _, ci in ipairs(state.pick_highlights or {}) do
        if ci.Highlight then pcall(ci.Highlight, ci, false) end
    end
    state.pick_highlights = nil
end

-- INV-REWORK-14 (п.9): клетки снаряжения/пояса/быстрых слотов красятся «главным» цветом, как в
-- UIInventory:Highlight (use_main_clr) — иначе clr_list_hl на слоте почти не виден.
function main_clr(bag)
    return EQU_BAGS[bag] and true or false
end

-- INV-REWORK-15 (п.2, Миша 2026-11-12): на слоте снаряжения родной clr_list.blue (100,150,255) на тёмной
-- текстуре слота выходит тёмно-синим; нужен светлый голубой, как у выделения в рюкзаке.
SLOT_HL_RGB = { blue = { 170, 230, 255 }, green = { 170, 255, 200 } }

-- INV-REWORK-16 (Миша 2026-11-12): цвет выделения одинаковый везде, два варианта на выбор.
-- Вариант 1 (по умолчанию): как в рюкзаке — на слоты ставится текстура рюкзака ui_button_inv_h и
-- родной полупрозрачный clr_list_hl (utils_ui.script:67). Вариант 2 (опция «глубокий синий»,
-- ui_options_gamepad gp_inv_hl_deep): как на слотах INV10 — родная текстура слота + SLOT_HL_RGB,
-- а в рюкзаке ui_button_inv_h подкрашивается HL_DEEP_ARGB.
BAG_HL_TEX = "ui_button_inv_h"
HL_DEEP_ARGB = { blue = { 120, 70, 120, 220 }, green = { 120, 70, 210, 130 } }
local DET, WPN = "ui_inGame2_detector_highlighter", "ui_inGame2_weapon_highlighter"
local HELM = "ui_inGame2_helmet_highlighter"
HL_ORIG_TEX = {
    actor_equ = { DET, WPN, WPN, DET, DET, DET, "ui_inGame2_armor_highlighter", DET, DET, DET, DET, HELM, HELM },
    actor_belt = "ui_inGame2_artefakt_highlighter",
    actor_quick = "ui_inGame2_quick_item_highlighter",
}

function hl_deep()
    if ui_options and type(ui_options.get) == "function" then
        local ok, v = pcall(ui_options.get, "control/gamepad/gp_inv_hl_deep")
        if ok and v ~= nil then return v == true end
    end
    local cfg = axr_main and axr_main.config
    if not (cfg and cfg.r_value) then return false end
    local ok, v = pcall(cfg.r_value, cfg, "options", "control_gamepad_gp_inv_hl_deep", 1)
    return ok and (v == true or v == 1 or v == "true" or v == "1") or false
end

function orig_hl_tex(bag, idx)
    local t = HL_ORIG_TEX[bag]
    if type(t) == "table" then return t[tonumber(idx) or 0] end
    return t
end

function set_hl_tex(ci, tex)
    if not (tex and ci.hl and ci.hl.InitTexture) or ci._rw_tex == tex then return false end
    if ci._rw_tex == nil and tex ~= BAG_HL_TEX then return false end
    pcall(ci.hl.InitTexture, ci.hl, tex)
    ci._rw_tex = tex
    return true
end

function paint_hl(ci, clr, bag)
    local main = main_clr(bag)
    local deep = hl_deep()
    if main and not deep then
        set_hl_tex(ci, BAG_HL_TEX)
        pcall(ci.Highlight, ci, true, clr, false)
        return main
    end
    if main then set_hl_tex(ci, orig_hl_tex(bag, ci.indx)) end
    pcall(ci.Highlight, ci, true, clr, main)
    local c = main and SLOT_HL_RGB[clr]
    if c and ci.hl and ci.hl.SetTextureColor and GetARGB then
        pcall(ci.hl.SetTextureColor, ci.hl, GetARGB(255, c[1], c[2], c[3]))
    end
    local d = (not main) and deep and HL_DEEP_ARGB[clr]
    if d and ci.hl and ci.hl.SetTextureColor and GetARGB then
        pcall(ci.hl.SetTextureColor, ci.hl, GetARGB(d[1], d[2], d[3], d[4]))
    end
    return main
end

-- INV-REWORK-14 (п.7): в режиме выбора синим горят только цели; родные подсветки игры
-- («похожие предметы», itms_manager/magazines ActorMenu_on_item_focus_receive, слоты On_CC_Hover)
-- гасятся каждый кадр.
function paint_pick_highlights(gui)
    clear_pick_highlights()
    local pk = state.pick
    if not pk or not gui or type(gui.CC) ~= "table" then return false end
    local refs = {}
    for bag, cc in pairs(gui.CC) do
        if type(cc.cell) == "table" then
            local b = cc.ID or bag
            for _, ci in pairs(cc.cell) do
                if ci and ci.Highlight then
                    if (ci.ID and pk.targets[ci.ID]) or is_pick_slot(b, ci) then
                        paint_hl(ci, "blue", b)
                        refs[#refs + 1] = ci
                    elseif ci.ID and ci.ID == pk.src_id then
                        paint_hl(ci, "green", b)
                        refs[#refs + 1] = ci
                    else
                        pcall(ci.Highlight, ci, false)
                    end
                end
            end
        end
    end
    state.pick_highlights = refs
    return true
end

-- INV-REWORK-14 (п.1, решение Миши): с модом магазинов патроны по удержанию A идут только в
-- магазины — оружие (досылание патрона, magazines_drag_drop 9c) не цель. Без мода — как раньше.
function mags_mod()
    return (_G.magazines ~= nil or _G.magazine_binder ~= nil)
end

function is_magazine_obj(o)
    local mb = _G.magazine_binder
    local f = (mb and type(mb.is_magazine) == "function" and mb.is_magazine)
        or (_G.magazines and _G.magazines.is_magazine)
    return is_kind(f, o)
end

-- INV-REWORK-17 п.7 (Миша 2026-11-12): у Миши все магазины калибра заряжены, а удержание A всё равно
-- открывало выбор «зарядить» — a_hold_fire не отсеивал полные магазины (это делал только choose_apply
-- для тапа; в автотесте магазинов не было, поэтому там был отказ). Теперь полные магазины не цели:
-- пустой список -> deny() с вибрацией.
function filter_ammo_targets(obj, list)
    if not (mags_mod() and is_kind(IsAmmo, obj)) then return list end
    local out = {}
    for _, t in ipairs(list) do
        if not is_kind(IsWeapon, t.obj) and not mag_full(t.obj) then out[#out + 1] = t end
    end
    return out
end

-- INV-REWORK-14 (п.8, решение Миши): рамка на предмете без нажатий подсвечивает, куда его можно
-- применить: обвес -> оружие (слоты и рюкзак), патроны -> магазины (с модом магазинов).
-- Оружие -> обвес — родная механика игры (itms_manager), батарейки — нет.
HOVER_ATTACH_RULES = { cond_attach = true, item_weapon_scope = true, scripted_canted_irons = true }

function hover_targets(gui, obj, bag)
    local set = {}
    if not obj or is_kind(IsWeapon, obj) then return set end
    local ammo = is_kind(IsAmmo, obj)
    if ammo and not mags_mod() then return set end
    local check = gp_bridge and gp_bridge.check_pair_compatibility_readonly
    if not check then return set end
    local src = obj:id()
    for _, c in ipairs(ordered_candidates(gui)) do
        if c.obj:id() ~= src then
            local want
            if ammo then want = is_magazine_obj(c.obj) else want = is_kind(IsWeapon, c.obj) end
            if want and ammo and mag_full(c.obj) then want = false end -- INV-REWORK-17 п.7
            if want then
                local ok, good, rule = pcall(check, obj, bag, c.obj, c.bag, gui)
                if ok and good and ((ammo and rule == "magazines_drag_drop") or (not ammo and HOVER_ATTACH_RULES[rule])) then
                    set[c.obj:id()] = true
                end
            end
        end
    end
    return set
end

function clear_hover_highlights()
    for _, r in ipairs(state.hover_refs or {}) do
        if r.ci.Highlight then pcall(r.ci.Highlight, r.ci, false) end
    end
    state.hover_refs = nil
    state.hover_hl_id = nil
end

-- Каждый кадр после UIInventory:Update: цели пересчитываются только при смене предмета под рамкой,
-- перекрашиваются каждый кадр (родной UnHighlight_All при смене наведения их гасит).
function paint_hover_highlights(gui)
    if state.pick or not is_active() or gui.mode ~= "inventory" then
        if state.hover_refs then clear_hover_highlights() end
        return false
    end
    local id, bag = hovered_id(gui)
    if id ~= state.hover_hl_id then
        clear_hover_highlights()
        state.hover_hl_id = id
        local refs = {}
        local cc = id and gui.CC and gui.CC[bag]
        local obj = id and level and level.object_by_id and level.object_by_id(id)
        if obj and (bag == "actor_bag" or bag == "actor_equ") then
            local set = hover_targets(gui, obj, bag)
            if next(set) then
                for b, c in pairs(gui.CC) do
                    if type(c.cell) == "table" then
                        if type(c.indx_id) == "table" then
                            for target_id in pairs(set) do
                                local idx = c.indx_id[target_id]
                                local ci = idx and c.cell[idx]
                                if ci and ci.ID == target_id then
                                    refs[#refs + 1] = { ci = ci, main = main_clr(c.ID or b), bag = c.ID or b }
                                end
                            end
                        else
                            for _, ci in pairs(c.cell) do
                                if ci and ci.ID and set[ci.ID] then refs[#refs + 1] = { ci = ci, main = main_clr(c.ID or b), bag = c.ID or b } end
                            end
                        end
                    end
                end
            end
        end
        state.hover_refs = refs
    end
    for _, r in ipairs(state.hover_refs or {}) do
        if r.ci.Highlight then paint_hl(r.ci, "blue", r.bag) end
    end
    return true
end

function single_slot(slots)
    if type(slots) ~= "table" then return nil end
    local only, n = nil, 0
    for i in pairs(slots) do
        only, n = i, n + 1
        if n > 1 then return nil end
    end
    return only
end

function start_pick(gui, obj, bag, list, slots, slot_bag)
    -- INV-REWORK-15 (п.8, Миша 2026-11-12, «везде»): место всего одно (одна ячейка артефакта, один слот
    -- детектора/шлема...) и других целей нет -> сразу положить/заменить, без выбора рамкой.
    local only = single_slot(slots)
    if only and #list == 0 then
        state.single_slot_direct = (state.single_slot_direct or 0) + 1
        return do_slot(gui, obj:id(), only, slots and (slot_bag or "actor_equ"))
    end
    local targets = {}
    for _, t in ipairs(list) do targets[t.id] = t end
    state.pick = { src_id = obj:id(), src_bag = bag, targets = targets, slots = slots, slot_bag = slots and (slot_bag or "actor_equ") or nil }
    state.picks = (state.picks or 0) + 1
    paint_pick_highlights(gui)
    local t = nearest_target(gui, 0, 0)
    if t then move_cursor(t.mx, t.my) end
    return true
end

function cursor_xy()
    if GetCursorPosition then
        local ok, p = pcall(GetCursorPosition)
        if ok and p then return p.x, p.y end
    end
    return 0, 0
end

-- B в режиме выбора: выйти из выбора, инвентарь не закрывать.
function pick_cancel()
    state.reopen = nil
    if not state.pick then return false end
    state.pick = nil
    clear_pick_highlights()
    local gui = get_gui()
    local t = gui and nearest_target(gui, cursor_xy())
    if t then move_cursor(t.mx, t.my) end
    return true
end

function pick_confirm(gui, cc, idx)
    local pk = state.pick
    local ci = cc and type(cc.cell) == "table" and cc.cell[idx]
    if cc and pk.slots and cc.ID == pk.slot_bag and pk.slots[idx] then
        state.pick = nil
        clear_pick_highlights()
        return do_slot(gui, pk.src_id, idx, pk.slot_bag)
    end
    local t = ci and ci.ID and pk.targets[ci.ID]
    if not t then return deny() end
    state.pick = nil
    clear_pick_highlights()
    return do_apply(pk.src_id, pk.src_bag, t)
end

function install_update_hook()
    local cls = ui_inventory and ui_inventory.UIInventory
    if not cls or cls._rw_update_hooked or type(cls.Update) ~= "function" then return false end
    cls._rw_update_hooked = true
    local orig = cls.Update
    cls.Update = function(self, ...)
        local res = orig(self, ...)
        local ok, err = pcall(drain_confirm)
        if not ok and printf then printf("! [gp_inv_rework] drain_confirm: %s", tostring(err)) end
        pcall(paint_pick_sel, self)
        pcall(drain_belt)
        pcall(drain_reopen, self)
        pcall(drain_return, self)
        pcall(hint_sync, self)
        pcall(upgr_info_sync, self)
        pcall(full_stats_sync, self)
        pcall(drain_open_place, self)
        pcall(stash_rename_sync, self)
        pcall(qty_dlg_sync, self)
        pcall(wpn_dlg_sync, self)
        pcall(side_hints_sync, self)
        if state.pick then pcall(paint_pick_highlights, self) end
        pcall(paint_hover_highlights, self)
        return res
    end
    return true
end

-- Подпись A по предмету под рамкой (как в On_CC_Mouse1_DB).
function a_label(gui, bag, idx)
    if not gui then return label("action") end
    if gui.mode == "repair" then
        if bag == "npc_up_repair" then return label("repair") end
        if bag == "upx" then return label("install") end
        if not bag and state.panel == "tech" then return repair_focus_a_label(gui) end
        return label("select")
    end
    if state.pick and gui.CC and gui.CC[bag] then
        local ci = gui.CC[bag].cell and gui.CC[bag].cell[idx]
        if state.pick.slots and bag == state.pick.slot_bag and state.pick.slots[idx] then
            return label(ci and ci.ID and "replace" or "place")
        end
        local target = ci and ci.ID and state.pick.targets[ci.ID]
        if target then
            if BATTERY_RULES[target.rule] then return label("charge") end
            if target.rule == "magazines_drag_drop" then return label("load") end
            if ATTACH_RULES[target.rule] then return label("install") end
            if bag == "actor_equ" or bag == "actor_belt" or bag == "actor_quick" then return label("replace") end
            return label("apply")
        end
    end
    if not bag or not idx or type(gui.CC) ~= "table" or not gui.CC[bag] then return label("action") end
    local ok, key = pcall(function()
        local obj = gui.CC[bag]:GetObj(idx)
        if not obj then return "action" end
        if gui:Item_On_Mode("use", bag) and gui:Cond_Use(obj, bag) then return "use" end
        if gui:Item_On_Mode("to_slot", bag) and gui:Cond_Equip(obj, bag) then return "equip" end
        if gui:Item_On_Mode("to_ruck", bag) then return "unequip" end
        if gui:Item_On_Mode("move", bag) and gui:Cond_Move(obj, bag) then return "move" end
        return "action"
    end)
    return label(ok and key or "action")
end

function hovered_a_label(gui)
    if gui and gui.mode == "repair" and state.panel == "tech" then
        return repair_focus_a_label(gui)
    end
    local h = gui and gui.hover
    if type(h) == "table" and h.bag and h.idx then
        return a_label(gui, h.bag, h.idx)
    end
    return label("action")
end

-- ---------------------------------------------------------------------------
-- Описание предмета: Y, фиксированная высота, позиция слева от рамки, прокрутка
-- ---------------------------------------------------------------------------

function desc_should_hide()
    return state.desc_hidden == true and is_gamepad()
end

-- FIX-LIVE2 p.30 (Misha 2026-11-16, 30a): a card with its own Y flag (character creation, gp_new_game sets
-- info._gp_own_hide for the current opening) does not follow the inventory flag.
function info_hidden(info)
    if info and info._gp_own_hide ~= nil then return info._gp_own_hide == true and is_gamepad() end
    return desc_should_hide()
end

function toggle_desc()
    state.desc_hidden = not state.desc_hidden
    state.desc_toggles = state.desc_toggles + 1
    local gui = get_gui()
    if gui and gui.item_info and state.desc_hidden then
        pcall(gui.item_info.Update, gui.item_info)
    end
    if gui and state.desc_hidden and gui.SetHint then
        pcall(gui.SetHint, gui, false)
    end
    if gui and gui.item_info and not state.desc_hidden then
        -- запасной путь: пока описание не показано, родная задержка UIInfoItem (700 мс) отключена
        state.desc_force = true
        show_desc_now(gui)
    end
    if gui and gui.mode == "repair" then
        pcall(upgr_info_sync, gui)
    end
    return state.desc_hidden and "desc:hidden" or "desc:shown"
end

-- Y «показать»: описание предмета под рамкой появляется сразу и с начала текста.
-- Пока описание скрыто, UIInfoItem:Pass (utils_ui.script:2964) каждый кадр сбрасывает id/timer,
-- и родное появление ждало задержку/смену предмета (жалоба Миши 2026-11-11).
function show_desc_now(gui)
    local info = gui and gui.item_info
    local h = gui and gui.hover
    if not info or type(h) ~= "table" or not h.bag or not h.idx or type(gui.CC) ~= "table" then return false end
    local cc = gui.CC[h.bag]
    local ci = cc and type(cc.cell) == "table" and cc.cell[h.idx]
    if not ci or not (ci.ID or ci.section) then return false end
    info._rw = nil
    reset_stat_flags(info)
    info.id = nil
    info.section = nil
    info.timer = -1000000
    local obj = ci.ID and level and level.object_by_id and level.object_by_id(ci.ID) or nil
    local ok, err = pcall(info.Update, info, obj, ci.section, ci.flags)
    if not ok and printf then printf("! [gp_inv_rework] show_desc_now: %s", tostring(err)) end
    return ok
end

local function measure(desc, text)
    desc:SetText(text)
    desc:AdjustHeightToText()
    return desc:GetHeight()
end

-- Позиции начала строк описания (по пробелам, бинарным поиском по высоте текста).
function compute_line_starts(desc, text, line_h)
    local starts = { 1 }
    local spaces = {}
    for i = 1, #text do
        local c = text:byte(i)
        if c == 32 or c == 10 then spaces[#spaces + 1] = i end
    end
    local function lines(pos)
        return math.floor(measure(desc, text:sub(1, pos)) / line_h + 0.5)
    end
    local lo = 1
    local total = lines(#text)
    for line = 2, total do
        -- наименьший пробел, после которого начинается строка `line`
        local a, b, found = lo, #spaces, nil
        while a <= b do
            local m = math.floor((a + b) / 2)
            if lines(spaces[m] + 1) >= line then
                found = m
                b = m - 1
            else
                a = m + 1
            end
        end
        if not found then break end
        starts[#starts + 1] = spaces[found] + 1
        lo = found + 1
    end
    return starts
end

DESC_BLOCKS = { "weight", "stats_dialog", "ammo", "parts", "parts_txt", "recipes", "recipes_txt", "cooking", "cooking_txt" }
DESC_LABELS = { parts_txt = true, recipes_txt = true, cooking_txt = true }

-- INV-REWORK-7: движок режет текст и картинки по SetClipRect предка (UIStatic.cpp push_text_scissor,
-- метка game.gamepad_text_clip) -> описание едет попиксельно, строки обрезаются краем окна.
function clip_mode(info)
    return type(game) == "table" and type(game.gamepad_text_clip) == "function" and Frect ~= nil
        and info.desc.EnableClip ~= nil and info.desc.SetClipRect ~= nil
end

function set_clip(info, rw)
    local ws = { info.desc }
    for _, name in ipairs(DESC_BLOCKS) do
        if info[name] then ws[#ws + 1] = info[name] end
    end
    for _, w in ipairs(ws) do
        if w.EnableClip then w:EnableClip(rw.clip) end
    end
    rw.clip_ws = ws
    return rw.clip
end

-- Окно прокрутки в абсолютных координатах UI: ширина рамки, высота region_h от начала описания.
function update_clip(info, rw)
    if not rw.clip then return false end
    local r = widget_rect(info.desc)
    local f = widget_rect(info.frame)
    if not r or not f then return false end
    local y1 = r.y1 - info.desc:GetWndPos().y + rw.desc_y
    local rect = Frect():set(f.x1, y1, f.x2, y1 + rw.region_h)
    for _, w in ipairs(rw.clip_ws) do
        if w.SetClipRect then w:SetClipRect(rect) end
    end
    rw.clip_y1 = y1
    return true
end

local function capture(info)
    local rw = {}
    rw.key = tostring(info.id) .. ":" .. tostring(info.section)
    rw.offset = 0
    rw.text = info.desc:GetText() or ""
    rw.text_y = info.desc:GetWndPos().y
    rw.desc_y = rw.text_y
    if info.weight and shown(info.weight) then rw.desc_y = math.min(rw.desc_y, info.weight:GetWndPos().y) end
    -- Weight is part of the scrolling body; it moves and clips with the description.
    rw.header_shift = 0
    rw.desc_h = info.desc:GetHeight()
    rw.line_h = math.max(1, measure(info.desc, "W"))
    rw.blocks = {}
    -- INV-REWORK-4: блоки модов «детали» (zz_parts_in_tooltip) и «используется для крафта / готовки»
    -- (zzz_craft_use_in_tooltip_mcm) тоже листаются внутри окна; подписи *_txt высотой в одну строку
    for _, name in ipairs(DESC_BLOCKS) do
        local w = info[name]
        if w and shown(w) then
            local p = w:GetWndPos()
            local h = DESC_LABELS[name] and rw.line_h or w:GetHeight()
            rw.blocks[#rw.blocks + 1] = { name = name, w = w, x = p.x, y = p.y, h = h }
        end
    end
    local bottom = rw.text_y + rw.desc_h
    for _, b in ipairs(rw.blocks) do bottom = math.max(bottom, b.y + b.h) end
    rw.content_h = bottom - rw.desc_y
    rw.region_h = math.max(20, DESC_H - DESC_PAD - rw.desc_y)
    rw.overflow = rw.content_h > rw.region_h + 1
    rw.clip = (rw.overflow and clip_mode(info)) and true or false
    set_clip(info, rw)
    measure(info.desc, rw.text)
    if rw.overflow and not rw.clip and rw.desc_h > rw.region_h then
        rw.starts = compute_line_starts(info.desc, rw.text, rw.line_h)
        measure(info.desc, rw.text)
    end
    return rw
end

function apply_scroll(info, rw)
    local o = rw.offset
    local top, bottom = 0, rw.region_h
    if rw.clip then
        -- INV-REWORK-7: всё содержимое едет целиком, обрезку делает движок
        info.desc:SetWndPos(vector2():set(info.desc:GetWndPos().x, rw.text_y - o))
        info.desc:Show(true)
        for _, b in ipairs(rw.blocks) do
            local rel = b.y - rw.desc_y - o
            b.w:SetWndPos(vector2():set(b.x, rw.desc_y + rel))
            if b.name == "stats_dialog" and type(info.stats) == "table" then
                for _, st in ipairs(info.stats) do
                    if st.base and st._rw_shown == nil then st._rw_shown = shown(st.base) end
                    if st.base then st.base:Show(st._rw_shown and true or false) end
                end
            end
            b.w:Show(rel + b.h > top and rel < bottom)
        end
        update_clip(info, rw)
        return
    end
    -- Текст описания: показываем только строки, целиком попадающие в окно
    if rw.starts then
        local n = #rw.starts
        local first = math.min(n, math.ceil(o / rw.line_h - 0.001) + 1)
        local fit = math.max(1, math.floor((bottom - ((first - 1) * rw.line_h - o)) / rw.line_h + 0.001))
        local last = math.min(n, first + fit - 1)
        local s = rw.starts[first]
        local e = (last < n) and (rw.starts[last + 1] - 1) or #rw.text
        -- show_full_stats (LB): UIInfoItem:Update re-sets the full text every frame -> no cache
        if rw.shown_s ~= s or rw.shown_e ~= e or (ui_inventory and ui_inventory.show_full_stats) then
            rw.shown_s, rw.shown_e = s, e
            info.desc:SetText(rw.text:sub(s, e))
            info.desc:AdjustHeightToText()
            rw.relayouts = (rw.relayouts or 0) + 1
        end
        info.desc:SetWndPos(vector2():set(info.desc:GetWndPos().x, rw.text_y + (first - 1) * rw.line_h - o))
        info.desc:Show((first - 1) * rw.line_h - o >= top - 0.5)
    else
        info.desc:SetWndPos(vector2():set(info.desc:GetWndPos().x, rw.text_y - o))
        info.desc:Show(rw.desc_h - o > 0 and -o >= top - 0.5)
    end
    -- Блоки характеристик/патронов: сдвиг и скрытие строк вне окна
    for _, b in ipairs(rw.blocks) do
        local rel = b.y - rw.desc_y - o
        b.w:SetWndPos(vector2():set(b.x, rw.desc_y + rel))
        if b.name == "stats_dialog" and type(info.stats) == "table" then
            local any = false
            for _, st in ipairs(info.stats) do
                if st.base and st._rw_shown ~= nil or (st.base and shown(st.base)) then
                    if st._rw_shown == nil then st._rw_shown = shown(st.base) end
                    local py = st.base:GetWndPos().y
                    local ok = st._rw_shown and rel + py >= top and rel + py + st.base:GetHeight() <= bottom
                    st.base:Show(ok and true or false)
                    any = any or ok
                end
            end
            b.w:Show(any)
        else
            b.w:Show(rel >= top and rel + b.h <= bottom)
        end
    end
end

function reset_stat_flags(info)
    if type(info.stats) == "table" then
        for _, st in ipairs(info.stats) do st._rw_shown = nil end
    end
end

-- Верх полосы категорий (вкладки gui.sort_btn + рамка полосы с LT/RT): полоса рисуется поверх
-- описания, поэтому описание не опускается ниже неё (жалоба Миши 2026-11-11, скриншот 22:5x).
RAIL_MARGIN = 8

function rail_top(gui)
    if not gui or type(gui.sort_btn) ~= "table" then return nil end
    local top, x1, x2 = nil, nil, nil
    for _, btn in pairs(gui.sort_btn) do
        local r = widget_rect(btn)
        if r and on_screen(r) then
            if not top or r.y1 < top then top = r.y1 end
            x1 = math.min(x1 or r.x1, r.x1)
            x2 = math.max(x2 or r.x2, r.x2)
        end
    end
    if not top then return nil end
    -- LT/RT по краям полосы шире вкладок
    return top - RAIL_MARGIN, x1 - 60, x2 + 60
end

function place_desc(info, target)
    local w = info.frame:GetWidth()
    local h = info.frame:GetHeight()
    local x = target.x1 - DESC_GAP - w
    if x < 2 then x = target.x2 + DESC_GAP end
    if x + w > 1022 then x = math.max(2, 1022 - w) end
    local y = (target.y1 + target.y2) * 0.5 - h * 0.5
    local bottom = 766
    local rt, rx1, rx2 = rail_top(info.owner)
    if rt and rt - h >= 2 and x < rx2 and x + w > rx1 then bottom = rt end
    y = math.max(2, math.min(y, bottom - h))
    info.dialog:SetWndPos(vector2():set(x, y))
    return x, y
end

function current_target_rect(gui)
    -- INV-REWORK-17 п.4: в окне «Подробно» описание стоит у выделенного LB/RB значка
    if gui and gui._rw_sheet_rect then return gui._rw_sheet_rect end
    -- WS1: в верстаке описание стоит у рамки (gp_workshop.tick_ws пишет gui._rw_frame_rect)
    if gui and gui._rw_frame_rect then return gui._rw_frame_rect end
    local h = gui and gui.hover
    if type(h) == "table" and h.bag and h.idx and type(gui.CC) == "table" then
        local cc = gui.CC[h.bag]
        local ci = cc and type(cc.cell) == "table" and cc.cell[h.idx]
        local r = ci and widget_rect(ci.cell)
        if r then return r end
    end
    if GetCursorPosition then
        local ok, p = pcall(GetCursorPosition)
        if ok and p then return { x1 = p.x - 20, y1 = p.y - 20, x2 = p.x + 20, y2 = p.y + 20 } end
    end
    return nil
end

function layout_desc(info)
    local key = tostring(info.id) .. ":" .. tostring(info.section)
    if not info._rw or info._rw.key ~= key then
        reset_stat_flags(info)
        info._rw = capture(info)
    end
    local rw = info._rw
    info.frame:SetWndSize(vector2():set(info.frame:GetWidth(), DESC_H))
    if rw.overflow then
        rw.offset = math.max(0, math.min(rw.offset, math.max(0, rw.content_h - rw.region_h)))
        apply_scroll(info, rw)
    end
    local t = current_target_rect(info.owner)
    if t then place_desc(info, t) end
    update_clip(info, rw)
    return rw
end

-- INV-REWORK-4: плавная прокрутка — скорость (ед. UI в секунду) при полном наклоне правого стика
DESC_SCROLL_SPEED = 260

-- Правый стик, каждый кадр (движок): смещение на наклон * скорость * время. Текст двигается
-- попиксельно, строки у краёв окна появляются/исчезают целиком (apply_scroll).
function desc_scroll_analog(y, dt)
    local gui = get_gui()
    if hint_scroll(gui, (tonumber(y) or 0) * DESC_SCROLL_SPEED * (tonumber(dt) or 0) / 1000) then return true end
    return info_scroll(gui and gui.item_info, y, dt)
end

-- FIX-LIVE2 p.30/31: smooth RS scroll of one item card (inventory or character creation). false = the card
-- is hidden (Y), absent or fits: the caller scrolls the list under the frame instead.
function info_scroll(info, y, dt)
    if not info or not is_gamepad() or info_hidden(info) or not info:IsShown() then return false end
    local rw = info._rw
    if not rw or not rw.overflow then return false end
    local max = rw.content_h - rw.region_h
    local o = rw.offset + (tonumber(y) or 0) * DESC_SCROLL_SPEED * (tonumber(dt) or 0) / 1000
    o = math.max(0, math.min(max, o))
    if math.abs(o - rw.offset) < 0.01 then return true end
    rw.offset = o
    apply_scroll(info, rw)
    return true
end

-- INV-REWORK-22 (Миша 2026-11-12): правый стик листает только тот список, над которым курсор, попиксельно.
-- Раньше стик слал колесо мыши: у края списка прокрутка "перетекала" в соседний список (торговца -> игрока),
-- шаг был ячейками. Теперь двигаем Scroll_SetPos контейнера под курсором на наклон * скорость * время;
-- true даже у края списка (стик забран, соседний не двигается). Над пустым местом - false (как раньше).
CC_SCROLL_SPEED = 520
CC_SCROLL_EASE_MS = 60

function cc_under_cursor(gui)
    if not gui or type(gui.CC) ~= "table" then return nil end
    -- FIX-LIVE2 p.31: the list of the framed cell first (the cursor point may sit on a cell border or on the
    -- card; then the wheel fallback stepped the list in jerks)
    local h = gui.hover
    local hc = type(h) == "table" and h.bag and gui.CC[h.bag]
    if type(hc) == "table" and hc.scroll and hc.Scroll_SetPos and shown(hc) then return hc end
    local cx, cy = cursor_xy()
    for _, cc in pairs(gui.CC) do
        if type(cc) == "table" and cc.scroll and cc.Scroll_SetPos and shown(cc) then
            local r = widget_rect(cc.scroll)
            if r and cx >= r.x1 and cx <= r.x2 and cy >= r.y1 and cy <= r.y2 then return cc end
        end
    end
    return nil
end

function cc_scroll_analog(y, dt)
    if not is_active() or state.pick then return false end
    local gui = get_gui()
    if not gui or picker_shown(gui) then return false end
    if gui.mode == "repair" and state.panel == "tech" then
        return tech_scroll_analog(gui, y, dt)
    end
    local cc = cc_under_cursor(gui)
    if not cc and gui.mode == "inventory" then
        -- FIX-LIVE3 п.23: рамка на снаряжении/кнопке — листаем сам рюкзак, а не «колесом мыши» рывками
        local bag = gui.CC.actor_bag
        if type(bag) == "table" and bag.scroll and bag.Scroll_SetPos and shown(bag) then cc = bag end
    end
    if not cc then return false end
    local sv = cc.scroll
    local cur = tonumber(cc.scroll_pos) or 0
    local acc = cc._gp_acc
    if not acc or math.abs(acc - cur) >= 1 then acc = cur; cc._gp_vel = 0 end
    local mn = tonumber(sv:GetMinScrollPos()) or 0
    local mx = tonumber(sv:GetMaxScrollPos()) or 0
    -- FIX-LIVE3 п.23: скорость разгоняется и тормозит за ~60 мс (без скачка на первом кадре)
    local d = tonumber(dt) or 0
    local target = (tonumber(y) or 0) * CC_SCROLL_SPEED
    local vel = tonumber(cc._gp_vel) or 0
    if (vel > 0 and target < 0) or (vel < 0 and target > 0) then vel = 0 end
    vel = vel + (target - vel) * math.min(1, d / CC_SCROLL_EASE_MS)
    cc._gp_vel = vel
    acc = math.max(mn, math.min(mx, acc + vel * d / 1000))
    cc._gp_acc = acc
    if math.floor(acc) ~= cur then
        cc:Scroll_SetPos(acc)
        -- родной On_Scroll «усиливает» любое расхождение позиций на целый ряд: держим его паузу 25 мс
        if type(_G.get_time) == "function" then cc.scroll_tg = _G.get_time() end
        local real = tonumber(sv.GetCurrentScrollPos and sv:GetCurrentScrollPos())
        if real and real ~= cc.scroll_pos then cc.scroll_pos = real end
    end
    return true
end

-- Правый стик: прокрутка описания, если оно показано и не влезает (иначе — рюкзак как раньше).
function desc_scroll(dir)
    local gui = get_gui()
    if state.hint and hint_scroll(gui, -(tonumber(dir) or 0) * state.hint.line_h * DESC_SCROLL_LINES) then return true end
    local info = gui and gui.item_info
    if not info or not is_gamepad() or desc_should_hide() or not info:IsShown() then return false end
    local rw = info._rw
    if not rw or not rw.overflow then return false end
    local step = rw.line_h * DESC_SCROLL_LINES
    local max = rw.content_h - rw.region_h
    local o = math.max(0, math.min(max, rw.offset - (tonumber(dir) or 0) * step))
    if o == rw.offset then return true end
    rw.offset = o
    apply_scroll(info, rw)
    return true
end

-- ---------------------------------------------------------------------------
-- INV-REWORK-14 (п.2, решение Миши 2026-11-12): «короткое» описание по макету
-- docs/ui/mockups/inv-rework/index.html:156 SZ.s = {w:440} на холсте 2000 px -> 440/2000*1024 = ~225 ед. UI.
-- Почему раньше не выходило: ширина менялась ПОСЛЕ родного UIInfoItem:Update — текст уже был перенесён
-- по старой ширине (desc:AdjustHeightToText), а блоки zz_parts_in_tooltip / zzz_craft_use_in_tooltip
-- считают свою ширину от frame:GetWidth() внутри Update. Теперь все части сужаются один раз ДО Update
-- (вложенные позиции x и ширины * k; значки — только позиция), родной Update пересчитывает высоты.
-- Мышь: restore_native возвращает записанные родные x/ширины, позиции, клип и показ строк.
-- ---------------------------------------------------------------------------
DESC_W = 225
NARROW_TOP = { "frame", "name", "weight", "value", "note", "desc", "stats_dialog", "ammo",
    "parts", "parts_txt", "recipes", "recipes_txt", "cooking", "cooking_txt" }
NARROW_STAT = { "cap", "bar1", "bar2", "txt", "comp" }

function narrow_items(info)
    local list = {}
    local function add(w, keep_w)
        if w and w.GetWndPos and w.SetWndPos then list[#list + 1] = { w = w, keep_w = keep_w } end
    end
    for _, n in ipairs(NARROW_TOP) do add(info[n], false) end
    for _, st in ipairs(type(info.stats) == "table" and info.stats or {}) do
        add(st.base, false)
        add(st.icon, true)
        for _, n in ipairs(NARROW_STAT) do add(st[n], false) end
    end
    add(info.ammo_cap, false)
    add(info.ammo_txt, false)
    for _, t in ipairs({ info.ammo_ico, info.ammo_ico_temp }) do
        if type(t) == "table" then
            for _, w in pairs(t) do add(w, true) end
        end
    end
    return list
end

function narrow_apply(info)
    if info._rw_narrow or not (info.frame and info.frame.GetWidth) then return false end
    local fw = info.frame:GetWidth()
    if not fw or fw <= DESC_W + 1 then return false end
    local k = DESC_W / fw
    local saved = {}
    for _, it in ipairs(narrow_items(info)) do
        local p = it.w:GetWndPos()
        local w = it.w.GetWidth and it.w:GetWidth() or 0
        saved[#saved + 1] = { w = it.w, x = p.x, width = w, keep_w = it.keep_w }
        it.w:SetWndPos(vector2():set(p.x * k, p.y))
        if not it.keep_w and it.w.SetWndSize and it.w.GetHeight then
            it.w:SetWndSize(vector2():set(w * k, it.w:GetHeight()))
        end
    end
    info._rw_narrow = { k = k, saved = saved }
    state.narrows = (state.narrows or 0) + 1
    return true
end

-- FIX-LIVE2 p.29 (Misha 2026-11-16, 29a): in the narrow gamepad card the stat names (stats_box:cap) were
-- scaled left onto their icons (icon keeps its width, cap x shrinks by k). Now the name starts right of its
-- icon (keeps its right edge) and a long name wraps to a second line; the rows below, stats_dialog and the
-- blocks under it (ammo, parts, recipes, cooking) move down. Runs once per rebuild of the card by
-- UIInfoItem:Update (stats_dialog height differs from the one we left), so the shift never doubles.
STAT_CAP_GAP = 3

function fix_stat_rows(info)
    local stats = info and info.stats
    local sd = info and info.stats_dialog
    if type(stats) ~= "table" or not (sd and sd.GetHeight and sd.SetWndSize) then return 0 end
    local sd_h = sd:GetHeight()
    if info._gp_rows_h and math.abs(info._gp_rows_h - sd_h) < 0.5 then return 0 end
    local extra = 0
    for _, st in ipairs(stats) do
        local base, icon, cap = st.base, st.icon, st.cap
        if base and icon and cap and shown(base) then
            if extra > 0 then
                local bp = base:GetWndPos()
                base:SetWndPos(vector2():set(bp.x, bp.y + extra))
            end
            st._gp_cap_h = st._gp_cap_h or cap:GetHeight()
            local cp, ip = cap:GetWndPos(), icon:GetWndPos()
            local right = cp.x + cap:GetWidth()
            local x = math.max(cp.x, ip.x + icon:GetWidth() + STAT_CAP_GAP)
            local width = math.max(10, right - x)
            cap:SetWndPos(vector2():set(x, cp.y))
            cap:SetWndSize(vector2():set(width, st._gp_cap_h))
            if cap.SetTextComplexMode and cap.AdjustHeightToText then
                if not st._gp_line_h then
                    local t = cap:GetText()
                    cap:SetTextComplexMode(true)
                    cap:SetText("Wg")
                    cap:AdjustHeightToText()
                    st._gp_line_h = cap:GetHeight()
                    cap:SetText(t or "")
                    cap:SetWndSize(vector2():set(width, st._gp_cap_h))
                end
                cap:AdjustHeightToText()
                local more = cap:GetHeight() - st._gp_line_h
                if more > 1 then
                    extra = extra + more
                    st._gp_wrapped = true
                else
                    cap:SetWndSize(vector2():set(width, st._gp_cap_h))
                    st._gp_wrapped = nil
                end
            end
        end
    end
    if extra > 0 then
        local p = sd:GetWndPos()
        local bottom = p.y + sd_h
        sd:SetWndSize(vector2():set(sd:GetWidth(), sd_h + extra))
        for _, name in ipairs(DESC_BLOCKS) do
            local w = info[name]
            if w and name ~= "stats_dialog" and name ~= "weight" and shown(w) then
                local wp = w:GetWndPos()
                if wp.y >= bottom - 1 then w:SetWndPos(vector2():set(wp.x, wp.y + extra)) end
            end
        end
    end
    info._gp_rows_h = sd:GetHeight()
    state.stat_wraps = extra
    return extra
end

-- mouse: native single-line names (positions and widths come back in narrow_restore)
function unfix_stat_rows(info)
    if not info or type(info.stats) ~= "table" then return false end
    for _, st in ipairs(info.stats) do
        local cap = st.cap
        if cap and st._gp_line_h then
            if cap.SetTextComplexMode then cap:SetTextComplexMode(false) end
            if st._gp_cap_h then cap:SetWndSize(vector2():set(cap:GetWidth(), st._gp_cap_h)) end
            st._gp_line_h, st._gp_wrapped = nil, nil
        end
    end
    info._gp_rows_h = nil
    return true
end

function narrow_restore(info)
    local n = info._rw_narrow
    if not n then return false end
    for _, s in ipairs(n.saved) do
        local p = s.w:GetWndPos()
        s.w:SetWndPos(vector2():set(s.x, p.y))
        if not s.keep_w and s.w.SetWndSize and s.w.GetHeight then
            s.w:SetWndSize(vector2():set(s.width, s.w:GetHeight()))
        end
    end
    info._rw_narrow = nil
    return true
end

-- Мышь после геймпада: родная раскладка целиком, затем полный пересчёт родным Update.
function restore_native(info)
    unfix_stat_rows(info)
    local rw = info._rw
    if rw then
        if info.desc and rw.text_y then
            info.desc:SetWndPos(vector2():set(info.desc:GetWndPos().x, rw.text_y))
        end
        for _, b in ipairs(rw.blocks or {}) do
            b.w:SetWndPos(vector2():set(b.x, b.y))
        end
    end
    for _, name in ipairs(DESC_BLOCKS) do
        local w = info[name]
        if w and w.EnableClip then pcall(w.EnableClip, w, false) end
    end
    if info.desc then
        if info.desc.EnableClip then pcall(info.desc.EnableClip, info.desc, false) end
        info.desc:Show(true)
    end
    if info.weight then info.weight:Show(true) end
    if type(info.stats) == "table" then
        for _, st in ipairs(info.stats) do
            if st.base and st._rw_shown ~= nil then st.base:Show(st._rw_shown and true or false) end
        end
    end
    narrow_restore(info)
    reset_base(info)
    info._rw = nil
    reset_stat_flags(info)
    info.id = nil
    info.section = nil
    state.restores = (state.restores or 0) + 1
    return true
end

-- INV-REWORK-15 (п.1/п.4): описание и вес стоят по y из xml, родной Update их не двигает
-- (Sync_Finale без syncer). Прокрутка сдвигала их вверх, и при смене предмета сдвиг оставался ->
-- текст уезжал над рамкой (скриншоты Миши 2026-11-12). Базовые y записываются один раз при
-- установке хука и возвращаются перед каждой новой раскладкой (геймпад) и при возврате на мышь.
DESC_BASE_NAMES = { "desc", "weight", "value", "note" }

function capture_base(info)
    local base = {}
    for _, n in ipairs(DESC_BASE_NAMES) do
        local w = info[n]
        if w and w.GetWndPos then base[n] = w:GetWndPos().y end
    end
    info._rw_base = base
    return base
end

function reset_base(info)
    local base = info._rw_base
    if not base then return false end
    for n, y in pairs(base) do
        local w = info[n]
        if w then w:SetWndPos(vector2():set(w:GetWndPos().x, y)) end
    end
    return true
end

function info_key(obj, sec)
    local id = obj and obj.id and obj:id() or nil
    local s = obj and obj.section and obj:section() or sec
    return tostring(id) .. ":" .. tostring(s)
end

function install_info_hook(info)
    if not info or info._rw_hooked then return false end
    info._rw_hooked = true
    capture_base(info)
    local orig = info.Update
    info.Update = function(self, obj, sec, flags)
        if ENABLED and info_hidden(self) then
            return orig(self)
        end
        if not (ENABLED and is_gamepad()) then
            if self._rw or self._rw_narrow then
                -- INV-REWORK-14 (п.3): вернуть родную раскладку целиком (ширины, позиции, клип, строки)
                pcall(restore_native, self)
            end
            return orig(self, obj, sec, flags)
        end
        if not self._rw_narrow then
            -- INV-REWORK-14 (п.2): сузить ДО родного Update — текст переносится и блоки модов
            -- (детали/рецепты, ширина по frame) строятся уже по узкой ширине
            local ok_n, err_n = pcall(narrow_apply, self)
            if not ok_n and printf then printf("! [gp_inv_rework] narrow_apply: %s", tostring(err_n)) end
            self._rw = nil
            reset_base(self)
            reset_stat_flags(self)
            self.id = nil
            self.section = nil
        elseif self._rw and (obj or sec) and self._rw.key ~= info_key(obj, sec) then
            -- INV-REWORK-15: новый предмет -> снять прокрутку прошлого до родной раскладки
            reset_base(self)
            self._rw = nil
            reset_stat_flags(self)
        end
        if state.desc_force then
            -- Y «показать»: без родной задержки появления (UIInfoItem:Pass, delay 700 мс)
            self.timer = -1000000
        end
        local res = orig(self, obj, sec, flags)
        if state.desc_force and (self.id or self.section) then state.desc_force = nil end
        if self:IsShown() then
            local okf, errf = pcall(fix_stat_rows, self)
            if not okf and printf then printf("! [gp_inv_rework] fix_stat_rows: %s", tostring(errf)) end
            local ok, err = pcall(layout_desc, self)
            if not ok and printf then printf("! [gp_inv_rework] layout_desc: %s", tostring(err)) end
        end
        return res
    end
    return true
end

-- ---------------------------------------------------------------------------
-- INV-REWORK-16 (п.1, Миша 2026-11-12): подсказка характеристики («Радиозащита» и т. п.,
-- UIInventory.hint_wnd, ui_inventory.script:546) на геймпаде — как описание предмета: ширина DESC_W,
-- высота DESC_H, рядом с рамкой (place_box), прокрутка RS по строкам. Родной SetHint (:3819) не
-- вызывается: у него задержка tg_hint/tg_hint_step после SetHint(false) — из-за неё после Y подсказка
-- появлялась только на следующей характеристике. Прокрутка: текст режется по началам строк
-- (жадный перенос с начала строки повторяет те же переносы), в окне только видимые строки.
-- ---------------------------------------------------------------------------
HINT_PAD_X, HINT_PAD_Y, HINT_PAD_R = 16, 20, 16
HINT_NATIVE = { w = 446, h = 170, tx = 16, ty = 20, tw = 402, th = 130 }

function hint_lines(tw, text)
    local lines, last_h, lh = {}, nil, nil
    for st, en in text:gmatch("()%S+()") do
        tw:SetText(text:sub(1, en - 1))
        tw:AdjustHeightToText()
        local h = tw:GetHeight()
        if not last_h then
            lh = h
            lines[1] = { s = st, e = en - 1 }
        elseif h > last_h + 0.5 then
            lines[#lines + 1] = { s = st, e = en - 1 }
        else
            lines[#lines].e = en - 1
        end
        last_h = h
    end
    -- INV-REWORK-17 п.1: шаг строки = (полная высота - первая строка)/(n-1); высота одной строки
    -- больше шага (поля сверху/снизу), поэтому per считается как lh + (per-1)*pitch <= высоты окна.
    lh = math.max(1, lh or 16)
    local pitch = lh
    if #lines > 1 and last_h and last_h > lh then pitch = math.max(1, (last_h - lh) / (#lines - 1)) end
    return lines, pitch, lh
end

function hint_target(gui)
    if type(gui.stat) == "table" then
        for _, v in pairs(gui.stat) do
            if v and v.bar and v.bar.IsCursorOverWindow then
                local ok, over = pcall(v.bar.IsCursorOverWindow, v.bar)
                if ok and over then
                    local r = widget_rect(v.base) or widget_rect(v.bar)
                    if r then return r end
                end
            end
        end
    end
    return current_target_rect(gui)
end

-- INV-REWORK-17 п.1: полоса категорий (LT … RT) рисуется поверх подсказки -> окно не заходит на
-- неё (низ = rail_top, как у описания); если не помещается — окно ниже ростом (возвращается h).
function place_box(dialog, w, h, target, gui)
    local x = target.x1 - DESC_GAP - w
    if x < 2 then x = target.x2 + DESC_GAP end
    if x + w > 1022 then x = math.max(2, 1022 - w) end
    local bottom = 766
    local rt, rx1, rx2 = rail_top(gui)
    if rt and x < rx2 and x + w > rx1 then bottom = rt end
    if h > bottom - 2 then h = math.max(HINT_MIN_H, bottom - 2) end
    local y = (target.y1 + target.y2) * 0.5 - h * 0.5
    y = math.max(2, math.min(y, bottom - h))
    dialog:SetWndPos(vector2():set(x, y))
    return x, y, h
end

HINT_MIN_H = 80

-- INV-REWORK-18 п.1 (Миша 2026-11-12): RS листал подсказку рывками по строкам, а цвет текста менялся —
-- метка цвета %c[...] оставалась в отрезанном начале. Если движок умеет обрезку (как у описания,
-- clip_mode / INV-REWORK-7) — весь текст едет попиксельно внутри окна; иначе — по строкам, но к
-- первой видимой строке приклеивается последняя метка цвета перед ней.
function hint_clip_mode(tw)
    return type(game) == "table" and type(game.gamepad_text_clip) == "function" and Frect ~= nil
        and tw ~= nil and tw.EnableClip ~= nil and tw.SetClipRect ~= nil
end

function color_before(text, pos)
    local last = nil
    for tag in text:sub(1, pos - 1):gmatch("%%c%[[^%]]*%]") do last = tag end
    return last
end

function hint_render(gui)
    local hs = state.hint
    if not hs then return false end
    local tw = gui.hint_wnd_text
    local n = #hs.lines
    local avail = (hs.box_h or DESC_H) - HINT_PAD_Y * 2
    local per = math.max(1, math.floor((avail - (hs.first_h or hs.line_h)) / hs.line_h) + 1)
    hs.per = per
    if hs.clip then
        local text_h = (hs.first_h or hs.line_h) + math.max(0, n - 1) * hs.line_h
        hs.off = math.max(0, math.min(hs.off, math.max(0, text_h - avail)))
        if hs.shown_txt ~= hs.text then
            tw:SetText(hs.text)
            hs.shown_txt = hs.text
        end
        tw:SetWndSize(vector2():set(DESC_W - HINT_PAD_X - HINT_PAD_R, math.max(avail, text_h)))
        tw:SetWndPos(vector2():set(HINT_PAD_X, HINT_PAD_Y - hs.off))
        local r = widget_rect(gui.hint_wnd)
        if r then
            tw:EnableClip(true)
            tw:SetClipRect(Frect():set(r.x1, r.y1 + HINT_PAD_Y, r.x2, r.y1 + HINT_PAD_Y + avail))
        end
        return true
    end
    hs.off = math.max(0, math.min(hs.off, math.max(0, n - per) * hs.line_h))
    local first = math.floor(hs.off / hs.line_h + 0.5) + 1
    local last = math.min(n, first + per - 1)
    local txt = ""
    if n > 0 then
        txt = hs.text:sub(hs.lines[first].s, hs.lines[last].e)
        local tag = first > 1 and color_before(hs.text, hs.lines[first].s)
        if tag then txt = tag .. txt end
    end
    tw:SetText(txt)
    hs.shown_txt = nil
    return true
end

-- INV-REWORK-18 п.1: у строки характеристики без описания родной Update делает return без SetHint(false)
-- (ui_inventory.script:3913-3918) -> старая подсказка оставалась. На геймпаде прячем её сами.
function hint_sync(gui)
    if not (state.hint and gui and gui.hint_wnd and is_gamepad()) then return false end
    local ok, vis = pcall(gui.hint_wnd.IsShown, gui.hint_wnd)
    if not (ok and vis) or type(gui.stat) ~= "table" then return false end
    for name, v in pairs(gui.stat) do
        if v and v.bar and v.bar.IsCursorOverWindow then
            local okc, over = pcall(v.bar.IsCursorOverWindow, v.bar)
            if okc and over then
                local sl = type(gui.stat_list) == "table" and gui.stat_list[name]
                if sl and sl.hint then return false end
                gui:SetHint(false)
                state.hint_hides = (state.hint_hides or 0) + 1
                return true
            end
        end
    end
    return false
end

function show_hint_rw(gui, text)
    local wnd, tw = gui.hint_wnd, gui.hint_wnd_text
    if not (wnd and tw) then return false end
    local hs = state.hint
    if not hs or hs.text ~= text or not hs.sized then
        wnd:SetWndSize(vector2():set(DESC_W, DESC_H))
        tw:SetWndPos(vector2():set(HINT_PAD_X, HINT_PAD_Y))
        tw:SetWndSize(vector2():set(DESC_W - HINT_PAD_X - HINT_PAD_R, DESC_H - HINT_PAD_Y * 2))
        local lines, pitch, lh = hint_lines(tw, text)
        hs = { text = text, lines = lines, line_h = pitch, first_h = lh, off = 0, sized = true, box_h = DESC_H,
            clip = hint_clip_mode(tw) and true or false }
        state.hint = hs
        -- AdjustHeightToText в hint_lines растянул текст на весь абзац -> вернуть высоту окна
        tw:SetWndSize(vector2():set(DESC_W - HINT_PAD_X - HINT_PAD_R, DESC_H - HINT_PAD_Y * 2))
    end
    wnd:Show(true)
    local t = hint_target(gui)
    local box_h = DESC_H
    if t then
        local _, _, bh = place_box(wnd, DESC_W, DESC_H, t, gui)
        box_h = bh or DESC_H
    end
    if box_h ~= hs.box_h then
        wnd:SetWndSize(vector2():set(DESC_W, box_h))
        tw:SetWndSize(vector2():set(DESC_W - HINT_PAD_X - HINT_PAD_R, box_h - HINT_PAD_Y * 2))
        hs.box_h = box_h
    end
    hint_render(gui)
    return true
end

function hint_restore_native(gui)
    local hs = state.hint
    if not (hs and hs.sized and gui.hint_wnd and gui.hint_wnd_text) then return false end
    gui.hint_wnd:SetWndSize(vector2():set(HINT_NATIVE.w, HINT_NATIVE.h))
    if hs.clip and gui.hint_wnd_text.EnableClip then gui.hint_wnd_text:EnableClip(false) end
    gui.hint_wnd_text:SetWndPos(vector2():set(HINT_NATIVE.tx, HINT_NATIVE.ty))
    gui.hint_wnd_text:SetWndSize(vector2():set(HINT_NATIVE.tw, HINT_NATIVE.th))
    state.hint = nil
    return true
end

-- RS: px > 0 — вниз. true, если подсказка показана и забрала стик.
function hint_scroll(gui, px)
    local hs = state.hint
    if not (hs and gui and gui.hint_wnd and is_gamepad()) then return false end
    local ok, vis = pcall(gui.hint_wnd.IsShown, gui.hint_wnd)
    if not (ok and vis) then return false end
    hs.off = hs.off + (tonumber(px) or 0)
    hint_render(gui)
    return true
end

function install_hint_hook(gui)
    if not gui or gui._rw_hint_hooked or type(gui.SetHint) ~= "function" then return false end
    gui._rw_hint_hooked = true
    local orig = gui.SetHint
    gui.SetHint = function(self, text, pos)
        if text and ENABLED and desc_should_hide() then
            return orig(self, false)
        end
        if ENABLED and is_gamepad() then
            if text and show_hint_rw(self, text) then return true end
            if state.hint then state.hint.off = 0 end
        elseif state.hint then
            hint_restore_native(self)
        end
        return orig(self, text, pos)
    end
    return true
end

-- Вызывается из gp_bridge при открытии инвентаря (on_gui_change "UIInventory").
function on_inventory_shown(gui)
    if not gui then return false end
    reset_panel()
    clear_transient_holds()
    state.full_stats = nil
    state.view_ret = nil
    state.tech_ret = nil
    state.last_inv_id = nil
    state.open_place = is_two_side(gui) and OPEN_PLACE_TRIES or nil
    if gp_bridge and gp_bridge.register_source_listener then
        pcall(gp_bridge.register_source_listener, "gp_inv_rework", on_source_changed)
    end
    xray_clear(gui)
    ensure_msg_box_hooks(gui)
    ensure_item_props_hook(gui)
    install_custom_props_hook()
    install_update_hook()
    install_key_hook()
    install_info_hook(gui.item_info)
    install_hint_hook(gui)
    install_sheet_hooks()
    return true
end

-- ---------------------------------------------------------------------------
-- INV-REWORK-12: отладочный «рентген» (решение Миши 2026-11-12: клавиша F8, только стенд -dbg).
-- F8 в открытом инвентаре: рамки всех клеток всех контейнеров (цвет по контейнеру, подпись bag#idx),
-- жёлтые рамки значков (ci.ico) снаряжения и пояса, голубые — характеристики; повторное F8 — убрать.
-- Координаты (UI 1024x768) пишутся в $app_data_root$\gamepad\inv_xray.txt.
-- ---------------------------------------------------------------------------
-- INV-REWORK-24: F8 теперь у движкового рентгена подсказок (GpHintXray.cpp, движок съедает F8 при -dbg);
-- рамки клеток инвентаря - на F7.
XRAY_KEY = "DIK_F7"
XRAY_COLORS = { actor_bag = { 80, 220, 80 }, actor_equ = { 255, 70, 70 }, actor_belt = { 255, 140, 0 },
    actor_quick = { 200, 80, 255 }, npc_bag = { 80, 160, 255 }, picker = { 255, 255, 255 } }
XRAY_ICO = { 255, 230, 0 }
XRAY_STAT = { 0, 220, 220 }

function xray_allowed()
    return gp_ui_tune and gp_ui_tune.is_debug_build and gp_ui_tune.is_debug_build() and true or false
end

local function xray_static(gui, x, y, w, h, c)
    local s = CUIStatic()
    s:SetAutoDelete(true)
    s:Enable(false)
    s:SetStretchTexture(true)
    s:InitTexture("ui_gp_solid_white")
    s:SetWndPos(vector2():set(x, y))
    s:SetWndSize(vector2():set(math.max(w, 1), math.max(h, 1)))
    s:SetTextureColor(GetARGB(230, c[1], c[2], c[3]))
    gui:AttachChild(s)
    return s
end

function xray_box(gui, r, c, text)
    local out = state.xray
    local w, h = r.x2 - r.x1, r.y2 - r.y1
    out[#out + 1] = xray_static(gui, r.x1, r.y1, w, 1, c)
    out[#out + 1] = xray_static(gui, r.x1, r.y2 - 1, w, 1, c)
    out[#out + 1] = xray_static(gui, r.x1, r.y1, 1, h, c)
    out[#out + 1] = xray_static(gui, r.x2 - 1, r.y1, 1, h, c)
    if text then
        local s = CUIStatic()
        s:SetAutoDelete(true)
        s:Enable(false)
        s:SetWndPos(vector2():set(r.x1 + 2, r.y1 + 1))
        s:SetWndSize(vector2():set(math.max(w, 40), 10))
        local tc = s.TextControl and s:TextControl()
        if tc then
            if GetFontSmall and tc.SetFont then tc:SetFont(GetFontSmall()) end
            if tc.SetTextColor then tc:SetTextColor(GetARGB(255, c[1], c[2], c[3])) end
            tc:SetText(text)
        end
        gui:AttachChild(s)
        out[#out + 1] = s
    end
end

function xray_collect(gui)
    local rows = {}
    if type(gui.CC) == "table" then
        for bag, cc in pairs(gui.CC) do
            if shown(cc) and type(cc.cell) == "table" then
                for idx, ci in pairs(cc.cell) do
                    local r = ci and ci.cell and widget_rect(ci.cell)
                    if r then
                        local sec = ci.section or ""
                        rows[#rows + 1] = { kind = "cell", bag = bag, idx = idx, id = ci.ID, sec = sec, r = r }
                        local ir = (bag == "actor_equ" or bag == "actor_belt" or bag == "actor_quick")
                            and ci.ico and widget_rect(ci.ico)
                        if ir then rows[#rows + 1] = { kind = "ico", bag = bag, idx = idx, id = ci.ID, sec = sec, r = ir } end
                    end
                end
            end
        end
    end
    -- окно описания: абсолютные рамки частей + относительная позиция (WndPos) в поле section
    local info = gui.item_info
    if type(info) == "table" then
        local names = { "dialog", "frame", "name", "value", "weight", "desc" }
        for _, n in ipairs(DESC_BLOCKS) do names[#names + 1] = n end
        for _, n in ipairs(names) do
            local w = info[n]
            if type(w) == "userdata" or type(w) == "table" then
                local okp, p = pcall(function() return w:GetWndPos() end)
                local r = widget_rect(w)
                if r then
                    rows[#rows + 1] = { kind = "info", bag = "info", idx = n, sec = okp and p
                        and string.format("rel=%.1f,%.1f", p.x, p.y) or "", r = r }
                end
            end
        end
    end
    for _, t in ipairs(collect_stat_targets(gui)) do
        rows[#rows + 1] = { kind = "stat", bag = "stat", idx = t.name or "?", sec = "",
            r = { x1 = t.mx - t.w * 0.5, y1 = t.my - t.h * 0.5, x2 = t.mx + t.w * 0.5, y2 = t.my + t.h * 0.5 } }
    end
    table.sort(rows, function(a, b)
        if a.bag ~= b.bag then return tostring(a.bag) < tostring(b.bag) end
        if a.kind ~= b.kind then return a.kind < b.kind end
        return tostring(a.idx) < tostring(b.idx)
    end)
    return rows
end

function xray_write(rows)
    local path = nil
    if getFS then
        local ok, fs = pcall(getFS)
        if ok and fs and fs.update_path then
            local ok2, pth = pcall(fs.update_path, fs, "$app_data_root$", "gamepad\\inv_xray.txt")
            if ok2 then path = pth end
        end
    end
    path = state.xray_path or path
    if not path or type(io) ~= "table" or type(io.open) ~= "function" then return false end
    local f = io.open(path, "wb")
    if not f then return false end
    f:write("kind\tbag\tidx\tid\tsection\tx1\ty1\tx2\ty2\n")
    for _, w in ipairs(rows) do
        f:write(string.format("%s\t%s\t%s\t%s\t%s\t%.1f\t%.1f\t%.1f\t%.1f\n", w.kind, tostring(w.bag),
            tostring(w.idx), tostring(w.id or "-"), tostring(w.sec), w.r.x1, w.r.y1, w.r.x2, w.r.y2))
    end
    f:close()
    return true
end

function xray_clear(gui)
    for _, s in ipairs(state.xray or {}) do
        if gui and gui.DetachChild then pcall(gui.DetachChild, gui, s) end
    end
    local was = state.xray ~= nil
    state.xray = nil
    return was
end

function xray_toggle(gui)
    if not gui then return false end
    if xray_clear(gui) then return true end
    state.xray = {}
    local rows = xray_collect(gui)
    for _, w in ipairs(rows) do
        if w.kind == "stat" then
            xray_box(gui, w.r, XRAY_STAT, nil)
        elseif w.kind == "ico" then
            xray_box(gui, w.r, XRAY_ICO, nil)
        else
            xray_box(gui, w.r, XRAY_COLORS[w.bag] or { 255, 0, 255 }, w.bag:gsub("^actor_", "") .. "#" .. tostring(w.idx))
        end
    end
    state.xray_rows = #rows
    xray_write(rows)
    return true
end

function on_key(gui, dik, action)
    if action ~= (ui_events and ui_events.WINDOW_KEY_PRESSED) then return false end
    if not (DIK_keys and dik == DIK_keys[XRAY_KEY]) or not xray_allowed() then return false end
    xray_toggle(gui)
    return true
end

function install_key_hook()
    local cls = ui_inventory and ui_inventory.UIInventory
    if not cls or cls._rw_key_hooked or type(cls.OnKeyboard) ~= "function" then return false end
    cls._rw_key_hooked = true
    local orig = cls.OnKeyboard
    cls.OnKeyboard = function(self, dik, action, ...)
        local ok, used = pcall(on_key, self, dik, action)
        if ok and used then return true end
        return orig(self, dik, action, ...)
    end
    return true
end

-- ---------------------------------------------------------------------------
-- INV-REWORK-13 (правки Миши после проверки INV8, 2026-11-12)
-- ---------------------------------------------------------------------------
BELT_RETRY_MS = 150
BELT_TRIES = 5
REOPEN_MS = 6000

function now_ms()
    return time_global and time_global() or 0
end

-- Одинарное A по оружию, оба слота заняты: замена в правом слоте (старое оружие в рюкзак).
function weapon_replace_right(gui, cc, idx)
    local obj = cc.GetObj and cc:GetObj(idx)
    local set = obj and slot_targets(gui, obj, "actor_bag")
    if not set then return deny() end
    local equ = gui.CC.actor_equ
    local best, bx = nil, nil
    for i in pairs(set) do
        local ci = equ.cell and equ.cell[i]
        local r = ci and ci.cell and widget_rect(ci.cell)
        local x = r and r.x1 or i
        if not bx or x > bx then best, bx = i, x end
    end
    return do_slot(gui, obj:id(), best, "actor_equ")
end

-- Артефакт из рюкзака при полном поясе: выбор ячейки рамкой (true — выбор начат).
function belt_full_pick(gui, cc, idx)
    if src_bag(cc) ~= "actor_bag" or gui.mode ~= "inventory" then return false end
    local obj = cc.GetObj and cc:GetObj(idx)
    if not (obj and is_kind(IsArtefact, obj)) then return false end
    local set = belt_targets(gui)
    if not set then return false end
    local belt = gui.CC.actor_belt
    for i in pairs(set) do
        local ci = belt.cell[i]
        if not (ci and ci.ID) then return false end
    end
    return start_pick(gui, obj, "actor_bag", {}, set, "actor_belt")
end

-- Отложенная установка артефакта после снятия старого (несколько попыток, пока пояс не освободится).
function drain_belt()
    local pb = state.pending_belt
    if not pb or now_ms() < pb.at then return false end
    local obj = level and level.object_by_id and level.object_by_id(pb.id)
    local actor = db and db.actor
    if not (obj and actor) then
        state.pending_belt = nil
        return false
    end
    pcall(actor.move_to_belt, actor, obj)
    pb.tries = pb.tries + 1
    local on = true
    if actor.is_on_belt then
        local ok, r = pcall(actor.is_on_belt, actor, obj)
        on = ok and r and true or false
    end
    if on or pb.tries >= BELT_TRIES then
        state.pending_belt = nil
        if on and itms_manager and itms_manager.play_item_sound then pcall(itms_manager.play_item_sound, obj) end
        return on
    end
    pb.at = now_ms() + BELT_RETRY_MS
    return false
end

-- Удержание A по батарейке: приборы, где заряд выше, чем у батарейки (игра такое запрещает,
-- "ui_st_battery_more_power", item_device.script:197). Осознанное действие игрока -> заменяем сами.
function battery_force_targets(gui, obj, bag)
    local out = {}
    local dev = item_device
    if not (dev and dev.device_battery and type(dev.dev_consumption) == "table") then return out end
    if obj:section() ~= dev.device_battery then return out end
    local cb = obj:condition()
    for _, c in ipairs(ordered_candidates(gui)) do
        local o = c.obj
        if o:id() ~= obj:id() and dev.dev_consumption[o:section()] and o:condition() > cb then
            out[#out + 1] = { id = o:id(), obj = o, bag = c.bag, rule = "battery_force" }
        end
    end
    return out
end

-- Повтор item_device on_item_drag_dropped (item_device.script:185-212) без проверки «в приборе больше
-- заряда»: старый заряд прибора уходит батарейкой в рюкзак (если выше критического), новая — в прибор.
function battery_swap(src_id, t)
    local dev = item_device
    local b = level and level.object_by_id and level.object_by_id(src_id)
    local d = t.obj
    if not (dev and b and d) then return deny() end
    local ok = pcall(function()
        local cb, cd = b:condition(), d:condition()
        local crit = type(dev.dev_critical) == "table" and dev.dev_critical[d:section()] or 0
        if cd > crit then alife_create_item(dev.device_battery, db.actor, { cond = cd }) end
        alife_release(b)
        d:set_condition(cb)
        if actor_effects and actor_effects.play_item_fx then pcall(actor_effects.play_item_fx, dev.device_battery) end
        if utils_obj and utils_obj.play_sound then pcall(utils_obj.play_sound, "interface\\inv_batt") end
    end)
    if not ok then return deny() end
    state.applies = (state.applies or 0) + 1
    return true
end

-- Патроны зарядили магазин: меню стопки патронов открывается снова, рамка на тех же патронах.
function remember_reopen(sec)
    state.reopen = { sec = sec, until_t = now_ms() + REOPEN_MS }
end

function drain_reopen(gui)
    local r = state.reopen
    if not r then return false end
    if now_ms() > r.until_t or not gui or state.pick then
        state.reopen = nil
        return false
    end
    if picker_shown(gui) then return false end
    local cc = gui.CC and gui.CC.actor_bag
    if not (cc and type(cc.cell) == "table") then return false end
    for idx, ci in pairs(cc.cell) do
        if ci and ci.ID and ci.section == r.sec and (not cc.IsCellVisible or cc:IsCellVisible(ci)) then
            local rc = widget_rect(ci.cell)
            if rc then move_cursor((rc.x1 + rc.x2) * 0.5, (rc.y1 + rc.y2) * 0.5) end
            if ci.HasChild and ci:HasChild() then open_picker(gui, cc, idx) end
            state.reopens = (state.reopens or 0) + 1
            return true
        end
    end
    return false
end

-- ---------------------------------------------------------------------------
-- INV-REWORK-17 п.8 (решение Миши 2026-11-12): после применения предмета к другому (набор для разбора,
-- ремнабор, чистка, батарейка — do_apply из tap_apply / pick_confirm / удержания) рамка возвращается
-- на исходный предмет-инструмент, чтобы можно было жать A подряд. Инструмент закончился — на такой же
-- (та же секция) в рюкзаке; нет и его — на предмет-цель. Ждём RETURN_DELAY_MS (игра успевает удалить
-- израсходованный предмет и пересобрать сетку), затем до RETURN_MS ищем каждое обновление UIInventory.
-- Патроны -> магазин не трогаем: там своё возвращение меню стопки (remember_reopen / drain_reopen).
-- ---------------------------------------------------------------------------
RETURN_DELAY_MS = 300
RETURN_MS = 2000
RETURN_BAGS = { "actor_bag", "actor_equ", "actor_belt", "actor_quick" }

function remember_return(src_id, t)
    local so = level and level.object_by_id and level.object_by_id(src_id)
    local now = now_ms()
    state.ret_tool = { id = src_id, sec = so and so:section() or nil, target = t and t.id or nil,
        from = now + RETURN_DELAY_MS, until_t = now + RETURN_MS }
    return true
end

function find_cell(gui, pred, bags)
    if not (gui and type(gui.CC) == "table") then return nil end
    for _, bag in ipairs(bags or RETURN_BAGS) do
        local cc = gui.CC[bag]
        if cc and type(cc.cell) == "table" then
            for idx, ci in pairs(cc.cell) do
                if ci and ci.ID and pred(ci) then
                    local tg = cell_target(gui, bag, idx)
                    if tg then return tg end
                end
            end
        end
    end
    return nil
end

function drain_return(gui)
    local r = state.ret_tool
    if not r then return false end
    local now = now_ms()
    if now > r.until_t or state.pick then
        state.ret_tool = nil
        return false
    end
    if now < r.from or not gui or gui.mode ~= "inventory" or picker_shown(gui) then return false end
    local how = "tool"
    local tg = find_cell(gui, function(ci) return ci.ID == r.id end)
    if not tg and r.sec then
        how = "same"
        tg = find_cell(gui, function(ci) return ci.section == r.sec end, { "actor_bag" })
    end
    if not tg and r.target then
        how = "target"
        tg = find_cell(gui, function(ci) return ci.ID == r.target end)
    end
    if not tg then return false end
    move_cursor(tg.mx, tg.my)
    state.ret_tool = nil
    state.last_return = how
    state.tool_returns = (state.tool_returns or 0) + 1
    return true
end

-- ---------------------------------------------------------------------------
-- INV-REWORK-17 п.4 (ответы Миши 2026-11-12, скриншот 13): окно «Подробно» (ui_itm_details.UIItemSheet).
-- Курсор заперт в центре (gp_bridge.cursor_locked), раньше он наводился на значки окна и всплывало
-- старое широкое описание. Теперь на геймпаде:
--   * наведение курсора в окне не работает (UICellContainer:Update не вызывается);
--   * LB/RB — выделение по значкам предметов окна (ремнаборы, крафт, разборка, готовка...): порядок
--     сверху вниз, слева направо, по кругу; выделенный значок — родная подсветка ячейки, окно само
--     прокручивается к нему;
--   * описание выделенного — наше узкое (install_info_hook: DESC_W, высота DESC_H) рядом со значком;
--   * Y — спрятать/показать описание (тот же флаг, что в инвентаре);
--   * A — «Подробно» выделенного предмета (нужен настоящий предмет: id значка, свой такой же или в
--     открытом инвентаре; нет — «нельзя» с вибрацией), B — назад к прошлому предмету; на первом — закрыть.
-- Кнопки ловит движок (StepItemSheetButtons) и спрашивает gp_bridge.sheet_button -> sheet_button.
-- ---------------------------------------------------------------------------
SHEET_ROW_TOL = 6
SHEET_SCROLL_PAD = 6

-- utils_ui.UICellContainer/UICellItem — классы luabind: в игре type() = "userdata", в luatest — "table".
function obj_like(v)
    local t = type(v)
    return t == "table" or t == "userdata"
end

function sheet_state(sheet)
    local st = state.sheet
    if not st or not rawequal(st.wnd, sheet) then -- luabind: no __eq on UI classes
        st = { wnd = sheet, stack = {}, sel = nil }
        state.sheet = st
    end
    return st
end

function sheet_cells(sheet)
    local out = {}
    if not sheet then return out end
    if type(sheet.CC) == "table" then
        for name, cc in pairs(sheet.CC) do
            if obj_like(cc) and type(cc.cell) == "table" and (not cc.IsShown or shown(cc)) then
                for idx, ci in pairs(cc.cell) do
                    if obj_like(ci) and ci.section and ci.cell then
                        local r = widget_rect(ci.cell)
                        if r then out[#out + 1] = { name = tostring(name), idx = idx, ci = ci, r = r, kind = "cell" } end
                    end
                end
            end
        end
    end
    if type(sheet.upx) == "table" then
        for ii, ele in pairs(sheet.upx) do
            if obj_like(ele) and ele.section and (not ele.base or shown(ele.base)) then
                local w = ele.btn or ele.base
                local r = w and widget_rect(w)
                if r then
                    out[#out + 1] = { name = "upx", idx = ii, ci = ele, r = r, kind = "upgr" }
                end
            end
        end
    end
    table.sort(out, function(a, b)
        local ka = (a.kind == "upgr") and 1 or 0
        local kb = (b.kind == "upgr") and 1 or 0
        if ka ~= kb then return ka < kb end
        if math.abs(a.r.y1 - b.r.y1) > SHEET_ROW_TOL then return a.r.y1 < b.r.y1 end
        if a.r.x1 ~= b.r.x1 then return a.r.x1 < b.r.x1 end
        return tostring(a.name) < tostring(b.name)
    end)
    return out
end

function sheet_find(sheet, sel)
    if not sel then return nil end
    if sel.kind == "upgr" or sel.name == "upx" then
        local ele = sheet and type(sheet.upx) == "table" and sheet.upx[sel.idx]
        if not obj_like(ele) or not ele.section or ele.section ~= sel.section then return nil end
        return ele
    end
    local cc = sheet and type(sheet.CC) == "table" and sheet.CC[sel.name]
    local ci = cc and type(cc.cell) == "table" and cc.cell[sel.idx]
    if not obj_like(ci) or not ci.section or ci.section ~= sel.section then return nil end
    return ci
end

function sheet_highlight(ci, on)
    if not obj_like(ci) then return end
    if type(ci.Highlight) == "function" then
        pcall(ci.Highlight, ci, on and true or false)
    elseif ci.btn and type(ci.btn.Highlight) == "function" then
        pcall(ci.btn.Highlight, ci.btn, on and true or false)
    end
end

-- Прокрутить окно, чтобы выделенный значок был виден целиком.
function sheet_reveal(sheet, r, kind)
    local sv = sheet and ((kind == "upgr" and sheet.scroll_upgr) or sheet.scroll)
    local sr = sv and widget_rect(sv)
    if not (sr and r and sv.GetCurrentScrollPos and sv.SetScrollPos) then return false end
    local ok, cur = pcall(sv.GetCurrentScrollPos, sv)
    cur = ok and tonumber(cur) or nil
    if not cur then return false end
    local d = 0
    if r.y1 < sr.y1 then d = r.y1 - sr.y1 - SHEET_SCROLL_PAD
    elseif r.y2 > sr.y2 then d = r.y2 - sr.y2 + SHEET_SCROLL_PAD end
    if d == 0 then return false end
    local okx, mx = pcall(sv.GetMaxScrollPos, sv)
    local okn, mn = pcall(sv.GetMinScrollPos, sv)
    mx = okx and tonumber(mx) or cur + d
    mn = okn and tonumber(mn) or 0
    local p = math.floor(math.max(mn, math.min(mx, cur + d)) + 0.5)
    pcall(sv.SetScrollPos, sv, p)
    return true
end

function sheet_apply_sel(sheet, st, c)
    sheet_highlight(sheet_find(sheet, st.sel), false)
    st.sel = { name = c.name, idx = c.idx, section = c.ci.section, kind = c.kind or "cell" }
    sheet_highlight(c.ci, true)
    sheet_reveal(sheet, c.r, c.kind)
    state.desc_force = true
    state.sheet_selects = (state.sheet_selects or 0) + 1
    return true
end

function sheet_select(sheet, step)
    local st = sheet_state(sheet)
    local cells = sheet_cells(sheet)
    if #cells == 0 then return deny() end
    local cur = nil
    if st.sel then
        for i, c in ipairs(cells) do
            if c.name == st.sel.name and c.idx == st.sel.idx then cur = i break end
        end
    end
    local n
    if not cur then n = step > 0 and 1 or #cells
    else n = (cur - 1 + step) % #cells + 1 end
    return sheet_apply_sel(sheet, st, cells[n])
end

-- Настоящий предмет для «Подробно»: id значка, свой предмет такой секции, предмет в открытом инвентаре.
function sheet_object(ci)
    if not ci then return nil end
    if ci.ID and level and level.object_by_id then
        local o = level.object_by_id(ci.ID)
        if o then return o end
    end
    local actor = db and db.actor
    if actor and actor.object then
        local ok, o = pcall(actor.object, actor, ci.section)
        if ok and o then return o end
    end
    local gui = ui_inventory and ui_inventory.GUI
    if gui and type(gui.CC) == "table" and level and level.object_by_id then
        for _, cc in pairs(gui.CC) do
            if obj_like(cc) and type(cc.cell) == "table" then
                for _, c in pairs(cc.cell) do
                    if obj_like(c) and c.ID and c.section == ci.section then
                        local o = level.object_by_id(c.ID)
                        if o then return o end
                    end
                end
            end
        end
    end
    return nil
end

function sheet_open_obj(sheet, obj)
    local st = sheet_state(sheet)
    sheet_highlight(sheet_find(sheet, st.sel), false)
    st.sel = nil
    st.prev_cc_sel = nil
    sheet._rw_sheet_rect = nil
    st.nav = true
    local ok, err = pcall(sheet.Reset, sheet, obj)
    st.nav = nil
    if not ok and printf then printf("! [gp_inv_rework] sheet Reset: %s", tostring(err)) end
    if sheet.scroll and sheet.scroll.SetScrollPos then pcall(sheet.scroll.SetScrollPos, sheet.scroll, 0) end
    return ok
end

function sheet_button(sheet, name)
    if not (ENABLED and sheet and is_gamepad()) then return false end
    local st = sheet_state(sheet)
    if name == "LB" then sheet_select(sheet, -1) return true end
    if name == "RB" then sheet_select(sheet, 1) return true end
    if name == "Y" then
        -- W4-TECH-SYS (В27): если у предмета есть видимое дерево улучшений upx — Y прыгает к дереву и обратно
        local cells = sheet_cells(sheet)
        local first_upgr, first_cc = nil, nil
        for _, c in ipairs(cells) do
            if c.kind == "upgr" and not first_upgr then first_upgr = c end
            if c.kind ~= "upgr" and not first_cc then first_cc = c end
        end
        if first_upgr then
            if st.sel and st.sel.kind == "upgr" then
                local back = nil
                if st.prev_cc_sel then
                    for _, c in ipairs(cells) do
                        if c.name == st.prev_cc_sel.name and c.idx == st.prev_cc_sel.idx then back = c break end
                    end
                end
                if back or first_cc then
                    state.desc_hidden = false
                    sheet_apply_sel(sheet, st, back or first_cc)
                    return true
                end
            else
                st.prev_cc_sel = st.sel
                state.desc_hidden = false
                sheet_apply_sel(sheet, st, first_upgr)
                return true
            end
        end
        state.desc_hidden = not state.desc_hidden
        if not state.desc_hidden then state.desc_force = true end
        if sheet.item_info then pcall(sheet.item_info.Update, sheet.item_info) end
        if sheet.upgr_info and state.desc_hidden then pcall(sheet.upgr_info.Update, sheet.upgr_info) end
        return true
    end
    if name == "A" then
        if st.sel and st.sel.kind == "upgr" then
            deny()
            return true
        end
        local obj = sheet_object(sheet_find(sheet, st.sel))
        if not obj then
            deny()
            return true
        end
        if st.cur_id and st.cur_id ~= obj:id() then st.stack[#st.stack + 1] = st.cur_id end
        sheet_open_obj(sheet, obj)
        state.sheet_opens = (state.sheet_opens or 0) + 1
        return true
    end
    if name == "B" then
        while #st.stack > 0 do
            local id = table.remove(st.stack)
            local obj = level and level.object_by_id and level.object_by_id(id)
            if obj then
                sheet_open_obj(sheet, obj)
                state.sheet_backs = (state.sheet_backs or 0) + 1
                return true
            end
        end
        return false -- закрыть окно (движок: Esc)
    end
    return false
end

-- Каждый кадр окна на геймпаде вместо родного наведения курсора.
function sheet_update(sheet)
    local info = sheet.item_info
    if info and not info._rw_hooked then install_info_hook(info) end
    local st = sheet_state(sheet)
    local ci = sheet_find(sheet, st.sel)
    if not ci then st.sel = nil end
    if st.sel and st.sel.kind == "upgr" and ci then
        local w = ci.btn or ci.base
        local r = w and widget_rect(w)
        local sr = (sheet.scroll_upgr and widget_rect(sheet.scroll_upgr)) or (sheet.scroll and widget_rect(sheet.scroll))
        if r and sr and (r.y2 < sr.y1 or r.y1 > sr.y2) then r = nil end
        sheet._rw_sheet_rect = r
        if info then pcall(info.Update, info) end
        if sheet.upgr_info then
            if r and not state.desc_hidden then
                sheet.upgr_info.timer = -1000000
                local inst = (ci.btn and ci.btn.GetCheck and ci.btn:GetCheck()) or false
                pcall(sheet.upgr_info.Update, sheet.upgr_info, ci.section, ci.prereq, inst)
                place_upgr_box(sheet.upgr_info, r)
                return true
            else
                pcall(sheet.upgr_info.Update, sheet.upgr_info)
                return false
            end
        end
        return r ~= nil
    end
    if sheet.upgr_info then pcall(sheet.upgr_info.Update, sheet.upgr_info) end
    local r = ci and widget_rect(ci.cell)
    local sr = sheet.scroll and widget_rect(sheet.scroll)
    if r and sr and (r.y2 < sr.y1 or r.y1 > sr.y2) then r = nil end -- значок уехал за край окна
    sheet._rw_sheet_rect = r
    if not info then return false end
    if not r then
        pcall(info.Update, info)
        return false
    end
    local obj = ci.ID and level and level.object_by_id and level.object_by_id(ci.ID) or nil
    pcall(info.Update, info, obj, ci.section)
    return true
end

function install_sheet_hooks()
    local m = rawget(_G, "ui_itm_details") or ui_itm_details
    local cls = type(m) == "table" and m.UIItemSheet
    if not cls or cls._rw_sheet_hooked or type(cls.Update) ~= "function" then return false end
    cls._rw_sheet_hooked = true
    local orig_update, orig_reset, orig_close = cls.Update, cls.Reset, cls.Close
    cls.Update = function(self, ...)
        if ENABLED and is_gamepad() then
            CUIScriptWnd.Update(self)
            local ok, err = pcall(sheet_update, self)
            if not ok and printf then printf("! [gp_inv_rework] sheet_update: %s", tostring(err)) end
            return
        end
        if self._rw_sheet_rect then
            self._rw_sheet_rect = nil
            if self.item_info and (self.item_info._rw or self.item_info._rw_narrow) then pcall(restore_native, self.item_info) end
        end
        return orig_update(self, ...)
    end
    if type(orig_reset) == "function" then
        cls.Reset = function(self, obj, ...)
            local st = sheet_state(self)
            if not st.nav then
                -- новое открытие из меню предмета: история и выделение с нуля
                st.stack = {}
                st.sel = nil
                self._rw_sheet_rect = nil
            end
            st.cur_id = obj and obj.id and obj:id() or nil
            return orig_reset(self, obj, ...)
        end
    end
    if type(orig_close) == "function" then
        cls.Close = function(self, ...)
            local st = state.sheet
            if st and rawequal(st.wnd, self) then
                sheet_highlight(sheet_find(self, st.sel), false)
                state.sheet = nil
            end
            self._rw_sheet_rect = nil
            return orig_close(self, ...)
        end
    end
    return true
end

-- ---------------------------------------------------------------------------
-- INV-REWORK-20 (Миша 2026-11-12): RS — переключатель «характеристики как у предмета в максимальном
-- состоянии» (родная функция show_full_stats: gp_bridge.inv_set_full_stats; у мыши — зажатая клавиша).
-- Включённое состояние живёт, пока рамка на том же предмете: навёлся на другой (или вернулся на
-- тот же) — сброс, нужно нажать RS ещё раз. Движок зовёт full_stats_toggle по нажатию RS.
-- ---------------------------------------------------------------------------
function hover_key(gui)
    local h = gui and gui.hover
    if type(h) ~= "table" or not h.bag then return nil end
    local cc = type(gui.CC) == "table" and gui.CC[h.bag]
    local ci = cc and type(cc.cell) == "table" and cc.cell[h.idx]
    return tostring(h.bag) .. ":" .. tostring(h.idx) .. ":" .. tostring(ci and ci.ID)
end

local function set_full_stats(on)
    local set = gp_bridge and gp_bridge.inv_set_full_stats
    if type(set) == "function" then pcall(set, on) end
end

function full_stats_toggle()
    local gui = get_gui()
    if not gui then return "fs:0" end
    local on = not state.full_stats
    set_full_stats(on)
    state.full_stats = on and { key = hover_key(gui) } or nil
    return on and "fs:1" or "fs:0"
end

function full_stats_sync(gui)
    local fs = state.full_stats
    if not fs or hover_key(gui) == fs.key then return false end
    state.full_stats = nil
    set_full_stats(false)
    return true
end

-- ============================================================================
-- W4-TECH-SYS: двухпанельные окна по концепту 00-windows-concept.md §4.4 / §4.8 / §10:
--   * G4.1 Техник (mode == "repair", В26): цикл View inv->equ->tech, автопереход A к «Починить»/дереву,
--     B возврат к списку, 2D-навигация по upx (5x3x2) + автоскролл npc_up_scheme, мгновенный UIInfoUpgr
--     (Y прячет/показывает), message_box и message_box_up со штатными RMode_UpgradeYes/RMode_RepairYes;
--   * В20 Обыск/торговля: «Перенести часть...» первым пунктом меню X + инлайн-окно количества;
--   * В21 Личный тайник: кнопка «Переименовать» в шапке npc_dialog (+ L3) -> экранная клавиатура F5.1;
--   * В22 Попап «Снять запчасть» / «Обслуживание» (UICellPropertiesCustom): рамка, крестовина, A, B;
--   * В23 Продажа оружия с патронами/магазином: модальное окно из 3 кнопок с рамкой на «Разрядить и продать»;
--   * В24 Торговля: L3 «Очистить корзину» только при непустых корзинах;
--   * В25 Отказ переноса (no_trade / перевес тайника stash_capacities): тряска рамки + тост с причиной.
-- ============================================================================

local function tr_or(id, fallback_ru, fallback_en)
    if game and type(game.translate_string) == "function" then
        local ok, s = pcall(game.translate_string, id)
        if ok and type(s) == "string" and s ~= "" and s ~= id then
            return s
        end
    end
    return is_russian() and fallback_ru or fallback_en
end

local function strip_xr_colors(s)
    if type(s) ~= "string" then return "" end
    local clean = s:gsub("%%c%[[^%]]*%]", ""):gsub("^%s+", ""):gsub("%s+$", "")
    local first = clean:match("([^\r\n]+)")
    return first or clean
end

function emit_toast(msg, category)
    if type(msg) ~= "string" or msg == "" then return false end
    state.last_toast = msg
    state.toast_count = (state.toast_count or 0) + 1
    local tm = rawget(_G, "gp_toasts")
    if type(tm) == "table" and type(tm.push_toast) == "function" then
        pcall(tm.push_toast, msg, nil, category or "reject")
        return true
    end
    return false
end

function modal_open(gui)
    return msg_box_shown(gui or get_gui()) or qty_dlg_shown() or wpn_dlg_shown() or active_custom_props() ~= nil
end

-- ---------------------------------------------------------------------------
-- Техник (mode == "repair", G4.1, В26)
-- ---------------------------------------------------------------------------

TECH_SCROLL_PAD = 8

local function is_w_enabled(w)
    if not w then return false end
    if type(w.IsEnabled) == "function" then
        return w:IsEnabled() == true
    end
    return w._enabled ~= false
end

function tech_all_nodes(gui)
    local out = {}
    if not (gui and gui.mode == "repair" and parent_shown(gui, "npc_up_dialog") and type(gui.upx) == "table") then
        return out
    end
    for ii, ele in pairs(gui.upx) do
        local btn = ele and ele.btn
        if btn and (not ele.base or shown(ele.base)) then
            local r = widget_rect(btn)
            if r then
                local s_ii = tostring(ii)
                local row = tonumber(ele.row) or tonumber(s_ii:match("^(%d)")) or 1
                local col = tonumber(ele.col) or tonumber(s_ii:match("^%d(%d)")) or 1
                local is_b = s_ii:sub(-1) == "b" or ele.solo == true
                local vx = math.ceil(col / 2)
                local vy = (row - 1) * 3 + (is_b and 2 or ((col % 2 == 1) and 1 or 3))
                out[#out + 1] = {
                    ii = ii,
                    ele = ele,
                    btn = btn,
                    section = ele.section,
                    prereq = ele.prereq,
                    row = row,
                    col = col,
                    vx = vx,
                    vy = vy,
                    r = r,
                    mx = (r.x1 + r.x2) * 0.5,
                    my = (r.y1 + r.y2) * 0.5,
                }
            end
        end
    end
    table.sort(out, function(a, b)
        if a.vy ~= b.vy then return a.vy < b.vy end
        if a.vx ~= b.vx then return a.vx < b.vx end
        return tostring(a.ii) < tostring(b.ii)
    end)
    return out
end

function tech_has_targets(gui)
    if not (gui and gui.mode == "repair" and parent_shown(gui, "npc_up_dialog")) then return false end
    if #tech_all_nodes(gui) > 0 then return true end
    local rb = gui.npc_up_repair
    if rb and widget_rect(rb) and is_w_enabled(rb) then return true end
    if gui.upgr and gui.upgr.id and rb and widget_rect(rb) then return true end
    return false
end

function tech_reveal_node(gui, node)
    local sv = gui and gui.npc_up_scheme
    local sr = sv and widget_rect(sv)
    local r = node and widget_rect(node.btn)
    if not (sr and r and sv.GetCurrentScrollPos and sv.SetScrollPos) then return false end
    local ok, cur = pcall(sv.GetCurrentScrollPos, sv)
    cur = ok and tonumber(cur) or nil
    if not cur then return false end
    local d = 0
    if r.y1 < sr.y1 then d = r.y1 - sr.y1 - TECH_SCROLL_PAD
    elseif r.y2 > sr.y2 then d = r.y2 - sr.y2 + TECH_SCROLL_PAD end
    if d == 0 then return false end
    local okx, mx = pcall(sv.GetMaxScrollPos, sv)
    local okn, mn = pcall(sv.GetMinScrollPos, sv)
    mx = okx and tonumber(mx) or (cur + d)
    mn = okn and tonumber(mn) or 0
    local p = math.floor(math.max(mn, math.min(mx, cur + d)) + 0.5)
    pcall(sv.SetScrollPos, sv, p)
    local nr = widget_rect(node.btn)
    if nr then
        node.r = nr
        node.mx = (nr.x1 + nr.x2) * 0.5
        node.my = (nr.y1 + nr.y2) * 0.5
    end
    return true
end

function tech_entry_target(gui)
    if not (gui and gui.mode == "repair" and parent_shown(gui, "npc_up_dialog")) then return nil end
    local rb = gui.npc_up_repair
    local rr = rb and widget_rect(rb)
    if rr and shown(rb) and is_w_enabled(rb) then
        return { mx = (rr.x1 + rr.x2) * 0.5, my = (rr.y1 + rr.y2) * 0.5, kind = "btn" }
    end
    local nodes = tech_all_nodes(gui)
    if #nodes > 0 then
        local first = nodes[1]
        for _, n in ipairs(nodes) do
            local en = is_w_enabled(n.btn)
            local chk = n.btn.GetCheck and n.btn:GetCheck() or false
            if en and not chk then
                first = n
                break
            end
        end
        tech_reveal_node(gui, first)
        local nr = widget_rect(first.btn) or first.r
        return { mx = (nr.x1 + nr.x2) * 0.5, my = (nr.y1 + nr.y2) * 0.5, kind = "upgr" }
    end
    if rr then
        return { mx = (rr.x1 + rr.x2) * 0.5, my = (rr.y1 + rr.y2) * 0.5, kind = "btn" }
    end
    return nil
end

function tech_under_cursor(gui, cx, cy)
    if not (gui and gui.mode == "repair") then return nil, nil end
    if cx == nil or cy == nil then cx, cy = cursor_xy() end
    local rb = gui.npc_up_repair
    local rr = rb and widget_rect(rb)
    if rr and cx >= rr.x1 and cx <= rr.x2 and cy >= rr.y1 and cy <= rr.y2 then
        return "repair", rb
    end
    local nodes = tech_all_nodes(gui)
    local sr = gui.npc_up_scheme and widget_rect(gui.npc_up_scheme)
    for _, n in ipairs(nodes) do
        local r = n.r
        local vis = not sr or (r.y2 > sr.y1 and r.y1 < sr.y2)
        if vis and cx >= r.x1 and cx <= r.x2 and cy >= r.y1 and cy <= r.y2 then
            return "upx", n
        end
    end
    local best_kind, best_obj, best_d = nil, nil, 400
    if rr then
        local dx, dy = (rr.x1 + rr.x2) * 0.5 - cx, (rr.y1 + rr.y2) * 0.5 - cy
        local d = dx * dx + dy * dy
        if d < best_d then best_kind, best_obj, best_d = "repair", rb, d end
    end
    for _, n in ipairs(nodes) do
        local r = n.r
        local vis = not sr or (r.y2 > sr.y1 and r.y1 < sr.y2)
        if vis then
            local dx, dy = n.mx - cx, n.my - cy
            local d = dx * dx + dy * dy
            if d < best_d then best_kind, best_obj, best_d = "upx", n, d end
        end
    end
    return best_kind, best_obj
end

function repair_focus_a_label(gui)
    if not (gui and gui.mode == "repair") then return label("action") end
    if state.panel == "tech" then
        local kind = tech_under_cursor(gui)
        if kind == "repair" then return label("repair") end
        return label("install")
    end
    return label("select")
end

function repair_after_item_select(gui, cc, idx)
    if not (is_active() and gui and gui.mode == "repair") then return false end
    ensure_msg_box_hooks(gui)
    local ci = cc and type(cc.cell) == "table" and cc.cell[idx]
    local x, y = cursor_xy()
    state.tech_ret = {
        panel = (state.panel == "equ") and "equ" or "inv",
        id = ci and ci.ID or nil,
        bag = src_bag(cc),
        idx = idx,
        mx = x,
        my = y,
    }
    if gui.npc_up_scheme and gui.npc_up_scheme.SetScrollPos then
        pcall(gui.npc_up_scheme.SetScrollPos, gui.npc_up_scheme, 0)
    end
    local t = tech_entry_target(gui)
    if not t then return false end
    goto_panel(gui, "tech", t)
    pcall(upgr_info_sync, gui)
    return true
end

function repair_return_from_tech(gui)
    if not gui then return "panel:0" end
    local r = state.tech_ret or { panel = "inv" }
    state.tech_ret = nil
    if gui.upgr_info then pcall(gui.upgr_info.Update, gui.upgr_info) end
    local p = (r.panel == "equ") and "equ" or "inv"
    local t = (r.id and target_by_id(gui, p, r.id))
        or (r.bag and r.idx and cell_target(gui, r.bag, r.idx))
    if not t and r.mx then
        state.panel = p
        t = nearest_target(gui, r.mx, r.my)
    end
    t = t or (p == "equ" and equ_entry_target(gui) or inv_entry_target(gui))
        or inv_entry_target(gui) or equ_entry_target(gui)
    if not t then
        state.panel = "inv"
        return "panel:0"
    end
    return goto_panel(gui, p, t)
end

REPAIR_ZONE_NEXT = { inv = "equ", equ = "tech", tech = "inv" }

function repair_cycle_panel(gui)
    local cur = (state.panel == "equ" or state.panel == "tech") and state.panel or "inv"
    if cur ~= "tech" then
        state.tech_ret = remember_spot(gui)
    end
    local dest = REPAIR_ZONE_NEXT[cur] or "inv"
    while dest ~= cur do
        local t = nil
        if dest == "equ" then
            t = equ_entry_target(gui)
        elseif dest == "tech" then
            if tech_has_targets(gui) then t = tech_entry_target(gui) end
        else
            t = inv_entry_target(gui)
        end
        if t then
            if cur == "tech" and gui.upgr_info then pcall(gui.upgr_info.Update, gui.upgr_info) end
            local res = goto_panel(gui, dest, t) .. ";zone=" .. dest
            if dest == "tech" then pcall(upgr_info_sync, gui) end
            return res
        end
        dest = REPAIR_ZONE_NEXT[dest]
    end
    return "panel:0"
end

local function tech_locked_reason(node)
    local p = strip_xr_colors(node and node.prereq or "")
    if p ~= "" then return p end
    return tr_or("st_upgr_disable", "Установка невозможна", "Cannot install upgrade")
end

function tech_activate_under_cursor(gui)
    if not (gui and gui.mode == "repair") then return false end
    ensure_msg_box_hooks(gui)
    local kind, target = tech_under_cursor(gui)
    if kind == "repair" then
        local en = is_w_enabled(target)
        if not en or not (gui.upgr and gui.upgr.id) then
            emit_toast(is_russian() and "Предмет не нуждается в ремонте" or "Item does not need repair")
            deny()
            return false
        end
        if type(gui.RMode_OnRepair) == "function" then
            gui:RMode_OnRepair()
            state.tech_repairs = (state.tech_repairs or 0) + 1
            return true
        end
        deny()
        return false
    end
    if kind == "upx" and target and target.btn then
        local btn = target.btn
        local installed = btn.GetCheck and btn:GetCheck() or false
        if installed then
            emit_toast(tr_or("st_upgr_installed", "Улучшение уже установлено", "Upgrade already installed"))
            deny()
            return false
        end
        local en = is_w_enabled(btn)
        if not en then
            emit_toast(tech_locked_reason(target))
            deny()
            return false
        end
        if btn.SetCheck then btn:SetCheck(true) end
        if type(gui.RMode_OnUpgrade) == "function" then
            gui:RMode_OnUpgrade(target.row, target.col, target.ii)
            state.tech_upgrades = (state.tech_upgrades or 0) + 1
            return true
        end
    end
    deny()
    return false
end

function tech_dpad_snap(gui, cx, cy, dir)
    local nodes = tech_all_nodes(gui)
    local kind, cur = tech_under_cursor(gui, cx, cy)
    if kind == "repair" then
        if dir == 2 and #nodes > 0 then
            local best = nodes[1]
            tech_reveal_node(gui, best)
            local r = widget_rect(best.btn) or best.r
            return string.format("%.1f,%.1f", (r.x1 + r.x2) * 0.5, (r.y1 + r.y2) * 0.5)
        end
        return ""
    end
    if kind ~= "upx" or not cur then
        local t = tech_entry_target(gui)
        return t and string.format("%.1f,%.1f", t.mx, t.my) or ""
    end
    local best, best_score = nil, nil
    if dir == 3 or dir == 4 then
        for _, n in ipairs(nodes) do
            if (dir == 3 and n.vx < cur.vx) or (dir == 4 and n.vx > cur.vx) then
                local dx = math.abs(n.vx - cur.vx)
                local dy = math.abs(n.vy - cur.vy)
                local same_row_pen = (n.row == cur.row) and 0 or 50
                local score = same_row_pen + dy * 12 + dx
                if not best_score or score < best_score then
                    best, best_score = n, score
                end
            end
        end
    elseif dir == 1 or dir == 2 then
        for _, n in ipairs(nodes) do
            if (dir == 1 and n.vy < cur.vy) or (dir == 2 and n.vy > cur.vy) then
                local dy = math.abs(n.vy - cur.vy)
                local dx = math.abs(n.vx - cur.vx)
                local score = dy * 12 + dx * 5
                if not best_score or score < best_score then
                    best, best_score = n, score
                end
            end
        end
        if not best and dir == 1 and gui.npc_up_repair then
            local rr = widget_rect(gui.npc_up_repair)
            if rr then
                return string.format("%.1f,%.1f", (rr.x1 + rr.x2) * 0.5, (rr.y1 + rr.y2) * 0.5)
            end
        end
    end
    if not best then return "" end
    tech_reveal_node(gui, best)
    local r = widget_rect(best.btn) or best.r
    return string.format("%.1f,%.1f", (r.x1 + r.x2) * 0.5, (r.y1 + r.y2) * 0.5)
end

function tech_scroll_analog(gui, y, dt)
    local sv = gui and gui.npc_up_scheme
    if not (sv and sv.GetCurrentScrollPos and sv.SetScrollPos) then return false end
    local ok, cur = pcall(sv.GetCurrentScrollPos, sv)
    cur = ok and tonumber(cur) or 0
    local acc = gui._gp_tech_acc
    if not acc or math.floor(acc) ~= math.floor(cur) then acc = cur end
    local okn, mn = pcall(sv.GetMinScrollPos, sv)
    local okx, mx = pcall(sv.GetMaxScrollPos, sv)
    mn = okn and tonumber(mn) or 0
    mx = okx and tonumber(mx) or 0
    if mx <= mn then return false end
    acc = math.max(mn, math.min(mx, acc + (tonumber(y) or 0) * CC_SCROLL_SPEED * 14 * (tonumber(dt) or 0) / 1000))
    gui._gp_tech_acc = acc
    local p = math.floor(acc + 0.5)
    if p ~= math.floor(cur + 0.5) then pcall(sv.SetScrollPos, sv, p) end
    return true
end

function place_upgr_box(upgr_info, target_r)
    local dlg = upgr_info and (upgr_info.dialog or upgr_info.frame or upgr_info)
    if not (dlg and target_r and dlg.GetWidth and dlg.GetHeight and dlg.SetWndPos and vector2) then return false end
    local ok_w, bw = pcall(dlg.GetWidth, dlg)
    local ok_h, bh = pcall(dlg.GetHeight, dlg)
    bw = ok_w and tonumber(bw) or 0
    bh = ok_h and tonumber(bh) or 0
    if bw <= 1 or bh <= 1 then return false end
    local x = target_r.x2 + DESC_GAP
    if x + bw > UI_W - DESC_PAD then
        x = target_r.x1 - bw - DESC_GAP
    end
    x = math.max(DESC_PAD, math.min(UI_W - bw - DESC_PAD, x))
    local y = math.max(DESC_PAD, math.min(UI_H - bh - DESC_PAD, target_r.y1))
    pcall(dlg.SetWndPos, dlg, vector2():set(x, y))
    return true
end

function upgr_info_sync(gui)
    if not (is_active() and gui and gui.mode == "repair" and gui.upgr_info) then return false end
    local uinfo = gui.upgr_info
    if state.desc_hidden or state.panel ~= "tech" or modal_open(gui) then
        pcall(uinfo.Update, uinfo)
        return false
    end
    local kind, node = tech_under_cursor(gui)
    if kind ~= "upx" or not node or not node.section then
        pcall(uinfo.Update, uinfo)
        return false
    end
    uinfo.timer = -1000000
    local installed = (node.btn and node.btn.GetCheck and node.btn:GetCheck()) or false
    pcall(uinfo.Update, uinfo, node.section, node.prereq, installed)
    place_upgr_box(uinfo, node.r)
    return true
end

-- ---------------------------------------------------------------------------
-- В22: Попап «Снять запчасть» / «Обслуживание» (utils_ui_custom.UICellPropertiesCustom)
-- ---------------------------------------------------------------------------

function install_custom_props_hook()
    local m = rawget(_G, "utils_ui_custom")
    local cls = type(m) == "table" and m.UICellPropertiesCustom
    if not cls or cls._gp_hooked or type(cls.Reset) ~= "function" then return false end
    cls._gp_hooked = true
    local orig_reset = cls.Reset
    local orig_hide = cls.OnHide
    cls.Reset = function(self, ...)
        local res = orig_reset(self, ...)
        state.custom_props = self
        if is_active() and self.list_box then
            local ok_sz, sz = pcall(self.list_box.GetSize, self.list_box)
            if ok_sz and type(sz) == "number" and sz > 0 then
                local ok_it, itm0 = pcall(self.list_box.GetItemByIndex, self.list_box, 0)
                local r = ok_it and itm0 and widget_rect(itm0)
                if r then move_cursor((r.x1 + r.x2) * 0.5, (r.y1 + r.y2) * 0.5) end
            end
        end
        return res
    end
    if type(orig_hide) == "function" then
        cls.OnHide = function(self, ...)
            if rawequal(state.custom_props, self) then state.custom_props = nil end
            return orig_hide(self, ...)
        end
    end
    return true
end

function active_custom_props()
    install_custom_props_hook()
    local cp = state.custom_props
    if cp and shown(cp) and cp.list_box then return cp end
    if cp and not shown(cp) then state.custom_props = nil end
    return nil
end

-- ---------------------------------------------------------------------------
-- В20: «Перенести часть...» первым пунктом меню X + инлайн-окно количества
-- ---------------------------------------------------------------------------

function stack_objects(cc, idx)
    local out = {}
    local ci = cc and type(cc.cell) == "table" and cc.cell[idx]
    if not (ci and ci.ID) then return out end
    local seen = {}
    local function push_id(id)
        if not id or seen[id] then return end
        seen[id] = true
        local o = (id == ci.ID and cc.GetObj and cc:GetObj(idx))
            or (level and level.object_by_id and level.object_by_id(id))
        if o then out[#out + 1] = o end
    end
    push_id(ci.ID)
    if type(ci.childs) == "table" then
        local cids = {}
        for cid in pairs(ci.childs) do cids[#cids + 1] = cid end
        table.sort(cids, function(a, b) return (tonumber(a) or 0) < (tonumber(b) or 0) end)
        for _, cid in ipairs(cids) do push_id(cid) end
    end
    return out
end

function ensure_item_props_hook(gui)
    if not gui then return false end
    gui._gp_open_partial_move = function(self_gui, cc_arg, idx_arg, bag_arg)
        qty_dlg_open(self_gui, cc_arg, idx_arg, bag_arg)
    end
    local props = gui.item_props
    if not props or props._gp_partial_hooked or type(props.Reset) ~= "function" then return false end
    props._gp_partial_hooked = true
    local orig = props.Reset
    props.Reset = function(self, pos, acts, names, params, ...)
        if is_active() and is_two_side(gui) and type(acts) == "table" and type(names) == "table" then
            local has_move = false
            for i = 1, #acts do
                if acts[i] == "Action_Move" or acts[i] == "Action_Move_All" then
                    has_move = true
                    break
                end
            end
            if has_move then
                local h = gui.hover
                local bag = h and h.bag
                local idx = h and h.idx
                local cc = bag and gui.CC and gui.CC[bag]
                if not cc and type(gui.CC) == "table" then
                    for bname, c in pairs(gui.CC) do
                        if c and c.selected then
                            bag, idx, cc = bname, c.selected, c
                            break
                        end
                    end
                end
                local objs = cc and idx and stack_objects(cc, idx) or {}
                if #objs >= 2 then
                    params = type(params) == "table" and params or {}
                    table.insert(acts, 1, "_gp_open_partial_move")
                    table.insert(names, 1, (label("move_part")))
                    table.insert(params, 1, { cc, idx, bag })
                end
            end
        end
        return orig(self, pos, acts, names, params, ...)
    end
    return true
end

local function make_panel_bg(parent, x, y, w, h, tex)
    if not CUIStatic then return nil end
    local s = CUIStatic()
    s:SetAutoDelete(true)
    if tex and s.InitTexture then pcall(s.InitTexture, s, tex) end
    if s.SetStretchTexture then pcall(s.SetStretchTexture, s, true) end
    s:SetWndPos(vector2():set(x, y))
    s:SetWndSize(vector2():set(w, h))
    s:Show(true)
    parent:AttachChild(s)
    return s
end

local function make_panel_txt(parent, x, y, w, h, fnt, align, r, g, b, a)
    if not CUITextWnd then return nil end
    local t = CUITextWnd()
    t:SetAutoDelete(true)
    if fnt then t:SetFont(fnt) end
    if t.SetTextAlignment then pcall(t.SetTextAlignment, t, align or 2) end
    if t.SetVTextAlignment then pcall(t.SetVTextAlignment, t, 1) end
    t:SetTextColor(GetARGB(a or 255, r or 230, g or 230, b or 230))
    t:SetWndPos(vector2():set(x, y))
    t:SetWndSize(vector2():set(w, h))
    t:Show(true)
    parent:AttachChild(t)
    return t
end

function qty_dlg_shown()
    local q = state.qty_dlg
    return q ~= nil and q.active == true
end

local function qty_dlg_refresh_ui()
    local q = state.qty_dlg
    if not q then return end
    if q.val_txt and q.val_txt.SetText then
        q.val_txt:SetText(string.format("<  %d / %d  >", q.count, q.max_count))
    end
end

function qty_dlg_open(gui, cc, idx, bag)
    qty_dlg_cancel()
    if not (gui and is_two_side(gui) and cc and idx) then return false end
    local objs = stack_objects(cc, idx)
    if #objs < 2 then return deny() end
    local q = {
        active = true,
        gui = gui,
        cc = cc,
        idx = idx,
        bag = bag or src_bag(cc),
        max_count = #objs,
        count = math.max(1, math.floor(#objs / 2)),
    }
    if CUIStatic and CUITextWnd and vector2 and GetARGB then
        local w, h = 250, 96
        local x, y = (UI_W - w) * 0.5, (UI_H - h) * 0.5
        local bg = make_panel_bg(gui, x, y, w, h, "ui_inGame2_hint_wnd_main_window")
        if bg then
            local f18 = GetFontLetterica18Russian and GetFontLetterica18Russian()
            local f16 = GetFontLetterica16Russian and GetFontLetterica16Russian()
            q.bg = bg
            q.title_txt = make_panel_txt(bg, 10, 10, w - 20, 22, f18, 2, 230, 230, 230, 255)
            if q.title_txt then q.title_txt:SetText(label("move_part")) end
            q.val_txt = make_panel_txt(bg, 10, 36, w - 20, 26, f18, 2, 245, 245, 245, 255)
            q.hint_txt = make_panel_txt(bg, 10, 66, w - 20, 20, f16, 2, 180, 180, 180, 235)
            if q.hint_txt then
                local ht = is_russian()
                    and string.format("%s: Ок   %s: Отмена   LB/RB: ±5", side_resolve_btn("A"), side_resolve_btn("B"))
                    or string.format("%s: OK   %s: Cancel   LB/RB: +-5", side_resolve_btn("A"), side_resolve_btn("B"))
                q.hint_txt:SetText(ht)
            end
        end
    end
    state.qty_dlg = q
    qty_dlg_refresh_ui()
    return true
end

function qty_dlg_step(delta)
    local q = state.qty_dlg
    if not (q and q.active) then return false end
    local nxt = math.max(1, math.min(q.max_count, (tonumber(q.count) or 1) + (tonumber(delta) or 0)))
    if nxt == q.count then
        deny()
        return false
    end
    q.count = nxt
    qty_dlg_refresh_ui()
    return true
end

function qty_dlg_cancel()
    local q = state.qty_dlg
    if not q then return false end
    if q.bg and q.gui and q.gui.DetachChild then
        q.bg:Show(false)
        pcall(q.gui.DetachChild, q.gui, q.bg)
    elseif q.bg and q.bg.Show then
        q.bg:Show(false)
    end
    state.qty_dlg = nil
    return true
end

function qty_dlg_confirm()
    local q = state.qty_dlg
    if not (q and q.active) then return false end
    local gui, cc, idx, bag, n = q.gui, q.cc, q.idx, q.bag, q.count
    qty_dlg_cancel()
    if not (gui and is_two_side(gui) and cc) then return false end
    local objs = stack_objects(cc, idx)
    local moved = 0
    for i = 1, math.min(n, #objs) do
        local obj = objs[i]
        if obj and gui:Cond_Move(obj, bag) then
            gui:Action_Move(obj, bag)
            moved = moved + 1
        else
            emit_move_deny_toast(gui, obj, bag, cc.cell and cc.cell[idx])
            break
        end
    end
    if moved == 0 then return deny() end
    state.side_actions = (state.side_actions or 0) + moved
    state.last_side = "move_part:" .. tostring(moved)
    return true
end

function qty_dlg_sync(gui)
    local q = state.qty_dlg
    if not q then return false end
    if not rawequal(q.gui, gui) or not is_two_side(gui) then
        qty_dlg_cancel()
        return false
    end
    return true
end

-- ---------------------------------------------------------------------------
-- В23: Продажа оружия с патронами/магазином («Разрядить и продать» / «Продать как есть» / «Отмена»)
-- ---------------------------------------------------------------------------

function weapon_has_ammo_or_mag(obj)
    if not obj then return false end
    local is_wpn = (IsWeapon and IsWeapon(obj)) or (type(obj.get_ammo_in_magazine) == "function")
    if not is_wpn then return false end
    local is_melee = IsMelee and IsMelee(obj)
    if is_melee then return false end
    if type(obj.get_ammo_in_magazine) == "function" then
        local ok, ammo = pcall(obj.get_ammo_in_magazine, obj)
        if ok and tonumber(ammo) and tonumber(ammo) > 0 then
            local sec = obj.section and obj:section() or ""
            if not sec:find("^wpn_binoc") and sec ~= "wpn_knife" then
                return true
            end
        end
    end
    local mags = rawget(_G, "magazines")
    if type(mags) == "table" and type(mags.get_mag_loaded) == "function" and obj.id then
        local ok, mag_data = pcall(mags.get_mag_loaded, obj:id())
        if ok and mag_data then return true end
    end
    return false
end

function unload_weapon_safe(gui, obj, bag)
    if not obj then return false end
    local mags = rawget(_G, "magazines")
    if type(mags) == "table" and obj.id then
        local ok_m, has_mag = pcall(function() return mags.get_mag_loaded and mags.get_mag_loaded(obj:id()) end)
        if ok_m and has_mag then
            if type(mags.eject_mag) == "function" then
                pcall(mags.eject_mag, obj)
            elseif rawget(_G, "mag_support") and type(mag_support.eject_mag) == "function" then
                pcall(mag_support.eject_mag, obj)
            end
        end
    end
    if gui and type(gui.Action_Unload) == "function" then
        pcall(gui.Action_Unload, gui, obj, bag)
    elseif type(obj.force_unload_magazine) == "function" then
        pcall(obj.force_unload_magazine, obj, true)
    end
    return true
end

function wpn_dlg_shown()
    local d = state.wpn_dlg
    return d ~= nil and d.active == true
end

function wpn_dlg_is_btn(w)
    local d = state.wpn_dlg
    if not (d and d.btns and w) then return false end
    for i = 1, #d.btns do
        if rawequal(d.btns[i], w) then return true end
    end
    return false
end

function wpn_dlg_targets()
    local out = {}
    local d = state.wpn_dlg
    if not (d and d.btns) then return out end
    for i = 1, #d.btns do
        local r = widget_rect(d.btns[i])
        if r then
            out[#out + 1] = {
                mx = (r.x1 + r.x2) * 0.5,
                my = (r.y1 + r.y2) * 0.5,
                w = r.x2 - r.x1,
                h = r.y2 - r.y1,
                kind = "btn",
                idx = i,
            }
        end
    end
    return out
end

function wpn_dlg_query(cx, cy)
    local d = state.wpn_dlg
    if not (d and d.active and d.btns) then return nil end
    for i = 1, #d.btns do
        local r = widget_rect(d.btns[i])
        if r and cx >= r.x1 and cx <= r.x2 and cy >= r.y1 and cy <= r.y2 then
            d.sel = i
            return string.format("1;%.1f,%.1f,%.1f,%.1f;kind=btn", r.x1, r.y1, r.x2 - r.x1, r.y2 - r.y1)
        end
    end
    local b = d.btns[d.sel or 1]
    local r = b and widget_rect(b)
    if r then
        return string.format("1;%.1f,%.1f,%.1f,%.1f;kind=btn", r.x1, r.y1, r.x2 - r.x1, r.y2 - r.y1)
    end
    return nil
end

function wpn_dlg_open(gui, src, all)
    wpn_dlg_cancel()
    if not (gui and src and src.cc) then return false end
    local cx, cy = cursor_xy()
    local d = {
        active = true,
        gui = gui,
        src = src,
        all = all and true or false,
        sel = 1,
        ret_x = cx,
        ret_y = cy,
        btns = {},
    }
    local titles = { label("wpn_unload_sell"), label("wpn_sell_loaded"), label("cancel") }
    if CUIStatic and CUITextWnd and vector2 and GetARGB then
        local w, h = 264, 138
        local x, y = (UI_W - w) * 0.5, (UI_H - h) * 0.5
        local bg = make_panel_bg(gui, x, y, w, h, "ui_inGame2_hint_wnd_main_window")
        if bg then
            d.bg = bg
            local f18 = GetFontLetterica18Russian and GetFontLetterica18Russian()
            local f16 = GetFontLetterica16Russian and GetFontLetterica16Russian()
            local hdr = make_panel_txt(bg, 10, 10, w - 20, 22, f18, 2, 235, 235, 235, 255)
            if hdr then hdr:SetText(label("wpn_ammo_title")) end
            for i = 1, 3 do
                local by = 38 + (i - 1) * 30
                local row_bg = make_panel_bg(bg, 16, by, w - 32, 25, "ui_inGame2_big_inventory_button")
                if row_bg then
                    local tx = make_panel_txt(row_bg, 6, 0, w - 44, 25, f16, 2, 230, 230, 230, 255)
                    if tx then tx:SetText(titles[i]) end
                    d.btns[i] = row_bg
                end
            end
        end
    end
    state.wpn_dlg = d
    if d.btns[1] then
        local r = widget_rect(d.btns[1])
        if r then move_cursor((r.x1 + r.x2) * 0.5, (r.y1 + r.y2) * 0.5) end
    end
    return true
end

function wpn_dlg_step(dir)
    local d = state.wpn_dlg
    if not (d and d.active) then return "" end
    local delta = (dir == 1 or dir == 3) and -1 or ((dir == 2 or dir == 4) and 1 or 0)
    if delta == 0 then return "" end
    local nxt = math.max(1, math.min(3, (d.sel or 1) + delta))
    if nxt == d.sel then
        deny()
        return ""
    end
    d.sel = nxt
    local b = d.btns and d.btns[nxt]
    local r = b and widget_rect(b)
    if r then
        return string.format("%.1f,%.1f", (r.x1 + r.x2) * 0.5, (r.y1 + r.y2) * 0.5)
    end
    return "0.0,0.0"
end

function wpn_dlg_cancel()
    local d = state.wpn_dlg
    if not d then return false end
    local rx, ry = d.ret_x, d.ret_y
    if d.bg and d.gui and d.gui.DetachChild then
        d.bg:Show(false)
        pcall(d.gui.DetachChild, d.gui, d.bg)
    elseif d.bg and d.bg.Show then
        d.bg:Show(false)
    end
    state.wpn_dlg = nil
    if rx and ry then move_cursor(rx, ry) end
    return true
end

function wpn_dlg_confirm()
    local d = state.wpn_dlg
    if not (d and d.active) then return false end
    local gui, src, all, sel = d.gui, d.src, d.all, d.sel or 1
    if d.btns and #d.btns > 0 then
        local cx, cy = cursor_xy()
        for i = 1, #d.btns do
            local r = widget_rect(d.btns[i])
            if r and cx >= r.x1 and cx <= r.x2 and cy >= r.y1 and cy <= r.y2 then
                sel = i
                break
            end
        end
    end
    wpn_dlg_cancel()
    if sel == 3 or not (gui and gui.mode == "trade" and src and src.cc) then
        return true
    end
    local ci = src.cc.cell and src.cc.cell[src.idx]
    local obj = (ci and ci.ID == src.id) and src.cc:GetObj(src.idx) or nil
    if not obj then return deny() end
    if sel == 1 then
        if all then
            local objs = stack_objects(src.cc, src.idx)
            for _, o in ipairs(objs) do unload_weapon_safe(gui, o, src.bag) end
        else
            unload_weapon_safe(gui, obj, src.bag)
        end
    end
    if not gui:Cond_Move(obj, src.bag) then
        emit_move_deny_toast(gui, obj, src.bag, ci)
        return deny()
    end
    if all and gui.Cond_Childs and gui:Cond_Childs(obj, src.bag) then
        gui:Action_Move_All(obj, src.bag)
    else
        gui:Action_Move(obj, src.bag)
    end
    state.side_actions = (state.side_actions or 0) + 1
    state.last_side = (sel == 1) and "unload_and_move" or (all and "move_all" or "move")
    return true
end

function wpn_dlg_sync(gui)
    local d = state.wpn_dlg
    if not d then return false end
    if d.gui ~= gui or gui.mode ~= "trade" then
        wpn_dlg_cancel()
        return false
    end
    return true
end

-- ---------------------------------------------------------------------------
-- В24: L3 Очистить корзину (trade) + В25: тосты отказа переноса
-- ---------------------------------------------------------------------------

function trade_carts_nonempty(gui)
    if not (gui and gui.mode == "trade") then return false end
    return (not cart_empty(gui, "actor_trade")) or (not cart_empty(gui, "npc_trade"))
end

local function collect_cart_objects(cc)
    local out = {}
    if not cc then return out end
    local seen = {}
    if type(cc.indx_id) == "table" and level and level.object_by_id then
        for id in pairs(cc.indx_id) do
            if not seen[id] then
                seen[id] = true
                local o = level.object_by_id(id)
                if o then out[#out + 1] = o end
            end
        end
    end
    if #out == 0 and type(cc.cell) == "table" then
        for idx, ci in pairs(cc.cell) do
            if ci and ci.ID and not seen[ci.ID] then
                seen[ci.ID] = true
                local o = (cc.GetObj and cc:GetObj(idx))
                    or (level and level.object_by_id and level.object_by_id(ci.ID))
                if o then out[#out + 1] = o end
            end
        end
    end
    return out
end

function clear_trade_carts(gui)
    if not trade_carts_nonempty(gui) then return false end
    if picker_shown(gui) and type(gui.Picker_Toggle) == "function" then
        pcall(gui.Picker_Toggle, gui, nil, nil, nil, true)
    end
    local moved = 0
    for _, bag in ipairs({ "actor_trade", "npc_trade" }) do
        local cc = gui.CC and gui.CC[bag]
        for _, obj in ipairs(collect_cart_objects(cc)) do
            if gui.Cond_Childs and gui:Cond_Childs(obj, bag) and type(gui.Action_Move_All) == "function" then
                gui:Action_Move_All(obj, bag)
                moved = moved + 1
            elseif type(gui.Action_Move) == "function" then
                gui:Action_Move(obj, bag)
                moved = moved + 1
            end
        end
    end
    if type(gui.TMode_ResetInventories) == "function" then
        pcall(gui.TMode_ResetInventories, gui)
    end
    state.cart_clears = (state.cart_clears or 0) + 1
    state.last_side = "clear_cart"
    return moved > 0 or true
end

function emit_move_deny_toast(gui, obj, bag, ci)
    if not gui then return false end
    local note = ci and ci.flags and strip_xr_colors(ci.flags.note_str)
    if note and note ~= "" then
        return emit_toast(note)
    end
    if gui.mode == "trade" then
        local msg = (bag == "npc_trade_bag" or bag == "npc_trade")
            and tr_or("st_no_trade_tip_2", "Торговец не продаёт этот предмет", "Trader will not sell this item")
            or tr_or("st_no_trade_tip_1", "Торговец не покупает этот предмет", "Trader does not buy this item")
        return emit_toast(msg)
    end
    if gui.mode == "loot" then
        if bag == "actor_bag" or bag == "actor_equ" or bag == "actor_belt" then
            if gui.npc_is_companion then
                return emit_toast(is_russian() and "Напарник перегружен" or "Companion is overloaded")
            end
            return emit_toast(is_russian() and "Тайник переполнен" or "Stash is full")
        end
        return emit_toast(is_russian() and "Нельзя перенести предмет" or "Cannot move item")
    end
    return false
end

-- ---------------------------------------------------------------------------
-- В21: Переименование личного тайника в окне обыска -> экранная клавиатура F5.1
-- ---------------------------------------------------------------------------

function stash_partner(gui)
    if not (gui and gui.mode == "loot") then return nil end
    if type(gui.GetPartner) == "function" then
        local ok, npc = pcall(gui.GetPartner, gui)
        if ok and npc then return npc end
    end
    if gui.npc_id and level and level.object_by_id then
        return level.object_by_id(gui.npc_id)
    end
    return nil
end

function stash_is_personal(gui)
    local npc = stash_partner(gui)
    if not npc then return false end
    local al = rawget(_G, "z_auto_looter")
    if type(al) == "table" and type(al.is_placable_stash) == "function" then
        local ok, res = pcall(al.is_placable_stash, npc)
        if ok and res == true then return true end
    end
    local id = type(npc.id) == "function" and npc:id() or gui.npc_id
    local asm = rawget(_G, "alife_storage_manager")
    if id and type(asm) == "table" and type(asm.get_state) == "function" then
        local ok, mdata = pcall(asm.get_state)
        if ok and type(mdata) == "table" and type(mdata.player_created_stashes) == "table"
            and mdata.player_created_stashes[id] ~= nil then
            return true
        end
    end
    local sec = type(npc.section) == "function" and npc:section() or ""
    if sec == "inv_backpack" or sec:find("^placeable_stash") then
        return true
    end
    return false
end

function stash_rename_hide(gui)
    local g = gui or (state.stash_rename and state.stash_rename.gui)
    local btn = g and g._gp_stash_rename_btn
    if btn and btn.Show then pcall(btn.Show, btn, false) end
end

function stash_rename_ui_sync(gui)
    if not (gui and gui.mode == "loot" and stash_is_personal(gui) and gui.npc_dialog) then
        stash_rename_hide(gui)
        return false
    end
    local btn = gui._gp_stash_rename_btn
    if not btn and CUIStatic and CUITextWnd and vector2 and GetARGB then
        btn = make_panel_bg(gui.npc_dialog, 206, 12, 118, 22, "ui_inGame2_big_inventory_button")
        if btn then
            local f16 = GetFontLetterica16Russian and GetFontLetterica16Russian()
            local tx = make_panel_txt(btn, 4, 0, 110, 22, f16, 2, 225, 225, 225, 255)
            if tx then tx:SetText(label("rename_stash")) end
            gui._gp_stash_rename_btn = btn
            gui._gp_stash_rename_txt = tx
        end
    end
    if btn then
        if gui._gp_stash_rename_txt then gui._gp_stash_rename_txt:SetText(label("rename_stash")) end
        btn:Show(true)
    end
    return btn ~= nil
end

function stash_rename_at_cursor(gui)
    local btn = gui and gui._gp_stash_rename_btn
    if not (btn and stash_is_personal(gui)) then return false end
    local r = widget_rect(btn)
    if not r then return false end
    local cx, cy = cursor_xy()
    return cx >= r.x1 and cx <= r.x2 and cy >= r.y1 and cy <= r.y2
end

function stash_apply_name(gui, npc_id, new_name)
    local clean = tostring(new_name or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if clean == "" or not npc_id then return false end
    if level then
        local spot = "treasure_player"
        if type(level.map_has_object_spot) == "function" then
            local ok_p, hp = pcall(level.map_has_object_spot, npc_id, "treasure_player")
            if not (ok_p and tonumber(hp) and tonumber(hp) > 0) then
                local ok_t, ht = pcall(level.map_has_object_spot, npc_id, "treasure")
                if ok_t and tonumber(ht) and tonumber(ht) > 0 then
                    spot = "treasure"
                elseif type(level.map_add_object_spot_ser) == "function" then
                    pcall(level.map_add_object_spot_ser, npc_id, "treasure_player", clean)
                end
            end
        end
        if type(level.map_change_spot_hint) == "function" then
            pcall(level.map_change_spot_hint, npc_id, spot, clean)
        end
    end
    if gui and gui.npc_name and type(gui.npc_name.SetText) == "function" then
        pcall(gui.npc_name.SetText, gui.npc_name, clean)
    end
    state.stash_renames = (state.stash_renames or 0) + 1
    state.last_stash_name = clean
    return true
end

function stash_rename_open(gui)
    if not (gui and stash_is_personal(gui)) then return false end
    local npc = stash_partner(gui)
    local npc_id = (npc and type(npc.id) == "function" and npc:id()) or gui.npc_id
    if not npc_id then return false end
    local edit = gui._gp_stash_edit
    if not edit and CUIEditBox and vector2 then
        edit = CUIEditBox()
        edit:SetAutoDelete(true)
        if edit.SetWindowName then pcall(edit.SetWindowName, edit, "fld_input") end
        edit:SetWndPos(vector2():set(-2000, -2000))
        edit:SetWndSize(vector2():set(160, 24))
        edit:Show(false)
        gui:AttachChild(edit)
        gui._gp_stash_edit = edit
    end
    if not edit then return false end
    local cur_name = (gui.npc_name and gui.npc_name.GetText and gui.npc_name:GetText()) or ""
    if edit.SetText then pcall(edit.SetText, edit, cur_name) end
    if game and type(game.gamepad_new_game_keyboard) == "function" then
        local ok, opened = pcall(game.gamepad_new_game_keyboard, edit)
        if ok and opened then
            state.stash_rename = {
                gui = gui,
                edit = edit,
                npc_id = npc_id,
                orig = cur_name,
                was_osk = false,
            }
            return true
        end
    end
    return false
end

function stash_rename_sync(gui)
    local sr = state.stash_rename
    if not sr then return false end
    if sr.gui ~= gui or gui.mode ~= "loot" then
        state.stash_rename = nil
        return false
    end
    local top = true
    if game and type(game.gamepad_is_top_dialog) == "function" then
        local ok, v = pcall(game.gamepad_is_top_dialog, gui)
        if ok then top = (v == true) end
    end
    if not top then
        sr.was_osk = true
        return false
    end
    local cur = (sr.edit and sr.edit.GetText and sr.edit:GetText()) or sr.orig
    if sr.was_osk or cur ~= sr.orig then
        state.stash_rename = nil
        if cur ~= sr.orig and cur ~= "" then
            return stash_apply_name(gui, sr.npc_id, cur)
        end
    end
    return false
end

-- ---------------------------------------------------------------------------
-- Единые точки входа для gp_bridge и StepInventoryButtons (A / B / D-Pad / L3)
-- ---------------------------------------------------------------------------

function on_button_a_fast()
    local mb_res = on_msg_box_button("A")
    if mb_res then return mb_res end
    if qty_dlg_shown() then
        qty_dlg_confirm()
        return "handled_item_props:qty_ok"
    end
    if wpn_dlg_shown() then
        wpn_dlg_confirm()
        return "handled_item_props:wpn_ok"
    end
    if active_custom_props() then
        return nil
    end
    local gui = get_gui()
    if not (is_active() and gui) then return nil end
    if gui.mode == "loot" and stash_rename_at_cursor(gui) then
        stash_rename_open(gui)
        return "handled_item_props:stash_rename"
    end
    if gui.mode == "repair" and state.panel == "tech" then
        tech_activate_under_cursor(gui)
        return "handled_item_props:tech"
    end
    return nil
end

function on_button_b_fast()
    local mb_res = on_msg_box_button("B")
    if mb_res then return mb_res end
    if qty_dlg_shown() then
        qty_dlg_cancel()
        return "closed_item_props"
    end
    if wpn_dlg_shown() then
        wpn_dlg_cancel()
        return "closed_item_props"
    end
    return nil
end

function modal_or_tech_dpad_snap(gui, cx, cy, dir)
    if msg_box_shown(gui) then
        return "0.0,0.0"
    end
    if qty_dlg_shown() then
        local d = (dir == 3 or dir == 2) and -1 or ((dir == 4 or dir == 1) and 1 or 0)
        if d ~= 0 then qty_dlg_step(d) end
        return string.format("%.1f,%.1f", tonumber(cx) or 512, tonumber(cy) or 384)
    end
    if wpn_dlg_shown() then
        local res = wpn_dlg_step(dir)
        if res ~= "" then return res end
        return string.format("%.1f,%.1f", tonumber(cx) or 512, tonumber(cy) or 384)
    end
    if gui and gui.mode == "repair" and state.panel == "tech" then
        return tech_dpad_snap(gui, cx, cy, dir)
    end
    return nil
end

function l3_press()
    if not is_active() or state.pick then return false end
    local gui = get_gui()
    if not gui or modal_open(gui) then return false end
    if gui.mode == "trade" then
        if trade_carts_nonempty(gui) then
            return clear_trade_carts(gui)
        end
        return false
    end
    if gui.mode == "loot" and stash_is_personal(gui) then
        return stash_rename_open(gui)
    end
    return false
end
